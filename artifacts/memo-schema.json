{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0.0"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-[a-z0-9]{16}$"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "companyName": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "industry": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "employees": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "city": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "cover": {
      "type": "object",
      "properties": {
        "kicker": {
          "type": "string",
          "minLength": 1
        },
        "roman": {
          "type": "string",
          "minLength": 1
        },
        "italic": {
          "type": "string"
        },
        "dek": {
          "type": "string"
        }
      },
      "required": [
        "kicker",
        "roman"
      ],
      "additionalProperties": false
    },
    "benchmark": {
      "type": "object",
      "properties": {
        "industryName": {
          "type": "string",
          "minLength": 1
        },
        "industryN": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "scoreNumeric": {
          "type": "number"
        },
        "industryMedian": {
          "type": "number"
        },
        "industryP25": {
          "type": "number"
        },
        "industryP75": {
          "type": "number"
        },
        "percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "betterThanCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "worseThanCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scoreMax": {
          "type": "number"
        },
        "snapshotDate": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "oneLiner": {
          "type": "string"
        }
      },
      "required": [
        "industryName",
        "industryN",
        "scoreNumeric",
        "industryMedian"
      ],
      "additionalProperties": false
    },
    "screenshots": {
      "type": "object",
      "properties": {
        "homepageDesktop": {
          "type": "string",
          "format": "uri"
        },
        "homepageMobile": {
          "type": "string",
          "format": "uri"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "verdictCells": {
      "minItems": 3,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string",
            "enum": [
              "search",
              "bolt",
              "target",
              "megaphone",
              "bar",
              "spark",
              "mail",
              "phone",
              "flag",
              "eye",
              "clock"
            ]
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "benchmark": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "checks": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "ok",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "icon",
          "heading",
          "value",
          "note",
          "checks"
        ],
        "additionalProperties": false
      }
    },
    "rankedFixes": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "enum": [
              "low",
              "med",
              "high"
            ]
          },
          "impact": {
            "type": "string",
            "enum": [
              "low",
              "med",
              "high"
            ]
          }
        },
        "required": [
          "rank",
          "what",
          "why",
          "effort",
          "impact"
        ],
        "additionalProperties": false
      }
    },
    "personalObservation": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "slug",
    "domain",
    "generatedAt",
    "cover",
    "verdictCells",
    "rankedFixes",
    "personalObservation"
  ],
  "additionalProperties": false
}
