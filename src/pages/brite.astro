---
import Base from '../layouts/Base.astro';

const title = 'Brite Demand Engine · Prototype';
const description = 'Cold outbound that turns marketing audits into Brite job reqs. A working prototype built for Anil.';
---
<Base
  title={title}
  description={description}
  posthogCapturePageview={true}
>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

<div class="brite">

  <!-- TOP BAR -->
  <header class="bx-top">
    <div class="bx-wrap bx-top-in">
      <div class="bx-brand">
        <span class="bx-word">Brite</span>
        <span class="bx-x">×</span>
        <span class="bx-rivett">Rivett</span>
      </div>
      <span class="bx-pill">Demand engine · prototype</span>
    </div>
  </header>

  <!-- HERO -->
  <section class="bx-hero">
    <div class="bx-wrap">
      <span class="bx-eyebrow">Built for Anil · by Fred Style</span>
      <h1 class="bx-h1">Every audit is a <span class="bx-orange">Brite job req.</span></h1>
      <p class="bx-lede">
        Cold outbound that finds startups leaking money on marketing, shows them exactly which
        hire fixes it, and routes them to Brite. The diagnosis sells the role.
      </p>
      <div class="bx-hero-cta">
        <a class="bx-btn" href="#engine">See it work</a>
        <span class="bx-hero-note">Live prototype. Click a finding below.</span>
      </div>
    </div>
  </section>

  <!-- PROBLEM STRIP -->
  <section class="bx-strip">
    <div class="bx-wrap bx-strip-in">
      <div class="bx-strip-item">
        <span class="bx-strip-k">The pain you named</span>
        <span class="bx-strip-v">Customer acquisition.</span>
      </div>
      <div class="bx-strip-item">
        <span class="bx-strip-k">The usual fix</span>
        <span class="bx-strip-v">Paid ads. CAC climbs.</span>
      </div>
      <div class="bx-strip-item bx-strip-hl">
        <span class="bx-strip-k">The engine</span>
        <span class="bx-strip-v">Demand that pre-sells the hire.</span>
      </div>
    </div>
  </section>

  <!-- PIPELINE -->
  <section class="bx-section">
    <div class="bx-wrap">
      <h2 class="bx-h2">How the engine runs</h2>
      <p class="bx-sub">Five steps. Fully automated up to the booked call.</p>

      <div class="bx-pipe">
        <div class="bx-step">
          <span class="bx-step-n">1</span>
          <h3>Find</h3>
          <p>Mine startups that fit Brite's ICP. Funded, growing, no senior marketer in seat yet.</p>
        </div>
        <div class="bx-step">
          <span class="bx-step-n">2</span>
          <h3>Audit</h3>
          <p>Auto-generate a personalised marketing audit at their own domain. Real findings, not a template.</p>
        </div>
        <div class="bx-step">
          <span class="bx-step-n">3</span>
          <h3>Diagnose</h3>
          <p>Each leak maps to a role Brite already places. The audit writes the job req for you.</p>
        </div>
        <div class="bx-step">
          <span class="bx-step-n">4</span>
          <h3>Pitch</h3>
          <p>Cold message leads with the leak, names the hire, routes them to Brite. Value before the ask.</p>
        </div>
        <div class="bx-step">
          <span class="bx-step-n">5</span>
          <h3>Book</h3>
          <p>Qualified, pre-matched founders land on Brite's calendar already knowing what they need.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- INTERACTIVE ENGINE -->
  <section class="bx-section bx-cream" id="engine">
    <div class="bx-wrap">
      <h2 class="bx-h2">The audit, turned into a hire</h2>
      <p class="bx-sub">
        Real audit. Real company. <a class="bx-link" href="https://rivett.tech/audit/v3/crinklepaper-com" target="_blank" rel="noopener">CrinklePak ↗</a>
        Click a finding. Watch it become a Brite role.
      </p>

      <div class="bx-engine">
        <div class="bx-findings" id="bx-findings"><!-- chips injected --></div>
        <div class="bx-panel" id="bx-panel"><!-- detail injected --></div>
      </div>
    </div>
  </section>

  <!-- ECONOMICS -->
  <section class="bx-section">
    <div class="bx-wrap">
      <h2 class="bx-h2">Why the CAC math works</h2>
      <p class="bx-sub">The audit does the selling, so the cost-per-booked-call stays low.</p>
      <div class="bx-econ">
        <div class="bx-econ-card">
          <span class="bx-econ-k">Paid ads</span>
          <p>You bid against everyone for a cold click. CAC only goes up. The click doesn't know it needs you.</p>
        </div>
        <div class="bx-econ-card bx-econ-win">
          <span class="bx-econ-k">The engine</span>
          <p>Every touch carries a personalised diagnosis. The founder sees the gap before you spend a dollar on paid. Warm, pre-qualified, pre-matched to a role.</p>
        </div>
      </div>
      <p class="bx-econ-line">
        Same money you'd burn proving a paid channel buys you a repeatable demand machine that
        also tells you <span class="bx-orange-t">which role to place.</span>
      </p>
    </div>
  </section>

  <!-- WHAT I'D BUILD -->
  <section class="bx-section bx-dark">
    <div class="bx-wrap">
      <span class="bx-eyebrow bx-eyebrow-dark">What I'd plug into Brite</span>
      <h2 class="bx-h2 bx-h2-dark">A demand engine, wired to your roster.</h2>
      <div class="bx-build">
        <div class="bx-build-row"><span class="bx-build-num">01</span><p><b>ICP mining</b> tuned to Brite's customer — funded startups missing a senior marketer.</p></div>
        <div class="bx-build-row"><span class="bx-build-num">02</span><p><b>Audit per prospect</b>, auto-generated, hosted, personalised to their real stack.</p></div>
        <div class="bx-build-row"><span class="bx-build-num">03</span><p><b>Finding-to-role routing</b> against your live roster, so every lead arrives matched.</p></div>
        <div class="bx-build-row"><span class="bx-build-num">04</span><p><b>Outreach + tracking</b> — reply rate, booked calls, pipeline, all on a dashboard you can audit.</p></div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bx-cta">
    <div class="bx-wrap bx-cta-in">
      <div>
        <h2 class="bx-cta-h">This is the prototype. <span class="bx-orange">Thursday I show you it running.</span></h2>
        <p class="bx-cta-p">You, me, Deniz. I'll point it at a real Brite ICP live and we watch the pipeline fill.</p>
      </div>
      <a class="bx-btn bx-btn-lg" href="https://calendly.com/incrementum-team/30min" target="_blank" rel="noopener">See you Thursday</a>
    </div>
  </section>

  <footer class="bx-foot">
    <div class="bx-wrap bx-foot-in">
      <span>Prototype built by <b>Fred Style</b> · Rivett</span>
      <span>Not affiliated with Brite. A demonstration.</span>
    </div>
  </footer>

</div>

<script is:inline>
  // Real CrinklePak audit findings, mapped to Brite's real published roles.
  const FINDINGS = [
    {
      tag: 'Email auth',
      finding: 'No DMARC record',
      detail: "CrinklePak's order confirmations and wholesale invoices have no DMARC policy. Mail lands in spam, and anyone can spoof their domain.",
      role: 'Email Marketing Manager',
      does: 'Email, SMS, push & in-app, lifecycle journeys',
      price: 'from $3,500/mo',
      cold: '"Your order confirmations are landing in spam and anyone can impersonate your domain. The fix is a half-day for the right hire — want the breakdown?"',
    },
    {
      tag: 'Paid',
      finding: 'No Meta Pixel',
      detail: "11 Google + 3 LinkedIn campaigns running, zero Meta tracking. They can't test or attribute the highest-ROAS channel for a Shopify brand.",
      role: 'Performance Marketer',
      does: 'Google Ads, Facebook Ads, campaign optimisation, reducing CAC',
      price: 'from $3,500/mo',
      cold: '"You\'re spending on ads but flying blind on the one channel that usually wins for Shopify. A performance hire pays for itself in a month."',
    },
    {
      tag: 'Conversion',
      finding: '4.7s mobile load · 9px tap targets',
      detail: 'Paid traffic hits a page that takes ~5s to paint on a phone, with buttons too small to tap. Half the clicks bounce before the price loads.',
      role: 'Growth Marketer',
      does: 'Landing-page conversion, mobile UX, funnel optimisation',
      price: 'from $3,500/mo',
      cold: '"You\'re paying for clicks that hit a 5-second page on mobile. A growth hire turns the traffic you already buy into orders."',
    },
    {
      tag: 'SEO',
      finding: 'No schema · no rich snippets',
      detail: 'Product pages ship no structured data. Google shows zero review stars in search while competitors get them. Free visibility, left on the floor.',
      role: 'Technical SEO',
      does: 'Schema implementation, snippet optimisation, indexing, internal linking',
      price: 'from $3,500/mo',
      cold: '"You claim hundreds of 5-star reviews but Google shows none of them. A technical SEO fixes that in a week and your listings light up."',
    },
    {
      tag: 'Analytics',
      finding: 'GA4 + 4 unidentified trackers',
      detail: "Tag manager is a junk drawer — four trackers nobody can name. No clean read on ROAS or CAC, so spend decisions are guesswork.",
      role: 'Marketing / Web Analytics',
      does: 'GA4, ROAS & CAC calculation, A/B tests, dashboards',
      price: 'from $3,500/mo',
      cold: '"There are four trackers on your site nobody can identify and no clean CAC number. An analytics hire gives you a dashboard you can actually trust."',
    },
  ];

  function renderPanel(f) {
    const p = document.getElementById('bx-panel');
    p.innerHTML = `
      <div class="bx-panel-flow">
        <div class="bx-panel-leak">
          <span class="bx-panel-k">Audit finds</span>
          <h3 class="bx-panel-finding">${f.finding}</h3>
          <p class="bx-panel-detail">${f.detail}</p>
        </div>
        <div class="bx-panel-arrow" aria-hidden="true">→</div>
        <div class="bx-panel-role">
          <span class="bx-panel-k">Brite places</span>
          <h3 class="bx-panel-rolename">${f.role}</h3>
          <p class="bx-panel-does">${f.does}</p>
          <span class="bx-panel-price">${f.price}</span>
        </div>
      </div>
      <div class="bx-panel-cold">
        <span class="bx-panel-k">The cold opener it writes</span>
        <p>${f.cold}</p>
      </div>
    `;
  }

  function renderChips() {
    const c = document.getElementById('bx-findings');
    c.innerHTML = '';
    FINDINGS.forEach((f, i) => {
      const b = document.createElement('button');
      b.className = 'bx-chip' + (i === 0 ? ' bx-chip-on' : '');
      b.innerHTML = `<span class="bx-chip-tag">${f.tag}</span><span class="bx-chip-finding">${f.finding}</span>`;
      b.addEventListener('click', () => {
        document.querySelectorAll('.bx-chip').forEach((x) => x.classList.remove('bx-chip-on'));
        b.classList.add('bx-chip-on');
        renderPanel(f);
        if (window.posthog) window.posthog.capture('brite_proto_finding_clicked', { finding: f.finding, role: f.role });
      });
      c.appendChild(b);
    });
  }

  renderChips();
  renderPanel(FINDINGS[0]);
</script>

<style is:global>
  .brite {
    --bx-orange: #ff9700;
    --bx-orange-d: #e88500;
    --bx-ink: #1f1f1f;
    --bx-ink-2: #373737;
    --bx-muted: #758696;
    --bx-cream: #fff5ea;
    --bx-off: #fafafa;
    --bx-line: #ececec;
    --bx-line-2: #e2e2e2;
    --bx-font: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
    --bx-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-family: var(--bx-body);
    color: var(--bx-ink);
    background: #fff;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .brite * { box-sizing: border-box; }
  .brite .bx-wrap { max-width: 1080px; margin: 0 auto; padding: 0 28px; }

  /* TOP */
  .brite .bx-top { border-bottom: 1px solid var(--bx-line); background: #fff; }
  .brite .bx-top-in { display: flex; justify-content: space-between; align-items: center; padding: 18px 28px; }
  .brite .bx-brand { display: flex; align-items: center; gap: 10px; font-family: var(--bx-font); font-weight: 800; font-size: 22px; letter-spacing: -0.02em; }
  .brite .bx-word { color: var(--bx-ink); }
  .brite .bx-x { color: var(--bx-muted); font-weight: 500; font-size: 16px; }
  .brite .bx-rivett { color: var(--bx-muted); font-weight: 700; }
  .brite .bx-pill { font-family: var(--bx-font); font-weight: 600; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--bx-orange-d); background: var(--bx-cream); padding: 7px 14px; border-radius: 999px; }

  /* HERO */
  .brite .bx-hero { background: linear-gradient(180deg, var(--bx-cream) 0%, #fff 100%); padding: 88px 0 72px; }
  .brite .bx-eyebrow { display: inline-block; font-family: var(--bx-font); font-weight: 700; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--bx-orange-d); margin-bottom: 20px; }
  .brite .bx-h1 { font-family: var(--bx-font); font-weight: 800; font-size: clamp(38px, 5.4vw, 62px); line-height: 1.04; letter-spacing: -0.03em; margin: 0; max-width: 880px; color: var(--bx-ink); }
  .brite .bx-orange { color: var(--bx-orange); }
  .brite .bx-orange-t { color: var(--bx-orange-d); font-weight: 600; }
  .brite .bx-lede { font-size: clamp(17px, 1.7vw, 20px); line-height: 1.55; color: var(--bx-ink-2); margin: 26px 0 0; max-width: 620px; }
  .brite .bx-hero-cta { display: flex; align-items: center; gap: 20px; margin-top: 36px; flex-wrap: wrap; }
  .brite .bx-hero-note { font-size: 14px; color: var(--bx-muted); }

  /* BUTTON */
  .brite .bx-btn { display: inline-block; font-family: var(--bx-font); font-weight: 700; font-size: 15px; color: #fff; background: var(--bx-orange); padding: 14px 28px; border-radius: 999px; text-decoration: none; transition: background 0.15s ease, transform 0.15s ease; box-shadow: 0 6px 18px -6px rgba(255,151,0,0.5); }
  .brite .bx-btn:hover { background: var(--bx-orange-d); transform: translateY(-1px); }
  .brite .bx-btn-lg { padding: 17px 34px; font-size: 16px; }

  /* STRIP */
  .brite .bx-strip { background: var(--bx-ink); }
  .brite .bx-strip-in { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }
  .brite .bx-strip-item { padding: 26px 28px; border-right: 1px solid rgba(255,255,255,0.1); }
  .brite .bx-strip-item:last-child { border-right: 0; }
  .brite .bx-strip-k { display: block; font-family: var(--bx-font); font-weight: 600; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.55); margin-bottom: 8px; }
  .brite .bx-strip-v { font-family: var(--bx-font); font-weight: 700; font-size: 19px; color: #fff; letter-spacing: -0.01em; }
  .brite .bx-strip-hl .bx-strip-v { color: var(--bx-orange); }

  /* SECTION */
  .brite .bx-section { padding: 76px 0; }
  .brite .bx-cream { background: var(--bx-cream); }
  .brite .bx-h2 { font-family: var(--bx-font); font-weight: 800; font-size: clamp(28px, 3.4vw, 40px); line-height: 1.1; letter-spacing: -0.025em; margin: 0; color: var(--bx-ink); text-wrap: balance; }
  .brite .bx-sub { font-size: 17px; color: var(--bx-muted); margin: 14px 0 40px; max-width: 640px; }
  .brite .bx-link { color: var(--bx-orange-d); font-weight: 600; text-decoration: none; border-bottom: 1px solid rgba(232,133,0,0.35); }
  .brite .bx-link:hover { border-bottom-color: var(--bx-orange-d); }

  /* PIPELINE */
  .brite .bx-pipe { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
  .brite .bx-step { background: #fff; border: 1px solid var(--bx-line); border-radius: 16px; padding: 24px 20px; }
  .brite .bx-step-n { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 999px; background: var(--bx-cream); color: var(--bx-orange-d); font-family: var(--bx-font); font-weight: 800; font-size: 15px; margin-bottom: 16px; }
  .brite .bx-step h3 { font-family: var(--bx-font); font-weight: 700; font-size: 17px; margin: 0 0 8px; letter-spacing: -0.01em; }
  .brite .bx-step p { font-size: 13.5px; line-height: 1.5; color: var(--bx-muted); margin: 0; }

  /* ENGINE */
  .brite .bx-engine { display: grid; grid-template-columns: 300px 1fr; gap: 20px; align-items: start; }
  .brite .bx-findings { display: flex; flex-direction: column; gap: 10px; }
  .brite .bx-chip { display: flex; flex-direction: column; gap: 4px; text-align: left; background: #fff; border: 1.5px solid var(--bx-line-2); border-radius: 14px; padding: 14px 16px; cursor: pointer; transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease; font-family: var(--bx-body); }
  .brite .bx-chip:hover { border-color: var(--bx-orange); transform: translateX(2px); }
  .brite .bx-chip-on { border-color: var(--bx-orange); box-shadow: 0 8px 22px -10px rgba(255,151,0,0.45); }
  .brite .bx-chip-tag { font-family: var(--bx-font); font-weight: 700; font-size: 10.5px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--bx-orange-d); }
  .brite .bx-chip-finding { font-family: var(--bx-font); font-weight: 600; font-size: 15px; color: var(--bx-ink); letter-spacing: -0.01em; }

  .brite .bx-panel { background: #fff; border: 1px solid var(--bx-line); border-radius: 20px; padding: 30px; box-shadow: 0 18px 50px -28px rgba(31,31,31,0.25); }
  .brite .bx-panel-flow { display: grid; grid-template-columns: 1fr auto 1fr; gap: 20px; align-items: stretch; }
  .brite .bx-panel-k { display: block; font-family: var(--bx-font); font-weight: 700; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--bx-muted); margin-bottom: 10px; }
  .brite .bx-panel-leak { background: var(--bx-off); border-radius: 14px; padding: 22px; }
  .brite .bx-panel-finding { font-family: var(--bx-font); font-weight: 800; font-size: 21px; margin: 0 0 10px; letter-spacing: -0.02em; color: var(--bx-ink); }
  .brite .bx-panel-detail { font-size: 14px; line-height: 1.55; color: var(--bx-ink-2); margin: 0; }
  .brite .bx-panel-arrow { display: flex; align-items: center; font-size: 26px; color: var(--bx-orange); font-weight: 700; }
  .brite .bx-panel-role { background: var(--bx-cream); border-radius: 14px; padding: 22px; }
  .brite .bx-panel-rolename { font-family: var(--bx-font); font-weight: 800; font-size: 21px; margin: 0 0 10px; letter-spacing: -0.02em; color: var(--bx-ink); }
  .brite .bx-panel-does { font-size: 14px; line-height: 1.55; color: var(--bx-ink-2); margin: 0 0 14px; }
  .brite .bx-panel-price { display: inline-block; font-family: var(--bx-font); font-weight: 700; font-size: 13px; color: var(--bx-orange-d); background: #fff; padding: 6px 14px; border-radius: 999px; }
  .brite .bx-panel-cold { margin-top: 22px; padding-top: 22px; border-top: 1px solid var(--bx-line); }
  .brite .bx-panel-cold p { font-size: 16px; line-height: 1.55; color: var(--bx-ink); margin: 0; font-style: italic; }

  /* ECON */
  .brite .bx-econ { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .brite .bx-econ-card { border: 1px solid var(--bx-line); border-radius: 16px; padding: 26px; }
  .brite .bx-econ-card p { margin: 10px 0 0; font-size: 15px; line-height: 1.55; color: var(--bx-ink-2); }
  .brite .bx-econ-k { font-family: var(--bx-font); font-weight: 700; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--bx-muted); }
  .brite .bx-econ-win { background: var(--bx-cream); border-color: transparent; }
  .brite .bx-econ-win .bx-econ-k { color: var(--bx-orange-d); }
  .brite .bx-econ-line { font-family: var(--bx-font); font-weight: 600; font-size: clamp(18px, 2vw, 23px); line-height: 1.4; color: var(--bx-ink); margin: 32px 0 0; max-width: 760px; letter-spacing: -0.01em; }

  /* DARK */
  .brite .bx-dark { background: var(--bx-ink); }
  .brite .bx-eyebrow-dark { color: var(--bx-orange); }
  .brite .bx-h2-dark { color: #fff; }
  .brite .bx-build { margin-top: 36px; }
  .brite .bx-build-row { display: grid; grid-template-columns: 56px 1fr; gap: 18px; align-items: baseline; padding: 20px 0; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .brite .bx-build-row:last-child { border-bottom: 0; }
  .brite .bx-build-num { font-family: var(--bx-font); font-weight: 800; font-size: 22px; color: var(--bx-orange); }
  .brite .bx-build-row p { margin: 0; font-size: 16px; line-height: 1.5; color: rgba(255,255,255,0.78); }
  .brite .bx-build-row b { color: #fff; font-weight: 600; }

  /* CTA */
  .brite .bx-cta { background: var(--bx-cream); padding: 64px 0; }
  .brite .bx-cta-in { display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap; }
  .brite .bx-cta-h { font-family: var(--bx-font); font-weight: 800; font-size: clamp(26px, 3vw, 36px); line-height: 1.12; letter-spacing: -0.025em; margin: 0; max-width: 620px; color: var(--bx-ink); }
  .brite .bx-cta-p { font-size: 16px; color: var(--bx-ink-2); margin: 14px 0 0; max-width: 460px; }

  /* FOOT */
  .brite .bx-foot { background: #fff; border-top: 1px solid var(--bx-line); padding: 24px 0; }
  .brite .bx-foot-in { display: flex; justify-content: space-between; font-size: 13px; color: var(--bx-muted); flex-wrap: wrap; gap: 8px; }
  .brite .bx-foot b { color: var(--bx-ink); font-weight: 600; }

  /* RESPONSIVE */
  @media (max-width: 880px) {
    .brite .bx-pipe { grid-template-columns: 1fr 1fr; }
    .brite .bx-engine { grid-template-columns: 1fr; }
    .brite .bx-findings { flex-direction: row; flex-wrap: wrap; }
    .brite .bx-chip { flex: 1 1 calc(50% - 5px); }
    .brite .bx-panel-flow { grid-template-columns: 1fr; }
    .brite .bx-panel-arrow { transform: rotate(90deg); justify-content: center; }
    .brite .bx-strip-in { grid-template-columns: 1fr; }
