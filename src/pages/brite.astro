---
import Base from '../layouts/Base.astro';

const title = 'Brite Demand Engine · Prototype';
const description = 'Cold outbound that turns marketing audits into Brite job reqs. A working prototype built for Anil.';
---
<Base
  title={title}
  description={description}
  posthogCapturePageview={true}
>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

<div class="brite">

  <!-- NAV -->
  <header class="bx-nav">
    <div class="bx-wrap bx-nav-in">
      <a class="bx-logo" href="#" aria-label="brite">
        <svg class="bx-logo-svg" viewBox="0 0 134 42" fill="none" xmlns="http://www.w3.org/2000/svg" role="img"><path d="M25.4891 3H25.5109M42.9781 21H43M25.4891 39H25.5109M8 21H8.02186M37.856 8.27179H37.8779M37.856 33.7282H37.8779M13.1221 33.7282H13.144M13.1221 8.27179H13.144M34.2336 21C34.2336 25.9706 30.3185 30 25.4891 30C20.6596 30 16.7445 25.9706 16.7445 21C16.7445 16.0294 20.6596 12 25.4891 12C30.3185 12 34.2336 16.0294 34.2336 21Z" stroke="#FF9700" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M71.2725 25.255C71.2725 21.5175 68.7425 19.1025 65.465 19.1025C62.1875 19.1025 59.6 21.5175 59.6 25.255C59.6 28.9925 62.13 31.4075 65.465 31.4075C68.8 31.4075 71.2725 28.9925 71.2725 25.255ZM75.93 25.255C75.93 31.35 71.675 35.375 65.925 35.375C60.175 35.375 60.9225 34.455 59.37 32.5575V35.0875H55V7.71751H59.6V17.78C61.21 15.9975 63.395 15.135 65.925 15.135C71.675 15.135 75.93 19.1025 75.93 25.1975V25.255Z" fill="white"/><path d="M90.2475 15.1924V19.5624C89.845 19.5049 89.5 19.4474 89.155 19.4474C85.6475 19.4474 83.4625 21.5174 83.4625 25.5424V35.0874H78.8625V15.3649H83.2325V18.2399C84.555 16.1699 86.97 15.1349 90.2475 15.1349V15.1924Z" fill="white"/><path d="M92.6624 15.4225H97.2624V35.145H92.6624V15.4225ZM92.0299 9.38502C92.0299 7.83252 93.2949 6.62503 94.9624 6.62503C96.6299 6.62503 97.8949 7.77503 97.8949 9.27003C97.8949 10.765 96.6874 12.145 94.9624 12.145C93.2374 12.145 92.0299 10.9375 92.0299 9.38502Z" fill="white"/><path d="M113.707 34.0525C112.615 34.915 110.947 35.375 109.28 35.375C104.967 35.375 102.495 33.075 102.495 28.7625V19.275H99.2749V15.595H102.495V11.11H107.095V15.595H112.385V19.275H107.095V28.6475C107.095 30.545 108.072 31.58 109.797 31.58C111.522 31.58 111.695 31.2925 112.385 30.775L113.65 34.0525H113.707Z" fill="white"/><path d="M118.307 23.7025H129.462C129.117 20.885 126.932 18.93 123.885 18.93C120.837 18.93 118.71 20.8275 118.25 23.7025H118.307ZM133.832 26.75H118.365C118.94 29.625 121.297 31.465 124.747 31.465C128.197 31.465 128.715 30.775 130.095 29.3375L132.567 32.155C130.785 34.2825 128.025 35.375 124.632 35.375C118.02 35.375 113.765 31.12 113.765 25.255C113.765 19.39 118.077 15.1925 123.942 15.1925C129.807 15.1925 133.89 19.2175 133.89 25.37C133.89 31.5225 133.89 26.29 133.832 26.75Z" fill="white"/></svg>
      </a>
      <div class="bx-nav-right">
        <span class="bx-nav-label">Demand engine · prototype</span>
        <a class="bx-btn bx-btn-sm" href="#engine">See it work</a>
      </div>
    </div>
  </header>

  <!-- HERO -->
  <section class="bx-hero">
    <div class="bx-glow" aria-hidden="true"></div>
    <div class="bx-wrap bx-hero-in">
      <span class="bx-eyebrow">Built for Anil · by Fred Style</span>
      <h1 class="bx-h1">Every <span class="bx-o">audit</span> is a <span class="bx-o">Brite job req.</span></h1>
      <p class="bx-lede">
        Cold outbound that finds startups leaking money on marketing, shows them exactly which
        hire fixes it, and routes them to Brite. The diagnosis sells the role.
      </p>
      <div class="bx-hero-cta">
        <a class="bx-btn" href="#engine">See it work</a>
        <span class="bx-hero-note">Live prototype. Click a finding below.</span>
      </div>
    </div>
  </section>

  <!-- PROBLEM STRIP -->
  <section class="bx-strip">
    <div class="bx-wrap bx-strip-in">
      <div class="bx-strip-item">
        <span class="bx-strip-k">The pain you named</span>
        <span class="bx-strip-v">Customer acquisition.</span>
      </div>
      <div class="bx-strip-item">
        <span class="bx-strip-k">The usual fix</span>
        <span class="bx-strip-v">Paid ads. CAC climbs.</span>
      </div>
      <div class="bx-strip-item bx-strip-hl">
        <span class="bx-strip-k">The engine</span>
        <span class="bx-strip-v">Demand that pre-sells the hire.</span>
      </div>
    </div>
  </section>

  <!-- PIPELINE (white break) -->
  <section class="bx-section bx-light">
    <div class="bx-wrap">
      <h2 class="bx-h2">How the engine runs</h2>
      <p class="bx-sub">Five steps. Fully automated up to the booked call.</p>

      <div class="bx-pipe">
        <div class="bx-step">
          <span class="bx-step-n">1</span>
          <h3>Find</h3>
          <p>Mine startups that fit Brite's ICP. Funded, growing, no senior marketer in seat yet.</p>
        </div>
        <div class="bx-step">
          <span class="bx-step-n">2</span>
          <h3>Audit</h3>
          <p>Auto-generate a personalised marketing audit at their own domain. Real findings from their live stack.</p>
        </div>
        <div class="bx-step">
          <span class="bx-step-n">3</span>
          <h3>Diagnose</h3>
          <p>Each leak maps to a role Brite already places. The audit writes the job req for you.</p>
        </div>
        <div class="bx-step">
          <span class="bx-step-n">4</span>
          <h3>Pitch</h3>
          <p>Cold message leads with the leak, names the hire, routes them to Brite. Value before the ask.</p>
        </div>
        <div class="bx-step">
          <span class="bx-step-n">5</span>
          <h3>Book</h3>
          <p>Qualified, pre-matched founders land on Brite's calendar already knowing what they need.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- INTERACTIVE ENGINE (dark centerpiece) -->
  <section class="bx-section bx-dark" id="engine">
    <div class="bx-wrap">
      <h2 class="bx-h2 bx-h2-d">The audit, turned into a hire</h2>
      <p class="bx-sub bx-sub-d">
        Real audit. Real company. <a class="bx-link" href="https://rivett.tech/audit/v3/crinklepaper-com" target="_blank" rel="noopener">CrinklePak ↗</a> &nbsp;·&nbsp; Click a finding. Watch it become a Brite role.
      </p>

      <div class="bx-engine">
        <div class="bx-findings" id="bx-findings"><!-- chips injected --></div>
        <div class="bx-panel" id="bx-panel"><!-- detail injected --></div>
      </div>
    </div>
  </section>

  <!-- ECONOMICS (white break) -->
  <section class="bx-section bx-light">
    <div class="bx-wrap">
      <h2 class="bx-h2">Why the CAC math works</h2>
      <p class="bx-sub">The audit does the selling, so the cost-per-booked-call stays low.</p>
      <div class="bx-econ">
        <div class="bx-econ-card">
          <span class="bx-econ-k">Paid ads</span>
          <p>You bid against everyone for a cold click. CAC only climbs. The click doesn't know it needs you.</p>
        </div>
        <div class="bx-econ-card bx-econ-win">
          <span class="bx-econ-k">The engine</span>
          <p>Every touch carries a personalised diagnosis. The founder sees the gap before you spend a dollar on paid. Warm and pre-matched to a role.</p>
        </div>
      </div>
      <p class="bx-econ-line">
        Same money you'd burn proving a paid channel buys a repeatable demand machine that also
        tells you <span class="bx-o">which role to place.</span>
      </p>
    </div>
  </section>

  <!-- WHAT I'D BUILD (dark) -->
  <section class="bx-section bx-dark">
    <div class="bx-wrap">
      <span class="bx-eyebrow">What I'd plug into Brite</span>
      <h2 class="bx-h2 bx-h2-d">A demand engine, wired to your roster.</h2>
      <div class="bx-build">
        <div class="bx-build-row"><span class="bx-build-num">01</span><p><b>ICP mining</b> tuned to Brite's customer: funded startups missing a senior marketer.</p></div>
        <div class="bx-build-row"><span class="bx-build-num">02</span><p><b>Audit per prospect</b>, auto-generated, hosted, personalised to their real stack.</p></div>
        <div class="bx-build-row"><span class="bx-build-num">03</span><p><b>Finding-to-role routing</b> against your live roster, so every lead arrives matched.</p></div>
        <div class="bx-build-row"><span class="bx-build-num">04</span><p><b>Outreach + tracking:</b> reply rate, booked calls, pipeline, on a dashboard you can audit.</p></div>
      </div>
    </div>
  </section>

  <!-- CTA (dark) -->
  <section class="bx-cta">
    <div class="bx-wrap bx-cta-in">
      <div>
        <h2 class="bx-cta-h">This is the prototype. <span class="bx-o">Thursday I show you it running.</span></h2>
        <p class="bx-cta-p">You, me, Deniz. I point it at a real Brite ICP live and we watch the pipeline fill.</p>
      </div>
      <a class="bx-btn bx-btn-lg" href="https://calendly.com/incrementum-team/30min" target="_blank" rel="noopener">See you Thursday</a>
    </div>
  </section>

  <footer class="bx-foot">
    <div class="bx-wrap bx-foot-in">
      <a class="bx-logo" href="#" aria-label="brite">
        <svg class="bx-logo-svg bx-logo-svg-sm" viewBox="0 0 134 42" fill="none" xmlns="http://www.w3.org/2000/svg" role="img"><path d="M25.4891 3H25.5109M42.9781 21H43M25.4891 39H25.5109M8 21H8.02186M37.856 8.27179H37.8779M37.856 33.7282H37.8779M13.1221 33.7282H13.144M13.1221 8.27179H13.144M34.2336 21C34.2336 25.9706 30.3185 30 25.4891 30C20.6596 30 16.7445 25.9706 16.7445 21C16.7445 16.0294 20.6596 12 25.4891 12C30.3185 12 34.2336 16.0294 34.2336 21Z" stroke="#FF9700" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M71.2725 25.255C71.2725 21.5175 68.7425 19.1025 65.465 19.1025C62.1875 19.1025 59.6 21.5175 59.6 25.255C59.6 28.9925 62.13 31.4075 65.465 31.4075C68.8 31.4075 71.2725 28.9925 71.2725 25.255ZM75.93 25.255C75.93 31.35 71.675 35.375 65.925 35.375C60.175 35.375 60.9225 34.455 59.37 32.5575V35.0875H55V7.71751H59.6V17.78C61.21 15.9975 63.395 15.135 65.925 15.135C71.675 15.135 75.93 19.1025 75.93 25.1975V25.255Z" fill="white"/><path d="M90.2475 15.1924V19.5624C89.845 19.5049 89.5 19.4474 89.155 19.4474C85.6475 19.4474 83.4625 21.5174 83.4625 25.5424V35.0874H78.8625V15.3649H83.2325V18.2399C84.555 16.1699 86.97 15.1349 90.2475 15.1349V15.1924Z" fill="white"/><path d="M92.6624 15.4225H97.2624V35.145H92.6624V15.4225ZM92.0299 9.38502C92.0299 7.83252 93.2949 6.62503 94.9624 6.62503C96.6299 6.62503 97.8949 7.77503 97.8949 9.27003C97.8949 10.765 96.6874 12.145 94.9624 12.145C93.2374 12.145 92.0299 10.9375 92.0299 9.38502Z" fill="white"/><path d="M113.707 34.0525C112.615 34.915 110.947 35.375 109.28 35.375C104.967 35.375 102.495 33.075 102.495 28.7625V19.275H99.2749V15.595H102.495V11.11H107.095V15.595H112.385V19.275H107.095V28.6475C107.095 30.545 108.072 31.58 109.797 31.58C111.522 31.58 111.695 31.2925 112.385 30.775L113.65 34.0525H113.707Z" fill="white"/><path d="M118.307 23.7025H129.462C129.117 20.885 126.932 18.93 123.885 18.93C120.837 18.93 118.71 20.8275 118.25 23.7025H118.307ZM133.832 26.75H118.365C118.94 29.625 121.297 31.465 124.747 31.465C128.197 31.465 128.715 30.775 130.095 29.3375L132.567 32.155C130.785 34.2825 128.025 35.375 124.632 35.375C118.02 35.375 113.765 31.12 113.765 25.255C113.765 19.39 118.077 15.1925 123.942 15.1925C129.807 15.1925 133.89 19.2175 133.89 25.37C133.89 31.5225 133.89 26.29 133.832 26.75Z" fill="white"/></svg>
      </a>
      <span>Prototype built by <b>Fred Style</b> · Rivett · A demonstration, not affiliated with Brite.</span>
    </div>
  </footer>

</div>

<script is:inline>
  const FINDINGS = [
    {
      tag: 'Email auth',
      finding: 'No DMARC record',
      detail: "CrinklePak's order confirmations and wholesale invoices have no DMARC policy. Mail lands in spam, and anyone can spoof their domain.",
      role: 'Email Marketing Manager',
      does: 'Email, SMS, push & in-app, lifecycle journeys',
      price: 'from $3,500/mo',
      cold: '"Your order confirmations are landing in spam and anyone can impersonate your domain. The fix is a half-day for the right hire. Want the breakdown?"',
    },
    {
      tag: 'Paid',
      finding: 'No Meta Pixel',
      detail: "11 Google + 3 LinkedIn campaigns running, zero Meta tracking. They can't test or attribute the highest-ROAS channel for a Shopify brand.",
      role: 'Performance Marketer',
      does: 'Google Ads, Facebook Ads, campaign optimisation, reducing CAC',
      price: 'from $3,500/mo',
      cold: '"You\'re spending on ads but flying blind on the one channel that usually wins for Shopify. A performance hire pays for itself in a month."',
    },
    {
      tag: 'Conversion',
      finding: '4.7s mobile load · 9px tap targets',
      detail: 'Paid traffic hits a page that takes ~5s to paint on a phone, with buttons too small to tap. Half the clicks bounce before the price loads.',
      role: 'Growth Marketer',
      does: 'Landing-page conversion, mobile UX, funnel optimisation',
      price: 'from $3,500/mo',
      cold: '"You\'re paying for clicks that hit a 5-second page on mobile. A growth hire turns the traffic you already buy into orders."',
    },
    {
      tag: 'SEO',
      finding: 'No schema · no rich snippets',
      detail: 'Product pages ship no structured data. Google shows zero review stars in search while competitors get them. Free visibility, left on the floor.',
      role: 'Technical SEO',
      does: 'Schema implementation, snippet optimisation, indexing, internal linking',
      price: 'from $3,500/mo',
      cold: '"You claim hundreds of 5-star reviews but Google shows none of them. A technical SEO fixes that in a week and your listings light up."',
    },
    {
      tag: 'Analytics',
      finding: 'GA4 + 4 unidentified trackers',
      detail: "Tag manager is a junk drawer with four trackers nobody can name. No clean read on ROAS or CAC, so spend decisions are guesswork.",
      role: 'Marketing / Web Analytics',
      does: 'GA4, ROAS & CAC calculation, A/B tests, dashboards',
      price: 'from $3,500/mo',
      cold: '"There are four trackers on your site nobody can identify and no clean CAC number. An analytics hire gives you a dashboard you can trust."',
    },
  ];

  function renderPanel(f) {
    const p = document.getElementById('bx-panel');
    p.innerHTML = `
      <div class="bx-panel-flow">
        <div class="bx-panel-leak">
          <span class="bx-panel-k">Audit finds</span>
          <h3 class="bx-panel-finding">${f.finding}</h3>
          <p class="bx-panel-detail">${f.detail}</p>
        </div>
        <div class="bx-panel-arrow" aria-hidden="true">→</div>
        <div class="bx-panel-role">
          <span class="bx-panel-k bx-panel-k-o">Brite places</span>
          <h3 class="bx-panel-rolename">${f.role}</h3>
          <p class="bx-panel-does">${f.does}</p>
          <span class="bx-panel-price">${f.price}</span>
        </div>
      </div>
      <div class="bx-panel-cold">
        <span class="bx-panel-k">The cold opener it writes</span>
        <p>${f.cold}</p>
      </div>
    `;
  }

  function renderChips() {
    const c = document.getElementById('bx-findings');
    c.innerHTML = '';
    FINDINGS.forEach((f, i) => {
      const b = document.createElement('button');
      b.className = 'bx-chip' + (i === 0 ? ' bx-chip-on' : '');
      b.innerHTML = `<span class="bx-chip-tag">${f.tag}</span><span class="bx-chip-finding">${f.finding}</span>`;
      b.addEventListener('click', () => {
        document.querySelectorAll('.bx-chip').forEach((x) => x.classList.remove('bx-chip-on'));
        b.classList.add('bx-chip-on');
        renderPanel(f);
        if (window.posthog) window.posthog.capture('brite_proto_finding_clicked', { finding: f.finding, role: f.role });
      });
      c.appendChild(b);
    });
  }

  renderChips();
  renderPanel(FINDINGS[0]);
</script>

<style is:global>
  /* This prototype is a standalone Brite-branded property. Hide Rivett's
     global nav so Anil sees a clean Brite page, not Rivett chrome. Scoped
     to this page only — the style bundle ships solely with /brite. */
  .site-header { display: none !important; }
  body { padding-top: 0 !important; }

  .brite {
    --o: #ff9700;
    --o-d: #e88500;
    --dark: #1a1a1a;
    --dark-2: #232323;
    --dark-3: #2b2b2b;
    --ink: #1f1f1f;
    --muted: #758696;
    --line-d: rgba(255,255,255,0.12);
    --line-l: #ececec;
    --font: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
    --body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-family: var(--body);
    color: #fff;
    background: var(--dark);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .brite * { box-sizing: border-box; }
  .brite .bx-wrap { max-width: 1080px; margin: 0 auto; padding: 0 28px; }
  .brite .bx-o { color: var(--o); }

  /* LOGO */
  .brite .bx-logo { display: inline-flex; align-items: center; text-decoration: none; }
  .brite .bx-logo-svg { height: 26px; width: auto; display: block; }
  .brite .bx-logo-svg-sm { height: 20px; }

  /* NAV */
  .brite .bx-nav { background: var(--dark); border-bottom: 1px solid var(--line-d); }
  .brite .bx-nav-in { display: flex; justify-content: space-between; align-items: center; padding: 18px 28px; }
  .brite .bx-nav-right { display: flex; align-items: center; gap: 18px; }
  .brite .bx-nav-label { font-family: var(--font); font-weight: 600; font-size: 11px; letter-spacing: 0.09em; text-transform: uppercase; color: rgba(255,255,255,0.5); }

  /* BUTTON */
  .brite .bx-btn { display: inline-block; font-family: var(--font); font-weight: 700; font-size: 15px; color: #fff; background: var(--o); padding: 13px 26px; border-radius: 999px; text-decoration: none; transition: background 0.15s ease, transform 0.15s ease; }
  .brite .bx-btn:hover { background: var(--o-d); transform: translateY(-1px); }
  .brite .bx-btn-sm { padding: 9px 18px; font-size: 13.5px; }
  .brite .bx-btn-lg { padding: 16px 32px; font-size: 16px; }

  /* HERO */
  .brite .bx-hero { position: relative; background: var(--dark); padding: 96px 0 84px; overflow: hidden; }
  .brite .bx-glow { position: absolute; top: -180px; right: -120px; width: 620px; height: 620px; background: radial-gradient(circle, rgba(255,151,0,0.18) 0%, rgba(255,151,0,0) 62%); pointer-events: none; }
  .brite .bx-hero-in { position: relative; }
  .brite .bx-eyebrow { display: inline-block; font-family: var(--font); font-weight: 700; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--o); margin-bottom: 22px; }
  .brite .bx-h1 { font-family: var(--font); font-weight: 800; font-size: clamp(40px, 5.8vw, 68px); line-height: 1.02; letter-spacing: -0.03em; margin: 0; max-width: 860px; color: #fff; }
  .brite .bx-lede { font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; color: rgba(255,255,255,0.7); margin: 26px 0 0; max-width: 600px; }
  .brite .bx-hero-cta { display: flex; align-items: center; gap: 20px; margin-top: 38px; flex-wrap: wrap; }
  .brite .bx-hero-note { font-size: 14px; color: rgba(255,255,255,0.5); }

  /* STRIP */
  .brite .bx-strip { background: var(--dark-2); border-top: 1px solid var(--line-d); border-bottom: 1px solid var(--line-d); }
  .brite .bx-strip-in { display: grid; grid-template-columns: repeat(3, 1fr); }
  .brite .bx-strip-item { padding: 28px; border-right: 1px solid var(--line-d); }
  .brite .bx-strip-item:last-child { border-right: 0; }
  .brite .bx-strip-k { display: block; font-family: var(--font); font-weight: 600; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.45); margin-bottom: 9px; }
  .brite .bx-strip-v { font-family: var(--font); font-weight: 700; font-size: 19px; color: #fff; letter-spacing: -0.01em; }
  .brite .bx-strip-hl .bx-strip-v { color: var(--o); }

  /* SECTION */
  .brite .bx-section { padding: 80px 0; }
  .brite .bx-light { background: #fff; color: var(--ink); }
  .brite .bx-dark { background: var(--dark); color: #fff; }
  .brite .bx-h2 { font-family: var(--font); font-weight: 800; font-size: clamp(28px, 3.4vw, 42px); line-height: 1.08; letter-spacing: -0.025em; margin: 0; color: var(--ink); text-wrap: balance; }
  .brite .bx-h2-d { color: #fff; }
  .brite .bx-sub { font-size: 17px; color: var(--muted); margin: 14px 0 44px; max-width: 660px; }
  .brite .bx-sub-d { color: rgba(255,255,255,0.6); }
  .brite .bx-link { color: var(--o); font-weight: 600; text-decoration: none; }
  .brite .bx-link:hover { color: var(--o-d); }

  /* PIPELINE */
  .brite .bx-pipe { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
  .brite .bx-step { background: #fff; border: 1px solid var(--line-l); border-radius: 16px; padding: 24px 20px; }
