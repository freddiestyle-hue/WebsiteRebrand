<div class="page">

  <header class="band">
    <div class="row">
      <div class="left">
        <a class="wordmark" href="/audit/v3">rivett<span class="dot-mark"></span></a>
        <span style="color: var(--ink-faint);">·</span>
        <span><b>Teardown memo</b> · Live audit</span>
      </div>
      <div class="right">
        <span>By <b>Fred Style</b> · <a href="https://www.linkedin.com/in/fredstyle/" target="_blank" rel="noopener" style="border-bottom: 1px solid var(--line-strong);">LinkedIn</a></span>
        <span>{headerDate}</span>
      </div>
    </div>
  </header>
  <div class="subband">
    {memo
      ? <span class="crumb">↑ <a href="/audit/v3">Audit index</a> <span class="sep">/</span> <b>v3</b> <span class="sep">/</span> <b>{memo.domain}</b></span>
      : <span class="crumb">↑ Audit index <span class="sep">/</span> <b>v3</b> <span class="sep">/</span> new run</span>}
    <span><b>v3.4</b> · in-browser scan{audit ? ` · ${audit.durationMs} ms` : ''}</span>
  </div>

  {!memo && (
    <section class="hero">
      <span class="kicker">Live · in-browser scan · ~30s</span>
      <h1>What does the open web <span class="ital">actually say about you.</span></h1>
      <p class="dek">Paste a domain. Nine teardowns run live in the browser. Page speed against the real Lighthouse numbers, schema, mail authentication, the ads you have running today, the pixels you forgot to remove. One memo. No login.</p>

      <form class="form-wrap" method="POST" action="/audit/v3" id="auditForm">
        <div class="form-left">
          <span class="form-lbl"><b>Domain</b> · enter the site you want read</span>
          <div class="url-input">
            <span class="scheme">https://</span>
            <input type="text" name="url" id="auditDomainInput" placeholder="somewhere.com" autocomplete="off" spellcheck="false" value={submittedUrl} required autofocus />
            <button class="submit" type="submit">Run audit <span aria-hidden="true">→</span></button>
          </div>
          <div class="form-meta">
            <span>Median run · <b>~30s</b></span>
            <span>No login</span>
            <span>No queue</span>
            <span>9 dimensions</span>
          </div>
          {inputError && <div class="form-error">{inputError}</div>}
          {runtimeError && <div class="form-error">{runtimeError}</div>}
        </div>
        <div class="form-right">
          <div>
            <span class="form-lbl"><b>Or read a sample.</b> Real domain. Real numbers.</span>
            <a class="sample" href="/audit/p/pellaofcolumbus-com-x7k2abcdefgh1234">pellaofcolumbus.com <span style="font-family: var(--serif); font-style: italic; color: var(--ink-dim); font-size: 0.92em;">read this</span> →</a>
          </div>
          <p style="margin: var(--sp-6) 0 0; font-family: var(--serif); font-style: italic; font-size: 17px; line-height: 1.5; color: var(--ink-dim); max-width: 360px;">The full read includes an AI citation probe and a benchmark percentile. Those need the offline pipeline. The rest is live in your browser.</p>
        </div>
      </form>
    </section>
  )}

  {!memo && (
    <section class="dims">
      <div class="dims-head">
        <span class="lbl">What it reads<span class="num">01</span></span>
        <h2>Nine dimensions. <span class="ital">Read live. Read together.</span></h2>
      </div>
      <div class="dim-grid">
        <div class="dim"><div class="top"><svg class="ico"><use href="#ic-01-diagnostic"/></svg><span class="num">D · 01</span></div><h3>How Google <span class="ital">sees you.</span></h3><p>Sitemap, robots, canonical, schema, og:type. The crawler's view.</p></div>
        <div class="dim"><div class="top"><svg class="ico"><use href="#ic-03-signal"/></svg><span class="num">D · 02</span></div><h3>How AI engines <span class="ital">cite you.</span></h3><p>/llms.txt, /llms-full.txt, structured data parseable by LLM crawlers.</p></div>
        <div class="dim"><div class="top"><svg class="ico"><use href="#ic-23-vital"/></svg><span class="num">D · 03</span></div><h3>How fast <span class="ital">it loads.</span></h3><p>Real Lighthouse: LCP, FCP, CLS, INP against Google's "good" thresholds.</p></div>
        <div class="dim"><div class="top"><svg class="ico"><use href="#ic-19-numbers"/></svg><span class="num">D · 04</span></div><h3>What you <span class="ital">measure.</span></h3><p>Meta, GA4, GTM, LinkedIn, X, TikTok, Reddit. Including pixels only loaded after JS.</p></div>
        <div class="dim"><div class="top"><svg class="ico"><use href="#ic-20-share"/></svg><span class="num">D · 05</span></div><h3>Ads <span class="ital">running today.</span></h3><p>Meta, Google, LinkedIn ad libraries. Creative count, platforms, earliest run.</p></div>
        <div class="dim"><div class="top"><svg class="ico"><use href="#ic-12-confirm"/></svg><span class="num">D · 06</span></div><h3>How visitors <span class="ital">convert.</span></h3><p>Top-1024 CTA, tappable contact, form fields, pricing visibility, social proof.</p></div>
        <div class="dim"><div class="top"><svg class="ico"><use href="#ic-06-operator"/></svg><span class="num">D · 07</span></div><h3>How it behaves <span class="ital">on mobile.</span></h3><p>Headless render at 390×844. Real scrollWidth, real tap targets, real text size.</p></div>
        <div class="dim"><div class="top"><svg class="ico"><use href="#ic-14-outreach"/></svg><span class="num">D · 08</span></div><h3>Email <span class="ital">reputation.</span></h3><p>SPF, DMARC, MX. DoH lookups against Cloudflare. Reject, quarantine, missing.</p></div>
        <div class="dim"><div class="top"><svg class="ico"><use href="#ic-05-stack"/></svg><span class="num">D · 09</span></div><h3>The stack <span class="ital">you actually run.</span></h3><p>Static + runtime fingerprint. Analytics, CMS, CDN, A/B, consent, support.</p></div>
      </div>
    </section>
  )}

  {!memo && (
    <section class="how">
      <div class="how-head">
        <span class="lbl">How it runs<span class="num">02</span></span>
        <h2>One paste. <span class="ital">Thirty seconds. One memo.</span></h2>
      </div>
      <div class="steps">
        <div class="step"><span class="day">Step · 01</span><div class="num">01</div><h4>Paste a domain.</h4><p>No login. No queue. The scan starts in your browser the moment you press run.</p></div>
        <div class="step"><span class="day">Step · 02</span><div class="num">02</div><h4>Scan runs live.</h4><p>Nine readers fire in parallel. PSI for speed, DoH for mail, Ad Library for spend.</p></div>
        <div class="step"><span class="day">Step · 03</span><div class="num">03</div><h4>Read the memo.</h4><p>Score of 100. Nine cells with the raw numbers. Top three fixes ranked by leverage.</p></div>
        <div class="step"><span class="day">Step · 04</span><div class="num">04</div><h4>Decide.</h4><p>Pick the fix and ship. Or book a call. The full pipeline picks up the gaps this one cannot.</p></div>
      </div>
    </section>
  )}

  {!memo && (
    <section class="end-cta">
      <div>
        <span class="lab">For when the scan isn't enough</span>
        <h2>Pick a time. Twenty minutes. <span class="ital">I'll bring the rest of the read.</span></h2>
        <p>The browser scan is the cheap version. The AI citation probe, the benchmark percentile, the deliverability test against a live mailbox. Those need the offline pipeline. Book a call, I'll bring those numbers.</p>
        <div class="end-actions">
          <a class="btn btn--inv" href="/diagnostic">Book a call <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="sig">
        <span class="lab" style="margin-bottom: 12px;">Signature</span>
        <div style="margin-top: 8px;"><b>Fred Style</b> · rivett.tech · {headerDate}</div>
      </div>
    </section>
  )}

  {!memo && (
    <div class="scan on-ink" id="scanOverlay" role="status" aria-live="polite">
      <div class="scan-top">
        <span><span class="dot-live"></span>Live scan · <b id="scanDomain">somewhere.com</b></span>
        <a class="wordmark">rivett<span class="dot-mark" style="background: var(--accent);"></span></a>
        <span><b>v3.4</b> · in-browser only</span>
      </div>
      <div class="scan-body">
        <div class="scan-log">
          <div class="log-head">stdout · run · audit.v3</div>
          <div class="log-list" id="logList"></div>
        </div>
        <aside class="scan-side">
          <h3>Reading the curve. <span class="ital">No deck. Just the numbers.</span></h3>
          <div class="progress">
            <div>
              <span class="label">Scan progress</span>
              <div class="pct"><span id="pctVal">0</span><sup>/100</sup></div>
            </div>
            <span class="label" id="elapsed">00.0s</span>
          </div>
          <div class="bar"><div class="fill" id="barFill"></div></div>
          <div style="margin-top: var(--sp-7);">
            <div class="lane" data-lane="0"><span class="ix">D · 01</span><span class="nm">Google index</span><span class="st">queued</span></div>
            <div class="lane" data-lane="1"><span class="ix">D · 02</span><span class="nm">AI engines</span><span class="st">queued</span></div>
            <div class="lane" data-lane="2"><span class="ix">D · 03</span><span class="nm">Page speed</span><span class="st">queued</span></div>
            <div class="lane" data-lane="3"><span class="ix">D · 04</span><span class="nm">Measurement</span><span class="st">queued</span></div>
            <div class="lane" data-lane="4"><span class="ix">D · 05</span><span class="nm">Ad libraries</span><span class="st">queued</span></div>
            <div class="lane" data-lane="5"><span class="ix">D · 06</span><span class="nm">Conversion</span><span class="st">queued</span></div>
            <div class="lane" data-lane="6"><span class="ix">D · 07</span><span class="nm">Mobile render</span><span class="st">queued</span></div>
            <div class="lane" data-lane="7"><span class="ix">D · 08</span><span class="nm">Email auth (DoH)</span><span class="st">queued</span></div>
            <div class="lane" data-lane="8"><span class="ix">D · 09</span><span class="nm">Tech fingerprint</span><span class="st">queued</span></div>
          </div>
        </aside>
      </div>
    </div>
  )}

  {memo && audit && (
    <section class="hook">
      <div>
        <span class="kicker">{fromCache ? `Cached · ${memo.domain}` : `Live audit · ${memo.domain}`}</span>
        <h1>
          Your site scores <span id="scoreNum">{compositeScore}</span> of 100.
          {verdictItalic && <> <span class="ital">{verdictItalic}</span></>}
        </h1>
        {memo.cover.dek && <p class="dek">{memo.cover.dek}</p>}
        <div class="meta-row">
          <span>Domain · <b>{memo.domain}</b></span>
          <span>Run · <b>{headerDate}{headerTime ? ` · ${headerTime}` : ''}</b></span>
          <span>Duration · <b>{audit.durationMs} ms</b></span>
          <span>Scan · <b>{memo.verdictCells.length} of 9</b></span>
        </div>
        {v3Slug && (
          <div class="share-link" style="margin-top: var(--sp-5); font-family: var(--mono); font-size: var(--t-meta); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--ink-faint);">
            <span>Share · </span>
            <a href={`/audit/v3/${v3Slug}`} style="color: var(--ink); border-bottom: 1px solid var(--line-strong);">rivett.tech/audit/v3/{v3Slug}</a>
          </div>
        )}
      </div>

      <aside class="score-panel">
        <span class="lab">Composite read · v3.4</span>
        <div class="read"><span id="scoreBig">{compositeScore}</span><span class="denom">/ 100</span></div>
        <div class="scale">
          {[0,1,2,3,4].map((i) => (
            <div class={`seg ${i < scoreSegment ? 'dim-lit' : i === scoreSegment ? 'lit' : ''}`}></div>
          ))}
        </div>
        <div class="markers">
          <span>{scoreSegment === 0 ? <b>Halt</b> : 'Halt'}</span>
          <span>{scoreSegment === 1 ? <b>Watch</b> : 'Watch'}</span>
          <span>{scoreSegment === 2 ? <b>Read</b> : 'Read'}</span>
          <span>{scoreSegment === 3 ? <b>Run</b> : 'Run'}</span>
          <span>{scoreSegment === 4 ? <b>Push</b> : 'Push'}</span>
        </div>
        <div class="chips">
          {memo.verdictCells.map((cell) => (
            <div class={`chip ${cellSeverity(cell)}`}>
              <span class="k">{chipKey(cell.icon)}</span>
              <span class="v">{chipValue(cell)}</span>
            </div>
          ))}
        </div>
      </aside>
    </section>
  )}

  {memo && (
    <section class="sec">
      <div class="sec-head">
        <span class="lbl">The verdict<span class="num">03</span></span>
        <h2>{memo.verdictCells.length === 9 ? 'Nine reads,' : `${memo.verdictCells.length} reads,`} <span class="ital">in one frame.</span></h2>
      </div>
      <div class="vgrid">
        {memo.verdictCells.map((cell) => {
          const dim = dimFor(cell.icon);
          const sev = cellSeverity(cell);
          const sv = splitValue(cell.value);
          const hd = splitHeading(cell.heading);
          return (
            <div class="vcell">
              <div class="vtop">
                <div class="icon-row">
                  <svg class="ico"><use href={`#${dim.sprite}`}/></svg>
                  <span class="key">{subKey(cell.icon)}</span>
                </div>
                <h3>{hd.lead}{hd.tail && <> <span class="ital">{hd.tail}</span></>}</h3>
                <div class={`big ${sev}`}>{sv.num}{sv.denom && <span class="denom">{sv.denom}</span>}</div>
                <p class="note" set:html={sanitizeMemoHtml(cell.note)} />
                {(cell.benchmark || cell.benchmarkRight) && (
                  <div class="bench">
                    <span class="bench-l" set:html={sanitizeMemoHtml(cell.benchmark ?? '')} />
                    {cell.benchmarkRight && <span class="bench-r" set:html={sanitizeMemoHtml(cell.benchmarkRight)} />}
                  </div>
                )}
              </div>
              {cell.checks.length > 0 ? (
                <details>
                  <summary>+ {cell.checks.length} checks <span class="marker">+</span></summary>
                  <div class="checks">
                    {cell.checks.map((c) => {
                      const badge = statusBadge(c.ok, sev);
                      return (
                        <div class={`check ${badge.cls}`}>
                          <span class="st">{badge.label}</span>
                          <span class="lbl" set:html={sanitizeMemoHtml(c.text)} />
                          <span class="val"></span>
                        </div>
                      );
                    })}
                  </div>
                </details>
              ) : (
                <div class="vfoot-empty">No checks recorded <span class="marker">·</span></div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  )}

  {memo && (
    <section class="sec">
      <div class="sec-head">
        <span class="lbl">Top three fixes<span class="num">04</span></span>
        <h2>Ranked by leverage. <span class="ital">Highest first.</span></h2>
      </div>
      <div class="fixes">
        {memo.rankedFixes.map((fix) => (
          <div class="fix">
            <div class="rank"><span class="k">Rank</span>F·{String(fix.rank).padStart(2, '0')}</div>
            <div class="what">
              <h4 set:html={sanitizeMemoHtml(fix.what)} />
              <span class="src">Source · <b>{memo.domain}</b> · audit</span>
            </div>
            <div class="why" set:html={sanitizeMemoHtml(fix.why)} />
            <div class="meta-col">
              <div class="meta-row"><span class="k">Effort</span><span class={`pill ${fix.effort}`}>{fix.effort === 'low' ? 'Low' : fix.effort === 'med' ? 'Medium' : 'High'}</span></div>
              <div class="meta-row"><span class="k">Impact</span><span class={`pill ${fix.impact}`}>{fix.impact === 'low' ? 'Low' : fix.impact === 'med' ? 'Medium' : 'High'}</span></div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  {memo && (
    <section class="obs">
      <div class="wrap">
        <span class="lbl">Field note<span class="num">05</span></span>
        <div>
          <blockquote>
            <b style="font-style: normal; font-family: var(--grotesk); font-weight: 600; color: var(--ink);">{memo.domain}</b> <span set:html={sanitizeMemoHtml(memo.personalObservation.text)} />
          </blockquote>
          <div class="author">· <b>Fred Style</b>, written for {memo.domain} · {headerDate} · Cape Town &amp; remote</div>

          <div class="teaser">
            <div>
              <h4 class="lh">What the full report adds. <span class="ital">The things this browser can't reach.</span></h4>
              <p>AI citation probe across eight category prompts. Benchmark percentile against tracked competitors in your set. Live deliverability test against a seeded inbox. Twelve-week instrumentation plan.</p>
            </div>
            <div class="stack">
              <a class="btn btn--pri" href="/diagnostic">Book a call <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  {memo && (
    <section class="end-cta on-ink">
      <div>
        <span class="lab">Want the full read</span>
        <h2>Pick a time. Twenty minutes. <span class="ital">I'll bring what this scan could not.</span></h2>
        <p>The ads, the live page-speed numbers against tracked competitors, the AI citation probe results, and the deliverability check this scan could not run. No deck, no sales motion. You bring questions. I bring the read.</p>
        <div class="end-actions">
          <a class="btn btn--inv" href="/diagnostic">Book a call <span aria-hidden="true">→</span></a>
          <a class="btn btn--sec" href="/audit/v3" style="border-color: var(--on-ink-line-2); color: var(--on-ink);">Audit another domain</a>
        </div>
      </div>
      <div class="sig">
        <span class="lab" style="margin-bottom: 12px;">Signature</span>
        <div style="margin-top: 8px;"><b>Fred Style</b> · rivett.tech · {headerDate}</div>
      </div>
    </section>
  )}

  <footer class="foot">
    <span class="wordmark">rivett<span class="dot-mark"></span></span>
    <span>Live in-browser scan · <b>not a formal assessment</b></span>
    <span>rivett.tech · {headerDate}</span>
  </footer>
</div>

{!memo && (
  <script is:inline>
    (function () {
      var form = document.getElementById('auditForm');
      var input = document.getElementById('auditDomainInput');
      var overlay = document.getElementById('scanOverlay');
      if (!form || !input || !overlay) return;

      var logList = document.getElementById('logList');
      var pctVal = document.getElementById('pctVal');
      var barFill = document.getElementById('barFill');
      var elapsed = document.getElementById('elapsed');
      var scanDomain = document.getElementById('scanDomain');
      var lanes = overlay.querySelectorAll('.scan-side .lane');

      function makeScript(domain) {
        return [
          ['run',  'resolve dns ' + domain,                    'A record'],
          ['ok',   'fetch / robots.txt',                       'parsing'],
          ['ok',   'fetch / sitemap.xml',                      'parsing'],
          ['ok',   'fetch /index.html (cold)',                 'live HTML'],
          ['ok',   'parse <head>',                             'meta, canonical, og:type'],
          ['ok',   'parse JSON-LD',                            'Organization + WebSite'],
          ['run',  'PSI · mobile lighthouse',                  'started'],
          ['ok',   'PSI · core web vitals',                    'LCP / FCP / CLS / INP'],
          ['ok',   'fingerprint · static',                     'tech detection'],
          ['run',  'headless · 390x844',                       'Chromium booting'],
          ['ok',   'headless · scrollWidth + tap targets',     'real DOM'],
          ['ok',   'fingerprint · runtime',                    'GTM-injected pixels'],
          ['ok',   'DoH · SPF lookup',                         'Cloudflare 1.1.1.1'],
          ['ok',   'DoH · DMARC lookup',                       'policy + MX'],
          ['ok',   'fetch /llms.txt',                          'AEO probe'],
          ['ok',   'Meta Ad Library',                          'active creatives'],
          ['ok',   'LinkedIn Ad Library',                      'active creatives'],
          ['ok',   'Google Ad Library',                        'active creatives'],
          ['ok',   'score · composite',                        'weighted band'],
          ['ok',   'memo · render',                            'verdict + fixes'],
        ];
      }

      function pad(n) { return n < 10 ? '0' + n : '' + n; }
      function tsAt(seconds) {
        var s = Math.floor(seconds);
        var ms = Math.floor((seconds - s) * 1000);
        return pad(s) + '.' + pad(Math.floor(ms / 10));
      }

      // Lane order modeled on real enrichment timing - everything fires in
      // parallel, mobile + tech-runtime are the long-tail because they wait
      // on the headless pass. Triggers indexed into the log script above.
      var laneTriggers = {
        0: { start: 1,  end: 5  },   // Google index (crawl/meta/schema)
        1: { start: 14, end: 15 },   // AI engines (llms.txt)
        2: { start: 6,  end: 8  },   // Page speed (PSI)
        3: { start: 8,  end: 12 },   // Measurement (tracking + runtime)
        4: { start: 15, end: 18 },   // Ad libraries
        5: { start: 4,  end: 6  },   // Conversion (form/CTA scan)
        6: { start: 9,  end: 11 },   // Mobile render (headless)
        7: { start: 12, end: 14 },   // Email (DoH)
        8: { start: 11, end: 12 },   // Tech fingerprint
      };

      function setLane(i, state) {
        var l = lanes[i]; if (!l) return;
        var st = l.querySelector('.st');
        l.classList.remove('run', 'done');
        if (state === 'run')  { l.classList.add('run');  if (st) st.textContent = 'running'; }
        else if (state === 'done') { l.classList.add('done'); if (st) st.textContent = 'ok'; }
        else if (st) st.textContent = 'queued';
      }

      function startScan(domain) {
        if (scanDomain) scanDomain.textContent = domain;
        overlay.classList.add('live');
        if (logList) logList.innerHTML = '';
        lanes.forEach(function (_, i) { setLane(i, 'queued'); });
        if (pctVal) pctVal.textContent = '0';
        if (barFill) barFill.style.right = '100%';
        if (elapsed) elapsed.textContent = '00.0s';

        var script = makeScript(domain);
        // Real scan duration is ~30s. Drive lane + log animation over 26s
        // so the user sees activity, then asymptote progress to 99% and
        // hold until the actual response arrives and the browser swaps the page.
        var totalMs = 26000;
        var perLine = totalMs / script.length;
        var startTime = performance.now();

        script.forEach(function (item, i) {
          setTimeout(function () {
            var t = (performance.now() - startTime) / 1000;
            var doneRatio = (i + 1) / script.length;
            if (pctVal) pctVal.textContent = Math.round(doneRatio * 92);
            if (barFill) barFill.style.right = (100 - doneRatio * 92) + '%';
            if (elapsed) elapsed.textContent = tsAt(t) + 's';

            Object.keys(laneTriggers).forEach(function (li) {
              var trig = laneTriggers[li];
              if (i >= trig.start && i < trig.end) setLane(parseInt(li, 10), 'run');
              if (i >= trig.end) setLane(parseInt(li, 10), 'done');
            });

            if (logList) {
              var div = document.createElement('span');
              div.className = 'line';
              var tag = item[0].toUpperCase();
              div.innerHTML =
                '<span class="ts">' + tsAt(t) + 's</span>' +
                '<span class="tag ' + item[0] + '">[' + tag + ']</span> ' +
                item[1] +
                ' <span class="arrow">→</span> <span class="em">' + item[2] + '</span>';
              logList.appendChild(div);
              while (logList.children.length > 14) logList.removeChild(logList.firstChild);
            }
          }, i * perLine);
        });

        // After the scripted log finishes, hold at ~95% and slowly creep to 99%
        // while we wait for the actual server response. The browser swaps the
        // page when the POST resolves; this overlay dies with it.
        setTimeout(function () {
          lanes.forEach(function (_, i) { setLane(i, 'done'); });
          var stall = 95;
          var stallTimer = setInterval(function () {
            if (stall >= 99) { clearInterval(stallTimer); return; }
            stall += 0.4;
            if (pctVal) pctVal.textContent = Math.round(stall);
            if (barFill) barFill.style.right = (100 - stall) + '%';
            var t = (performance.now() - startTime) / 1000;
            if (elapsed) elapsed.textContent = tsAt(t) + 's';
          }, 1500);
        }, totalMs + 200);
      }

      form.addEventListener('submit', function () {
        // Don't preventDefault - let the form POST naturally. The browser
        // waits for the response (~30s) while this overlay animates. When
        // /audit/v3 returns, the new HTML replaces the page, overlay gone.
        var raw = (input.value || '').trim().replace(/^https?:\/\//, '');
        startScan(raw || 'somewhere.com');
      });
    })();
  </script>
)}

{memo && (
  <script
    is:inline
    define:vars={{
      target: compositeScore,
      domain: memo.domain,
      durationMs: audit?.durationMs ?? null,
      verdictCellCount: memo.verdictCells.length,
      rankedFixCount: memo.rankedFixes.length,
    }}
  >
    (function () {
      var elBig = document.getElementById('scoreBig');
      var elNum = document.getElementById('scoreNum');
      var start = null;
      var dur = 1100;
      function step(t) {
        if (!start) start = t;
        var p = Math.min(1, (t - start) / dur);
        var eased = 1 - Math.pow(1 - p, 3);
        var v = Math.round(eased * target);
        if (elBig) elBig.textContent = v;
        if (elNum) elNum.textContent = v;
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);

      if (typeof window.posthog !== 'undefined') {
        window.posthog.capture('audit_v3_memo_rendered', {
          domain: domain,
          scoreNumeric: target,
          durationMs: durationMs,
          verdictCellCount: verdictCellCount,
          rankedFixCount: rankedFixCount,
        });
        document.querySelectorAll('.vcell details').forEach(function (d, i) {
          d.addEventListener('toggle', function () {
            if (d.open) {
              window.posthog.capture('audit_v3_verdict_expanded', { domain: domain, cell_index: i });
            }
          });
        });
      }
    })();
  </script>
)}

</body>
</html>
