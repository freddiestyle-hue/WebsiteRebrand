---
// Live v3 audit — verbatim implementation of the audit.html / landing.html
// design dropped in audit.zip. Form state mirrors landing.html, result state
// mirrors audit.html. Score animation + scan overlay deferred to follow-up.
export const prerender = false;

import { Redis } from '@upstash/redis';
import PostHog from '../../components/PostHog.astro';
import { runAudit, normalizeAuditUrl, type AuditResult } from '../../utils/audit/engine';
import { buildMemoFromAudit, type EnrichmentBundle } from '../../utils/audit/v3-synth';
import { checkDeliverability } from '../../utils/audit/dns-check';
import { checkMobileFromHtml } from '../../utils/audit/mobile-check';
import { checkPageSpeed } from '../../utils/audit/pagespeed';
import { checkAds } from '../../utils/audit/ads-check';
import { detectTechStack } from '../../utils/audit/tech-stack-check';
import { runHeadlessCheck } from '../../utils/audit/headless-check';
import type { Memo, VerdictCell, VerdictIcon } from '../../utils/audit/memo-schema';
import { sanitizeMemoHtml } from '../../utils/audit/safe-html';
import { v3SlugFromDomain } from '../../utils/audit/slug';

interface CachedV3 {
  memo: Memo;
  durationMs: number;
  scoreNumeric: number;
  scoreMax: number;
  hostname: string;
  url: string;
  fetchedAt: string;
}

const isPOST = Astro.request.method === 'POST';

let audit: AuditResult | null = null;
let memo: Memo | null = null;
let inputError: string | null = null;
let runtimeError: string | null = null;
let submittedUrl = '';
let enrichment: EnrichmentBundle | null = null;
let v3Slug: string | null = null;
let fromCache = false;

// Slug-based rewrite path: v3/[slug].astro reads from KV and rewrites here,
// passing the cached audit through Astro.locals so we render without re-running.
const cached = (Astro.locals as { cachedV3?: CachedV3 }).cachedV3;
if (cached) {
  memo = cached.memo;
  v3Slug = cached.hostname ? v3SlugFromDomain(cached.hostname) : null;
  fromCache = true;
  // Reconstruct just the AuditResult fields v3.astro needs for the score panel.
  audit = {
    url: cached.url,
    hostname: cached.hostname,
    fetchedAt: cached.fetchedAt,
    durationMs: cached.durationMs,
    checks: [],
    scoreNumeric: cached.scoreNumeric,
    scoreMax: cached.scoreMax,
    scorePercent: 0,
    band: 'invisible',
    bandLabel: '',
    bandKicker: '',
    verdict: {
      crawl: { grade: 'N/A', passed: 0, total: 0 },
      schema: { grade: 'N/A', passed: 0, total: 0 },
      aeo: { grade: 'N/A', passed: 0, total: 0 },
      sendReady: { grade: 'N/A', passed: 0, total: 0 },
    },
  };
}

if (isPOST && !memo) {
  try {
    const form = await Astro.request.formData();
    submittedUrl = String(form.get('url') ?? '').trim();
    if (!submittedUrl) {
      inputError = 'Type a domain to audit.';
    } else {
      const norm = normalizeAuditUrl(submittedUrl);
      if ('error' in norm) {
        inputError = norm.error;
      } else {
        audit = await runAudit(norm.url);
        if (audit.error) {
          runtimeError = audit.error;
        } else {
          const [deliverability, pageSpeed, ads, headless] = await Promise.all([
            checkDeliverability(audit.hostname),
            checkPageSpeed(audit.url, 'mobile'),
            checkAds(audit.hostname),
            runHeadlessCheck(audit.url),
          ]);
          const mobile = checkMobileFromHtml(audit.homepageHtml);
          const techStack = detectTechStack(audit.homepageHtml ?? '', audit.homepageHeaders);
          const techStackRuntime = headless
            ? detectTechStack(headless.renderedHtml, audit.homepageHeaders)
            : null;
          enrichment = {
            deliverability, mobile, pageSpeed, ads, techStack, techStackRuntime, headless,
          };
          memo = buildMemoFromAudit(audit, enrichment);
          v3Slug = v3SlugFromDomain(audit.hostname);

          // Persist for sharing. Fire-and-forget so a KV outage never blocks
          // the response. Keys are deterministic per domain, so a re-run
          // overwrites cleanly. 14-day TTL keeps the cache fresh during
          // outreach motions without unbounded growth.
          const payload: CachedV3 = {
            memo,
            durationMs: audit.durationMs,
            scoreNumeric: audit.scoreNumeric,
            scoreMax: audit.scoreMax,
            hostname: audit.hostname,
            url: audit.url,
            fetchedAt: audit.fetchedAt,
          };
          try {
            const redis = Redis.fromEnv();
            redis
              .set(`audit-v3:${v3Slug}`, JSON.stringify(payload), { ex: 60 * 60 * 24 * 14 })
              .catch((e) => console.error('[audit/v3] KV write failed', e));
          } catch (e) {
            console.error('[audit/v3] KV init failed', e);
          }
        }
      }
    }
  } catch (e) {
    runtimeError = e instanceof Error ? e.message : String(e);
    console.error('[audit/v3] failed', e);
  }
}

const fmtDate = (iso?: string): string => {
  const d = iso ? new Date(iso) : new Date();
  if (Number.isNaN(d.getTime())) return iso ?? '';
  return `${d.getUTCFullYear()}·${String(d.getUTCMonth() + 1).padStart(2, '0')}·${String(d.getUTCDate()).padStart(2, '0')}`;
};

const fmtTime = (iso: string): string => {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '';
  return `${String(d.getUTCHours()).padStart(2, '0')}:${String(d.getUTCMinutes()).padStart(2, '0')}`;
};

const DIM_MAP: Record<VerdictIcon, { num: string; suffix: string; sprite: string }> = {
  search:    { num: '01', suffix: '',            sprite: 'ic-01-diagnostic' },
  spark:     { num: '02', suffix: 'NEW',         sprite: 'ic-03-signal' },
  bolt:      { num: '03', suffix: 'PSI',         sprite: 'ic-23-vital' },
  target:    { num: '04', suffix: '',            sprite: 'ic-19-numbers' },
  megaphone: { num: '05', suffix: 'LIVE',        sprite: 'ic-20-share' },
  eye:       { num: '06', suffix: '',            sprite: 'ic-12-confirm' },
  phone:     { num: '07', suffix: 'HEADLESS',    sprite: 'ic-06-operator' },
  mail:      { num: '08', suffix: 'DOH',         sprite: 'ic-14-outreach' },
  flag:      { num: '09', suffix: 'FINGERPRINT', sprite: 'ic-05-stack' },
  bar:       { num: '10', suffix: '',            sprite: 'ic-21-curve' },
  clock:     { num: '11', suffix: '',            sprite: 'ic-04-cadence' },
};

const dimFor = (icon: VerdictIcon) => DIM_MAP[icon] ?? DIM_MAP.flag;
const subKey = (icon: VerdictIcon): string => {
  const d = dimFor(icon);
  return d.suffix ? `D · ${d.num} · ${d.suffix}` : `D · ${d.num}`;
};
const chipKey = (icon: VerdictIcon): string => {
  const d = dimFor(icon);
  const short = (() => {
    switch (icon) {
      case 'search': return 'Search';
      case 'spark': return 'AI';
      case 'bolt': return 'Speed';
      case 'target': return 'Pixels';
      case 'megaphone': return 'Ads';
      case 'eye': return 'Conv.';
      case 'phone': return 'Mobile';
      case 'mail': return 'Email';
      case 'flag': return 'Stack';
      default: return '';
    }
  })();
  return `D · ${d.num} ${short}`;
};

const cellSeverity = (cell: VerdictCell): 'r' | 'a' | 'g' | '' => {
  if (cell.checks.length === 0) return '';
  const passed = cell.checks.filter((c) => c.ok).length;
  const ratio = passed / cell.checks.length;
  if (ratio >= 0.85) return 'g';
  if (ratio >= 0.5) return 'a';
  return 'r';
};

const splitValue = (value: string): { num: string; denom: string } => {
  const m1 = value.match(/^([0-9.]+)\s*\/\s*(.+)$/);
  if (m1) return { num: m1[1], denom: `/ ${m1[2]}` };
  const m2 = value.match(/^([0-9.]+)\s+of\s+([0-9.]+)$/i);
  if (m2) return { num: m2[1], denom: `/ ${m2[2]}` };
  const m3 = value.match(/^([0-9.]+)\s+(.+)$/);
  if (m3) return { num: m3[1], denom: m3[2] };
  return { num: value, denom: '' };
};

const chipValue = (cell: VerdictCell): string => {
  const v = cell.value.trim();
  const m1 = v.match(/^([0-9]+)\s+of\s+([0-9]+)$/i);
  if (m1) return `${m1[1]}/${m1[2]}`;
  const m2 = v.match(/^([0-9]+)\s*\/\s*100$/);
  if (m2) return m2[1];
  const m3 = v.match(/^([0-9]+)\s+active/i);
  if (m3) return m3[1];
  const m4 = v.match(/^([0-9]+)\s+issues?/i);
  if (m4) return `${m4[1]} iss.`;
  if (v === 'None active') return '0';
  if (v === 'Clean') return '✓';
  return v.slice(0, 8);
};

const compositeScore = audit
  ? Math.round((audit.scoreNumeric / Math.max(audit.scoreMax, 1)) * 100)
  : 0;

const scoreSegment = compositeScore < 20 ? 0
  : compositeScore < 40 ? 1
  : compositeScore < 60 ? 2
  : compositeScore < 80 ? 3
  : 4;

const statusBadge = (ok: boolean, cellSev: 'r' | 'a' | 'g' | ''): { cls: string; label: string } => {
  if (ok) return { cls: 'ok', label: 'OK' };
  if (cellSev === 'a') return { cls: 'warn', label: 'WARN' };
  return { cls: 'fail', label: 'FAIL' };
};

const verdictItalic = memo?.cover.italic ?? '';
const headerDate = fmtDate(memo?.generatedAt);
const headerTime = memo ? fmtTime(memo.generatedAt) : '';

const pageTitle = memo
  ? `${memo.domain} · ${compositeScore} of 100 · Teardown memo · rivett`
  : 'Live audit · rivett';

const splitHeading = (heading: string): { lead: string; tail: string } => {
  // "How Google sees you" → lead="How Google", tail="sees you."
  const parts = heading.trim().replace(/\.$/, '').split(' ');
  if (parts.length <= 2) return { lead: heading, tail: '' };
  const lead = parts.slice(0, 2).join(' ');
  const tail = parts.slice(2).join(' ') + '.';
  return { lead, tail };
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="robots" content="noindex,nofollow" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#8FBF3F" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap" />
<link rel="stylesheet" href="/audit/tokens.css" />
<link rel="stylesheet" href="/audit/audit-v3.css" />
<link rel="stylesheet" href="/audit/v3-css/kit.css" />
<link rel="stylesheet" href="/audit/v3-css/audit.css" />
<link rel="stylesheet" href="/audit/v3-css/audit-page.css" />
<PostHog capturePageview={true} />
<style>
  /* Wordmark image (matches site header/footer behavior) */
  .wordmark img { display: block; width: auto; height: 1em; }
  .band .wordmark img { height: 22px; }
  .foot .wordmark img { height: 18px; }

  /* Form-state styles are now provided by /audit/v3-css/{kit,audit,audit-page}.css.
     The old .hero / .form-wrap / .url-input / .dim-grid / .dim / .steps inline
     rules were dead AND actively overriding the new mock CSS via Astro's CID
     scoping (inline rules win the cascade against linked stylesheets when the
     class name matches a rendered element with the data-astro-cid attribute).
     The pulse keyframe is reused by the .score-panel kicker in result state. */
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

  /* Result hook: 2-col grid on desktop. Score panel sticks to the top of
     the viewport WHILE the hero is visible, then scrolls off naturally with
     the hook section. Everything below the hook (verdict, fixes, obs) is
     full-width on its own. */
  .hook { padding: var(--sp-12) 0 var(--sp-14); border-bottom: var(--bw-rule) solid var(--ink); display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 64px; align-items: start; }
  .hook > div { min-width: 0; }
  .hook .score-panel { position: sticky; top: var(--sp-5); align-self: start; }
  @media (max-width: 980px) {
    .hook { display: flex; flex-direction: column; gap: var(--sp-7); }
    .hook .score-panel { position: static; order: -1; }
  }
  .hook .kicker { font-family: var(--mono); font-size: var(--t-meta); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--accent-deep); display: inline-flex; align-items: center; }
  .hook .kicker::before { content: ''; display: inline-block; width: 8px; height: 8px; background: var(--accent); border-radius: var(--r-pill); margin-right: 12px; animation: pulse 2.4s var(--ease) infinite; }
  .hook h1 { font-family: var(--grotesk); font-weight: 800; font-size: clamp(48px, 6.4vw, 96px); line-height: 0.92; letter-spacing: var(--track-display); margin: var(--sp-6) 0 var(--sp-7); text-wrap: balance; }
  /* Italic flourish under the score statement. Sized as a subtitle (~half
     the hero), forced onto its own line, with the same color/serif treatment
     as before. Without the size cap, "24 paid ads, 8 conversion gaps." rendered
     at 96px italic serif and bullied the page. */
  .hook h1 .ital { display: block; font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 0.48em; line-height: 1.1; color: var(--ink-dim); letter-spacing: -0.01em; margin-top: var(--sp-4); text-wrap: pretty; }
  .hook .dek { font-family: var(--serif); font-style: italic; font-size: clamp(18px, 1.7vw, 22px); line-height: 1.5; color: var(--ink-dim); margin: 0 0 var(--sp-8); max-width: 600px; text-wrap: pretty; }
  .hook .meta-row { border-top: var(--bw-hair) solid var(--line); padding-top: var(--sp-4); display: flex; gap: var(--sp-8); flex-wrap: wrap; font-family: var(--mono); font-size: var(--t-meta); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--ink-faint); }
  .hook .meta-row b { color: var(--ink); font-weight: 500; }

  .score-panel { background: var(--ink); color: var(--on-ink); padding: var(--sp-8); display: flex; flex-direction: column; gap: var(--sp-5); }
  .score-panel .lab { font-family: var(--mono); font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--on-ink-faint); display: inline-flex; align-items: center; }
  .score-panel .lab::before { content: ''; display: inline-block; width: 8px; height: 8px; background: var(--accent); border-radius: var(--r-pill); margin-right: 12px; }
  .score-panel .read { font-family: var(--grotesk); font-weight: 800; font-size: clamp(100px, 14vw, 184px); letter-spacing: var(--track-display); line-height: 0.86; color: var(--on-ink); display: inline-flex; align-items: baseline; gap: var(--sp-3); }
  .score-panel .read .denom { font-size: 0.28em; color: var(--on-ink-faint); font-weight: 600; letter-spacing: 0; line-height: 1; transform: translateY(-0.6em); }
  .score-panel .scale { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; margin-top: var(--sp-3); }
  .score-panel .scale .seg { height: 6px; background: var(--on-ink-line); }
  .score-panel .scale .seg.lit { background: var(--accent); }
  .score-panel .scale .seg.dim-lit { background: var(--accent-deep); }
  .score-panel .markers { display: flex; justify-content: space-between; margin-top: 8px; font-family: var(--mono); font-size: 10px; letter-spacing: var(--track-mono-tight); text-transform: uppercase; color: var(--on-ink-faint); }
  .score-panel .markers b { color: var(--on-ink); font-weight: 500; }
  .score-panel .chips { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; margin-top: var(--sp-6); }
  .score-panel .chip { border: 1px solid var(--on-ink-line); padding: 8px 10px; display: flex; flex-direction: column; gap: 4px; }
  .score-panel .chip .k { font-family: var(--mono); font-size: 9.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--on-ink-faint); }
  .score-panel .chip .v { font-family: var(--grotesk); font-weight: 700; font-size: 17px; color: var(--on-ink); letter-spacing: -0.02em; }
  .score-panel .chip.g .v { color: var(--accent); }
  .score-panel .chip.a .v { color: #E0A24E; }
  .score-panel .chip.r .v { color: #E36868; }

  /* Section scaffold */
  .sec { padding: var(--sp-14) 0 var(--sp-10); border-bottom: var(--bw-hair) solid var(--line-strong); }
  .sec-head { display: grid; grid-template-columns: 240px 1fr; gap: 64px; margin-bottom: var(--sp-10); }
  @media (max-width: 880px) { .sec-head { grid-template-columns: 1fr; gap: var(--sp-5); } }
  .sec-head .lbl { font-family: var(--mono); font-size: var(--t-meta); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--ink-faint); }
  .sec-head .lbl .num { display: block; font-family: var(--grotesk); font-weight: 700; font-size: 56px; line-height: 1; color: var(--ink); letter-spacing: var(--track-tighter); margin-top: var(--sp-3); }
  .sec-head h2 { font-family: var(--grotesk); font-weight: 700; font-size: clamp(36px, 4.4vw, 56px); line-height: 1.04; letter-spacing: var(--track-h); margin: 0; text-wrap: balance; }

  /* Verdict grid */
  .vgrid { display: grid; grid-template-columns: repeat(3, 1fr); border: var(--bw-hair) solid var(--line); background: var(--paper); }
  @media (max-width: 980px) { .vgrid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .vgrid { grid-template-columns: 1fr; } }
  .vcell { border-right: var(--bw-hair) solid var(--line); border-bottom: var(--bw-hair) solid var(--line); padding: 0; display: flex; flex-direction: column; }
  .vgrid > .vcell:nth-child(3n) { border-right: 0; }
  .vgrid > .vcell:nth-last-child(-n+3) { border-bottom: 0; }
  @media (max-width: 980px) { .vgrid > .vcell { border-right: var(--bw-hair) solid var(--line) !important; border-bottom: var(--bw-hair) solid var(--line) !important; } .vgrid > .vcell:nth-child(2n) { border-right: 0 !important; } .vgrid > .vcell:nth-last-child(-n+2) { border-bottom: 0 !important; } }
  @media (max-width: 640px) { .vgrid > .vcell { border-right: 0 !important; } .vgrid > .vcell:last-child { border-bottom: 0 !important; } }
  .vcell .vtop { padding: var(--sp-6); display: flex; flex-direction: column; gap: var(--sp-3); flex: 1; }
  .vcell .icon-row { display: flex; justify-content: space-between; align-items: center; }
  .vcell .icon-row .key { font-family: var(--mono); font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--ink-faint); }
  .vcell h3 { font-family: var(--grotesk); font-weight: 700; font-size: 18px; letter-spacing: var(--track-h-sm); line-height: 1.2; margin: 0; text-wrap: balance; }
  .vcell h3 .ital { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--ink-dim); letter-spacing: -0.02em; }
  .vcell .big { font-family: var(--grotesk); font-weight: 800; font-size: clamp(48px, 5.4vw, 68px); line-height: 1; letter-spacing: var(--track-display); margin-top: 4px; display: flex; align-items: baseline; gap: var(--sp-2); }
  .vcell .big .denom { font-size: 0.38em; color: var(--ink-faint); font-weight: 600; letter-spacing: 0; }
  .vcell .big.r { color: var(--signal-halt); }
  .vcell .big.a { color: var(--signal-warn); }
  .vcell .big.g { color: var(--accent-deep); }
  .vcell .note { font-size: 14.5px; line-height: 1.5; color: var(--ink-dim); margin: 0; max-width: 36ch; text-wrap: pretty; }
  .vcell .bench { margin-top: auto; font-family: var(--mono); font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--ink-faint); border-top: 1px dashed var(--line-strong); padding-top: var(--sp-3); display: flex; justify-content: space-between; gap: var(--sp-3); }
  .vcell .bench b { color: var(--ink); font-weight: 500; }
  .vcell .bench .bench-l { color: var(--ink-faint); }
  .vcell .bench .bench-r { color: var(--ink); font-weight: 500; }
  .vcell details { border-top: var(--bw-hair) solid var(--line); }
  .vcell summary { list-style: none; cursor: pointer; padding: var(--sp-4) var(--sp-6); font-family: var(--mono); font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--ink-faint); display: flex; justify-content: space-between; align-items: center; transition: background var(--dur-1) var(--ease); }
  .vcell summary::-webkit-details-marker { display: none; }
  .vcell summary:hover { background: var(--paper-2); color: var(--ink); }
  .vcell summary .marker { font-family: var(--mono); font-size: 14px; color: var(--accent-deep); line-height: 1; transition: transform var(--dur-2) var(--ease); display: inline-block; }
  .vcell details[open] summary { background: var(--paper-2); color: var(--ink); }
  .vcell details[open] summary .marker { transform: rotate(45deg); }
  /* Same-height placeholder so cells without check arrays align with their
     neighbors at the bottom of a grid row. Matches summary padding exactly. */
  .vcell .vfoot-empty { border-top: var(--bw-hair) solid var(--line); padding: var(--sp-4) var(--sp-6); font-family: var(--mono); font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--ink-soft); display: flex; justify-content: space-between; align-items: center; }
  .vcell .vfoot-empty .marker { color: var(--ink-soft); font-size: 14px; line-height: 1; }
  .vcell .checks { padding: var(--sp-2) var(--sp-6) var(--sp-5); background: var(--paper-2); border-top: var(--bw-hair) solid var(--line); }
  .vcell .checks .check { display: grid; grid-template-columns: 60px 1fr auto; gap: var(--sp-3); padding: 7px 0; border-bottom: var(--bw-hair) solid var(--line-soft); font-size: 13.5px; line-height: 1.4; align-items: baseline; }
  .vcell .checks .check:last-child { border-bottom: 0; }
  .vcell .checks .check .st { font-family: var(--mono); font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; line-height: 1.5; }
  .vcell .checks .check.ok .st { color: var(--accent-deep); }
  .vcell .checks .check.warn .st { color: var(--signal-warn); }
  .vcell .checks .check.fail .st { color: var(--signal-halt); }
  .vcell .checks .check .lbl { color: var(--ink); }
  .vcell .checks .check .lbl b { font-weight: 600; }
  .vcell .checks .check .val { font-family: var(--mono); font-size: 11.5px; color: var(--ink-faint); text-align: right; white-space: nowrap; }
  .vcell .checks .check .val b { color: var(--ink); font-weight: 500; }

  /* Top 3 Fixes */
  .fixes { border: var(--bw-hair) solid var(--line); }
  .fix { display: grid; grid-template-columns: 132px 1.4fr 1fr 200px; gap: 0; border-bottom: var(--bw-hair) solid var(--line); }
  .fix:last-child { border-bottom: 0; }
  @media (max-width: 880px) { .fix { grid-template-columns: 1fr; } }
  .fix > div { padding: var(--sp-7) var(--sp-6); border-right: var(--bw-hair) solid var(--line); }
  .fix > div:last-child { border-right: 0; }
  @media (max-width: 880px) { .fix > div { border-right: 0; border-bottom: var(--bw-hair) solid var(--line); } .fix > div:last-child { border-bottom: 0; } }
  .fix .rank { background: var(--ink); color: var(--on-ink); font-family: var(--grotesk); font-weight: 800; font-size: 32px; letter-spacing: -0.01em; line-height: 1; display: flex; flex-direction: column; gap: 6px; justify-content: center; padding: var(--sp-7) var(--sp-5); }
  .fix .rank .k { font-family: var(--mono); font-weight: 400; font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--on-ink-faint); }
  .fix .what h4 { font-family: var(--grotesk); font-weight: 700; font-size: clamp(22px, 2.4vw, 30px); line-height: 1.15; letter-spacing: var(--track-h-md); margin: 0 0 var(--sp-3); text-wrap: balance; }
  .fix .what h4 .ital { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--ink-dim); letter-spacing: -0.02em; }
  .fix .what .src { font-family: var(--mono); font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--ink-faint); margin-top: var(--sp-4); display: block; }
  .fix .what .src b { color: var(--ink); }
  .fix .why { font-size: 15px; line-height: 1.55; color: var(--ink-dim); }
  .fix .meta-col { display: flex; flex-direction: column; justify-content: center; gap: var(--sp-3); }
  .fix .meta-row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--sp-3); }
  .fix .meta-row .k { font-family: var(--mono); font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--ink-faint); }
  .fix .pill { font-family: var(--mono); font-size: 11px; letter-spacing: var(--track-mono); text-transform: uppercase; padding: 4px 10px; }
  .fix .pill.low { background: var(--accent-bg); color: var(--accent-deep); }
  .fix .pill.med { background: rgba(184, 101, 31, 0.12); color: var(--signal-warn); }
  .fix .pill.high { background: rgba(154, 43, 43, 0.10); color: var(--signal-halt); }

  /* Observation */
  .obs { padding: var(--sp-14) 0; border-bottom: var(--bw-hair) solid var(--line-strong); }
  .obs .wrap { display: grid; grid-template-columns: 240px 1fr; gap: 64px; }
  @media (max-width: 880px) { .obs .wrap { grid-template-columns: 1fr; gap: var(--sp-5); } }
  .obs .lbl { font-family: var(--mono); font-size: var(--t-meta); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--ink-faint); }
  .obs .lbl .num { display: block; font-family: var(--grotesk); font-weight: 700; font-size: 56px; line-height: 1; color: var(--ink); letter-spacing: var(--track-tighter); margin-top: var(--sp-3); }
  .obs blockquote { margin: 0; font-family: var(--serif); font-style: italic; font-weight: 400; font-size: clamp(22px, 2.4vw, 30px); line-height: 1.45; color: var(--ink); max-width: 760px; border-left: var(--bw-thick) solid var(--accent); padding-left: var(--sp-7); text-wrap: pretty; }
  .obs blockquote em { font-style: normal; color: var(--ink); background: var(--accent-bg); padding: 0 6px; }
  .obs .author { margin-top: var(--sp-7); padding-left: calc(var(--bw-thick) + var(--sp-7)); font-family: var(--mono); font-size: 11px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--ink-faint); }
  .obs .author b { color: var(--ink); font-weight: 500; }

  .teaser { margin: var(--sp-12) 0 0; border: var(--bw-hair) solid var(--line); background: var(--paper-2); padding: var(--sp-7) var(--sp-8); display: grid; grid-template-columns: 1fr auto; gap: var(--sp-7); align-items: center; }
  @media (max-width: 780px) { .teaser { grid-template-columns: 1fr; } }
  .teaser .lh { font-family: var(--grotesk); font-weight: 700; font-size: 22px; line-height: 1.25; letter-spacing: var(--track-h-md); color: var(--ink); margin: 0 0 6px; }
  .teaser .lh .ital { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--ink-dim); }
  .teaser p { margin: 0; color: var(--ink-dim); font-size: 14.5px; line-height: 1.5; max-width: 560px; }
  .teaser .stack { display: flex; gap: var(--sp-3); flex-wrap: wrap; }

  /* -------- live scan overlay -------- */
  /* The fullscreen scan overlay. Use #scanOverlay (ID) to win the cascade
     against the mock's audit.css `.scan { max-width: 1040px; ... }` rule,
     which would otherwise cap the overlay at 1040px and break fullscreen. */
  #scanOverlay { position: fixed; inset: 0; max-width: none; width: 100vw; height: 100vh; border: 0; background: var(--ink); color: var(--on-ink); z-index: 9999; display: none; flex-direction: column; padding: var(--sp-10) var(--sp-12); overflow: hidden; font-family: var(--mono); }
  #scanOverlay.live { display: flex; }
  #scanOverlay .scan-top { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--on-ink-line); padding-bottom: var(--sp-5); margin-bottom: var(--sp-8); font-size: var(--t-meta); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--on-ink-faint); }
  #scanOverlay .scan-top b { color: var(--on-ink); font-weight: 500; }
  /* Wordmark inside the dark overlay top-bar: kill the uppercase cascade so
     "rivett" stays lowercase + grotesk weight 700 (matches the canonical
     wordmark instead of becoming a mono-uppercase "RIVETT"). */
  #scanOverlay .scan-top .wordmark { color: var(--on-ink); font-family: var(--grotesk); font-weight: 700; font-size: 22px; letter-spacing: -0.05em; text-transform: none; }
  .scan .dot-live { display: inline-block; width: 8px; height: 8px; border-radius: var(--r-pill); background: var(--accent); animation: pulse 1.2s var(--ease) infinite; margin-right: 12px; vertical-align: middle; }
  .scan-body { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--sp-12); height: 100%; overflow: hidden; }
  @media (max-width: 980px) { .scan-body { grid-template-columns: 1fr; } }
  .scan-log { border: 1px solid var(--on-ink-line); padding: var(--sp-6); height: 100%; overflow: hidden; position: relative; }
  .scan-log .log-head { font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--on-ink-faint); border-bottom: 1px solid var(--on-ink-line); padding-bottom: var(--sp-3); margin-bottom: var(--sp-4); }
  .scan-log .log-list { font-size: 12.5px; line-height: 1.7; color: var(--on-ink-dim); max-height: 60vh; overflow: hidden; }
  .scan-log .log-list .line { display: block; }
  .scan-log .log-list .ts { color: var(--on-ink-faint); margin-right: var(--sp-3); }
  .scan-log .log-list .tag { display: inline-block; min-width: 50px; }
  .scan-log .log-list .tag.ok { color: var(--accent); }
  .scan-log .log-list .tag.warn { color: var(--signal-warn); }
  .scan-log .log-list .tag.fail { color: var(--signal-halt); }
  .scan-log .log-list .tag.run { color: var(--on-ink); }
  .scan-log .log-list .arrow { color: var(--on-ink-faint); margin: 0 6px; }
  .scan-log .log-list .em { color: var(--on-ink); }
  .scan-side h3 { font-family: var(--grotesk); font-weight: 700; font-size: clamp(36px, 4.4vw, 56px); line-height: 1.02; letter-spacing: var(--track-h); margin: 0 0 var(--sp-6); color: var(--on-ink); text-wrap: balance; }
  .scan-side h3 .ital { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--on-ink-italic); }
  .scan-side .progress { border-top: 1px solid var(--on-ink-line); border-bottom: 1px solid var(--on-ink-line); padding: var(--sp-5) 0; margin: var(--sp-7) 0; display: grid; grid-template-columns: 1fr auto; gap: var(--sp-3); align-items: baseline; }
  .scan-side .progress .pct { font-family: var(--grotesk); font-weight: 800; font-size: 96px; line-height: 0.9; letter-spacing: var(--track-display); color: var(--on-ink); }
  .scan-side .progress .pct sup { font-size: 0.32em; vertical-align: 38px; color: var(--on-ink-faint); margin-left: 4px; }
  .scan-side .progress .label { font-family: var(--mono); font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--on-ink-faint); }
  .scan-side .bar { height: 6px; background: var(--on-ink-line); margin-top: var(--sp-3); position: relative; overflow: hidden; }
  .scan-side .bar .fill { position: absolute; inset: 0 100% 0 0; background: var(--accent); transition: right 0.4s linear; }
  .scan-side .lane { display: grid; grid-template-columns: 22px 1fr auto; gap: var(--sp-3); padding: 10px 0; border-bottom: 1px solid var(--on-ink-line); align-items: center; }
  .scan-side .lane:last-child { border-bottom: 0; }
  .scan-side .lane .ix { font-family: var(--mono); font-size: 10.5px; letter-spacing: var(--track-mono); color: var(--on-ink-faint); }
  .scan-side .lane .nm { font-family: var(--grotesk); font-size: 15px; color: var(--on-ink-dim); }
  .scan-side .lane.done .nm { color: var(--on-ink); }
  .scan-side .lane .st { font-family: var(--mono); font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--on-ink-faint); }
  .scan-side .lane.done .st { color: var(--accent); }
  .scan-side .lane.run .st { color: var(--on-ink); }
</style>
</head>
