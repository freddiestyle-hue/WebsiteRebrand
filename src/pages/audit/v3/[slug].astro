---
// Teardown render for cached v3 audits. Reads audit-v3:{slug} from Upstash KV
// for the memo, fetches the per-prospect hero from /api/audit/v3/hero/{slug},
// and renders the ungated teardown: the LLM hero as a lede, all 9 findings
// with calm reliability tags, and a 3-step prioritized-plan preview.
//
// Phase 1 rebuild. The page used to gate 8 of 9 findings behind a redaction;
// the rebuild shows every finding honestly and moves the call's reason to the
// fix order and the revenue math.

export const prerender = false;

import { Redis } from '@upstash/redis';
import PostHog from '../../../components/PostHog.astro';
import type { Memo, VerdictCell, VerdictIcon } from '../../../utils/audit/memo-schema';
import { isValidV3Slug } from '../../../utils/audit/slug';
import { pickHeroFinding } from '../../../utils/audit/pick-hero';
import { pickRelatedNotes } from '../../../utils/audit/related-notes';
import slugToIcp from '../../../utils/audit/slug-to-icp.json';
import icpVoice from '../../../utils/audit/icp-voice.json';
import { lockedMeta, deriveTone } from '../../../utils/audit/locked-observation';

// Verdict-dimension icons — verbatim from the V4 Hybrid teardown sprite
// (Prospect Teardown standalone). Inner SVG markup per VerdictIcon; .dot
// fills accent, .fill fills currentColor (see .v3-lock-ic svg CSS).
const LOCK_ICON: Record<string, string> = {
  search: '<path d="M3 18 L9 12 L13 16 L21 6"/><circle class="dot" cx="21" cy="6" r="1.6"/>',
  spark: '<circle cx="12" cy="12" r="9"/><path d="M12 12 L12 3 M12 12 L21 12"/><circle class="dot" cx="12" cy="12" r="1.2"/>',
  bolt: '<circle cx="12" cy="12" r="9"/><path d="M12 6 V12 L17 14"/>',
  target: '<path d="M3 21 V11 H7 V21 Z M10 21 V5 H14 V21 Z M17 21 V15 H21 V21 Z"/>',
  megaphone: '<path d="M4 20 L12 4 L20 20 Z"/><path d="M12 11 V15"/><circle class="fill" cx="12" cy="17.5" r="0.8"/>',
  eye: '<path d="M3 12 H8 L10 6 L14 18 L16 12 H21"/><circle class="dot" cx="14" cy="18" r="1.4"/>',
  phone: '<path d="M3 12 H8 L10 6 L14 18 L16 12 H21"/><circle class="dot" cx="14" cy="18" r="1.4"/>',
  mail: '<rect x="3" y="6" width="18" height="13"/><path d="M3 6 L12 14 L21 6"/>',
  flag: '<path d="M3 7 L12 3 L21 7 L12 11 Z"/><path d="M3 12 L12 16 L21 12"/><path d="M3 17 L12 21 L21 17"/>',
  bar: '<path d="M3 21 V11 H7 V21 Z M10 21 V5 H14 V21 Z M17 21 V15 H21 V21 Z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 6 V12 L17 14"/>',
};

interface IcpQuote { title: string; quote: string; attribution: string; source_url: string | null }
interface IcpVoiceEntry { label: string; voice_line: string | null; quotes: IcpQuote[]; hooks: unknown[] }
type SlugToIcpMap = Record<string, string | null>;
type IcpVoiceMap = Record<string, IcpVoiceEntry>;

interface CachedV3 {
  memo: Memo;
  durationMs: number;
  scoreNumeric: number;
  scoreMax: number;
  hostname: string;
  url: string;
  fetchedAt: string;
}

const CAL_BASE_URL = 'https://cal.com/fred-style/discovery';
// Email clients (Outlook, Gmail) and DM platforms (LinkedIn) routinely append
// or absorb the trailing punctuation when a URL ends a sentence:
//   "audit of your site: https://rivett.tech/audit/v3/foo-com. Would love..."
// becomes a link to "/audit/v3/foo-com." with the dot. Same for trailing
// commas, semicolons, closing parens. Strip them before the KV lookup so the
// prospect lands on their actual audit instead of a 404.
const rawSlug = Astro.params.slug ?? '';
const slug = rawSlug.replace(/[.,;)\]\s]+$/, '');
const calUrl = new URL(CAL_BASE_URL);
calUrl.searchParams.set('overlayCalendar', 'true');
calUrl.searchParams.set('prospect', slug);
calUrl.searchParams.set('utm_source', 'audit_memo');
calUrl.searchParams.set('utm_medium', 'site');
calUrl.searchParams.set('utm_content', 'memo_book_call');
for (const key of ['utm_campaign', 'utm_recipient', 'rl', 'r']) {
  const value = Astro.url.searchParams.get(key);
  if (value) calUrl.searchParams.set(key, value);
}
const CAL_URL = calUrl.toString();

let cached: CachedV3 | null = null;
let kvError: 'invalid' | 'not_found' | 'kv_failed' | null = null;

if (!isValidV3Slug(slug)) {
  kvError = 'invalid';
  Astro.response.status = 404;
} else {
  try {
    const redis = Redis.fromEnv();
    const raw = await redis.get<unknown>(`audit-v3:${slug}`);
    if (raw == null) {
      kvError = 'not_found';
      Astro.response.status = 404;
    } else {
      cached = typeof raw === 'string' ? JSON.parse(raw) : (raw as CachedV3);
    }
  } catch (e) {
    console.error('[audit/v3/slug] KV read failed', e);
    kvError = 'kv_failed';
    Astro.response.status = 500;
  }
}

const memo = cached?.memo ?? null;

// Resolve the per-prospect hero. The hero endpoint owns generation + caching;
// the page just reads it. If the endpoint is unreachable, fall back to the
// rule-based pickHeroFinding so the page still renders an honest headline.
interface PageHero {
  pageHero: string;
  strength: string;
}
let heroData: PageHero | null = null;
if (memo) {
  try {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 25_000);
    try {
      const res = await fetch(new URL(`/api/audit/v3/hero/${slug}`, Astro.url), {
        signal: controller.signal,
      });
      if (res.ok) {
        const j = (await res.json()) as { hero?: { pageHero?: string; strength?: string } };
        if (j?.hero?.pageHero?.trim()) {
          heroData = { pageHero: j.hero.pageHero, strength: j.hero.strength?.trim() ?? '' };
        }
      }
    } finally {
      clearTimeout(timer);
    }
  } catch (e) {
    console.error('[audit/v3/slug] hero fetch failed; using rule-based fallback', e);
  }
  if (!heroData) {
    const hf = pickHeroFinding(memo);
    heroData = { pageHero: hf.diagnosis, strength: '' };
  }
}

const scorePercent = cached
  ? Math.round((cached.scoreNumeric / Math.max(cached.scoreMax, 1)) * 100)
  : 0;
const companyName = memo?.companyName ?? memo?.domain ?? cached?.hostname ?? '';

// All 9 findings render, ungated. The hero is the prose above; the cards are
// the evidence. No cell is skipped.
const verdictCells: VerdictCell[] = memo?.verdictCells ?? [];

// Prioritized-plan preview: the top-3 ranked fixes. The full order and the
// revenue math behind it is what the call is for.
const topFixes = (memo?.rankedFixes ?? []).slice(0, 3);
const relatedNotes = memo ? pickRelatedNotes(memo, 3) : [];

// Numbered dimension codes mirror the v3.astro 9-cell legend so prospects
// see consistent numbering across the public form path and the gated path.
const DIM_CODE: Record<VerdictIcon, string> = {
  search:    '01',
  spark:     '02',
  bolt:      '03',
  target:    '04',
  megaphone: '05',
  eye:       '06',
  phone:     '07',
  mail:      '08',
  flag:      '09',
  bar:       '10',
  clock:     '11',
};

// Reliability-tag copy. Calm, never alarming. Severity (the warn/halt tone
// colour on the reading) is a separate axis from reliability.
const REL_LABEL: Record<string, string> = {
  verified: 'Verified reading',
  'soft-absence': 'Unconfirmed',
  inferred: 'A read, not a measurement',
};

// Resolve the prospect's ICP voice (one verbatim Reddit quote per industry).
// Renders ONLY if the slug maps to one of our 10 ICPs AND the ICP has a quote.
const icpSlug: string | null = (slugToIcp as SlugToIcpMap)[slug] ?? null;
const icpEntry: IcpVoiceEntry | null = icpSlug
  ? ((icpVoice as IcpVoiceMap)[icpSlug] ?? null)
  : null;
const heroQuote: IcpQuote | null = icpEntry?.quotes?.[0] ?? null;

const now = new Date();
const headerDate = `${now.getUTCFullYear()}·${String(now.getUTCMonth() + 1).padStart(2, '0')}·${String(now.getUTCDate()).padStart(2, '0')}`;
const fetchedAtDisplay = cached?.fetchedAt
  ? new Date(cached.fetchedAt).toISOString().replace('T', ' · ').slice(0, 19).replace(/-/g, '·')
  : headerDate;

// Score scale segments. Computed in the frontmatter to avoid Astro's JSX
// parser choking on inline `<=` comparators (Issue: < gets read as tag open).
const scoreSegs: string[] = Array.from({ length: 5 }).map((_, i) => {
  const segPercent = (i + 1) * 20;
  if (segPercent <= scorePercent) return 'lit';
  if (segPercent <= scorePercent + 20) return 'dim-lit';
  return '';
});

function bandLabel(pct: number): string {
  if (pct < 30) return 'Halt';
  if (pct < 50) return 'Watch';
  if (pct < 75) return 'Read';
  return 'Ready';
}
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{cached ? `${cached.hostname} · Teardown · rivett` : 'Audit not found · rivett'}</title>
<meta name="robots" content="noindex,nofollow" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#8FBF3F" />
<link rel="stylesheet" href="/audit/tokens.css" />
<link rel="stylesheet" href="/audit/audit-v3.css" />
<PostHog
  capturePageview={true}
  identifyAs={memo && cached ? slug : undefined}
  personProperties={memo && cached ? {
    type: 'memo_v3_slug',
    slug,
    domain: cached.hostname,
    company_name: memo.companyName ?? null,
    industry: memo.industry ?? null,
    score_numeric: cached.scoreNumeric,
    score_max: cached.scoreMax,
    score_percent: scorePercent,
    first_viewed_at: new Date().toISOString(),
  } : undefined}
  groupKey={memo?.domain}
  groupType="company"
/>
<style>
  body { font-family: var(--grotesk); background: var(--paper); color: var(--ink); margin: 0; }
  .page { max-width: 1200px; margin: 0 auto; padding: var(--sp-10) var(--sp-8); }
  @media (max-width: 880px) { .page { padding: var(--sp-7) var(--sp-5); } }

  /* Top strip: wordmark + meta */
  .top {
    display: flex; align-items: center; justify-content: space-between;
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--sp-10);
  }
  .top .left { display: flex; align-items: center; gap: var(--sp-4); }
  .top a.wordmark { color: var(--ink); text-decoration: none; font-weight: 800; font-size: 18px; text-transform: none; letter-spacing: -0.01em; }
  .top a.wordmark .dot-mark { color: var(--accent-deep); }

  /* Hero block above fold */
  .hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--sp-10);
    align-items: start;
    padding-bottom: var(--sp-10);
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 880px) {
    .hero { grid-template-columns: 1fr; gap: var(--sp-7); }
  }
  .hero .kicker {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-bottom: var(--sp-5);
  }
  /* The LLM page_hero renders as a prominent editorial lede — large and
     readable prose, not an oversized display headline. */
  .hero .lede {
    font-family: var(--grotesk);
    font-weight: 500;
    font-size: clamp(22px, 2.35vw, 31px);
    line-height: 1.34;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 var(--sp-6);
    max-width: 620px;
    text-wrap: pretty;
  }
  .hero .strength {
    margin: 0 0 var(--sp-7);
    padding-top: var(--sp-4);
    border-top: var(--bw-hair) solid var(--line);
    max-width: 560px;
  }
  .hero .strength .s-lab {
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--accent-deep); display: block; margin-bottom: var(--sp-2);
  }
  .hero .strength .s-text {
    font-family: var(--serif); font-style: italic;
    font-size: 16px; line-height: 1.5; color: var(--ink-dim); margin: 0;
  }
  .hero .cta-block {
    display: flex; flex-direction: column; gap: var(--sp-3);
  }
  .hero .cta-trust {
    font-family: var(--grotesk);
    font-size: 14px;
    color: var(--ink-faint);
    margin: 0;
    max-width: 540px;
    line-height: 1.5;
  }
  .hero-meta-row {
    display: flex; flex-wrap: wrap; gap: var(--sp-5);
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--sp-7);
  }
  .hero-meta-row b { color: var(--ink); font-weight: 500; }

  /* Score panel (right column) */
  .score-card {
    background: var(--ink);
    color: var(--on-ink);
    padding: var(--sp-8);
    display: flex; flex-direction: column; gap: var(--sp-4);
  }
  .score-card .lab {
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--on-ink-italic);
  }
  .score-card .read {
    font-family: var(--grotesk); font-weight: 800;
    font-size: clamp(64px, 8vw, 96px);
    line-height: 1; letter-spacing: var(--track-display);
  }
  .score-card .denom { color: var(--on-ink-italic); font-weight: 500; font-size: 0.6em; }
  .score-card .band {
    font-family: var(--serif); font-style: italic;
    color: var(--on-ink-italic); font-size: 16px;
  }
  .score-card .scale { display: flex; gap: 4px; margin-top: var(--sp-3); }
  .score-card .seg { flex: 1; height: 6px; background: var(--on-ink-line); }
  .score-card .seg.lit { background: var(--accent); }
  .score-card .seg.dim-lit { background: var(--accent-deep); }

  /* Findings section */
  .locked-section {
    padding-top: var(--sp-10);
  }
  .locked-section h2 {
    font-family: var(--grotesk);
    font-weight: 800;
    font-size: clamp(26px, 2.4vw, 36px);
    line-height: 1.15;
    margin: 0 0 var(--sp-3);
    letter-spacing: var(--track-display);
  }
  .locked-section h2 .ital { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--ink-dim); }
  .locked-section .lab {
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--accent-deep); margin-bottom: var(--sp-5);
  }
  /* ---- Findings · dossier grid — verbatim from the V4 Hybrid teardown ---- */
  .v3-locks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--ink);
    margin-top: var(--sp-7);
  }
  .v3-lock {
    padding: 24px 24px 22px;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
    position: relative;
    transition: background 120ms cubic-bezier(0.2, 0.6, 0.2, 1);
    min-height: 232px;
    display: flex;
    flex-direction: column;
  }
  .v3-lock:nth-child(3n) { border-right: 0; }
  .v3-lock:nth-last-child(-n+3) { border-bottom: 0; }
  .v3-lock:hover { background: var(--paper-2); }
  .v3-lock .lhead {
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--mono); font-size: 10.5px;
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--ink-faint); gap: 12px;
  }
  .v3-lock .lhead .dcode {
    margin-left: auto; font-family: var(--mono); font-size: 11px;
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--ink-faint); background: transparent; padding: 0;
  }
  .v3-lock .lhead .dcode b { color: var(--ink); font-weight: 500; }
  .v3-lock-ic {
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--ink);
    transition: color 120ms cubic-bezier(0.2, 0.6, 0.2, 1), transform 200ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .v3-lock-ic svg {
    fill: none; stroke: currentColor; stroke-width: 1.6;
    stroke-linecap: square; stroke-linejoin: miter;
  }
  .v3-lock-ic svg :global(.dot) { fill: var(--accent); stroke: none; }
  .v3-lock-ic svg :global(.fill) { fill: currentColor; stroke: none; }
  .v3-lock:hover .v3-lock-ic { color: var(--accent-deep); }
  .v3-lock h3 {
    margin: 18px 0 4px; font-family: var(--grotesk); font-weight: 700;
    font-size: 22px; line-height: 1.1; letter-spacing: -0.02em;
    color: var(--ink); text-wrap: balance;
  }
  .v3-lock .reading {
    margin-top: 14px; font-family: var(--grotesk); font-weight: 700;
    font-size: var(--t-h-lg); line-height: 1; letter-spacing: -0.03em;
    color: var(--ink);
  }
  .v3-lock .reading.warn { color: var(--signal-warn); }
  .v3-lock .reading.halt { color: var(--signal-halt); }
  .v3-lock .reading-k {
    margin-top: 4px; font-family: var(--mono); font-size: 10.5px;
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--ink-faint);
  }
  .v3-lock .reading-unmeasured {
    margin-top: 14px; font-family: var(--serif); font-style: italic;
    font-size: 14px; line-height: 1.5; color: var(--ink-dim);
  }
  /* The finding's real observation. Redaction removed in the Phase 1 rebuild —
     this shows the honest text where the REDACTED bar used to sit. */
  .v3-lock .obs {
    margin-top: 16px; padding-top: 16px;
    border-top: 1px solid var(--line);
    font-family: var(--mono); font-style: normal; font-size: 12px;
    letter-spacing: 0; text-transform: none; line-height: 1.5;
    color: var(--ink-dim);
  }
  /* Reliability tag — calm, mono, bottom-aligned across the grid row. */
  .v3-lock .rel-tag {
    margin-top: auto; padding-top: 14px;
    border-top: 1px solid var(--line);
    font-family: var(--mono); font-size: 10.5px;
    letter-spacing: var(--track-mono); text-transform: uppercase;
  }
  .v3-lock .rel-tag.rel-verified { color: var(--ink); }
  .v3-lock .rel-tag.rel-soft-absence { color: var(--ink-faint); }
  /* Upgrade 12 - per-cell expand toggle. Subtle until hovered or focused.
     Sits at the bottom of each card under the reliability tag. */
  .v3-lock-expand-toggle {
    appearance: none;
    background: transparent;
    border: none;
    border-top: 1px dashed var(--line);
    padding: var(--sp-3) 0 0;
    margin-top: var(--sp-3);
    cursor: pointer;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--ink-faint);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-2);
    width: 100%;
    transition: color var(--dur-1) var(--ease);
  }
  .v3-lock-expand-toggle:hover,
  .v3-lock-expand-toggle:focus-visible { color: var(--accent-deep); outline: none; }
  .v3-lock-expand-toggle .toggle-icon {
    font-family: var(--grotesk);
    font-weight: 700;
    font-size: 16px;
    line-height: 1;
    color: var(--accent-deep);
    transition: transform var(--dur-2) var(--ease);
    display: inline-block;
  }
  .v3-lock-expand-toggle[aria-expanded="true"] .toggle-icon { transform: rotate(45deg); }
  .v3-lock-checks {
    margin-top: var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line);
  }
  .v3-lock-checks ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .v3-lock-checks .check {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: var(--sp-2);
    padding: 7px 0;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--ink-dim);
    border-bottom: 1px solid var(--line-soft);
    align-items: baseline;
  }
  .v3-lock-checks .check:last-child { border-bottom: 0; }
  .v3-lock-checks .check .check-marker {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 13px;
    line-height: 1;
  }
  .v3-lock-checks .check.check-ok .check-marker { color: var(--accent-deep); }
  .v3-lock-checks .check.check-fail .check-marker { color: var(--signal-halt); }
  /* Soft-absence rows are quieter - they're not failures, they're "could not
     confirm". Italic + muted matches the locked-observation tone elsewhere. */
  .v3-lock-checks .check.rel-soft-absence { color: var(--ink-faint); font-style: italic; }
  .v3-lock-checks .check.rel-soft-absence .check-marker { color: var(--ink-faint); }
  .v3-lock-checks .check.rel-inferred { font-style: italic; }
  /* Bolded fragments inside the check label (used for highlighting tracker
     names, fields, etc.) stay readable in the muted context. */
  .v3-lock-checks .check :global(b) { font-weight: 600; color: var(--ink); }
  .v3-lock .rel-tag.rel-inferred {
    font-family: var(--serif); font-style: italic;
    text-transform: none; letter-spacing: 0;
    font-size: 13px; color: var(--ink-dim);
  }
  @media (max-width: 1100px) {
    .v3-locks-grid { grid-template-columns: repeat(2, 1fr); }
    .v3-lock:nth-child(3n) { border-right: 1px solid var(--ink); }
    .v3-lock:nth-child(2n) { border-right: 0; }
    .v3-lock:nth-last-child(-n+3) { border-bottom: 1px solid var(--ink); }
    .v3-lock:nth-last-child(-n+2) { border-bottom: 0; }
  }
  @media (max-width: 600px) {
    .v3-locks-grid { grid-template-columns: 1fr; }
    .v3-lock { border-right: 0; }
    .v3-lock:nth-last-child(-n+2) { border-bottom: 1px solid var(--ink); }
    .v3-lock:last-child { border-bottom: 0; }
  }

  /* Prioritized-plan preview — the first 3 ranked fixes. */
  .plan-preview { padding-top: var(--sp-12); }
  .plan-preview .lab {
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--accent-deep); margin-bottom: var(--sp-5);
  }
  .plan-preview h2 {
    font-family: var(--grotesk); font-weight: 800;
    font-size: clamp(26px, 2.4vw, 36px); line-height: 1.15;
    letter-spacing: var(--track-display); margin: 0 0 var(--sp-4);
  }
  .plan-preview h2 .ital { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--ink-dim); }
  .plan-preview .plan-intro {
    font-family: var(--serif); font-style: italic;
    font-size: clamp(16px, 1.4vw, 19px); line-height: 1.55;
    color: var(--ink-dim); margin: 0 0 var(--sp-8); max-width: 640px;
  }
  .plan-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--ink); }
  .plan-item {
    display: flex; gap: var(--sp-6);
    padding: var(--sp-7); border-bottom: 1px solid var(--ink);
  }
  .plan-item:last-child { border-bottom: 0; }
  @media (max-width: 700px) {
    .plan-item { gap: var(--sp-5); padding: var(--sp-6) var(--sp-5); }
  }
  .plan-rank {
    font-family: var(--mono); font-size: 26px; font-weight: 500;
    color: var(--accent-deep); line-height: 1; flex-shrink: 0;
  }
  .plan-body { display: flex; flex-direction: column; gap: var(--sp-3); }
  .plan-body h3 {
    font-family: var(--grotesk); font-weight: 700;
    font-size: clamp(18px, 1.6vw, 22px); line-height: 1.2;
    letter-spacing: -0.02em; margin: 0; color: var(--ink); text-wrap: balance;
  }
  .plan-body p {
    font-family: var(--grotesk); font-size: 15px; line-height: 1.55;
    color: var(--ink-dim); margin: 0; max-width: 620px;
  }
  .plan-chips { display: flex; gap: var(--sp-3); flex-wrap: wrap; margin-top: var(--sp-2); }
  .plan-chips .chip {
    font-family: var(--mono); font-size: 10.5px;
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--ink-faint); border: 1px solid var(--line); padding: 4px 9px;
  }
  .plan-chips .chip b { color: var(--ink); font-weight: 500; }

  /* Related notes — three editorial cards keyed off the audit findings */
  .related-notes {
    margin-top: var(--sp-12);
    padding-top: var(--sp-10);
    border-top: 1px solid var(--line);
  }
  .related-notes .rn-lab {
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--accent-deep);
    margin-bottom: var(--sp-3);
  }
  .related-notes .rn-h {
    font-family: var(--grotesk); font-weight: 800;
    font-size: clamp(26px, 2.4vw, 36px); line-height: 1.15;
    letter-spacing: var(--track-display); margin: 0 0 var(--sp-7);
  }
  .related-notes .rn-h .ital {
    font-family: var(--serif); font-style: italic; font-weight: 400;
    color: var(--ink-dim);
  }
  .related-notes .rn-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--ink);
  }
  @media (max-width: 980px) { .related-notes .rn-grid { grid-template-columns: 1fr; } }
  .related-notes .rn-card {
    display: flex; flex-direction: column;
    padding: var(--sp-7);
    border-right: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition: background 120ms;
    min-height: 220px;
  }
  .related-notes .rn-card:last-child { border-right: 0; }
  @media (max-width: 980px) {
    .related-notes .rn-card { border-right: 0; border-bottom: 1px solid var(--ink); }
    .related-notes .rn-card:last-child { border-bottom: 0; }
  }
  .related-notes .rn-card:hover { background: var(--paper-2); }
  .related-notes .rn-title {
    font-family: var(--grotesk); font-weight: 700;
    font-size: 20px; line-height: 1.2;
    letter-spacing: -0.02em; color: var(--ink);
    margin: 0 0 var(--sp-3);
    text-wrap: balance;
  }
  .related-notes .rn-hook {
    font-family: var(--serif); font-style: italic;
    font-size: 14.5px; line-height: 1.5;
    color: var(--ink-dim);
    margin: 0 0 var(--sp-5);
    flex: 1;
  }
  .related-notes .rn-more {
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--accent-deep);
    margin-top: auto;
  }

  /* MRI soft-ramp link below the primary closer CTA */
  .ramp-ramp {
    margin: var(--sp-5) 0 0 !important;
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--on-ink-italic) !important;
  }
  .ramp-ramp a {
    color: var(--accent) !important;
    text-decoration: none;
    border-bottom: 1px dotted var(--on-ink-line-2);
    padding-bottom: 1px;
  }
  .ramp-ramp a:hover {
    color: var(--on-ink) !important;
    border-bottom-color: var(--on-ink);
  }

  /* Footer CTA + bio */
  .closer {
    margin-top: var(--sp-12);
    background: var(--ink); color: var(--on-ink);
    padding: var(--sp-12) var(--sp-10);
    display: grid; grid-template-columns: 1.5fr 1fr;
    gap: var(--sp-10); align-items: end;
  }
  @media (max-width: 880px) {
    .closer { grid-template-columns: 1fr; padding: var(--sp-8) var(--sp-6); }
  }
  .closer h2 {
    font-family: var(--grotesk); font-weight: 800;
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1.05; letter-spacing: var(--track-display);
    margin: 0 0 var(--sp-5);
  }
  .closer h2 .ital { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--on-ink-italic); }
  .closer p { font-family: var(--grotesk); font-size: 15px; color: var(--on-ink-italic); line-height: 1.55; margin: 0 0 var(--sp-5); max-width: 480px; }
  .closer .actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; }
  .closer .sig {
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--on-ink-italic);
  }
  .closer .sig b { color: var(--on-ink); font-weight: 500; }

  /* Subtle defamation/legal footer */
  .legal-foot {
    margin-top: var(--sp-7);
    font-family: var(--mono); font-size: 11px;
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--ink-faint);
    text-align: center;
  }

  /* 404 layout when slug not found */
  .nf-wrap { max-width: 720px; margin: 0 auto; padding: var(--sp-14) var(--sp-8); }
  .nf-wrap h1 { font-family: var(--grotesk); font-weight: 800; font-size: clamp(40px, 5.4vw, 64px); line-height: 1; letter-spacing: var(--track-display); margin: var(--sp-6) 0; }
  .nf-wrap h1 .ital { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--ink-dim); }
  .nf-wrap p { font-family: var(--serif); font-style: italic; font-size: 20px; line-height: 1.5; color: var(--ink-dim); margin: 0 0 var(--sp-8); }

  /* Industry voice band — one verbatim Reddit quote pulled from the ICP research file. */
  .industry-voice {
    margin: var(--sp-10) 0 var(--sp-12);
    padding: var(--sp-8) var(--sp-10);
    background: var(--sage);
    border: 1px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }
  @media (max-width: 780px) {
    .industry-voice { padding: var(--sp-7) var(--sp-6); margin: var(--sp-8) 0 var(--sp-10); }
  }
  .industry-voice .iv-lab {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--accent-deep);
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .industry-voice .iv-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 999px;
  }
  .industry-voice .iv-ital {
    font-family: var(--serif);
    font-style: italic;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-dim);
    font-size: 13px;
  }
  .industry-voice .iv-quote {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.4;
    color: var(--ink);
    margin: 0;
    text-wrap: pretty;
    max-width: 820px;
  }
  .industry-voice .iv-attr {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: var(--track-mono);
    color: var(--ink-faint);
    text-transform: uppercase;
  }
  .industry-voice .iv-attr a {
    color: var(--accent-deep);
    text-decoration: none;
  }
  .industry-voice .iv-attr a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
</head>
<body>
{cached && memo && heroData ? (
  <main class="page">
    <header class="top">
      <div class="left">
        <a class="wordmark" href="/">rivett<span class="dot-mark">.</span></a>
        <span>· Teardown · {cached.hostname}</span>
      </div>
      <span>{fetchedAtDisplay}</span>
    </header>

    <section class="hero">
      <div class="hero-text">
        <div class="hero-meta-row">
          <span>Domain · <b>{cached.hostname}</b></span>
          {companyName && companyName !== cached.hostname ? <span>Company · <b>{companyName}</b></span> : null}
          <span>Scan · <b>9 of 9</b></span>
        </div>

        <div class="kicker">Diagnosis</div>
        <p class="lede">{heroData.pageHero}</p>

        {heroData.strength ? (
          <div class="strength">
            <span class="s-lab">What's working</span>
            <p class="s-text">{heroData.strength}</p>
          </div>
        ) : null}

        <div class="cta-block">
          <a class="btn btn--pri" href={CAL_URL}>Book 30 min with Fred <span aria-hidden="true">→</span></a>
          <p class="cta-trust">Thirty minutes with Fred. We walk through your audit, not a slide deck.</p>
        </div>
      </div>

      <aside class="score-card">
        <span class="lab">Composite read · v3.4</span>
        <div class="read">{cached.scoreNumeric}<span class="denom"> / {cached.scoreMax}</span></div>
        <div class="band">{bandLabel(scorePercent)}</div>
        <div class="scale">
          {scoreSegs.map((cls) => <div class={`seg ${cls}`.trim()}></div>)}
        </div>
      </aside>
    </section>

    {heroQuote ? (
      <section class="industry-voice" aria-label="What operators in your industry are saying">
        <div class="iv-lab">
          <span class="iv-dot"></span>
          Operators in {icpEntry?.label ?? 'your industry'} <span class="iv-ital">are saying this.</span>
        </div>
        <blockquote class="iv-quote">{heroQuote.quote}</blockquote>
        <div class="iv-attr">
          {heroQuote.source_url ? (
            <a href={heroQuote.source_url} target="_blank" rel="noopener noreferrer">{heroQuote.attribution} <span aria-hidden="true">→</span></a>
          ) : (
            <span>{heroQuote.attribution}</span>
          )}
        </div>
      </section>
    ) : null}

    <section class="locked-section">
      <div class="lab">The full read · all 9 findings</div>
      <h2>What the audit <span class="ital">found.</span></h2>
      <div class="v3-locks-grid">
        {verdictCells.map((cell) => {
          const value = (cell.value ?? '').trim();
          const isUnmeasured = value === '' || value.toLowerCase() === 'n/a';
          const meta = lockedMeta(cell.icon);
          const tone = deriveTone(cell);
          return (
            <article class="v3-lock" tabindex="0">
              <div class="lhead">
                <span class="v3-lock-ic" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="24" height="24" set:html={LOCK_ICON[cell.icon] ?? LOCK_ICON.search} />
                </span>
                <span class="dcode">D · <b>{DIM_CODE[cell.icon] ?? '·'}</b></span>
              </div>
              <h3>{meta.shortLabel}</h3>
              {isUnmeasured ? (
                <div class="reading-unmeasured">The public scan couldn't reach this one. We measure it together on the call.</div>
              ) : (
                <Fragment>
                  <div class={`reading ${tone === 'none' ? '' : tone}`.trim()}>{cell.value}</div>
                  <div class="reading-k">{meta.valueLabel}</div>
                </Fragment>
              )}
              <p class="obs">{cell.note}</p>
              {cell.reliability ? (
                <div class={`rel-tag rel-${cell.reliability}`}>{REL_LABEL[cell.reliability] ?? cell.reliability}</div>
              ) : null}
              {/* Upgrade 12 - per-cell expand. Reveals the underlying check list
                  so prospects can verify what was measured without breaking the
                  locked-observation interpretation up top. data-cta lets PostHog
                  track which dimensions each prospect drilled into - the only
                  signal we have for "which findings do they care about". */}
              {cell.checks && cell.checks.length > 0 ? (
                <Fragment>
                  <button
                    type="button"
                    class="v3-lock-expand-toggle"
                    data-cta={`cell_expand_${cell.icon}`}
                    data-cta-location="memo_cell"
                    aria-expanded="false"
                    aria-controls={`cell-checks-${cell.icon}`}
                  >
                    <span class="toggle-text">Show {cell.checks.length} signal{cell.checks.length === 1 ? '' : 's'}</span>
                    <span class="toggle-icon" aria-hidden="true">+</span>
                  </button>
                  <div class="v3-lock-checks" id={`cell-checks-${cell.icon}`} hidden>
                    <ul>
                      {cell.checks.map((check) => (
                        <li class={`check ${check.ok ? 'check-ok' : 'check-fail'} rel-${check.reliability ?? 'verified'}`}>
                          <span class="check-marker" aria-hidden="true">{check.ok ? '✓' : '×'}</span>
                          <span class="check-text" set:html={check.text} />
                        </li>
                      ))}
                    </ul>
                  </div>
                </Fragment>
              ) : null}
            </article>
          );
        })}
      </div>
    </section>

    {topFixes.length ? (
      <section class="plan-preview">
        <div class="lab">Where I'd start · the fix order</div>
        <h2>The first <span class="ital">three moves.</span></h2>
        <p class="plan-intro">Ranked by what returns the most for the least work. The rest of the order, and the revenue math behind the ranking, is what the call is for.</p>
        <ol class="plan-list">
          {topFixes.map((fix) => (
            <li class="plan-item">
              <span class="plan-rank">{String(fix.rank).padStart(2, '0')}</span>
              <div class="plan-body">
                <h3>{fix.what}</h3>
                <p>{fix.why}</p>
                <div class="plan-chips">
                  <span class="chip">Effort · <b>{fix.effort}</b></span>
                  <span class="chip">Impact · <b>{fix.impact}</b></span>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ) : null}

    {relatedNotes.length > 0 ? (
      <section class="related-notes">
        <div class="rn-lab">What to read next · related to this audit</div>
        <h2 class="rn-h">Three notes <span class="ital">on the gaps this audit found.</span></h2>
        <div class="rn-grid">
          {relatedNotes.map((n) => (
            <a
              class="rn-card"
              href={`/blog/${n.slug}`}
              data-cta="memo_related"
              data-cta-location="memo_footer"
              data-content-slug={n.slug}
              target="_blank"
              rel="noopener"
            >
              <h3 class="rn-title">{n.title}</h3>
              <p class="rn-hook">{n.hook}</p>
              <span class="rn-more">Read note <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </section>
    ) : null}

    <section class="closer">
      <div>
        <div style="font-family: var(--mono); font-size: var(--t-meta); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--accent); margin-bottom: var(--sp-3);">● 30 min · no deck</div>
        <h2>
          Pick a time.<br/>
          <span class="ital">We go through the fix order together.</span>
        </h2>
        <p>You've seen all nine findings and the first three moves. The call is the rest of the order, the revenue math behind the ranking, and the things a browser scan can't reach: your pipeline, your follow-up, your numbers.</p>
        <div class="actions">
          <a class="btn btn--inv" href={CAL_URL} data-cta="memo_book_call" data-cta-location="memo_closer">Book a call <span aria-hidden="true">→</span></a>
          <a class="btn btn--sec" href="/audit/v3" style="border-color: var(--on-ink-line-2); color: var(--on-ink);" data-cta="memo_audit_another" data-cta-location="memo_closer">Audit another domain</a>
        </div>
        <p class="ramp-ramp">
          <a href="/revenue-leak-mri" data-cta="memo_to_mri" data-cta-location="memo_closer">Or run the Revenue Leak MRI yourself first <span aria-hidden="true">→</span></a>
        </p>
      </div>
      <div class="sig">
        <span style="display:block; color: var(--accent); margin-bottom: var(--sp-2);">● Signature</span>
        <b>Fred Style</b> · rivett.tech · {fetchedAtDisplay.split(' ')[0]}
        <p style="font-family: var(--serif); font-style: italic; font-size: 14px; line-height: 1.5; margin-top: var(--sp-5); color: var(--on-ink-italic); max-width: 360px;">Live in-browser scan. Not a formal assessment. The audit reads the public surface of a domain in your browser. It does not access authenticated dashboards, customer data, or anything behind a login.</p>
      </div>
    </section>

    <p class="legal-foot">rivett.tech · {fetchedAtDisplay.split(' ')[0]}</p>
  </main>
) : (
  <div class="nf-wrap">
    <span class="kicker" style="font-family: var(--mono); font-size: var(--t-meta); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--accent-deep);">Cached audit · {kvError === 'invalid' ? 'invalid slug' : kvError === 'kv_failed' ? 'kv error' : 'not found'}</span>
    <h1>No cached run for <span class="ital">that slug.</span></h1>
    <p>The cache holds audits for 14 days. After that, or if no audit has ever been run for this domain on this build, the URL returns 404. Paste the domain into the live audit form to generate a fresh one.</p>
    <p style="font-style: normal; font-family: var(--mono); font-size: 13px; color: var(--ink-faint);">Slug attempted: <span style="background: var(--paper-2); padding: 4px 8px; border: 1px solid var(--line);">{slug}</span></p>
    <div style="display: flex; gap: var(--sp-3); flex-wrap: wrap;">
      <a class="btn btn--pri" href="/audit/v3">Run a fresh audit <span aria-hidden="true">→</span></a>
      <a class="btn btn--sec" href={CAL_URL}>Book a call</a>
    </div>
  </div>
)}

{/* Upgrade 12 - per-cell expand toggle. Vanilla JS, no framework. Each toggle
    flips its own aria-expanded + the controlled element's hidden state. The
    PostHog autocapture layer picks up the click via data-cta so we can see
    which dimensions prospects drill into. Cells are independent (no
    auto-collapse) - prospects often want to compare two dimensions side by
    side. If clutter becomes a problem in practice we can add accordion later. */}
<script is:inline>
  (function() {
    document.querySelectorAll('.v3-lock-expand-toggle').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        var targetId = btn.getAttribute('aria-controls');
        var target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;
        var nextExpanded = !expanded;
        btn.setAttribute('aria-expanded', String(nextExpanded));
        target.hidden = !nextExpanded;
        var textEl = btn.querySelector('.toggle-text');
        if (textEl) {
          var count = target.querySelectorAll('li').length;
          textEl.textContent = nextExpanded
            ? 'Hide'
            : 'Show ' + count + ' signal' + (count === 1 ? '' : 's');
        }
      });
    });
  })();
</script>

</body>
</html>
