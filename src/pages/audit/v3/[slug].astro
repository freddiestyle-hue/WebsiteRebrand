---
// Teardown render for cached v3 audits. Reads audit-v3:{slug} from Upstash KV
// for the memo, fetches the per-prospect hero from /api/audit/v3/hero/{slug},
// and renders the ungated teardown: the LLM hero as a lede, all 9 findings
// with calm reliability tags, and a 3-step prioritized-plan preview.
//
// Phase 1 rebuild. The page used to gate 8 of 9 findings behind a redaction;
// the rebuild shows every finding honestly and moves the call's reason to the
// fix order and the revenue math.

export const prerender = false;

import { Redis } from '@upstash/redis';
import PostHog from '../../../components/PostHog.astro';
import type { Memo, VerdictCell, VerdictIcon } from '../../../utils/audit/memo-schema';
import { isValidV3Slug } from '../../../utils/audit/slug';
import { pickHeroFinding } from '../../../utils/audit/pick-hero';
import { pickRelatedNotes } from '../../../utils/audit/related-notes';
import slugToIcp from '../../../utils/audit/slug-to-icp.json';
import icpVoice from '../../../utils/audit/icp-voice.json';
import { lockedMeta, deriveTone } from '../../../utils/audit/locked-observation';

// Verdict-dimension icons — verbatim from the V4 Hybrid teardown sprite
// (Prospect Teardown standalone). Inner SVG markup per VerdictIcon; .dot
// fills accent, .fill fills currentColor (see .v3-lock-ic svg CSS).
const LOCK_ICON: Record<string, string> = {
  search: '<path d="M3 18 L9 12 L13 16 L21 6"/><circle class="dot" cx="21" cy="6" r="1.6"/>',
  spark: '<circle cx="12" cy="12" r="9"/><path d="M12 12 L12 3 M12 12 L21 12"/><circle class="dot" cx="12" cy="12" r="1.2"/>',
  bolt: '<circle cx="12" cy="12" r="9"/><path d="M12 6 V12 L17 14"/>',
  target: '<path d="M3 21 V11 H7 V21 Z M10 21 V5 H14 V21 Z M17 21 V15 H21 V21 Z"/>',
  megaphone: '<path d="M4 20 L12 4 L20 20 Z"/><path d="M12 11 V15"/><circle class="fill" cx="12" cy="17.5" r="0.8"/>',
  eye: '<path d="M3 12 H8 L10 6 L14 18 L16 12 H21"/><circle class="dot" cx="14" cy="18" r="1.4"/>',
  phone: '<path d="M3 12 H8 L10 6 L14 18 L16 12 H21"/><circle class="dot" cx="14" cy="18" r="1.4"/>',
  mail: '<rect x="3" y="6" width="18" height="13"/><path d="M3 6 L12 14 L21 6"/>',
  flag: '<path d="M3 7 L12 3 L21 7 L12 11 Z"/><path d="M3 12 L12 16 L21 12"/><path d="M3 17 L12 21 L21 17"/>',
  bar: '<path d="M3 21 V11 H7 V21 Z M10 21 V5 H14 V21 Z M17 21 V15 H21 V21 Z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 6 V12 L17 14"/>',
};

interface IcpQuote { title: string; quote: string; attribution: string; source_url: string | null }
interface IcpVoiceEntry { label: string; voice_line: string | null; quotes: IcpQuote[]; hooks: unknown[] }
type SlugToIcpMap = Record<string, string | null>;
type IcpVoiceMap = Record<string, IcpVoiceEntry>;

interface CachedV3 {
  memo: Memo;
  durationMs: number;
  scoreNumeric: number;
  scoreMax: number;
  hostname: string;
  url: string;
  fetchedAt: string;
}

const CAL_BASE_URL = 'https://cal.com/fred-style/discovery';
// Email clients (Outlook, Gmail) and DM platforms (LinkedIn) routinely append
// or absorb the trailing punctuation when a URL ends a sentence:
//   "audit of your site: https://rivett.tech/audit/v3/foo-com. Would love..."
// becomes a link to "/audit/v3/foo-com." with the dot. Same for trailing
// commas, semicolons, closing parens. Strip them before the KV lookup so the
// prospect lands on their actual audit instead of a 404.
const rawSlug = Astro.params.slug ?? '';
const slug = rawSlug.replace(/[.,;)\]\s]+$/, '');
const calUrl = new URL(CAL_BASE_URL);
calUrl.searchParams.set('overlayCalendar', 'true');
calUrl.searchParams.set('prospect', slug);
calUrl.searchParams.set('utm_source', 'audit_memo');
calUrl.searchParams.set('utm_medium', 'site');
calUrl.searchParams.set('utm_content', 'memo_book_call');
for (const key of ['utm_campaign', 'utm_recipient', 'rl', 'r']) {
  const value = Astro.url.searchParams.get(key);
  if (value) calUrl.searchParams.set(key, value);
}
const CAL_URL = calUrl.toString();

let cached: CachedV3 | null = null;
let kvError: 'invalid' | 'not_found' | 'kv_failed' | null = null;

if (!isValidV3Slug(slug)) {
  kvError = 'invalid';
  Astro.response.status = 404;
} else {
  try {
    // Prod injects UPSTASH_*; local .env.local only carries the Vercel KV
    // names. Resolve both so the page renders against real memos in dev
    // (same fallback as /audit/b). Behaviour in prod is unchanged.
    const kvUrl =
      import.meta.env.UPSTASH_REDIS_REST_URL ?? process.env.UPSTASH_REDIS_REST_URL ??
      import.meta.env.KV_REST_API_URL ?? process.env.KV_REST_API_URL;
    const kvToken =
      import.meta.env.UPSTASH_REDIS_REST_TOKEN ?? process.env.UPSTASH_REDIS_REST_TOKEN ??
      import.meta.env.KV_REST_API_TOKEN ?? process.env.KV_REST_API_TOKEN;
    const redis = kvUrl && kvToken ? new Redis({ url: kvUrl, token: kvToken }) : Redis.fromEnv();
    const raw = await redis.get<unknown>(`audit-v3:${slug}`);
    if (raw == null) {
      kvError = 'not_found';
      Astro.response.status = 404;
    } else {
      cached = typeof raw === 'string' ? JSON.parse(raw) : (raw as CachedV3);
    }
  } catch (e) {
    console.error('[audit/v3/slug] KV read failed', e);
    kvError = 'kv_failed';
    Astro.response.status = 500;
  }
}

const memo = cached?.memo ?? null;

// Resolve the per-prospect hero. The hero endpoint owns generation + caching;
// the page just reads it. If the endpoint is unreachable, fall back to the
// rule-based pickHeroFinding so the page still renders an honest headline.
interface PageHero {
  pageHero: string;
  strength: string;
}
let heroData: PageHero | null = null;
if (memo) {
  try {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), 25_000);
    try {
      const res = await fetch(new URL(`/api/audit/v3/hero/${slug}`, Astro.url), {
        signal: controller.signal,
      });
      if (res.ok) {
        const j = (await res.json()) as { hero?: { pageHero?: string; strength?: string } };
        if (j?.hero?.pageHero?.trim()) {
          heroData = { pageHero: j.hero.pageHero, strength: j.hero.strength?.trim() ?? '' };
        }
      }
    } finally {
      clearTimeout(timer);
    }
  } catch (e) {
    console.error('[audit/v3/slug] hero fetch failed; using rule-based fallback', e);
  }
  if (!heroData) {
    const hf = pickHeroFinding(memo);
    heroData = { pageHero: hf.diagnosis, strength: '' };
  }
}

// Competitor contrast: read-only fetch (generate=0) so a cold cache never
// delays the page. When absent, a client-side fire-and-forget kicks off
// generation; the section appears from the next view onward.
let contrastData: import('../../../utils/audit/competitor-contrast').CompetitorContrast | null = null;
if (memo) {
  try {
    const cc = new AbortController();
    const ct = setTimeout(() => cc.abort(), 3500);
    try {
      const res = await fetch(new URL(`/api/audit/v3/competitors/${slug}?generate=0`, Astro.url), {
        signal: cc.signal,
      });
      if (res.ok) {
        const j = (await res.json()) as { contrast?: typeof contrastData };
        if (j?.contrast?.competitors?.length) contrastData = j.contrast;
      }
    } finally {
      clearTimeout(ct);
    }
  } catch {
    /* fail-open: no section */
  }
}

const scorePercent = cached
  ? Math.round((cached.scoreNumeric / Math.max(cached.scoreMax, 1)) * 100)
  : 0;
const companyName = memo?.companyName ?? memo?.domain ?? cached?.hostname ?? '';

// All 9 findings render, ungated. The hero is the prose above; the cards are
// the evidence. No cell is skipped.
const verdictCells: VerdictCell[] = memo?.verdictCells ?? [];

// Prioritized-plan preview: the top-3 ranked fixes. The full order and the
// revenue math behind it is what the call is for.
const topFixes = (memo?.rankedFixes ?? []).slice(0, 3);
const relatedNotes = memo ? pickRelatedNotes(memo, 3) : [];

// Numbered dimension codes mirror the v3.astro 9-cell legend so prospects
// see consistent numbering across the public form path and the gated path.
const DIM_CODE: Record<VerdictIcon, string> = {
  search:    '01',
  spark:     '02',
  bolt:      '03',
  target:    '04',
  megaphone: '05',
  eye:       '06',
  phone:     '07',
  mail:      '08',
  flag:      '09',
  bar:       '10',
  clock:     '11',
};

// Reliability-tag copy. Calm, never alarming. Severity (the warn/halt tone
// colour on the reading) is a separate axis from reliability.
const REL_LABEL: Record<string, string> = {
  verified: 'Verified reading',
  'soft-absence': 'Unconfirmed',
  inferred: 'A read, not a measurement',
  'verified-na': 'Verified not applicable',
};

// Resolve the prospect's ICP voice (one verbatim Reddit quote per industry).
// Renders ONLY if the slug maps to one of our 10 ICPs AND the ICP has a quote.
const icpSlug: string | null = (slugToIcp as SlugToIcpMap)[slug] ?? null;
const icpEntry: IcpVoiceEntry | null = icpSlug
  ? ((icpVoice as IcpVoiceMap)[icpSlug] ?? null)
  : null;
const heroQuote: IcpQuote | null = icpEntry?.quotes?.[0] ?? null;

// ===== Variant resolution (server-side) =====
// Progressive-reveal A/B/C test. URL param ?v= wins, then rivett_variant cookie
// (set by /r/[code] shortlink resolver), then default A.
//
// Server-rendering the variant state means cells ship gated from the first paint -
// no flash of ungated content (FOUC) before the JS runs, and no-JS readers
// see the variant correctly.
type Variant = 'a' | 'b' | 'c';
// 2026-06-10: reveal-gate experiment ENDED (Move 1, AI-HQ design brief).
// Gating findings was a red-team kill shot ("you can't run a reliability
// framework and a slot-machine reveal mechanic on the same page") and the
// page-level A/B is now /audit/v3 (control) vs /audit/b (buyer-shaped).
// Everyone gets the ungated page; ?v= and the rivett_variant cookie are
// ignored. The gating machinery below is dormant, kept for git history.
const VARIANT: Variant = 'a';

// Per-cell gate opener copy. Mirrors the client-side COPY object below so the
// server emits the same label JS would have appended on mount.
const CELL_OPENER: Record<number, string> = {
  1: 'Tap for the index read',
  2: 'Tap for the citation read',
  3: 'Tap for the speed score',
  4: "Tap for what's tracking",
  5: 'Tap for the ad count',
  6: 'Tap for the path read',
  7: 'Tap for the mobile read',
  8: 'Tap for the auth read',
  9: 'Tap for the stack count',
};
const PLAN_OPENER: Record<number | 'combined', string> = {
  2: 'Tap for fix 02',
  3: 'Tap for fix 03',
  combined: 'Tap for the first three moves',
};
const HERO_OPENER = 'Tap to see what I found';

function cellIsGated(cellNum: number, v: Variant): boolean {
  if (v === 'c') return true;
  if (v === 'b') return cellNum >= 4;
  return false;
}

const now = new Date();
const headerDate = `${now.getUTCFullYear()}·${String(now.getUTCMonth() + 1).padStart(2, '0')}·${String(now.getUTCDate()).padStart(2, '0')}`;
const fetchedAtDisplay = cached?.fetchedAt
  ? new Date(cached.fetchedAt).toISOString().replace('T', ' · ').slice(0, 19).replace(/-/g, '·')
  : headerDate;

// Score scale segments. Computed in the frontmatter to avoid Astro's JSX
// parser choking on inline `<=` comparators (Issue: < gets read as tag open).
const scoreSegs: string[] = Array.from({ length: 5 }).map((_, i) => {
  const segPercent = (i + 1) * 20;
  if (segPercent <= scorePercent) return 'lit';
  if (segPercent <= scorePercent + 20) return 'dim-lit';
  return '';
});

function bandLabel(pct: number): string {
  if (pct < 30) return 'Halt';
  if (pct < 50) return 'Watch';
  if (pct < 75) return 'Read';
  return 'Ready';
}

// Letter-grade replacement for the raw 21/27.5 composite (see
// docs: grade-score-brief.md). Standard US scale on the composite percentage.
// A bare letter (A, B, C, D, F) has no sign; +/- variants render with a small
// accent-coloured glyph. Fail tier (D / F) flips the entire letter to
// --signal-halt so colour-blind users still get the verdict from the letter.
type GradeTier = 'pass' | 'mid' | 'fail';
interface GradeInfo { label: string; base: string; sign: string; tier: GradeTier; }
const GRADE_SCALE: Array<[number, string]> = [
  [97, 'A+'], [93, 'A'], [90, 'A-'],
  [87, 'B+'], [83, 'B'], [80, 'B-'],
  [77, 'C+'], [73, 'C'], [70, 'C-'],
  [67, 'D+'], [63, 'D'], [60, 'D-'],
  [0, 'F'],
];
function gradeFor(pct: number): GradeInfo {
  let label = 'F';
  for (const [threshold, lab] of GRADE_SCALE) {
    if (pct >= threshold) { label = lab; break; }
  }
  const base = label.charAt(0);
  const sign = label.length > 1 ? label.charAt(1) : '';
  const tier: GradeTier = base === 'D' || base === 'F'
    ? 'fail'
    : base === 'C' ? 'mid' : 'pass';
  return { label, base, sign, tier };
}

// 2026-06-10: the field-average benchmark row was removed from the grade
// card (Move 1) - a hardcoded constant presented as a peer comparison was a
// red-team credibility bomb. Constant kept only because the inline tracking
// script still reports it for continuity of existing PostHog insights.
// Field average benchmark. v1: hardcoded to HubSpot's published industry
// median. Replace with our own rolling 90-day composite median once the
// audit corpus crosses ~100 scanned domains (sample stability). Tracked as
// a TODO in tasks; see /api/cron/warm-hq for the cron entry point when
// we wire the real query.
const FIELD_AVG_NUMERIC = 61;
const FIELD_AVG_GRADE = gradeFor(FIELD_AVG_NUMERIC);
const SCORE_GRADE = gradeFor(scorePercent);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{cached ? `${cached.hostname} · Teardown · rivett` : 'Audit not found · rivett'}</title>
<meta name="robots" content="noindex,nofollow" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#8FBF3F" />
<link rel="stylesheet" href="/audit/tokens.css" />
<link rel="stylesheet" href="/audit/audit-v3.css" />
<PostHog
  capturePageview={true}
  identifyAs={memo && cached ? slug : undefined}
  personProperties={memo && cached ? {
    type: 'memo_v3_slug',
    slug,
    domain: cached.hostname,
    company_name: memo.companyName ?? null,
    industry: memo.industry ?? null,
    score_numeric: cached.scoreNumeric,
    score_max: cached.scoreMax,
    score_percent: scorePercent,
    first_viewed_at: new Date().toISOString(),
  } : undefined}
  groupKey={memo?.domain}
  groupType="company"
/>
<style>
  body { font-family: var(--grotesk); background: var(--paper); color: var(--ink); margin: 0; }
  .page { max-width: 1200px; margin: 0 auto; padding: var(--sp-10) var(--sp-8); }
  @media (max-width: 880px) { .page { padding: var(--sp-7) var(--sp-5); } }

  /* Top strip: wordmark + meta */
  .top {
    display: flex; align-items: center; justify-content: space-between;
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--sp-10);
  }
  .top .left { display: flex; align-items: center; gap: var(--sp-4); }
  .top a.wordmark { color: var(--ink); text-decoration: none; font-weight: 800; font-size: 18px; text-transform: none; letter-spacing: -0.01em; }
  .top a.wordmark .dot-mark { color: var(--accent-deep); }

  /* Hero block above fold */
  .hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--sp-10);
    align-items: start;
    padding-bottom: var(--sp-10);
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 880px) {
    .hero { grid-template-columns: 1fr; gap: var(--sp-7); }
  }
  .hero .kicker {
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-bottom: var(--sp-5);
  }
  /* The LLM page_hero renders as a prominent editorial lede — large and
     readable prose, not an oversized display headline. */
  .hero .lede {
    font-family: var(--grotesk);
    font-weight: 500;
    font-size: clamp(22px, 2.35vw, 31px);
    line-height: 1.34;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 var(--sp-6);
    max-width: 620px;
    text-wrap: pretty;
  }
  .hero .strength {
    margin: 0 0 var(--sp-7);
    padding-top: var(--sp-4);
    border-top: var(--bw-hair) solid var(--line);
    max-width: 560px;
  }
  .hero .strength .s-lab {
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--accent-deep); display: block; margin-bottom: var(--sp-2);
  }
  .hero .strength .s-text {
    font-family: var(--serif); font-style: italic;
    font-size: 16px; line-height: 1.5; color: var(--ink-dim); margin: 0;
  }
  .hero .cta-block {
    display: flex; flex-direction: column; gap: var(--sp-3);
  }
  .hero .cta-trust {
    font-family: var(--grotesk);
    font-size: 14px;
    color: var(--ink-faint);
    margin: 0;
    max-width: 540px;
    line-height: 1.5;
  }
  .hero-meta-row {
    display: flex; flex-wrap: wrap; gap: var(--sp-5);
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--sp-7);
  }
  .hero-meta-row b { color: var(--ink); font-weight: 500; }

  /* Score panel (right column) */
  .score-card {
    background: var(--ink);
    color: var(--on-ink);
    padding: var(--sp-8);
    display: flex; flex-direction: column; gap: var(--sp-4);
  }
  .score-card .lab {
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--on-ink-italic);
  }
  .score-card .read {
    font-family: var(--grotesk); font-weight: 800;
    font-size: clamp(64px, 8vw, 96px);
    line-height: 1; letter-spacing: var(--track-display);
  }
  .score-card .denom { color: var(--on-ink-italic); font-weight: 500; font-size: 0.6em; }
  .score-card .band {
    font-family: var(--serif); font-style: italic;
    color: var(--on-ink-italic); font-size: 16px;
  }
  .score-card .scale { display: flex; gap: 4px; margin-top: var(--sp-3); }
  .score-card .seg { flex: 1; height: 6px; background: var(--on-ink-line); }
  .score-card .seg.lit { background: var(--accent); }
  .score-card .seg.dim-lit { background: var(--accent-deep); }

  /* Findings section */
  .locked-section {
    padding-top: var(--sp-10);
  }
  .locked-section h2 {
    font-family: var(--grotesk);
    font-weight: 800;
    font-size: clamp(26px, 2.4vw, 36px);
    line-height: 1.15;
    margin: 0 0 var(--sp-3);
    letter-spacing: var(--track-display);
  }
  .locked-section h2 .ital { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--ink-dim); }
  .locked-section .lab {
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--accent-deep); margin-bottom: var(--sp-5);
  }
  /* ---- Findings · dossier grid — verbatim from the V4 Hybrid teardown ---- */
  .v3-locks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--ink);
    margin-top: var(--sp-7);
  }
  .v3-lock {
    padding: 24px 24px 22px;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    background: var(--paper);
    position: relative;
    transition: background 120ms cubic-bezier(0.2, 0.6, 0.2, 1);
    min-height: 232px;
    display: flex;
    flex-direction: column;
  }
  .v3-lock:nth-child(3n) { border-right: 0; }
  .v3-lock:nth-last-child(-n+3) { border-bottom: 0; }
  .v3-lock:hover { background: var(--paper-2); }
  .v3-lock .lhead {
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--mono); font-size: 10.5px;
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--ink-faint); gap: 12px;
  }
  .v3-lock .lhead .dcode {
    margin-left: auto; font-family: var(--mono); font-size: 11px;
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--ink-faint); background: transparent; padding: 0;
  }
  .v3-lock .lhead .dcode b { color: var(--ink); font-weight: 500; }
  .v3-lock-ic {
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--ink);
    transition: color 120ms cubic-bezier(0.2, 0.6, 0.2, 1), transform 200ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .v3-lock-ic svg {
    fill: none; stroke: currentColor; stroke-width: 1.6;
    stroke-linecap: square; stroke-linejoin: miter;
  }
  .v3-lock-ic svg :global(.dot) { fill: var(--accent); stroke: none; }
  .v3-lock-ic svg :global(.fill) { fill: currentColor; stroke: none; }
  .v3-lock:hover .v3-lock-ic { color: var(--accent-deep); }
  .v3-lock h3 {
    margin: 18px 0 4px; font-family: var(--grotesk); font-weight: 700;
    font-size: 22px; line-height: 1.1; letter-spacing: -0.02em;
    color: var(--ink); text-wrap: balance;
  }
  .v3-lock .reading {
    margin-top: 14px; font-family: var(--grotesk); font-weight: 700;
    font-size: var(--t-h-lg); line-height: 1; letter-spacing: -0.03em;
    color: var(--ink);
  }
  .v3-lock .reading.warn { color: var(--signal-warn); }
  .v3-lock .reading.halt { color: var(--signal-halt); }
  .v3-lock .reading.good { color: var(--accent-deep); }
  .v3-lock .reading-k {
    margin-top: 4px; font-family: var(--mono); font-size: 10.5px;
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--ink-faint);
  }
  .v3-lock .reading-unmeasured {
    margin-top: 14px; font-family: var(--serif); font-style: italic;
    font-size: 14px; line-height: 1.5; color: var(--ink-dim);
  }
  /* The finding's real observation. Redaction removed in the Phase 1 rebuild —
     this shows the honest text where the REDACTED bar used to sit. */
  .v3-lock .obs {
    margin-top: 16px; padding-top: 16px;
    border-top: 1px solid var(--line);
    font-family: var(--mono); font-style: normal; font-size: 12px;
    letter-spacing: 0; text-transform: none; line-height: 1.5;
    color: var(--ink-dim);
  }
  /* Reliability tag — calm, mono, bottom-aligned across the grid row. */
  .v3-lock .rel-tag {
    margin-top: auto; padding-top: 14px;
    border-top: 1px solid var(--line);
    font-family: var(--mono); font-size: 10.5px;
    letter-spacing: var(--track-mono); text-transform: uppercase;
  }
  .v3-lock .rel-tag.rel-verified { color: var(--ink); }
  .v3-lock .rel-tag.rel-soft-absence { color: var(--ink-faint); }
  /* Upgrade 12 - per-cell expand toggle. Subtle until hovered or focused.
     Sits at the bottom of each card under the reliability tag. */
  .v3-lock-expand-toggle {
    appearance: none;
    background: transparent;
    border: none;
    border-top: 1px dashed var(--line);
    padding: var(--sp-3) 0 0;
    margin-top: var(--sp-3);
    cursor: pointer;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--ink-faint);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-2);
    width: 100%;
    transition: color var(--dur-1) var(--ease);
  }
  .v3-lock-expand-toggle:hover,
  .v3-lock-expand-toggle:focus-visible { color: var(--accent-deep); outline: none; }
  .v3-lock-expand-toggle .toggle-icon {
    font-family: var(--grotesk);
    font-weight: 700;
    font-size: 16px;
    line-height: 1;
    color: var(--accent-deep);
    transition: transform var(--dur-2) var(--ease);
    display: inline-block;
  }
  .v3-lock-expand-toggle[aria-expanded="true"] .toggle-icon { transform: rotate(45deg); }
  .v3-lock-checks {
    margin-top: var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line);
  }
  .v3-lock-checks ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .v3-lock-checks .check {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: var(--sp-2);
    padding: 7px 0;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--ink-dim);
    border-bottom: 1px solid var(--line-soft);
    align-items: baseline;
  }
  .v3-lock-checks .check:last-child { border-bottom: 0; }
  .v3-lock-checks .check .check-marker {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 13px;
    line-height: 1;
  }
  .v3-lock-checks .check.check-ok .check-marker { color: var(--accent-deep); }
  .v3-lock-checks .check.check-fail .check-marker { color: var(--signal-halt); }
  /* Soft-absence rows are quieter - they're not failures, they're "could not
     confirm". Italic + muted matches the locked-observation tone elsewhere. */
  .v3-lock-checks .check.rel-soft-absence { color: var(--ink-faint); font-style: italic; }
  .v3-lock-checks .check.rel-soft-absence .check-marker { color: var(--ink-faint); }
  .v3-lock-checks .check.rel-inferred { font-style: italic; }
  /* Bolded fragments inside the check label (used for highlighting tracker
     names, fields, etc.) stay readable in the muted context. */
  .v3-lock-checks .check :global(b) { font-weight: 600; color: var(--ink); }
  .v3-lock .rel-tag.rel-inferred {
    font-family: var(--serif); font-style: italic;
    text-transform: none; letter-spacing: 0;
    font-size: 13px; color: var(--ink-dim);
  }
  @media (max-width: 1100px) {
    .v3-locks-grid { grid-template-columns: repeat(2, 1fr); }
    .v3-lock:nth-child(3n) { border-right: 1px solid var(--ink); }
    .v3-lock:nth-child(2n) { border-right: 0; }
    .v3-lock:nth-last-child(-n+3) { border-bottom: 1px solid var(--ink); }
    .v3-lock:nth-last-child(-n+2) { border-bottom: 0; }
  }
  @media (max-width: 600px) {
    .v3-locks-grid { grid-template-columns: 1fr; }
    .v3-lock { border-right: 0; }
    .v3-lock:nth-last-child(-n+2) { border-bottom: 1px solid var(--ink); }
    .v3-lock:last-child { border-bottom: 0; }
  }

  /* Prioritized-plan preview — the first 3 ranked fixes. */
  .plan-preview { padding-top: var(--sp-12); }
  .plan-preview .lab {
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--accent-deep); margin-bottom: var(--sp-5);
  }
  .plan-preview h2 {
    font-family: var(--grotesk); font-weight: 800;
    font-size: clamp(26px, 2.4vw, 36px); line-height: 1.15;
    letter-spacing: var(--track-display); margin: 0 0 var(--sp-4);
  }
  .plan-preview h2 .ital { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--ink-dim); }
  .plan-preview .plan-intro {
    font-family: var(--serif); font-style: italic;
    font-size: clamp(16px, 1.4vw, 19px); line-height: 1.55;
    color: var(--ink-dim); margin: 0 0 var(--sp-8); max-width: 640px;
  }
  .plan-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--ink); }
  .plan-item {
    display: flex; gap: var(--sp-6);
    padding: var(--sp-7); border-bottom: 1px solid var(--ink);
  }
  .plan-item:last-child { border-bottom: 0; }
  @media (max-width: 700px) {
    .plan-item { gap: var(--sp-5); padding: var(--sp-6) var(--sp-5); }
  }
  .plan-rank {
    font-family: var(--mono); font-size: 26px; font-weight: 500;
    color: var(--accent-deep); line-height: 1; flex-shrink: 0;
  }
  .plan-body { display: flex; flex-direction: column; gap: var(--sp-3); }
  .plan-body h3 {
    font-family: var(--grotesk); font-weight: 700;
    font-size: clamp(18px, 1.6vw, 22px); line-height: 1.2;
    letter-spacing: -0.02em; margin: 0; color: var(--ink); text-wrap: balance;
  }
  .plan-body p {
    font-family: var(--grotesk); font-size: 15px; line-height: 1.55;
    color: var(--ink-dim); margin: 0; max-width: 620px;
  }
  .plan-chips { display: flex; gap: var(--sp-3); flex-wrap: wrap; margin-top: var(--sp-2); }
  .plan-chips .chip {
    font-family: var(--mono); font-size: 10.5px;
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--ink-faint); border: 1px solid var(--line); padding: 4px 9px;
  }
  .plan-chips .chip b { color: var(--ink); font-weight: 500; }

  /* Related notes — three editorial cards keyed off the audit findings */
  .related-notes {
    margin-top: var(--sp-12);
    padding-top: var(--sp-10);
    border-top: 1px solid var(--line);
  }
  .related-notes .rn-lab {
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--accent-deep);
    margin-bottom: var(--sp-3);
  }
  .related-notes .rn-h {
    font-family: var(--grotesk); font-weight: 800;
    font-size: clamp(26px, 2.4vw, 36px); line-height: 1.15;
    letter-spacing: var(--track-display); margin: 0 0 var(--sp-7);
  }
  .related-notes .rn-h .ital {
    font-family: var(--serif); font-style: italic; font-weight: 400;
    color: var(--ink-dim);
  }
  .related-notes .rn-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--ink);
  }
  @media (max-width: 980px) { .related-notes .rn-grid { grid-template-columns: 1fr; } }
  .related-notes .rn-card {
    display: flex; flex-direction: column;
    padding: var(--sp-7);
    border-right: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition: background 120ms;
    min-height: 220px;
  }
  .related-notes .rn-card:last-child { border-right: 0; }
  @media (max-width: 980px) {
    .related-notes .rn-card { border-right: 0; border-bottom: 1px solid var(--ink); }
    .related-notes .rn-card:last-child { border-bottom: 0; }
  }
  .related-notes .rn-card:hover { background: var(--paper-2); }
  .related-notes .rn-title {
    font-family: var(--grotesk); font-weight: 700;
    font-size: 20px; line-height: 1.2;
    letter-spacing: -0.02em; color: var(--ink);
    margin: 0 0 var(--sp-3);
    text-wrap: balance;
  }
  .related-notes .rn-hook {
    font-family: var(--serif); font-style: italic;
    font-size: 14.5px; line-height: 1.5;
    color: var(--ink-dim);
    margin: 0 0 var(--sp-5);
    flex: 1;
  }
  .related-notes .rn-more {
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--accent-deep);
    margin-top: auto;
  }

  /* MRI soft-ramp link below the primary closer CTA */
  .ramp-ramp {
    margin: var(--sp-5) 0 0 !important;
    font-family: var(--mono);
    font-size: var(--t-meta);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--on-ink-italic) !important;
  }
  .ramp-ramp a {
    color: var(--accent) !important;
    text-decoration: none;
    border-bottom: 1px dotted var(--on-ink-line-2);
    padding-bottom: 1px;
  }
  .ramp-ramp a:hover {
    color: var(--on-ink) !important;
    border-bottom-color: var(--on-ink);
  }

  /* Footer CTA + bio */
  .closer {
    margin-top: var(--sp-12);
    background: var(--ink); color: var(--on-ink);
    padding: var(--sp-12) var(--sp-10);
    display: grid; grid-template-columns: 1.5fr 1fr;
    gap: var(--sp-10); align-items: end;
  }
  @media (max-width: 880px) {
    .closer { grid-template-columns: 1fr; padding: var(--sp-8) var(--sp-6); }
  }
  .closer h2 {
    font-family: var(--grotesk); font-weight: 800;
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1.05; letter-spacing: var(--track-display);
    margin: 0 0 var(--sp-5);
  }
  .closer h2 .ital { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--on-ink-italic); }
  .closer p { font-family: var(--grotesk); font-size: 15px; color: var(--on-ink-italic); line-height: 1.55; margin: 0 0 var(--sp-5); max-width: 480px; }
  .closer .actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; }
  .closer .sig {
    font-family: var(--mono); font-size: var(--t-meta);
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--on-ink-italic);
  }
  .closer .sig b { color: var(--on-ink); font-weight: 500; }

  /* Subtle defamation/legal footer */
  .legal-foot {
    margin-top: var(--sp-7);
    font-family: var(--mono); font-size: 11px;
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--ink-faint);
    text-align: center;
  }

  /* 404 layout when slug not found */
  .nf-wrap { max-width: 720px; margin: 0 auto; padding: var(--sp-14) var(--sp-8); }
  .nf-wrap h1 { font-family: var(--grotesk); font-weight: 800; font-size: clamp(40px, 5.4vw, 64px); line-height: 1; letter-spacing: var(--track-display); margin: var(--sp-6) 0; }
  .nf-wrap h1 .ital { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--ink-dim); }
  .nf-wrap p { font-family: var(--serif); font-style: italic; font-size: 20px; line-height: 1.5; color: var(--ink-dim); margin: 0 0 var(--sp-8); }

  /* Industry voice band — one verbatim Reddit quote pulled from the ICP research file. */
  .industry-voice {
    margin: var(--sp-10) 0 var(--sp-12);
    padding: var(--sp-8) var(--sp-10);
    background: var(--sage);
    border: 1px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }
  @media (max-width: 780px) {
    .industry-voice { padding: var(--sp-7) var(--sp-6); margin: var(--sp-8) 0 var(--sp-10); }
  }
  .industry-voice .iv-lab {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--accent-deep);
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .industry-voice .iv-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 999px;
  }
  .industry-voice .iv-ital {
    font-family: var(--serif);
    font-style: italic;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-dim);
    font-size: 13px;
  }
  .industry-voice .iv-quote {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.4;
    color: var(--ink);
    margin: 0;
    text-wrap: pretty;
    max-width: 820px;
  }
  .industry-voice .iv-attr {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: var(--track-mono);
    color: var(--ink-faint);
    text-transform: uppercase;
  }
  .industry-voice .iv-attr a {
    color: var(--accent-deep);
    text-decoration: none;
  }
  .industry-voice .iv-attr a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ============================================================
     GRADE CARD · v3.5 · letter grade + field-average benchmark
     Replaces the raw 21/27.5 composite display. Same dark shell,
     same 5-seg scale, same band line - only the centre changes.
     ============================================================ */
  .score-card .grade-row {
    display: flex; align-items: flex-end; gap: var(--sp-6);
    margin-top: var(--sp-2);
  }
  .score-card .grade {
    font-family: var(--grotesk); font-weight: 800;
    font-size: clamp(72px, 8vw, 92px); line-height: 0.9;
    letter-spacing: -0.05em; color: var(--on-ink);
  }
  .score-card .grade .sgn {
    font-size: 0.45em; color: var(--accent);
    vertical-align: 0.18em;
  }
  .score-card .grade.is-fail { color: var(--signal-halt); }
  .score-card .grade.is-fail .sgn { color: var(--signal-halt); }
  .score-card .bench {
    border-left: 1px solid var(--on-ink-line-2);
    padding-left: var(--sp-5);
    padding-bottom: var(--sp-2);
  }
  .score-card .bench .bk {
    display: block;
    font-family: var(--mono); font-size: 10.5px;
    letter-spacing: var(--track-mono); text-transform: uppercase;
    color: var(--on-ink-faint); margin-bottom: 6px;
  }
  .score-card .bench .bv {
    font-family: var(--grotesk); font-weight: 700;
    font-size: 15px; color: var(--on-ink);
  }
  .score-card .bench .bv .bg { color: var(--on-ink-italic); }

  /* ============================================================
     LOCK-AFFORDANCE COMPONENT · the canonical reveal gate.
     Reuses the existing "+" affordance. Three sizes:
       .lock-gate--cell  inside a finding cell
       .lock-gate--plan  plan items / combined plan gate
       .lock-gate--hero  hero strength
     Optional .lg-dots stage indicator for Variant C three-tap.
     ============================================================ */
  .lock-gate {
    position: relative;
    display: flex; align-items: center; gap: var(--sp-3);
    width: 100%;
    min-height: 48px;
    background: transparent;
    border: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--mono); font-size: 11px; letter-spacing: var(--track-mono);
    text-transform: uppercase; text-align: left;
    padding: 11px 13px;
    cursor: pointer;
    transition: background var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }
  .lock-gate:hover { background: var(--ink); color: var(--on-ink); }
  .lock-gate:focus-visible { outline: 2px solid var(--accent-deep); outline-offset: 2px; }

  /* "+" signifier - accent-deep on paper, flips to bright accent on the ink hover fill */
  .lock-gate .lg-plus {
    font-family: var(--grotesk); font-weight: 700; line-height: 1;
    color: var(--accent-deep); flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    transition: color var(--dur-1) var(--ease);
  }
  .lock-gate:hover .lg-plus { color: var(--accent); }
  .lock-gate .lg-label { flex: 1; padding-top: 1px; }

  /* trailing action arrow (hidden when stage dots are present) */
  .lock-gate .lg-go {
    font-family: var(--grotesk); font-weight: 600; line-height: 1;
    color: var(--accent-deep); flex-shrink: 0;
    transition: color var(--dur-1) var(--ease);
  }
  .lock-gate:hover .lg-go { color: var(--accent); }
  .lock-gate:has(.lg-dots) .lg-go { display: none; }

  /* stage progress (Variant C) - hollow rings that fill accent as you advance */
  .lock-gate .lg-dots { display: inline-flex; gap: 6px; flex-shrink: 0; }
  .lock-gate .lg-dots i {
    width: 7px; height: 7px; border-radius: var(--r-pill);
    background: transparent; border: 1px solid var(--line-strong);
    display: block;
    transition: background var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease);
  }
  .lock-gate .lg-dots i.on { background: var(--accent); border-color: var(--accent); }
  .lock-gate:hover .lg-dots i { border-color: var(--on-ink-line-2); }
  .lock-gate:hover .lg-dots i.on { background: var(--accent); border-color: var(--accent); }

  .lock-gate .lg-plus { font-size: 18px; width: 18px; height: 18px; }
  .lock-gate .lg-go { font-size: 14px; }

  .lock-gate--cell { margin-top: auto; margin-bottom: auto; }
  .lock-gate--plan .lg-plus { font-size: 20px; width: 20px; height: 20px; }
  .lock-gate--plan .lg-go { font-size: 15px; }
  .lock-gate--plan { margin-top: var(--sp-2); }
  .lock-gate--hero { margin-top: var(--sp-3); max-width: 380px; }
  .lock-gate--hero .lg-plus { font-size: 16px; width: 16px; height: 16px; }

  /* Whole locked block reads interactive */
  .v3-lock[data-gated] { cursor: pointer; }
  .plan-item[data-gated] { cursor: pointer; }

  /* Pulse on first paint - quiet accent wash on the gate, settles after ~10s */
  .lock-gate::after {
    content: ""; position: absolute; inset: 0;
    background: var(--accent); opacity: 0; pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    body.pulsing .lock-gate::after { animation: gate-pulse 2000ms var(--ease) infinite; }
  }
  @keyframes gate-pulse {
    0%, 100% { opacity: 0.04; }
    50% { opacity: 0.085; }
  }

  /* Reveal animation: fade + 8px slide-in. Honours reduced-motion. */
  @media (prefers-reduced-motion: no-preference) {
    .reveal-anim { animation: reveal-in var(--dur-2) var(--ease); }
  }
  @keyframes reveal-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  /* Freshly-revealed highlight - one 600ms accent border, fades out */
  @media (prefers-reduced-motion: no-preference) {
    .v3-lock.just-revealed,
    .plan-item.just-revealed { animation: fresh 600ms var(--ease); }
  }
  @keyframes fresh {
    0% { box-shadow: inset 0 0 0 2px var(--accent); }
    100% { box-shadow: inset 0 0 0 2px transparent; }
  }

  /* ===== Gated finding cells: hide the verdict block until revealed ===== */
  .v3-lock[data-gated] .reading,
  .v3-lock[data-gated] .reading-k,
  .v3-lock[data-gated] .obs,
  .v3-lock[data-gated] .rel-tag,
  .v3-lock[data-gated] .v3-lock-expand-toggle,
  .v3-lock[data-gated] .v3-lock-checks { display: none; }

  /* In a gated cell the reliability tag drops its push-to-bottom so the
     gate stays the last element */
  .v3-lock[data-gated] .rel-tag { margin-top: var(--sp-4); }

  /* Three-stage progressive reveal (Variant C). Variant B uses one-tap
     full reveal so it removes the data-gated attr entirely. */
  .v3-lock[data-gated][data-stage="1"] .reading,
  .v3-lock[data-gated][data-stage="1"] .reading-k,
  .v3-lock[data-gated][data-stage="2"] .reading,
  .v3-lock[data-gated][data-stage="2"] .reading-k,
  .v3-lock[data-gated][data-stage="3"] .reading,
  .v3-lock[data-gated][data-stage="3"] .reading-k { display: block; }
  .v3-lock[data-gated][data-stage="2"] .obs,
  .v3-lock[data-gated][data-stage="2"] .rel-tag,
  .v3-lock[data-gated][data-stage="3"] .obs,
  .v3-lock[data-gated][data-stage="3"] .rel-tag { display: block; }
  .v3-lock[data-gated][data-stage="3"] .v3-lock-checks { display: block; }

  /* Gate hides once the cell is fully revealed (Variant C: stage 3) */
  .v3-lock[data-gated][data-stage="3"] .lock-gate--cell { display: none; }
  .v3-lock[data-gated][data-stage="3"] { cursor: default; }

  /* ===== Gated plan items (Variant B: items 2 + 3) ===== */
  .plan-item[data-gated] .plan-body { display: none; }

  /* ===== Combined plan gate (Variant C only) ===== */
  .plan-gate-wrap { display: none; }
  body.variant-c .plan-preview[data-gated] .plan-list { display: none; }
  body.variant-c .plan-preview[data-gated] .plan-gate-wrap { display: block; }

  /* ===== Gated hero strength (Variant C only) ===== */
  .hero .strength[data-gated] .s-text { display: none; }

  /* ===== Competitor contrast ===== */
  .contrast-sec { margin: 64px 0 0; }
  .contrast-head h2 { font-size: 1.4rem; margin: 0 0 6px; }
  .contrast-ai { color: var(--ink-dim, #5c574b); font-style: italic; margin: 0 0 18px; max-width: 62ch; }
  .contrast-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .contrast-card { border: 1px solid var(--line-2, #e2ddd2); border-radius: 10px; padding: 16px 18px; }
  .contrast-card header strong { font-size: 1.05rem; }
  .c-domain { display: inline-block; margin-left: 8px; font-family: var(--mono, monospace); font-size: 0.75rem; color: var(--ink-faint, #8a8270); }
  .c-reason { margin: 4px 0 0; font-size: 0.82rem; color: var(--ink-dim, #5c574b); }
  .c-rows { list-style: none; margin: 12px 0 0; padding: 0; }
  .c-rows li { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-top: 1px solid var(--line-2, #eee9de); font-size: 0.88rem; }
  .c-them { font-variant-numeric: tabular-nums; font-weight: 600; text-align: right; }
  .contrast-note { margin-top: 14px; font-size: 0.75rem; color: var(--ink-faint, #8a8270); max-width: 70ch; }
</style>
</head>
<body class={`variant-${VARIANT}`}>
{cached && memo && heroData ? (
  <main class="page">
    <header class="top">
      <div class="left">
        <a class="wordmark" href="/">rivett<span class="dot-mark">.</span></a>
        <span>· Teardown · {cached.hostname}</span>
      </div>
      <span>{fetchedAtDisplay}</span>
    </header>

    <section class="hero">
      <div class="hero-text">
        <div class="hero-meta-row">
          <span>Domain · <b>{cached.hostname}</b></span>
          {companyName && companyName !== cached.hostname ? <span>Company · <b>{companyName}</b></span> : null}
          <span>Scan · <b>9 of 9</b></span>
        </div>

        <div class="kicker">Diagnosis</div>
        <p class="lede">{heroData.pageHero}</p>

        {heroData.strength ? (
          <div
            class="strength"
            id="heroStrength"
            data-gated={VARIANT === 'c' ? '' : undefined}
          >
            <span class="s-lab">What's working</span>
            <p class="s-text">{heroData.strength}</p>
            {VARIANT === 'c' ? (
              <button type="button" class="lock-gate lock-gate--hero" aria-expanded="false">
                <span class="lg-plus" aria-hidden="true">+</span>
                <span class="lg-label">{HERO_OPENER}</span>
                <span class="lg-go" aria-hidden="true">→</span>
              </button>
            ) : null}
          </div>
        ) : null}

        <div class="cta-block">
          <a class="btn btn--pri" href={CAL_URL} data-cta="memo_book_call" data-cta-location="memo_hero">Book 30 min with Fred <span aria-hidden="true">→</span></a>
          <p class="cta-trust">Thirty minutes with Fred. We walk through your audit, not a slide deck.</p>
        </div>
      </div>

      {/* Grade-card · v3.5 · letter grade + field-average benchmark.
         Replaces the raw 21/27.5 composite. Spec: grade-score-brief.md.
         The grade is always visible (even in Variant C of the reveal test):
         it is the hook that pulls the reader into revealing the cells. */}
      {/* 2026-06-10 credibility fixes (Move 1, see AI-HQ design brief): the
          "Field average" benchmark was a hardcoded constant presented as a
          peer comparison, and "v3.4" shipped our engine version to buyers.
          Both were red-team kill shots. The letter stands on its own. */}
      <aside
        class="score-card"
        id="scoreCard"
        role="img"
        aria-label={`The read: grade ${SCORE_GRADE.label.replace('+', ' plus').replace('-', ' minus')}.`}
      >
        <span class="lab" aria-hidden="true">The read</span>
        <div class="grade-row" aria-hidden="true">
          <span class={`grade ${SCORE_GRADE.tier === 'fail' ? 'is-fail' : ''}`.trim()}>
            {SCORE_GRADE.base}{SCORE_GRADE.sign ? <span class="sgn">{SCORE_GRADE.sign === '-' ? '−' : SCORE_GRADE.sign}</span> : null}
          </span>
        </div>
        <div class="band" aria-hidden="true">{bandLabel(scorePercent)}</div>
        <div class="scale" aria-hidden="true">
          {scoreSegs.map((cls) => <div class={`seg ${cls}`.trim()}></div>)}
        </div>
      </aside>
    </section>

    {heroQuote ? (
      <section class="industry-voice" aria-label="What operators in your industry are saying">
        <div class="iv-lab">
          <span class="iv-dot"></span>
          Operators in {icpEntry?.label ?? 'your industry'} <span class="iv-ital">are saying this.</span>
        </div>
        <blockquote class="iv-quote">{heroQuote.quote}</blockquote>
        <div class="iv-attr">
          {heroQuote.source_url ? (
            <a href={heroQuote.source_url} target="_blank" rel="noopener noreferrer">{heroQuote.attribution} <span aria-hidden="true">→</span></a>
          ) : (
            <span>{heroQuote.attribution}</span>
          )}
        </div>
      </section>
    ) : null}

    <section class="locked-section">
      <div class="lab">The full read · all 9 findings</div>
      <h2>What the audit <span class="ital">found.</span></h2>
      <div class="v3-locks-grid">
        {verdictCells.map((cell, idx) => {
          const value = (cell.value ?? '').trim();
          const isUnmeasured = value === '' || value.toLowerCase() === 'n/a';
          const meta = lockedMeta(cell.icon);
          const tone = deriveTone(cell);
          const cellNumber = idx + 1;
          const isGated = cellIsGated(cellNumber, VARIANT);
          return (
            <article
              class="v3-lock"
              tabindex="0"
              data-cell={cellNumber}
              data-dimension={cell.icon}
              data-gated={isGated ? '' : undefined}
              data-stage={isGated ? '0' : undefined}
            >
              <div class="lhead">
                <span class="v3-lock-ic" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="24" height="24" set:html={LOCK_ICON[cell.icon] ?? LOCK_ICON.search} />
                </span>
                <span class="dcode">D · <b>{DIM_CODE[cell.icon] ?? '·'}</b></span>
              </div>
              <h3>{meta.shortLabel}</h3>
              {isUnmeasured ? (
                <div class="reading-unmeasured">The public scan couldn't reach this one. We measure it together on the call.</div>
              ) : (
                <Fragment>
                  <div class={`reading ${tone === 'none' ? '' : tone}`.trim()}>{cell.value}</div>
                  <div class="reading-k">{meta.valueLabel}</div>
                </Fragment>
              )}
              <p class="obs">{cell.note}</p>
              {cell.reliability ? (
                <div class={`rel-tag rel-${cell.reliability}`}>{REL_LABEL[cell.reliability] ?? cell.reliability}</div>
              ) : null}
              {/* Upgrade 12 - per-cell expand. Reveals the underlying check list
                  so prospects can verify what was measured without breaking the
                  locked-observation interpretation up top. data-cta lets PostHog
                  track which dimensions each prospect drilled into - the only
                  signal we have for "which findings do they care about". */}
              {cell.checks && cell.checks.length > 0 ? (
                <Fragment>
                  <button
                    type="button"
                    class="v3-lock-expand-toggle"
                    data-cta={`cell_expand_${cell.icon}`}
                    data-cta-location="memo_cell"
                    aria-expanded="false"
                    aria-controls={`cell-checks-${cell.icon}`}
                  >
                    <span class="toggle-text">Show {cell.checks.length} signal{cell.checks.length === 1 ? '' : 's'}</span>
                    <span class="toggle-icon" aria-hidden="true">+</span>
                  </button>
                  <div class="v3-lock-checks" id={`cell-checks-${cell.icon}`} hidden>
                    <ul>
                      {cell.checks.map((check) => (
                        <li class={`check ${check.ok ? 'check-ok' : 'check-fail'} rel-${check.reliability ?? 'verified'}`}>
                          <span class="check-marker" aria-hidden="true">{check.ok ? '✓' : '×'}</span>
                          <span class="check-text" set:html={check.text} />
                        </li>
                      ))}
                    </ul>
                  </div>
                </Fragment>
              ) : null}
              {isGated ? (
                <button
                  type="button"
                  class="lock-gate lock-gate--cell"
                  aria-expanded="false"
                  aria-controls={`cell-checks-${cell.icon}`}
                >
                  <span class="lg-plus" aria-hidden="true">+</span>
                  <span class="lg-label">{CELL_OPENER[cellNumber] ?? 'Tap to reveal'}</span>
                  <span class="lg-go" aria-hidden="true">→</span>
                  {VARIANT === 'c' ? (
                    <span class="lg-dots" aria-hidden="true">
                      <i></i><i></i><i></i>
                    </span>
                  ) : null}
                </button>
              ) : null}
            </article>
          );
        })}
      </div>
    </section>

    {contrastData ? (
      <section class="contrast-sec" aria-label="How you stack up">
        <div class="contrast-head">
          <h2>How you stack up</h2>
          <p class="contrast-ai">{contrastData.aiLine}</p>
        </div>
        <div class="contrast-grid">
          {contrastData.competitors.map((c) => (
            <article class="contrast-card">
              <header>
                <strong>{c.name}</strong>
                <span class="c-domain">{c.domain}</span>
                {c.aiReason && <p class="c-reason">{c.aiReason}</p>}
              </header>
              <ul class="c-rows">
                {c.adsTotal != null && (
                  <li>
                    <span>Active ads</span>
                    <span class="c-them">{c.adsTotal}{c.adsBreakdown ? ` (${c.adsBreakdown})` : ''}</span>
                  </li>
                )}
                {c.indexedPages != null && (
                  <li><span>Pages Google can find</span><span class="c-them">{c.indexedPages}</span></li>
                )}
                {c.emailAuthOk != null && (
                  <li><span>Email authentication</span><span class="c-them">{c.emailAuthOk ? 'In place' : 'Missing'}</span></li>
                )}
                {c.llmsTxt != null && (
                  <li><span>Readable by AI search</span><span class="c-them">{c.llmsTxt ? 'Yes (llms.txt)' : 'No llms.txt'}</span></li>
                )}
                {c.hasBookingPath != null && (
                  <li><span>Way to book or call on homepage</span><span class="c-them">{c.hasBookingPath ? 'Yes' : 'None found'}</span></li>
                )}
              </ul>
            </article>
          ))}
        </div>
        <p class="contrast-note">Competitor figures are a partial scan ({new Date(contrastData.generatedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}) across the same public checks used above. Your full audit is the grid you just read.</p>
      </section>
    ) : (
      <div
        id="contrast-primer"
        data-slug={slug}
        style="display:none"
      ></div>
    )}

    {topFixes.length ? (
      <section class="plan-preview" id="planPreview">
        <div class="lab">Where I'd start · the fix order</div>
        <h2>The first <span class="ital">three moves.</span></h2>
        <p class="plan-intro">Ranked by what returns the most for the least work. The rest of the order, and the revenue math behind the ranking, is what the call is for.</p>
        {/* Combined gate slot - injected by variant C only; sits above the list */}
        <div class="plan-gate-wrap" id="planGateWrap"></div>
        <ol class="plan-list">
          {topFixes.map((fix, fIdx) => (
            <li class="plan-item" data-plan={fIdx + 1}>
              <span class="plan-rank">{String(fix.rank).padStart(2, '0')}</span>
              <div class="plan-body">
                <h3>{fix.what}</h3>
                <p>{fix.why}</p>
                <div class="plan-chips">
                  <span class="chip">Effort · <b>{fix.effort}</b></span>
                  <span class="chip">Impact · <b>{fix.impact}</b></span>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ) : null}

    {relatedNotes.length > 0 ? (
      <section class="related-notes">
        <div class="rn-lab">What to read next · related to this audit</div>
        <h2 class="rn-h">Three notes <span class="ital">on the gaps this audit found.</span></h2>
        <div class="rn-grid">
          {relatedNotes.map((n) => (
            <a
              class="rn-card"
              href={`/blog/${n.slug}`}
              data-cta="memo_related"
              data-cta-location="memo_footer"
              data-content-slug={n.slug}
              target="_blank"
              rel="noopener"
            >
              <h3 class="rn-title">{n.title}</h3>
              <p class="rn-hook">{n.hook}</p>
              <span class="rn-more">Read note <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </section>
    ) : null}

    <section class="closer">
      <div>
        <div style="font-family: var(--mono); font-size: var(--t-meta); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--accent); margin-bottom: var(--sp-3);">● 30 min · no deck</div>
        <h2>
          Pick a time.<br/>
          <span class="ital">We go through the fix order together.</span>
        </h2>
        <p>You've seen all nine findings and the first three moves. The call is the rest of the order, the revenue math behind the ranking, and the things a browser scan can't reach: your pipeline, your follow-up, your numbers.</p>
        <div class="actions">
          <a class="btn btn--inv" href={CAL_URL} data-cta="memo_book_call" data-cta-location="memo_closer">Book a call <span aria-hidden="true">→</span></a>
          <a class="btn btn--sec" href="/audit/v3" style="border-color: var(--on-ink-line-2); color: var(--on-ink);" data-cta="memo_audit_another" data-cta-location="memo_closer">Audit another domain</a>
        </div>
        <p class="ramp-ramp">
          <a href="/revenue-leak-mri" data-cta="memo_to_mri" data-cta-location="memo_closer">Or run the Revenue Leak MRI yourself first <span aria-hidden="true">→</span></a>
        </p>
      </div>
      <div class="sig">
        <span style="display:block; color: var(--accent); margin-bottom: var(--sp-2);">● Signature</span>
        <b>Fred Style</b> · rivett.tech · {fetchedAtDisplay.split(' ')[0]}
        <p style="font-family: var(--serif); font-style: italic; font-size: 14px; line-height: 1.5; margin-top: var(--sp-5); color: var(--on-ink-italic); max-width: 360px;">Live in-browser scan. Not a formal assessment. The audit reads the public surface of a domain in your browser. It does not access authenticated dashboards, customer data, or anything behind a login.</p>
      </div>
    </section>

    <p class="legal-foot">rivett.tech · {fetchedAtDisplay.split(' ')[0]}</p>
  </main>
) : (
  <div class="nf-wrap">
    <span class="kicker" style="font-family: var(--mono); font-size: var(--t-meta); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--accent-deep);">Cached audit · {kvError === 'invalid' ? 'invalid slug' : kvError === 'kv_failed' ? 'kv error' : 'not found'}</span>
    <h1>No cached run for <span class="ital">that slug.</span></h1>
    <p>The cache holds audits for 14 days. After that, or if no audit has ever been run for this domain on this build, the URL returns 404. Paste the domain into the live audit form to generate a fresh one.</p>
    <p style="font-style: normal; font-family: var(--mono); font-size: 13px; color: var(--ink-faint);">Slug attempted: <span style="background: var(--paper-2); padding: 4px 8px; border: 1px solid var(--line);">{slug}</span></p>
    <div style="display: flex; gap: var(--sp-3); flex-wrap: wrap;">
      <a class="btn btn--pri" href="/audit/v3">Run a fresh audit <span aria-hidden="true">→</span></a>
      <a class="btn btn--sec" href={CAL_URL}>Book a call</a>
    </div>
  </div>
)}

{/* Audit v3 page controller · merges three responsibilities into a single
    IIFE so they share state (variant, T0, events) without globals:
      1. Variant assignment (Test 1: progressive reveal A/B/C)
      2. Reveal interactions (cell three-stage for C, single-tap for B,
         hero-strength gate for C, plan gates for B and combined for C)
      3. Engagement instrumentation (memo_rendered, section_viewed,
         scroll_depth, dwell, form_view, verdict_expanded, cell_revealed,
         strength_revealed, plan_revealed)
    The variant ID flows through to every event as a property AND is
    registered as a super-property on first identify so PostHog cohorting
    by variant is single-line. */}
<script is:inline define:vars={{
  slug,
  hostname: cached?.hostname || '',
  scorePercent,
  scoreGradeLabel: SCORE_GRADE.label,
  fieldAvgGradeLabel: FIELD_AVG_GRADE.label,
  fieldAvgNumeric: FIELD_AVG_NUMERIC,
}}>
(function () {
  'use strict';

  // Prime competitor-contrast generation when the section hasn't been built
  // yet. Fire-and-forget; the ~15s build happens server-side and caches, so
  // the section exists for the next view. Never blocks or reflows this view.
  var primer = document.getElementById('contrast-primer');
  if (primer && primer.dataset.slug) {
    try {
      fetch('/api/audit/v3/competitors/' + primer.dataset.slug, { method: 'GET', keepalive: true }).catch(function () {});
    } catch (e) {}
  }

  var T0 = (window.performance && performance.now) ? performance.now() : Date.now();
  var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var pulseTimer = null;
  var freshTimer = null;

  // Per-cell microcopy. Index matches the cell's data-cell value (1-9), which
  // mirrors the verdictCells render order. Each cell carries three labels so
  // Variant C's three-tap progression has unique copy per stage.
  var COPY = {
    1: { opener: 'Tap for the index read',     mid: 'And the gaps',          deep: 'Show the signals' },
    2: { opener: 'Tap for the citation read',  mid: 'And what reads it',     deep: 'Show the signals' },
    3: { opener: 'Tap for the speed score',    mid: 'Where it drags',        deep: 'Show the signals' },
    4: { opener: "Tap for what's tracking",    mid: "What I couldn't confirm", deep: 'Show the signals' },
    5: { opener: 'Tap for the ad count',       mid: 'Where I read it',       deep: 'Show the signals' },
    6: { opener: 'Tap for the path read',      mid: 'Why that one stings',   deep: 'Show the signals' },
    7: { opener: 'Tap for the mobile read',    mid: 'The two that bite',     deep: 'Show the signals' },
    8: { opener: 'Tap for the auth read',      mid: 'Where the gap is',      deep: 'Show the signals' },
    9: { opener: 'Tap for the stack count',    mid: 'What I caught',         deep: 'Show the signals' }
  };
  var PLAN_COPY = { 2: 'Tap for fix 02', 3: 'Tap for fix 03', combined: 'Tap for the first three moves' };
  var HERO_COPY = 'Tap to see what I found';

  // ===== Variant resolution: ?v= wins, then rivett_variant cookie, default A
  function readCookie(name) {
    var m = document.cookie.match('(?:^|; )' + name + '=([^;]*)');
    return m ? decodeURIComponent(m[1]) : null;
  }
  function resolveVariant() {
    // 2026-06-10: reveal-gate experiment ENDED (Move 1). The client used to
    // re-resolve ?v=/cookie here and rebuild gating even when the server
    // rendered ungated. Everyone gets the ungated page; the page-level A/B
    // is now /audit/v3 vs /audit/b.
    return 'a';
  }
  var VARIANT = resolveVariant();
  document.body.classList.add('variant-' + VARIANT);

  // Register variant + score_grade as PostHog super-properties so they
  // attach to every event fired on this page (including autocapture
  // cta_clicked, $pageview, $autocapture, etc.) without us having to pass
  // them through every track() call. The track() helper still passes them
  // explicitly as a belt-and-braces for events fired before posthog loads.
  try {
    if (window.posthog && typeof window.posthog.register === 'function') {
      window.posthog.register({
        variant: VARIANT.toUpperCase(),
        score_grade: scoreGradeLabel,
        score_numeric: scorePercent,
      });
    } else {
      // posthog may not be loaded yet (script async). Try again in 500ms.
      setTimeout(function () {
        if (window.posthog && typeof window.posthog.register === 'function') {
          window.posthog.register({
            variant: VARIANT.toUpperCase(),
            score_grade: scoreGradeLabel,
            score_numeric: scorePercent,
          });
        }
      }, 500);
    }
  } catch (e) {}

  // ===== Tracking =====
  // Uses window.rivett.track from PostHog.astro when available; falls back
  // to a no-op so analytics never breaks the page.
  function track(name, props) {
    var payload = Object.assign({
      slug: slug,
      hostname: hostname,
      variant: VARIANT.toUpperCase(),
      score_grade: scoreGradeLabel,
      score_numeric: scorePercent,
      field_avg_grade: fieldAvgGradeLabel,
      field_avg_numeric: fieldAvgNumeric,
    }, props || {});
    try {
      if (window.rivett && typeof window.rivett.track === 'function') {
        window.rivett.track(name, payload);
      } else if (window.posthog && typeof window.posthog.capture === 'function') {
        window.posthog.capture(name, payload);
      }
    } catch (e) {}
  }
  function sinceLoad() {
    var now = (window.performance && performance.now) ? performance.now() : Date.now();
    return Math.round(now - T0);
  }

  // ===== Animation helpers =====
  function animateIn(el) {
    if (!el || prefersReduced) return;
    el.classList.remove('reveal-anim');
    void el.offsetWidth;
    el.classList.add('reveal-anim');
    setTimeout(function () { el.classList.remove('reveal-anim'); }, 280);
  }
  function flashFresh(node) {
    if (prefersReduced || !node) return;
    document.querySelectorAll('.just-revealed').forEach(function (n) { n.classList.remove('just-revealed'); });
    node.classList.add('just-revealed');
    clearTimeout(freshTimer);
    freshTimer = setTimeout(function () { node.classList.remove('just-revealed'); }, 640);
  }

  // ===== Lock-gate factory =====
  function makeGate(kind, opts) {
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'lock-gate lock-gate--' + kind;
    btn.setAttribute('aria-expanded', 'false');
    if (opts.controls) btn.setAttribute('aria-controls', opts.controls);
    var plus = document.createElement('span');
    plus.className = 'lg-plus';
    plus.setAttribute('aria-hidden', 'true');
    plus.textContent = '+';
    btn.appendChild(plus);
    var label = document.createElement('span');
    label.className = 'lg-label';
    label.textContent = opts.label;
    btn.appendChild(label);

    var go = document.createElement('span');
    go.className = 'lg-go';
    go.setAttribute('aria-hidden', 'true');
    go.textContent = '→';
    btn.appendChild(go);

    if (opts.stages) {
      var dots = document.createElement('span');
      dots.className = 'lg-dots';
      dots.setAttribute('aria-hidden', 'true');
      for (var i = 0; i < opts.stages; i += 1) dots.appendChild(document.createElement('i'));
      btn.appendChild(dots);
      btn._dots = dots;
    }
    btn._label = label;
    return btn;
  }
  function setGateStage(gate, reached) {
    if (!gate || !gate._dots) return;
    var dots = gate._dots.querySelectorAll('i');
    for (var i = 0; i < dots.length; i += 1) dots[i].classList.toggle('on', i < reached);
  }

  // ===== Build gated state for the active variant =====
  function build(v) {
    if (v === 'a') return; // control: nothing gated

    // Finding cells.
    //   Variant B: cells 4-9 gated, single-tap full reveal.
    //   Variant C: all 9 gated, three-stage reveal.
    // Server-rendering note: the Astro template now emits data-gated +
    // data-stage="0" + the gate <button> directly. If we see that, skip
    // re-gating client-side (would duplicate the button). The block below
    // is the fallback for any path that still arrives without server gates.
    document.querySelectorAll('.v3-lock').forEach(function (cell) {
      if (cell.hasAttribute('data-gated')) return; // already gated server-side
      var idx = parseInt(cell.getAttribute('data-cell'), 10);
      var copy = COPY[idx] || {};
      var gated = (v === 'c') || (v === 'b' && idx >= 4);
      if (!gated) return;
      cell.setAttribute('data-gated', '');
      cell.setAttribute('data-stage', '0');
      var gate = makeGate('cell', {
        label: copy.opener || 'Tap to reveal the verdict',
        stages: v === 'c' ? 3 : 0,
        controls: 'cell-checks-' + idx
      });
      cell.appendChild(gate);
    });

    // Hero strength (Variant C only).
    if (v === 'c') {
      var strength = document.getElementById('heroStrength');
      if (strength && !strength.hasAttribute('data-gated')) {
        strength.setAttribute('data-gated', '');
        strength.appendChild(makeGate('hero', { label: HERO_COPY, stages: 0 }));
      }
    }

    // Plan preview.
    //   Variant B: items 2 + 3 gated individually.
    //   Variant C: whole list gated behind a single combined gate.
    var plan = document.getElementById('planPreview');
    if (v === 'b' && plan) {
      [2, 3].forEach(function (n) {
        var item = plan.querySelector('.plan-item[data-plan="' + n + '"]');
        if (!item) return;
        item.setAttribute('data-gated', '');
        item.appendChild(makeGate('plan', { label: PLAN_COPY[n], stages: 0 }));
      });
    }
    if (v === 'c' && plan) {
      plan.setAttribute('data-gated', '');
      var wrap = document.getElementById('planGateWrap');
      if (wrap) wrap.appendChild(makeGate('plan', { label: PLAN_COPY.combined, stages: 0, controls: 'planList' }));
    }

    // Pulse the gates for ~10s on first paint so the affordance is discoverable.
    if (!prefersReduced) {
      document.body.classList.add('pulsing');
      pulseTimer = setTimeout(function () { document.body.classList.remove('pulsing'); }, 10000);
    }
  }

  // ===== Reveal actions =====
  function advanceCell(cell) {
    var idx = parseInt(cell.getAttribute('data-cell'), 10);
    var dim = cell.getAttribute('data-dimension');
    var copy = COPY[idx] || {};
    var gate = cell.querySelector('.lock-gate--cell');

    if (VARIANT === 'b') {
      cell.removeAttribute('data-gated');
      cell.removeAttribute('data-stage');
      if (gate) gate.remove();
      ['.reading', '.reading-k', '.obs', '.rel-tag', '.v3-lock-expand-toggle'].forEach(function (s) {
        animateIn(cell.querySelector(s));
      });
      flashFresh(cell);
      track('audit_v3_cell_revealed', {
        dimension: dim,
        cell_index: idx,
        reveal_stage: 1,
        time_since_load_ms: sinceLoad(),
      });
      return;
    }

    // Variant C: three stages
    var stage = parseInt(cell.getAttribute('data-stage'), 10);
    if (stage >= 3) return;
    var next = stage + 1;
    cell.setAttribute('data-stage', String(next));
    if (gate) {
      setGateStage(gate, next);
      gate.setAttribute('aria-expanded', next >= 3 ? 'true' : 'false');
    }
    if (next === 1) {
      animateIn(cell.querySelector('.reading'));
      animateIn(cell.querySelector('.reading-k'));
      if (gate) gate._label.textContent = copy.mid || 'Tap for the note';
    } else if (next === 2) {
      animateIn(cell.querySelector('.obs'));
      animateIn(cell.querySelector('.rel-tag'));
      if (gate) gate._label.textContent = copy.deep || 'Show the signals';
    } else if (next === 3) {
      var checks = cell.querySelector('.v3-lock-checks');
      if (checks) { checks.hidden = false; animateIn(checks); }
    }
    flashFresh(cell);
    track('audit_v3_cell_revealed', {
      dimension: dim,
      cell_index: idx,
      reveal_stage: next,
      time_since_load_ms: sinceLoad(),
    });
  }

  function revealStrength() {
    var strength = document.getElementById('heroStrength');
    if (!strength || !strength.hasAttribute('data-gated')) return;
    strength.removeAttribute('data-gated');
    var gate = strength.querySelector('.lock-gate--hero');
    if (gate) gate.remove();
    animateIn(strength.querySelector('.s-text'));
    track('audit_v3_strength_revealed', { time_since_load_ms: sinceLoad() });
  }

  function revealPlanItem(item) {
    if (!item.hasAttribute('data-gated')) return;
    item.removeAttribute('data-gated');
    var gate = item.querySelector('.lock-gate--plan');
    if (gate) gate.remove();
    animateIn(item.querySelector('.plan-body'));
    flashFresh(item);
    track('audit_v3_plan_revealed', {
      plan_item: parseInt(item.getAttribute('data-plan'), 10),
      time_since_load_ms: sinceLoad(),
    });
  }

  function revealPlanAll() {
    var plan = document.getElementById('planPreview');
    if (!plan || !plan.hasAttribute('data-gated')) return;
    plan.removeAttribute('data-gated');
    animateIn(plan.querySelector('.plan-list'));
    track('audit_v3_plan_revealed', { plan_item: 'all', time_since_load_ms: sinceLoad() });
  }

  function handleVerdictToggle(btn) {
    var expanded = btn.getAttribute('aria-expanded') === 'true';
    var target = document.getElementById(btn.getAttribute('aria-controls'));
    if (!target) return;
    btn.setAttribute('aria-expanded', String(!expanded));
    target.hidden = expanded;
    if (!expanded) animateIn(target);
    var textEl = btn.querySelector('.toggle-text');
    if (textEl) {
      var count = target.querySelectorAll('li').length;
      textEl.textContent = expanded ? ('Show ' + count + ' signal' + (count === 1 ? '' : 's')) : 'Hide';
    }
    if (!expanded) {
      var cell = btn.closest('.v3-lock');
      var dim = cell ? cell.getAttribute('data-dimension') : null;
      track('audit_v3_verdict_expanded', { dimension: dim });
    }
  }

  // Single delegated click handler. Buttons fire click on Enter/Space natively,
  // so keyboard is covered. Order matters: more-specific selectors first.
  document.addEventListener('click', function (e) {
    var t = e.target;
    if (!t || !t.closest) return;

    var toggle = t.closest('.v3-lock-expand-toggle');
    if (toggle) { e.stopPropagation(); handleVerdictToggle(toggle); return; }

    var heroGate = t.closest('.lock-gate--hero');
    if (heroGate) { revealStrength(); return; }

    var planGate = t.closest('.plan-gate-wrap .lock-gate--plan');
    if (planGate) { revealPlanAll(); return; }

    var planItem = t.closest('.plan-item[data-gated]');
    if (planItem) { revealPlanItem(planItem); return; }

    var cell = t.closest('.v3-lock[data-gated]');
    if (cell) { advanceCell(cell); return; }
  });

  // ===== Build now =====
  build(VARIANT);

  // ===== Engagement instrumentation =====
  // memo_rendered fires once on first paint, carrying the grade + score
  // properties so downstream cohorting can segment by letter grade.
  track('audit_v3_memo_rendered', { url: window.location.href });

  // section_viewed via IntersectionObserver, one fire per section
  var SECTION_MAP = [
    ['.hero', 'hero'],
    ['.industry-voice', 'industry_voice'],
    ['.locked-section', 'findings'],
    ['.plan-preview', 'plan_preview'],
    ['.related-notes', 'related_notes'],
    ['.closer', 'closer'],
  ];
  var seenSections = new Set();
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var name = entry.target.getAttribute('data-section');
        if (!name || seenSections.has(name)) return;
        seenSections.add(name);
        track('audit_v3_section_viewed', { section: name });
        io.unobserve(entry.target);
      });
    }, { threshold: 0.4 });
    SECTION_MAP.forEach(function (pair) {
      var el = document.querySelector(pair[0]);
      if (el) {
        el.setAttribute('data-section', pair[1]);
        io.observe(el);
      }
    });
  }

  // scroll_depth at 25/50/75/100
  var depths = [25, 50, 75, 100];
  var depthsHit = new Set();
  function onScroll() {
    var doc = document.documentElement;
    var max = Math.max(1, (doc.scrollHeight - doc.clientHeight));
    var pct = Math.min(100, Math.round((window.scrollY / max) * 100));
    for (var i = 0; i < depths.length; i += 1) {
      var d = depths[i];
      if (pct >= d && !depthsHit.has(d)) {
        depthsHit.add(d);
        track('audit_v3_scroll_depth', { depth: d });
      }
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // dwell ladder, active-time only (visibilitychange + focus/blur gated)
  var activeMs = 0;
  var tickStart = (document.hasFocus() && !document.hidden) ? Date.now() : 0;
  var ladders = [30, 60, 120, 300];
  var laddersHit = new Set();
  function flushTick() {
    if (tickStart) {
      activeMs += (Date.now() - tickStart);
      tickStart = 0;
    }
    var seconds = Math.floor(activeMs / 1000);
    for (var i = 0; i < ladders.length; i += 1) {
      var l = ladders[i];
      if (seconds >= l && !laddersHit.has(l)) {
        laddersHit.add(l);
        track('audit_v3_dwell', { seconds: l });
      }
    }
  }
  function resumeTick() {
    if (!tickStart && document.hasFocus() && !document.hidden) tickStart = Date.now();
  }
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) flushTick(); else resumeTick();
  });
  window.addEventListener('focus', resumeTick);
  window.addEventListener('blur', flushTick);
  window.addEventListener('beforeunload', flushTick);
  setInterval(flushTick, 5000);

  // form_view = reaching the closer CTA (no email-capture form on this page)
  var closer = document.querySelector('.closer');
  if (closer && 'IntersectionObserver' in window) {
    var ctaSeen = false;
    var ctaIo = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting && !ctaSeen) {
          ctaSeen = true;
          track('audit_v3_form_view', {});
          ctaIo.disconnect();
        }
      });
    }, { threshold: 0.3 });
    ctaIo.observe(closer);
  }
})();
</script>

</body>
</html>
