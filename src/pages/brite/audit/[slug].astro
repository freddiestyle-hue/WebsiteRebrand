---
export const prerender = false;

import { Redis } from '@upstash/redis';
import PostHog from '../../../components/PostHog.astro';
import { BRITE_ROLES, roleById } from '../../../data/brite-roles';
import { confidenceCopy, findingLead } from '../../../utils/audit/brite-confidence';
import { MemoSchema, type BriteRole, type Memo } from '../../../utils/audit/memo-schema';
import { sanitizeMemoHtml } from '../../../utils/audit/safe-html';
import { isValidSlug } from '../../../utils/audit/slug';

const DEFAULT_CTA_URL = 'https://calendly.com/incrementum-team/45-minite-call';

const rawSlug = Astro.params.slug ?? '';
const slug = rawSlug.replace(/[.,;)\]\s]+$/, '');

let memo: Memo | null = null;
let error: string | null = null;
let statusCode: 200 | 404 | 500 = 200;

if (!isValidSlug(slug)) {
  statusCode = 404;
  error = 'Audit not found.';
} else {
  try {
    const redis = Redis.fromEnv();
    const raw = await redis.get<unknown>(`memo:${slug}`);
    if (raw == null) {
      statusCode = 404;
      error = 'Audit not found.';
    } else {
      const payload = typeof raw === 'string' ? JSON.parse(raw) : raw;
      const parsed = MemoSchema.safeParse(payload);
      if (!parsed.success) {
        statusCode = 500;
        error = 'Memo schema validation failed.';
        console.error('[brite/audit] schema validation failed', parsed.error.flatten());
      } else if (parsed.data.slug !== slug || parsed.data.brand !== 'brite') {
        statusCode = 404;
        error = 'Brite audit not found.';
      } else {
        memo = parsed.data;
      }
    }
  } catch (e) {
    statusCode = 500;
    error = e instanceof Error ? e.message : String(e);
    console.error('[brite/audit] KV fetch failed', e);
  }
}

Astro.response.status = statusCode;

const roles: BriteRole[] = memo?.roles?.length ? memo.roles : BRITE_ROLES;
const fallbackRole = roles[0] ?? BRITE_ROLES[0];
const missingRoles = (memo?.teamGap?.missing ?? [])
  .map((id) => roleById(roles, id))
  .filter((role): role is BriteRole => role != null);

const renderedCells = (memo?.verdictCells ?? []).map((cell) => {
  const role = roleById(roles, cell.role) ?? missingRoles[0] ?? fallbackRole;
  const confidence = confidenceCopy(cell.reliability);
  return {
    cell,
    role,
    confidence,
    lead: findingLead(cell.reliability),
  };
});

const grade = memo?.grade ?? { letter: 'C-', band: 'gaps', peerLabel: 'B2B SaaS peer benchmark' };
const ctaUrl = memo?.ctaUrl ?? DEFAULT_CTA_URL;
const generatedAt = memo?.generatedAt ? new Date(memo.generatedAt) : null;
const generatedLabel = generatedAt && !Number.isNaN(generatedAt.getTime())
  ? `${generatedAt.getUTCFullYear()}-${String(generatedAt.getUTCMonth() + 1).padStart(2, '0')}-${String(generatedAt.getUTCDate()).padStart(2, '0')}`
  : '2026-06-05';
const pageTitle = memo
  ? `${memo.companyName ?? memo.domain} | Brite demand read`
  : 'Brite audit not found';

function money(n?: number): string {
  if (n == null) return 'Priced by role';
  return `$${n.toLocaleString('en-US')}/mo`;
}
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="robots" content="noindex,nofollow" />
<meta name="theme-color" content="#111111" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<PostHog
  capturePageview={true}
  identifyAs={memo ? slug : undefined}
  personProperties={memo ? {
    type: 'brite_memo',
    brand: 'brite',
    slug,
    domain: memo.domain,
    company_name: memo.companyName ?? null,
    grade: memo.grade?.letter ?? null,
    grade_band: memo.grade?.band ?? null,
    first_viewed_at: new Date().toISOString(),
  } : undefined}
  groupKey={memo?.domain}
  groupType="company"
/>
<style>
  :root {
    --brite-orange: #ff9700;
    --brite-orange-dark: #c66e00;
    --ink: #111111;
    --ink-soft: #3d3d3d;
    --muted: #69645c;
    --paper: #f8f5ef;
    --paper-2: #ffffff;
    --line: rgba(17, 17, 17, 0.14);
    --line-strong: rgba(17, 17, 17, 0.34);
    --green: #2c6e49;
    --blue: #245c7a;
    --red: #8f2f23;
  }

  * { box-sizing: border-box; }
  html { background: var(--paper); color: var(--ink); }
  body {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    background: var(--paper);
    color: var(--ink);
    letter-spacing: 0;
  }
  a { color: inherit; }

  .page {
    min-height: 100vh;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px clamp(20px, 5vw, 72px);
    background: var(--ink);
    color: #fff;
    border-bottom: 4px solid var(--brite-orange);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  .mark {
    width: 30px;
    height: 30px;
    border: 3px solid var(--brite-orange);
    border-radius: 50%;
    position: relative;
    flex: 0 0 auto;
  }
  .mark:before,
  .mark:after {
    content: "";
    position: absolute;
    background: var(--brite-orange);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    top: 50%;
    transform: translateY(-50%);
  }
  .mark:before { left: -10px; }
  .mark:after { right: -10px; }
  .brand-word {
    font-family: Montserrat, Inter, sans-serif;
    font-weight: 800;
    font-size: 28px;
    line-height: 1;
  }
  .nav-meta {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    justify-content: flex-end;
    font-size: 12px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    font-weight: 700;
  }

  .shell {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: clamp(36px, 6vw, 72px) 0 52px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.6fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: stretch;
    padding-bottom: 42px;
    border-bottom: 1px solid var(--line-strong);
  }
  .kicker {
    font-size: 12px;
    line-height: 1;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--brite-orange-dark);
    margin: 0 0 18px;
  }
  h1 {
    font-family: Montserrat, Inter, sans-serif;
    font-size: clamp(34px, 5vw, 66px);
    line-height: 0.98;
    margin: 0;
    letter-spacing: 0;
    max-width: 820px;
  }
  .italic {
    color: var(--muted);
    font-weight: 600;
  }
  .dek {
    margin: 22px 0 0;
    max-width: 700px;
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .pill {
    border: 1px solid var(--line-strong);
    padding: 8px 10px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: rgba(255, 255, 255, 0.45);
  }
  .pill b { color: var(--ink); }

  .grade-panel {
    background: var(--ink);
    color: #fff;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 320px;
  }
  .grade-label {
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.68);
    font-size: 12px;
    font-weight: 800;
  }
  .grade {
    font-family: Montserrat, Inter, sans-serif;
    font-size: clamp(74px, 8vw, 118px);
    line-height: 0.9;
    font-weight: 800;
    color: var(--brite-orange);
    margin: 24px 0 16px;
  }
  .grade-panel p {
    margin: 0;
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.5;
  }
  .grade-panel .cta {
    margin-top: 24px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 18px;
    border: 2px solid var(--brite-orange);
    background: var(--brite-orange);
    color: #111;
    text-decoration: none;
    font-weight: 800;
    font-size: 14px;
  }
  .cta:hover { background: #fff; }

  .section {
    padding: 42px 0;
    border-bottom: 1px solid var(--line);
  }
  .section-head {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 30px;
    margin-bottom: 24px;
  }
  .section-code {
    color: var(--brite-orange-dark);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }
  h2 {
    font-family: Montserrat, Inter, sans-serif;
    font-size: clamp(25px, 3vw, 38px);
    line-height: 1.08;
    margin: 0;
    letter-spacing: 0;
  }
  .section-copy {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
    max-width: 760px;
  }

  .team-grid,
  .findings-grid,
  .roles-grid {
    display: grid;
    gap: 16px;
  }
  .team-grid {
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.55fr);
  }
  .roles-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .findings-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .panel,
  .finding,
  .role-card {
    background: var(--paper-2);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    padding: 22px;
  }
  .panel h3,
  .finding h3,
  .role-card h3 {
    font-family: Montserrat, Inter, sans-serif;
    margin: 0;
    letter-spacing: 0;
  }
  .panel h3 { font-size: 24px; }
  .finding h3,
  .role-card h3 { font-size: 20px; line-height: 1.18; }
  .muted {
    color: var(--muted);
    line-height: 1.55;
  }
  .role-price {
    display: inline-flex;
    margin-top: 14px;
    padding: 7px 9px;
    background: rgba(255, 151, 0, 0.14);
    color: var(--ink);
    font-weight: 800;
    font-size: 13px;
  }
  .senior-swap {
    color: var(--muted);
    font-size: 13px;
    margin-top: 10px;
  }
  .confidence {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    font-size: 12px;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--muted);
  }
  .confidence:before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--blue);
  }
  .confidence.is-assertive:before { background: var(--green); }
  .finding-value {
    margin: 12px 0 10px;
    font-family: Montserrat, Inter, sans-serif;
    font-size: 34px;
    line-height: 1;
    font-weight: 800;
  }
  .role-strip {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: start;
  }
  .role-strip strong {
    display: block;
    font-family: Montserrat, Inter, sans-serif;
    margin-bottom: 4px;
  }
  .checks {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .checks li {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    color: var(--ink-soft);
  }
  .checks .ok { color: var(--green); font-weight: 800; }
  .checks .no { color: var(--red); font-weight: 800; }
  .checks .soft { color: var(--muted); }
  .fix-list {
    display: grid;
    gap: 0;
    border: 1px solid var(--line-strong);
    background: #fff;
  }
  .fix {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 180px;
    gap: 22px;
    padding: 22px;
    border-bottom: 1px solid var(--line);
  }
  .fix:last-child { border-bottom: 0; }
  .rank {
    font-family: Montserrat, Inter, sans-serif;
    font-size: 28px;
    font-weight: 800;
    color: var(--brite-orange-dark);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    border: 1px solid var(--line-strong);
    padding: 7px 8px;
    font-size: 12px;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--muted);
  }

  .close {
    margin-top: 42px;
    background: var(--ink);
    color: #fff;
    padding: clamp(28px, 5vw, 48px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
  }
  .close h2 { color: #fff; }
  .close p {
    color: rgba(255, 255, 255, 0.74);
    max-width: 680px;
    line-height: 1.55;
  }
  .footer {
    padding: 22px 0 0;
    color: var(--muted);
    font-size: 12px;
    text-align: center;
  }

  .not-found {
    width: min(720px, calc(100% - 40px));
    margin: 0 auto;
    padding: 80px 0;
  }
  .not-found h1 { margin-bottom: 18px; }

  @media (max-width: 900px) {
    .nav { align-items: flex-start; flex-direction: column; }
    .nav-meta { justify-content: flex-start; }
    .hero,
    .team-grid,
    .section-head,
    .close {
      grid-template-columns: 1fr;
    }
    .findings-grid,
    .roles-grid {
      grid-template-columns: 1fr;
    }
    .fix {
      grid-template-columns: 48px minmax(0, 1fr);
    }
    .fix .chips { grid-column: 2; }
  }
  @media (max-width: 560px) {
    .shell { width: min(100% - 28px, 1180px); }
    .grade-panel,
    .panel,
    .finding,
    .role-card,
    .fix,
    .close {
      padding: 18px;
    }
    h1 { font-size: 34px; }
    .role-strip { grid-template-columns: 1fr; }
    .checks li { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
</head>
<body>
<div class="page">
  <header class="nav">
    <a class="brand" href="/brite" aria-label="Brite">
      <span class="mark" aria-hidden="true"></span>
      <span class="brand-word">brite</span>
    </a>
    <div class="nav-meta">
      <span>Private demand read</span>
      <span>{generatedLabel}</span>
      <span>{slug || 'no-slug'}</span>
    </div>
  </header>

  {memo ? (
    <main class="shell">
      <section class="hero">
        <div>
          <p class="kicker">{memo.cover.kicker}</p>
          <h1>
            {memo.cover.roman}
            {memo.cover.italic ? <span class="italic"> {memo.cover.italic}</span> : null}
          </h1>
          {memo.cover.dek ? <p class="dek">{memo.cover.dek}</p> : null}
          <div class="hero-meta">
            <span class="pill">Domain <b>{memo.domain}</b></span>
            {memo.companyName ? <span class="pill">Company <b>{memo.companyName}</b></span> : null}
            <span class="pill">Brand <b>Brite</b></span>
          </div>
        </div>
        <aside class={`grade-panel grade-${grade.band}`}>
          <div>
            <div class="grade-label">Peer grade</div>
            <div class="grade">{grade.letter}</div>
            <p>{grade.peerLabel}. This page uses the memo grade, not the Rivett composite score.</p>
          </div>
          <a class="cta" href={ctaUrl} target="_blank" rel="noopener" data-cta="brite_book_call" data-cta-location="hero">Book 45 min with Brite</a>
        </aside>
      </section>

      <section class="section">
        <div class="section-head">
          <div class="section-code">01 / Team gap</div>
          <div>
            <h2>The basics are there. The missing piece is senior ownership.</h2>
            <p class="section-copy">This read is calibrated for an established B2B SaaS team. It does not grade you like a company missing GA4 and DMARC. It asks which specialist should own the next layer.</p>
          </div>
        </div>
        <div class="team-grid">
          <div class="panel">
            <h3>{missingRoles[0]?.name ?? fallbackRole.name}</h3>
            <p class="muted">
              {memo.teamGap?.headcount == null
                ? 'Public headcount was not measured in this sample memo.'
                : `Public marketing headcount read: ${memo.teamGap.headcount}.`}
              {' '}
              The staffing read is {confidenceCopy(memo.teamGap?.reliability).label.toLowerCase()}.
            </p>
            <span class="role-price">{money(missingRoles[0]?.priceMonthly ?? fallbackRole.priceMonthly)}</span>
            <div class="senior-swap">Senior US equivalent: ${(missingRoles[0]?.usEquivAnnual ?? fallbackRole.usEquivAnnual ?? 180000).toLocaleString('en-US')}/yr.</div>
          </div>
          <div class="panel">
            <h3>Missing owner IDs</h3>
            <p class="muted">{memo.teamGap?.missing?.length ? memo.teamGap.missing.join(', ') : 'No team-gap IDs supplied.'}</p>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <div class="section-code">02 / Findings</div>
          <div>
            <h2>Each gap maps to the Brite hire who would own it.</h2>
            <p class="section-copy">Verified checks are stated plainly. Inferred or soft-absence signals are framed as questions for the team.</p>
          </div>
        </div>
        <div class="findings-grid">
          {renderedCells.map(({ cell, role, confidence, lead }) => (
            <article class="finding">
              <div class={`confidence ${confidence.assertive ? 'is-assertive' : ''}`}>{lead} / {confidence.label}</div>
              <h3>{cell.heading}</h3>
              <div class="finding-value">{cell.value}</div>
              <p class="muted" set:html={sanitizeMemoHtml(cell.note)} />
              <p class="muted">{confidence.detail}</p>
              <div class="role-strip">
                <div>
                  <strong>{role.name}</strong>
                  <span class="muted">{role.does}</span>
                </div>
                <span class="role-price">{money(role.priceMonthly)}</span>
              </div>
              {cell.checks.length ? (
                <ul class="checks">
                  {cell.checks.map((check) => {
                    const rowConfidence = confidenceCopy(check.reliability);
                    return (
                      <li>
                        <span class={rowConfidence.assertive ? (check.ok ? 'ok' : 'no') : 'soft'}>
                          {rowConfidence.assertive ? (check.ok ? 'Verified' : 'Finding') : rowConfidence.label}
                        </span>
                        <span set:html={sanitizeMemoHtml(check.text)} />
                      </li>
                    );
                  })}
                </ul>
              ) : null}
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <div class="section-code">03 / Role cards</div>
          <div>
            <h2>The senior-swap math.</h2>
            <p class="section-copy">Brite places the specialist who owns the gap inside the team. The commercial frame is a senior operator without a $180k US hire.</p>
          </div>
        </div>
        <div class="roles-grid">
          {roles.map((role) => (
            <article class="role-card">
              <h3>{role.name}</h3>
              <p class="muted">{role.does}</p>
              <span class="role-price">{money(role.priceMonthly)}</span>
              <div class="senior-swap">US equivalent: ${(role.usEquivAnnual ?? 180000).toLocaleString('en-US')}/yr.</div>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <div class="section-code">04 / First moves</div>
          <div>
            <h2>The fix order starts with ownership.</h2>
          </div>
        </div>
        <div class="fix-list">
          {memo.rankedFixes.map((fix) => (
            <article class="fix">
              <div class="rank">{String(fix.rank).padStart(2, '0')}</div>
              <div>
                <h3 set:html={sanitizeMemoHtml(fix.what)} />
                <p class="muted" set:html={sanitizeMemoHtml(fix.why)} />
              </div>
              <div class="chips">
                <span class="chip">Effort <b>{fix.effort}</b></span>
                <span class="chip">Impact <b>{fix.impact}</b></span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <div class="section-code">05 / Operator note</div>
          <div>
            <h2>What this points to.</h2>
            <p class="section-copy" set:html={sanitizeMemoHtml(memo.personalObservation.text)} />
          </div>
        </div>
      </section>

      <aside class="close">
        <div>
          <h2>You need a senior in-house owner. Brite is that owner.</h2>
          <p>The call is about the first role to place, the gaps it would own, and where that hire changes the demo path fastest.</p>
        </div>
        <a class="cta" href={ctaUrl} target="_blank" rel="noopener" data-cta="brite_book_call" data-cta-location="closer">Book 45 min with Brite</a>
      </aside>

      <footer class="footer">External read of public signals. Not a formal assessment. Brite demand read / {generatedLabel}.</footer>
    </main>
  ) : (
    <main class="not-found">
      <p class="kicker">{statusCode === 404 ? 'Brite audit' : 'Brite audit error'}</p>
      <h1>{statusCode === 404 ? 'No Brite audit lives at this URL.' : 'The Brite audit could not load.'}</h1>
      <p class="dek">{error}</p>
    </main>
  )}
</div>
</body>
</html>
