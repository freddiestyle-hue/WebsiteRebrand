---
import Base from '../../layouts/Base.astro';

const title = 'Brite Demand Engine HQ';
const description = 'A seeded Brite demand engine demo showing prospect audits, role routing, outreach status, and pilot activity.';
---
<Base
  title={title}
  description={description}
  posthogCapturePageview={true}
>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

<div class="bhq">
  <header class="bx-nav">
    <div class="bx-wrap bx-wrap-wide bx-nav-in">
      <a class="bx-logo" href="/brite" aria-label="brite">
        <svg class="bx-logo-svg" viewBox="0 0 134 42" fill="none" xmlns="http://www.w3.org/2000/svg" role="img"><path d="M25.4891 3H25.5109M42.9781 21H43M25.4891 39H25.5109M8 21H8.02186M37.856 8.27179H37.8779M37.856 33.7282H37.8779M13.1221 33.7282H13.144M13.1221 8.27179H13.144M34.2336 21C34.2336 25.9706 30.3185 30 25.4891 30C20.6596 30 16.7445 25.9706 16.7445 21C16.7445 16.0294 20.6596 12 25.4891 12C30.3185 12 34.2336 16.0294 34.2336 21Z" stroke="#FF9700" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M71.2725 25.255C71.2725 21.5175 68.7425 19.1025 65.465 19.1025C62.1875 19.1025 59.6 21.5175 59.6 25.255C59.6 28.9925 62.13 31.4075 65.465 31.4075C68.8 31.4075 71.2725 28.9925 71.2725 25.255ZM75.93 25.255C75.93 31.35 71.675 35.375 65.925 35.375C60.175 35.375 60.9225 34.455 59.37 32.5575V35.0875H55V7.71751H59.6V17.78C61.21 15.9975 63.395 15.135 65.925 15.135C71.675 15.135 75.93 19.1025 75.93 25.1975V25.255Z" fill="white"/><path d="M90.2475 15.1924V19.5624C89.845 19.5049 89.5 19.4474 89.155 19.4474C85.6475 19.4474 83.4625 21.5174 83.4625 25.5424V35.0874H78.8625V15.3649H83.2325V18.2399C84.555 16.1699 86.97 15.1349 90.2475 15.1349V15.1924Z" fill="white"/><path d="M92.6624 15.4225H97.2624V35.145H92.6624V15.4225ZM92.0299 9.38502C92.0299 7.83252 93.2949 6.62503 94.9624 6.62503C96.6299 6.62503 97.8949 7.77503 97.8949 9.27003C97.8949 10.765 96.6874 12.145 94.9624 12.145C93.2374 12.145 92.0299 10.9375 92.0299 9.38502Z" fill="white"/><path d="M113.707 34.0525C112.615 34.915 110.947 35.375 109.28 35.375C104.967 35.375 102.495 33.075 102.495 28.7625V19.275H99.2749V15.595H102.495V11.11H107.095V15.595H112.385V19.275H107.095V28.6475C107.095 30.545 108.072 31.58 109.797 31.58C111.522 31.58 111.695 31.2925 112.385 30.775L113.65 34.0525H113.707Z" fill="white"/><path d="M118.307 23.7025H129.462C129.117 20.885 126.932 18.93 123.885 18.93C120.837 18.93 118.71 20.8275 118.25 23.7025H118.307ZM133.832 26.75H118.365C118.94 29.625 121.297 31.465 124.747 31.465C128.197 31.465 128.715 30.775 130.095 29.3375L132.567 32.155C130.785 34.2825 128.025 35.375 124.632 35.375C118.02 35.375 113.765 31.12 113.765 25.255C113.765 19.39 118.077 15.1925 123.942 15.1925C129.807 15.1925 133.89 19.2175 133.89 25.37C133.89 31.5225 133.89 26.29 133.832 26.75Z" fill="white"/></svg>
      </a>
      <span class="bx-nav-label">Demand engine · live ops</span>
    </div>
  </header>

  <section class="bhq-demo" aria-label="Demo status">
    <div class="bhq-demo-in">
      <span class="bhq-demo-pill">DEMO</span>
      <span>DEMO · Seeded with sample Brite-ICP prospects. Live data starts week 1 of pilot.</span>
    </div>
  </section>

  <section class="bhq-header">
    <div class="bx-wrap bx-wrap-wide">
      <span class="bx-eyebrow">BRITE DEMAND ENGINE</span>
      <h1 class="bhq-h1">Pipeline · pilot week 4</h1>
      <p class="bhq-subtitle">Cold outbound that finds startups leaking money on marketing, audits them, and routes the leak to a Brite role.</p>
    </div>
  </section>

  <section class="bhq-pulse" aria-label="Pipeline metrics">
    <div class="bx-wrap bx-wrap-wide">
      <div class="bhq-kpis">
        <article class="bhq-kpi">
          <span class="bhq-kpi-label">Prospects in pipeline</span>
          <strong>47</strong>
          <span class="bhq-kpi-sub bhq-kpi-sub-o">+12 this week</span>
        </article>
        <article class="bhq-kpi">
          <span class="bhq-kpi-label">Audits run · 7d</span>
          <strong>14</strong>
          <span class="bhq-kpi-sub bhq-kpi-sub-o">100% delivered</span>
        </article>
        <article class="bhq-kpi">
          <span class="bhq-kpi-label">Outreach sent</span>
          <strong>31</strong>
          <span class="bhq-kpi-sub">4-week cumulative</span>
        </article>
        <article class="bhq-kpi">
          <span class="bhq-kpi-label">Replies</span>
          <strong>11</strong>
          <span class="bhq-kpi-sub bhq-kpi-sub-o">35.5% reply rate</span>
        </article>
        <article class="bhq-kpi">
          <span class="bhq-kpi-label">Calls booked</span>
          <strong>4</strong>
          <span class="bhq-kpi-sub bhq-kpi-sub-o">36% reply→call</span>
        </article>
        <article class="bhq-kpi">
          <span class="bhq-kpi-label">Hires placed</span>
          <strong>2</strong>
          <span class="bhq-kpi-sub bhq-kpi-sub-o">$7,000 MRR landed</span>
        </article>
      </div>
    </div>
  </section>

  <section class="bhq-main">
    <div class="bx-wrap bx-wrap-wide">
      <div class="bhq-grid">
        <section class="bhq-card bhq-queue-card" aria-label="Send queue">
          <div class="bhq-card-head">
            <span class="bhq-card-k">SEND QUEUE</span>
            <div class="bhq-filter" aria-label="Status filters">
              <span class="is-active">All</span>
              <span>Audited</span>
              <span>Sent</span>
              <span>Replied</span>
              <span>Booked</span>
              <span>Placed</span>
            </div>
          </div>
          <div class="bhq-queue" id="bhq-queue"></div>
        </section>

        <aside class="bhq-card bhq-roles-card" aria-label="Brite roles">
          <div class="bhq-card-head">
            <span class="bhq-card-k">BRITE ROLES</span>
            <span class="bhq-card-k">PILOT TOTAL</span>
          </div>
          <div class="bhq-roles" id="bhq-roles"></div>
        </aside>
      </div>

      <section class="bhq-card bhq-feed-card" aria-label="Recent audits">
        <div class="bhq-card-head">
          <span class="bhq-card-k">RECENT AUDITS</span>
          <span class="bhq-head-note">Last 8</span>
        </div>
        <div class="bhq-feed" id="bhq-feed"></div>
      </section>

      <section class="bhq-card bhq-activity-card" aria-label="Audit activity">
        <div class="bhq-card-head">
          <span class="bhq-card-k">AUDITS · LAST 7 DAYS</span>
        </div>
        <div class="bhq-bars" id="bhq-bars"></div>
      </section>
    </div>
  </section>

  <section class="bx-cta">
    <div class="bx-wrap bx-wrap-wide bx-cta-in">
      <div>
        <h2 class="bx-cta-h">Monday 9am — first 50 prospects scoped to your real ICP.</h2>
        <p class="bx-cta-p">You see every audit, every reply, every call. Pay me what it's worth once we have data.</p>
      </div>
      <a class="bx-btn bx-btn-lg" href="https://calendly.com/incrementum-team/30min" target="_blank" rel="noopener" data-cta="brite-hq-cta">Lock the pilot</a>
    </div>
  </section>

  <footer class="bx-foot">
    <div class="bx-wrap bx-wrap-wide bx-foot-in">
      <a class="bx-logo" href="/brite" aria-label="brite">
        <svg class="bx-logo-svg bx-logo-svg-sm" viewBox="0 0 134 42" fill="none" xmlns="http://www.w3.org/2000/svg" role="img"><path d="M25.4891 3H25.5109M42.9781 21H43M25.4891 39H25.5109M8 21H8.02186M37.856 8.27179H37.8779M37.856 33.7282H37.8779M13.1221 33.7282H13.144M13.1221 8.27179H13.144M34.2336 21C34.2336 25.9706 30.3185 30 25.4891 30C20.6596 30 16.7445 25.9706 16.7445 21C16.7445 16.0294 20.6596 12 25.4891 12C30.3185 12 34.2336 16.0294 34.2336 21Z" stroke="#FF9700" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M71.2725 25.255C71.2725 21.5175 68.7425 19.1025 65.465 19.1025C62.1875 19.1025 59.6 21.5175 59.6 25.255C59.6 28.9925 62.13 31.4075 65.465 31.4075C68.8 31.4075 71.2725 28.9925 71.2725 25.255ZM75.93 25.255C75.93 31.35 71.675 35.375 65.925 35.375C60.175 35.375 60.9225 34.455 59.37 32.5575V35.0875H55V7.71751H59.6V17.78C61.21 15.9975 63.395 15.135 65.925 15.135C71.675 15.135 75.93 19.1025 75.93 25.1975V25.255Z" fill="white"/><path d="M90.2475 15.1924V19.5624C89.845 19.5049 89.5 19.4474 89.155 19.4474C85.6475 19.4474 83.4625 21.5174 83.4625 25.5424V35.0874H78.8625V15.3649H83.2325V18.2399C84.555 16.1699 86.97 15.1349 90.2475 15.1349V15.1924Z" fill="white"/><path d="M92.6624 15.4225H97.2624V35.145H92.6624V15.4225ZM92.0299 9.38502C92.0299 7.83252 93.2949 6.62503 94.9624 6.62503C96.6299 6.62503 97.8949 7.77503 97.8949 9.27003C97.8949 10.765 96.6874 12.145 94.9624 12.145C93.2374 12.145 92.0299 10.9375 92.0299 9.38502Z" fill="white"/><path d="M113.707 34.0525C112.615 34.915 110.947 35.375 109.28 35.375C104.967 35.375 102.495 33.075 102.495 28.7625V19.275H99.2749V15.595H102.495V11.11H107.095V15.595H112.385V19.275H107.095V28.6475C107.095 30.545 108.072 31.58 109.797 31.58C111.522 31.58 111.695 31.2925 112.385 30.775L113.65 34.0525H113.707Z" fill="white"/><path d="M118.307 23.7025H129.462C129.117 20.885 126.932 18.93 123.885 18.93C120.837 18.93 118.71 20.8275 118.25 23.7025H118.307ZM133.832 26.75H118.365C118.94 29.625 121.297 31.465 124.747 31.465C128.197 31.465 128.715 30.775 130.095 29.3375L132.567 32.155C130.785 34.2825 128.025 35.375 124.632 35.375C118.02 35.375 113.765 31.12 113.765 25.255C113.765 19.39 118.077 15.1925 123.942 15.1925C129.807 15.1925 133.89 19.2175 133.89 25.37C133.89 31.5225 133.89 26.29 133.832 26.75Z" fill="white"/></svg>
      </a>
      <span>Prototype built by <b>Fred Style</b> · Rivett · A demonstration, not affiliated with Brite.</span>
    </div>
  </footer>
</div>

<script is:inline>
  const PROSPECTS = [
    { name: "Outbound Labs",    stage: "Series A · GTM tooling · scaling sales",          finding: "4 unidentified trackers",      role: "Marketing/Web Analytics", price: "$2,800/mo", status: "audited", lastTouch: "30min ago", minutes: 30 },
    { name: "Edenflow",         stage: "Seed · Workflow automation",                       finding: "No Meta Pixel",                role: "Performance Marketing",    price: "$3,500/mo", status: "audited", lastTouch: "45min ago", minutes: 45 },
    { name: "Klever HR",        stage: "Seed · Performance reviews · Series A pending",    finding: "No Meta Pixel",                role: "Performance Marketing",    price: "$3,500/mo", status: "audited", lastTouch: "1h ago",    minutes: 60 },
    { name: "Anvil Studios",    stage: "Seed · No-code internal tools",                    finding: "GTM junk drawer",              role: "Marketing/Web Analytics", price: "$2,800/mo", status: "audited", lastTouch: "1h ago",    minutes: 65 },
    { name: "Indigo Lattice",   stage: "Series A · Vertical SaaS for insurance",           finding: "No Meta Pixel",                role: "Performance Marketing",    price: "$3,500/mo", status: "audited", lastTouch: "1h ago",    minutes: 75 },
    { name: "Brio Energy",      stage: "Series A · ESG analytics",                         finding: "5s mobile load",               role: "Digital Marketing",        price: "$3,500/mo", status: "audited", lastTouch: "2h ago",    minutes: 120 },
    { name: "Lumenpath AI",     stage: "Series A · LLM agents · 8mo runway",               finding: "No Meta Pixel",                role: "Performance Marketing",    price: "$3,500/mo", status: "sent",    lastTouch: "2h ago",    minutes: 130 },
    { name: "Forge Logistics",  stage: "Seed · Trucking SaaS · founder-led growth",        finding: "4.7s mobile load",             role: "Digital Marketing",        price: "$3,500/mo", status: "replied", lastTouch: "4h ago",    minutes: 240 },
    { name: "Tessellate",       stage: "Series A · Design ops SaaS",                       finding: "No DMARC record",              role: "Email Marketing",          price: "$3,500/mo", status: "replied", lastTouch: "5h ago",    minutes: 300 },
    { name: "Klyff Health",     stage: "Series A · Patient intake · D2C component",        finding: "No DMARC record",              role: "Email Marketing",          price: "$3,500/mo", status: "booked",  lastTouch: "6h ago",    minutes: 360 },
    { name: "Kindred Stack",    stage: "Seed · DevEx platform",                            finding: "No Meta Pixel",                role: "Performance Marketing",    price: "$3,500/mo", status: "replied", lastTouch: "8h ago",    minutes: 480 },
    { name: "Drift Robotics",   stage: "Series A · Warehouse automation",                  finding: "4 unidentified trackers",      role: "Marketing/Web Analytics", price: "$2,800/mo", status: "booked",  lastTouch: "9h ago",    minutes: 540 },
    { name: "Gilded Markets",   stage: "Seed · Fintech infra",                             finding: "No schema markup",             role: "Technical SEO",            price: "$4,000/mo", status: "replied", lastTouch: "12h ago",   minutes: 720 },
    { name: "Stride Finance",   stage: "Seed · B2B AP automation",                         finding: "No schema markup",             role: "Technical SEO",            price: "$4,000/mo", status: "sent",    lastTouch: "1d ago",    minutes: 1440 },
    { name: "Boundless Data",   stage: "Series A · CDP for mid-market",                    finding: "No rich snippets",             role: "Technical SEO",            price: "$4,000/mo", status: "sent",    lastTouch: "1d ago",    minutes: 1500 },
    { name: "Northwave Bio",    stage: "Series A · Bio devtools · TAM US+EU",              finding: "5.2s mobile load",             role: "Digital Marketing",        price: "$3,500/mo", status: "sent",    lastTouch: "2d ago",    minutes: 2880 },
    { name: "Flint Climate",    stage: "Series A · Carbon accounting",                     finding: "No DMARC record",              role: "Email Marketing",          price: "$3,500/mo", status: "sent",    lastTouch: "2d ago",    minutes: 2940 },
    { name: "Cinder Devtools",  stage: "Seed · Open source tooling",                       finding: "No schema markup",             role: "Technical SEO",            price: "$4,000/mo", status: "sent",    lastTouch: "3d ago",    minutes: 4320 },
    { name: "Habit AI",         stage: "Seed · Behavior science API",                      finding: "GTM junk drawer",              role: "Marketing/Web Analytics", price: "$2,800/mo", status: "placed",  lastTouch: "4d ago",    minutes: 5760 },
    { name: "Acorn Path",       stage: "Series A · Education D2C",                         finding: "No DMARC record",              role: "Email Marketing",          price: "$3,500/mo", status: "placed",  lastTouch: "11d ago",   minutes: 15840 },
  ];

  const COLD_OPENERS = {
    "No Meta Pixel":
      "You're spending on Google and LinkedIn but flying blind on the channel that usually wins for your category. A performance hire pays for itself the month they wire up Meta.",
    "No DMARC record":
      "Your order and onboarding emails are landing in spam, and anyone can spoof your domain at the same time. A half-day fix for the right hire. Want the breakdown?",
    "4.7s mobile load":
      "You're paying for ad clicks that hit a 4.7-second page on mobile. A digital marketing hire turns the traffic you're already buying into qualified leads.",
    "5s mobile load":
      "You're paying for ad clicks that hit a 5-second page on mobile. A digital marketing hire turns the traffic you're already buying into qualified leads.",
    "5.2s mobile load":
      "You're paying for ad clicks that hit a 5.2-second page on mobile. A digital marketing hire turns the traffic you're already buying into qualified leads.",
    "No schema markup":
      "Your competitors are getting review stars and rich snippets in Google search. You're not. A technical SEO fixes that in a week and your category page lights up.",
    "No rich snippets":
      "You ship great product pages and Google shows none of the review stars. A technical SEO closes that gap inside a sprint and your CTR climbs.",
    "4 unidentified trackers":
      "Your tag manager has four trackers nobody can name, no clean CAC, no clean ROAS. An analytics hire gives you a dashboard the team will actually trust.",
    "GTM junk drawer":
      "Your tag manager is a junk drawer. There's no clean read on what's working. An analytics hire installs the dashboard your CFO will stop questioning.",
  };

  const ROLES = {
    "Performance Marketing":     { does: "Google Ads, Facebook Ads, campaign optimisation, reducing CAC",                          price: "$3,500/mo" },
    "Email Marketing":           { does: "Email, SMS, push & in-app, lifecycle journeys",                                          price: "$3,500/mo" },
    "Digital Marketing":         { does: "Google Ads, Facebook Ads, email, reducing CAC",                                          price: "$3,500/mo" },
    "Marketing/Web Analytics":   { does: "GA4, Mixpanel, Heap, ROAS & CAC, A/B tests, dashboards",                                 price: "$2,800/mo" },
    "Technical SEO":             { does: "Keyword research, sitemap, schema, internal linking, snippet optimisation",              price: "$4,000/mo" },
    "Salesforce Admin":          { does: "Salesforce administration",                                                              price: "$5,000/mo" },
  };

  const ROLES_BOARD = [
    { role: "Performance Marketing",   price: "$3,500/mo", matches: 14 },
    { role: "Email Marketing",         price: "$3,500/mo", matches: 10 },
    { role: "Marketing/Web Analytics", price: "$2,800/mo", matches: 9  },
    { role: "Technical SEO",           price: "$4,000/mo", matches: 8  },
    { role: "Digital Marketing",       price: "$3,500/mo", matches: 6  },
    { role: "Salesforce Admin",        price: "$5,000/mo", matches: 0  },
  ];

  const DAILY_AUDITS = [
    { day: "Mon", count: 3 },
    { day: "Tue", count: 2 },
    { day: "Wed", count: 3 },
    { day: "Thu", count: 2 },
    { day: "Fri", count: 3 },
    { day: "Sat", count: 1 },
    { day: "Sun", count: 0 },
  ];

  let expandedCompany = null;

  function escapeHtml(value) {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function statusLabel(status) {
    return status.charAt(0).toUpperCase() + status.slice(1);
  }

  function renderExpanded(prospect) {
    const role = ROLES[prospect.role];
    return `
      <div class="bhq-expanded">
        <div class="bx-panel-flow">
          <div class="bx-panel-leak">
            <span class="bx-panel-k">Audit finds</span>
            <h3 class="bx-panel-finding">${escapeHtml(prospect.finding)}</h3>
            <p class="bx-panel-detail">${escapeHtml(prospect.stage)}</p>
          </div>
          <div class="bx-panel-arrow" aria-hidden="true">→</div>
          <div class="bx-panel-role">
            <span class="bx-panel-k bx-panel-k-o">Brite places</span>
            <h3 class="bx-panel-rolename">${escapeHtml(prospect.role)}</h3>
            <p class="bx-panel-does">${escapeHtml(role.does)}</p>
            <span class="bx-panel-price">${escapeHtml(role.price)}</span>
          </div>
        </div>
        <div class="bx-panel-cold">
          <span class="bx-panel-k">The cold opener it writes</span>
          <p>${escapeHtml(COLD_OPENERS[prospect.finding])}</p>
        </div>
      </div>
    `;
  }

  function renderQueue() {
    const queue = document.getElementById('bhq-queue');
    queue.innerHTML = PROSPECTS.map((prospect) => `
      <article class="bhq-prospect${expandedCompany === prospect.name ? ' is-expanded' : ''}">
        <button class="bhq-queue-row" type="button" data-company="${escapeHtml(prospect.name)}">
          <span class="bhq-company">${escapeHtml(prospect.name)}</span>
          <span class="bhq-stage-finding">
            <span class="bhq-stage">${escapeHtml(prospect.stage)}</span>
            <span class="bhq-finding"><span aria-hidden="true">●</span>${escapeHtml(prospect.finding)}</span>
          </span>
          <span class="bhq-role">${escapeHtml(prospect.role)}</span>
          <span class="bhq-status bhq-status-${escapeHtml(prospect.status)}">${escapeHtml(statusLabel(prospect.status))}</span>
          <span class="bhq-touch">${escapeHtml(prospect.lastTouch)}</span>
        </button>
        ${expandedCompany === prospect.name ? renderExpanded(prospect) : ''}
      </article>
    `).join('');

    queue.querySelectorAll('.bhq-queue-row').forEach((row) => {
      row.addEventListener('click', () => {
        const company = row.dataset.company;
        const prospect = PROSPECTS.find((item) => item.name === company);
        const nextCompany = expandedCompany === company ? null : company;
        expandedCompany = nextCompany;
        renderQueue();
        if (nextCompany && window.posthog) {
          window.posthog.capture('brite_hq_row_expanded', {
            company: prospect.name,
            role: prospect.role,
            status: prospect.status,
          });
        }
      });
    });
  }

  function renderRoles() {
    const roles = document.getElementById('bhq-roles');
    roles.innerHTML = ROLES_BOARD.map((item) => `
      <article class="bhq-role-row${item.matches === 0 ? ' is-zero' : ''}">
        <div>
          <h3>${escapeHtml(item.role)}</h3>
          <p>${escapeHtml(item.price)}</p>
          ${item.role === 'Salesforce Admin' ? '<em>Audit doesn&#039;t catch this yet — separate scan in week 2.</em>' : ''}
        </div>
        <div class="bhq-role-count">
          <strong>${escapeHtml(item.matches)}</strong>
          <span>matches</span>
        </div>
      </article>
    `).join('');
  }

  function renderFeed() {
    const feed = document.getElementById('bhq-feed');
    const recent = PROSPECTS.slice().sort((a, b) => a.minutes - b.minutes).slice(0, 8);
    feed.innerHTML = recent.map((item) => `
      <article class="bhq-feed-row">
        <span class="bhq-feed-company">${escapeHtml(item.name)}</span>
        <span>${escapeHtml(item.finding)}</span>
        <span>${escapeHtml(item.role)}</span>
        <span class="bhq-feed-time">${escapeHtml(item.lastTouch)}</span>
      </article>
    `).join('');
  }

  function renderBars() {
    const bars = document.getElementById('bhq-bars');
    const max = Math.max(...DAILY_AUDITS.map((item) => item.count));
    bars.innerHTML = DAILY_AUDITS.map((item) => `
      <article class="bhq-bar-item">
        <div class="bhq-bar-shell">
          ${item.count === max ? `<span class="bhq-bar-count">${escapeHtml(item.count)}</span>` : ''}
          <span class="bhq-bar" style="height: ${max ? (item.count / max) * 120 : 0}px"></span>
        </div>
        <span class="bhq-bar-label">${escapeHtml(item.day)}</span>
      </article>
    `).join('');
  }

  renderQueue();
  renderRoles();
  renderFeed();
  renderBars();
</script>

