  /* One-shot sheen sweep on h2/h3 italic phrases when they scroll into
     view. Mirrors the hero sheen, single pass instead of looping. */
  .audit-first-home h2 .ital,
  .audit-first-home h3 .ital {
    display: inline-block;
    background-clip: text;
    -webkit-background-clip: text;
    transition: opacity 600ms ease;
  }
  .audit-first-home h2 .ital.in-view,
  .audit-first-home h3 .ital.in-view {
    background: linear-gradient(
      90deg,
      var(--ink-italic, #3A4658) 0%,
      var(--ink-italic, #3A4658) 38%,
      rgba(143, 191, 63, 0.75) 50%,
      var(--ink-italic, #3A4658) 62%,
      var(--ink-italic, #3A4658) 100%
    );
    background-size: 240% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: section-ital-sheen 1.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes section-ital-sheen {
    0% { background-position: 100% 0; }
    100% { background-position: -40% 0; }
  }

  /* Module + audience cards: subtle lift + accent-tinted border on hover.
     Reads as interactive without feeling like a SaaS landing page. */
  .audit-first-home .modules .mod,
  .audit-first-home .audience .col {
    transition:
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 320ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 320ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .audit-first-home .modules .mod:hover,
  .audit-first-home .audience .col:hover {
    transform: translateY(-3px);
    box-shadow:
      0 12px 28px rgba(14, 26, 44, 0.06),
      0 0 0 1px rgba(143, 191, 63, 0.20),
      inset 0 1px 0 rgba(143, 191, 63, 0.15);
  }

  /* Subtle scale-in on numbox numbers as they enter view (paired with
     the JS counter that animates the actual digits). */
  .audit-first-home .numbox .v {
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .audit-first-home .numbox .v.counting {
    transform: scale(1.02);
  }
  .audit-first-home .numbox .v.counting::after {
    /* Tiny blinking cursor while the count animates - reads as
       "system reading the number" rather than decoration. */
    content: '_';
    margin-left: 4px;
    color: var(--accent, #8FBF3F);
    opacity: 0.7;
    animation: numbox-cursor-blink 0.6s steps(2) infinite;
  }
  @keyframes numbox-cursor-blink {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-progress-fill { display: none; }
    .audit-first-home h2 .ital.in-view,
    .audit-first-home h3 .ital.in-view {
      animation: none;
      background: none;
      -webkit-text-fill-color: var(--ink-italic, #3A4658);
      color: var(--ink-italic, #3A4658);
    }
    .audit-first-home .modules .mod,
    .audit-first-home .audience .col,
    .audit-first-home .numbox .v { transition: none; }
    .audit-first-home .modules .mod:hover,
    .audit-first-home .audience .col:hover { transform: none; }
    .audit-first-home .numbox .v.counting::after { display: none; }
  }

  /* -------- live scan overlay (lifted from /audit/v3) -------- */
  /* Fullscreen ID overrides the .scan { max-width: 1040px } rule from audit.css
     so the overlay fills the viewport instead of being capped. */
  #scanOverlay { position: fixed; inset: 0; max-width: none; width: 100vw; height: 100vh; border: 0; background: var(--ink); color: var(--on-ink); z-index: 9999; display: none; flex-direction: column; padding: var(--sp-10) var(--sp-12); overflow: hidden; font-family: var(--mono); }
  #scanOverlay.live { display: flex; }
  #scanOverlay .scan-top { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--on-ink-line); padding-bottom: var(--sp-5); margin-bottom: var(--sp-8); font-size: var(--t-meta); letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--on-ink-faint); }
  #scanOverlay .scan-top b { color: var(--on-ink); font-weight: 500; }
  #scanOverlay .scan-top .wordmark { color: var(--on-ink); font-family: var(--grotesk); font-weight: 700; font-size: 22px; letter-spacing: -0.05em; text-transform: none; }
  #scanOverlay .dot-live { display: inline-block; width: 8px; height: 8px; border-radius: var(--r-pill); background: var(--accent); animation: pulse 1.2s var(--ease) infinite; margin-right: 12px; vertical-align: middle; }
  #scanOverlay .scan-body { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--sp-12); height: 100%; overflow: hidden; }
  @media (max-width: 980px) { #scanOverlay .scan-body { grid-template-columns: 1fr; } }
  #scanOverlay .scan-log { border: 1px solid var(--on-ink-line); padding: var(--sp-6); height: 100%; overflow: hidden; position: relative; }
  #scanOverlay .scan-log .log-head { font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--on-ink-faint); border-bottom: 1px solid var(--on-ink-line); padding-bottom: var(--sp-3); margin-bottom: var(--sp-4); }
  #scanOverlay .scan-log .log-list { font-size: 12.5px; line-height: 1.7; color: var(--on-ink-dim); max-height: 60vh; overflow: hidden; }
  #scanOverlay .scan-log .log-list .line { display: block; }
  #scanOverlay .scan-log .log-list .ts { color: var(--on-ink-faint); margin-right: var(--sp-3); }
  #scanOverlay .scan-log .log-list .tag { display: inline-block; min-width: 50px; }
  #scanOverlay .scan-log .log-list .tag.ok { color: var(--accent); }
  #scanOverlay .scan-log .log-list .tag.warn { color: var(--signal-warn); }
  #scanOverlay .scan-log .log-list .tag.fail { color: var(--signal-halt); }
  #scanOverlay .scan-log .log-list .tag.run { color: var(--on-ink); }
  #scanOverlay .scan-log .log-list .arrow { color: var(--on-ink-faint); margin: 0 6px; }
  #scanOverlay .scan-log .log-list .em { color: var(--on-ink); }
  #scanOverlay .scan-side h3 { font-family: var(--grotesk); font-weight: 700; font-size: clamp(36px, 4.4vw, 56px); line-height: 1.02; letter-spacing: var(--track-h); margin: 0 0 var(--sp-6); color: var(--on-ink); text-wrap: balance; }
  #scanOverlay .scan-side h3 .ital { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--on-ink-italic); }
  #scanOverlay .scan-side .progress { border-top: 1px solid var(--on-ink-line); border-bottom: 1px solid var(--on-ink-line); padding: var(--sp-5) 0; margin: var(--sp-7) 0; display: grid; grid-template-columns: 1fr auto; gap: var(--sp-3); align-items: baseline; }
  #scanOverlay .scan-side .progress .pct { font-family: var(--grotesk); font-weight: 800; font-size: 96px; line-height: 0.9; letter-spacing: var(--track-display); color: var(--on-ink); }
  #scanOverlay .scan-side .progress .pct sup { font-size: 0.32em; vertical-align: 38px; color: var(--on-ink-faint); margin-left: 4px; }
  #scanOverlay .scan-side .progress .label { font-family: var(--mono); font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--on-ink-faint); }
  #scanOverlay .scan-side .bar { height: 6px; background: var(--on-ink-line); margin-top: var(--sp-3); position: relative; overflow: hidden; }
  #scanOverlay .scan-side .bar .fill { position: absolute; inset: 0 100% 0 0; background: var(--accent); transition: right 0.4s linear; }
  #scanOverlay .scan-side .lane { display: grid; grid-template-columns: 22px 1fr auto; gap: var(--sp-3); padding: 10px 0; border-bottom: 1px solid var(--on-ink-line); align-items: center; }
  #scanOverlay .scan-side .lane:last-child { border-bottom: 0; }
  #scanOverlay .scan-side .lane .ix { font-family: var(--mono); font-size: 10.5px; letter-spacing: var(--track-mono); color: var(--on-ink-faint); }
  #scanOverlay .scan-side .lane .nm { font-family: var(--grotesk); font-size: 15px; color: var(--on-ink-dim); }
  #scanOverlay .scan-side .lane.done .nm { color: var(--on-ink); }
  #scanOverlay .scan-side .lane .st { font-family: var(--mono); font-size: 10.5px; letter-spacing: var(--track-mono); text-transform: uppercase; color: var(--on-ink-faint); }
  #scanOverlay .scan-side .lane.done .st { color: var(--accent); }
  #scanOverlay .scan-side .lane.run .st { color: var(--on-ink); }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('homeAuditForm');
    var overlay = document.getElementById('scanOverlay');
    if (!form) return;

    var logList = document.getElementById('logList');
    var pctVal = document.getElementById('pctVal');
    var barFill = document.getElementById('barFill');
    var elapsed = document.getElementById('elapsed');
    var scanDomain = document.getElementById('scanDomain');
    var lanes = overlay ? overlay.querySelectorAll('.scan-side .lane') : [];

    function makeScript(domain) {
      return [
        ['run',  'resolve dns ' + domain,                    'A record'],
        ['ok',   'fetch / robots.txt',                       'parsing'],
        ['ok',   'fetch / sitemap.xml',                      'parsing'],
        ['ok',   'fetch /index.html (cold)',                 'live HTML'],
        ['ok',   'parse <head>',                             'meta, canonical, og:type'],
        ['ok',   'parse JSON-LD',                            'Organization + WebSite'],
        ['run',  'PSI · mobile lighthouse',                  'started'],
        ['ok',   'PSI · core web vitals',                    'LCP / FCP / CLS / INP'],
        ['ok',   'fingerprint · static',                     'tech detection'],
        ['run',  'headless · 390x844',                       'Chromium booting'],
        ['ok',   'headless · scrollWidth + tap targets',     'real DOM'],
        ['ok',   'fingerprint · runtime',                    'GTM-injected pixels'],
        ['ok',   'DoH · SPF lookup',                         'Cloudflare 1.1.1.1'],
        ['ok',   'DoH · DMARC lookup',                       'policy + MX'],
        ['ok',   'fetch /llms.txt',                          'AEO probe'],
        ['ok',   'Meta Ad Library',                          'active creatives'],
        ['ok',   'LinkedIn Ad Library',                      'active creatives'],
        ['ok',   'Google Ad Library',                        'active creatives'],
        ['ok',   'score · composite',                        'weighted band'],
        ['ok',   'memo · render',                            'verdict + fixes'],
      ];
    }

    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function tsAt(seconds) {
      var s = Math.floor(seconds);
      var ms = Math.floor((seconds - s) * 1000);
      return pad(s) + '.' + pad(Math.floor(ms / 10));
    }

    var laneTriggers = {
      0: { start: 1,  end: 5  },
      1: { start: 14, end: 15 },
      2: { start: 6,  end: 8  },
      3: { start: 8,  end: 12 },
      4: { start: 15, end: 18 },
      5: { start: 4,  end: 6  },
      6: { start: 9,  end: 11 },
      7: { start: 12, end: 14 },
      8: { start: 11, end: 12 },
    };

    function setLane(i, state) {
      var l = lanes[i]; if (!l) return;
      var st = l.querySelector('.st');
      l.classList.remove('run', 'done');
      if (state === 'run')  { l.classList.add('run');  if (st) st.textContent = 'running'; }
      else if (state === 'done') { l.classList.add('done'); if (st) st.textContent = 'ok'; }
      else if (st) st.textContent = 'queued';
    }

    function startScan(domain) {
      if (!overlay) return;
      if (scanDomain) scanDomain.textContent = domain;
      overlay.setAttribute('aria-hidden', 'false');
      overlay.classList.add('live');
      if (logList) logList.innerHTML = '';
      lanes.forEach(function (_, i) { setLane(i, 'queued'); });
      if (pctVal) pctVal.textContent = '0';
      if (barFill) barFill.style.right = '100%';
      if (elapsed) elapsed.textContent = '00.0s';

      var script = makeScript(domain);
      var totalMs = 26000;
      var perLine = totalMs / script.length;
      var startTime = performance.now();

      script.forEach(function (item, i) {
        setTimeout(function () {
          var t = (performance.now() - startTime) / 1000;
          var doneRatio = (i + 1) / script.length;
          if (pctVal) pctVal.textContent = Math.round(doneRatio * 92);
          if (barFill) barFill.style.right = (100 - doneRatio * 92) + '%';
          if (elapsed) elapsed.textContent = tsAt(t) + 's';

          Object.keys(laneTriggers).forEach(function (li) {
            var trig = laneTriggers[li];
            if (i >= trig.start && i < trig.end) setLane(parseInt(li, 10), 'run');
            if (i >= trig.end) setLane(parseInt(li, 10), 'done');
          });

          if (logList) {
            var div = document.createElement('span');
            div.className = 'line';
            var tag = item[0].toUpperCase();
            div.innerHTML =
              '<span class="ts">' + tsAt(t) + 's</span>' +
              '<span class="tag ' + item[0] + '">[' + tag + ']</span> ' +
              item[1] +
              ' <span class="arrow">→</span> <span class="em">' + item[2] + '</span>';
            logList.appendChild(div);
            while (logList.children.length > 14) logList.removeChild(logList.firstChild);
          }
        }, i * perLine);
      });

      setTimeout(function () {
        lanes.forEach(function (_, i) { setLane(i, 'done'); });
        var stall = 95;
        var stallTimer = setInterval(function () {
          if (stall >= 99) { clearInterval(stallTimer); return; }
          stall += 0.4;
          if (pctVal) pctVal.textContent = Math.round(stall);
          if (barFill) barFill.style.right = (100 - stall) + '%';
          var t = (performance.now() - startTime) / 1000;
          if (elapsed) elapsed.textContent = tsAt(t) + 's';
        }, 1500);
      }, totalMs + 200);
    }

    form.addEventListener('submit', function () {
      var input = form.querySelector('input[name="url"]');
      var normalized = '';
      if (input) {
        normalized = input.value.trim().replace(/^https?:\/\//, '').replace(/\/$/, '');
        input.value = normalized;
      }
      if (window.posthog && window.posthog.capture) {
        window.posthog.capture('audit_form_submitted', {
          surface: 'homepage',
          form_id: 'homeAuditForm',
          input_domain: normalized,
          source: 'home_preview',
          path: window.location.pathname,
        }, { send_instantly: true, transport: 'sendBeacon' });
        window.posthog.capture('audit_v3_form_submitted', {
          input_domain: normalized,
          source: 'home_preview',
          path: window.location.pathname,
        }, { send_instantly: true, transport: 'sendBeacon' });
      }
      // Don't preventDefault — the form POSTs naturally to /audit/v3.
      // The browser waits up to ~30s for the response while this overlay
      // animates. When /audit/v3 returns, the new page replaces this one
      // and the overlay dies with it.
      startScan(normalized || 'somewhere.com');
    });
  })();
</script>

<script is:inline>
  // Smart scroll motion: progress line, one-shot sheen on section italics,
  // and counters on the proof-number blocks. All IntersectionObserver-driven,
  // no library, respects prefers-reduced-motion.
  (function () {
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return;

    // -- 1. Scroll progress line at top of viewport.
    var fill = document.getElementById('scrollProgressFill');
    if (fill) {
      var rafPending = false;
      function updateProgress() {
        rafPending = false;
        var doc = document.documentElement;
        var max = (doc.scrollHeight - doc.clientHeight) || 1;
        var pct = Math.min(100, Math.max(0, (window.scrollY / max) * 100));
        fill.style.width = pct.toFixed(2) + '%';
      }
      function onScroll() {
        if (rafPending) return;
        rafPending = true;
        requestAnimationFrame(updateProgress);
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      updateProgress();
    }

    // -- 2. One-shot sheen sweep on section italics as they scroll in.
    var italics = document.querySelectorAll(
      '.audit-first-home h2 .ital, .audit-first-home h3 .ital'
    );
    if (italics.length && 'IntersectionObserver' in window) {
      var italObs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('in-view');
            italObs.unobserve(e.target);
          }
        });
      }, { threshold: 0.4, rootMargin: '0px 0px -10% 0px' });
      italics.forEach(function (el) { italObs.observe(el); });
    }

    // -- 3. Number counters on the proof / track-record numboxes.
    // Parses the leading number out of the .v text, animates 0 → target,
    // preserves the existing suffix markup (e.g. <span class="ital">+</span>).
    // Skips non-numeric or range values ("60–85", "0 / 15") so they stay static.
    var nums = document.querySelectorAll('.audit-first-home .numbox .v');
    if (nums.length && 'IntersectionObserver' in window) {
      function animateNumber(el) {
        // Capture original markup so we can restore the italic suffix.
        var original = el.innerHTML;
        // Try to find a leading integer optionally prefixed by $ and followed
        // by an optional M/K. Anything that doesn't match cleanly is skipped.
        var m = el.textContent.trim().match(/^(\$?)(\d+)([MK]?)/);
        if (!m) return;
        var prefix = m[1] || '';
        var target = parseInt(m[2], 10);
        var suffix = m[3] || '';
        if (target <= 0) return;
        // Preserve the trailing italic markup so the suffix returns intact.
        var italMatch = original.match(/<span class="ital"[^>]*>[\s\S]*<\/span>/);
        var italHtml = italMatch ? ' ' + italMatch[0] : '';
        // Preserve zero-padding if the original was "04" or "05".
        var pad = (m[2].length > 1 && m[2].charAt(0) === '0') ? m[2].length : 0;

        el.classList.add('counting');
        var startTime = null;
        var duration = 1200;
        function step(t) {
          if (!startTime) startTime = t;
          var p = Math.min(1, (t - startTime) / duration);
          // ease-out-cubic
          var eased = 1 - Math.pow(1 - p, 3);
          var v = Math.round(eased * target);
          var vStr = pad ? String(v).padStart(pad, '0') : String(v);
          el.innerHTML = prefix + vStr + suffix + italHtml;
          if (p < 1) {
            requestAnimationFrame(step);
          } else {
            el.classList.remove('counting');
            el.innerHTML = original; // restore exact original markup
          }
        }
        requestAnimationFrame(step);
      }
      var numObs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            animateNumber(e.target);
            numObs.unobserve(e.target);
          }
        });
      }, { threshold: 0.6 });
      nums.forEach(function (el) { numObs.observe(el); });
    }
  })();
</script>
