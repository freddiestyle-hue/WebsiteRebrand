---
import Base from '../layouts/Base.astro';
import CadenceIcon from '../components/icons/Cadence.astro';
import DiagnosticIcon from '../components/icons/Diagnostic.astro';
import MemoIcon from '../components/icons/Memo.astro';
import NumbersIcon from '../components/icons/Numbers.astro';
import OutreachIcon from '../components/icons/Outreach.astro';
import PipelineIcon from '../components/icons/Pipeline.astro';
import SignalIcon from '../components/icons/Signal.astro';
import StackIcon from '../components/icons/Stack.astro';
---
<Base
  title="Rivett · Find and fix revenue leaks"
  description="A senior growth practice for profitable US operators. Run the Revenue MRI, diagnose the leaks, and rebuild the system between demand and revenue."
  fontWeights="Inter+Tight:wght@400;500;600;700"
  currentNav="home"
>
  <div class="page home-page">
    <section class="first">
      <div class="hero">
        <div>
          <div class="stamp">Ran growth at Somewhere.com · $100M+ managed</div>
          <h1 class="display display--hero">
            I find where<br/>
            revenue leaks.<br/>
            <span class="ital">Then I fix the system<span class="accent-dot">.</span></span>
          </h1>
          <p class="lede">
            I work with profitable US operators to find the expensive leaks between demand and revenue, then rebuild the reporting, handoffs, follow-up, and AI-assisted workflows that keep money moving.
          </p>
          <div class="hero-cta">
            <a href="/revenue-leak-mri" class="btn primary">Run the Revenue MRI →</a>
            <a href="/diagnostic" class="btn secondary">Book diagnostic</a>
          </div>
          <p class="funnel-note">60-sec self-serve. The diagnostic ($3,500) picks up where the MRI ends. One earns the right to the other.</p>
          <p class="past-work-credit" aria-labelledby="past-work-stamp">
            <span class="stamp" id="past-work-stamp">Past work</span>
            <span class="credit">
              Fifteen years on growth at Somewhere, Unilever, Samsung, Visa, and Vodafone. <span class="ital">In-house, agency, and vendor.</span>
            </span>
          </p>
        </div>

        <aside class="hero-r" aria-label="Rivett proof and next step">
          <div class="proof-kicker">Proof from the work</div>
          <p class="proof-copy">
            Before selling the system, I ran it on my own pipeline for 90 days. The first hard failure was caught internally, rebuilt, and turned into the approval discipline clients get.
          </p>
          <div class="row"><span class="k">Throughput</span><span class="v">10 prospects / hr to review queue</span></div>
          <div class="row"><span class="k">Review rhythm</span><span class="v">80 decisions / day at pace</span></div>
          <div class="row"><span class="k">Calibration</span><span class="v">60% to 85% approval by week 12</span></div>
          <div class="row"><span class="k">Failure caught</span><span class="v">0 / 15 ICP miss before client work</span></div>
          <a href="/blog/90-days-sdr-agent-results" class="proof-link">Read the 90-day note →</a>
        </aside>
      </div>
    </section>

    <section id="modules">
      <div class="sec-head">
        <div class="label"><b>01</b> · The work</div>
        <div>
          <h2 class="section-title">A fixed path from leak to operating rhythm.</h2>
          <p class="lede lede-offset">First I find the leaks. Then I build the highest-value fixes. If the rhythm matters enough to keep, I run the system with dashboards, alerts, weekly decisions, and board-grade summaries.</p>
        </div>
      </div>

      <div class="modules">
        <div class="module featured">
          <div class="head">
            <span class="module-mark">
              <DiagnosticIcon size={24} class="module-icon" />
              <span class="num">M01 · Diagnostic</span>
            </span>
            <span class="dur">02 wks</span>
          </div>
          <h3>Find the leaks, name the constraints, and decide what is worth fixing.</h3>
          <ul>
            <li>Acquisition &amp; channel teardown</li>
            <li>Funnel + lifecycle audit</li>
            <li>Tooling &amp; AI workflow review</li>
            <li>Prioritized 90-day fix list</li>
          </ul>
          <div class="price">
            <div class="p"><span class="cur">USD</span>3,500</div>
            <div class="term">Fixed · credited to M02</div>
          </div>
        </div>

        <div class="module">
          <div class="head">
            <span class="module-mark">
              <StackIcon size={24} class="module-icon" />
              <span class="num">M02 · Build</span>
            </span>
            <span class="dur">04-06 wks</span>
          </div>
          <h3>Rebuild acquisition and revenue operations around the highest-value fixes.</h3>
          <ul>
            <li>Paid media rebuild · GA / Meta / LinkedIn</li>
            <li>SEO foundations &amp; programmatic</li>
            <li>Lifecycle &amp; CRM activation</li>
            <li>AI-assisted workflows with approval gates</li>
          </ul>
          <div class="price">
            <div class="p p-muted">Scoped after M01</div>
            <div class="term">Fixed-scope quote</div>
          </div>
        </div>

        <div class="module">
          <div class="head">
            <span class="module-mark">
              <CadenceIcon size={24} class="module-icon" />
              <span class="num">M03 · Run</span>
            </span>
            <span class="dur">monthly</span>
          </div>
          <h3>Maintain the weekly rhythm that keeps revenue moving.</h3>
          <ul>
            <li>Weekly working sessions</li>
            <li>Live dashboard &amp; alerting</li>
            <li>Monthly board summary</li>
            <li>Cancel any month</li>
          </ul>
          <div class="price">
            <div class="p p-muted">Scoped after M01</div>
            <div class="term">Month-to-month</div>
          </div>
        </div>
      </div>
      <div class="modules-foot">M01 fee credits in full toward M02 if you continue. No long contracts. No retainer creep.</div>
    </section>

    <section id="who">
      <div class="sec-head">
        <div class="label"><b>02</b> · Who this is for</div>
        <div>
          <h2 class="section-title">Operators of profitable, un-glamorous businesses. Real revenue, ready to compound.</h2>
          <p class="lede lede-offset">You already have demand. The problem is what happens around it.</p>
        </div>
      </div>

      <div class="who-grid">
        <div class="who-cell">
          <div class="tag">01</div>
          <h3>Real estate operators &amp; brokerages.</h3>
          <p>Self-storage, multifamily, brokerage, REPE. Capital raise, sphere and farm, leasing pipeline.</p>
        </div>
        <div class="who-cell">
          <div class="tag">02</div>
          <h3>Service businesses &amp; agencies.</h3>
          <p>Boring, profitable, growing. Construction, manufacturing, professional services, agency owners. 50-500 people, real revenue, ready to compound.</p>
        </div>
        <div class="who-cell">
          <div class="tag">03</div>
          <h3>Founders &amp; operators of mid-market companies.</h3>
          <p>50 to 500 people, profitable, ready to compound. You do not want a slick agency. You want senior judgment on the growth system underneath the business.</p>
        </div>
      </div>
      <div class="fit-foot">
        <p>If you do not see yourself here exactly, <a href="#contact">email me anyway</a>. I will tell you straight if I am the wrong call.</p>
        <p><strong>Probably not:</strong> you want a junior to take orders, a yes-person, or a generic AI roadmap.</p>
      </div>
    </section>

    <section id="about">
      <div class="sec-head">
        <div class="label"><b>03</b> · Track record</div>
        <h2 class="section-title">Fifteen years inside acquisition. Now applied to the whole system.</h2>
      </div>

      <div class="inherit">
        <div>
          <div class="op-byline">
            <picture>
              <source type="image/avif" srcset="/img/portrait/fred-96.avif 1x, /img/portrait/fred-192.avif 2x" />
              <source type="image/webp" srcset="/img/portrait/fred-96.webp 1x, /img/portrait/fred-192.webp 2x" />
              <img src="/img/portrait/fred-96.png" srcset="/img/portrait/fred-96.png 1x, /img/portrait/fred-192.png 2x" width="48" height="48" alt="Fred Style" loading="lazy" decoding="async" />
            </picture>
            <div>
              <div class="op-name">Fred Style</div>
              <div class="op-role">Founder · Operator · Sole point of contact</div>
            </div>
          </div>
          <p class="editorial">Paid acquisition is the proof. <span class="em">Revenue operations are the work.</span></p>
          <p class="body">
            Fifteen years inside paid acquisition for brands across consumer, B2B and DTC. Most recently running growth at <strong>Somewhere.com</strong>, the global recruiting platform. Before that, in-house performance leadership across four continents and roughly $100M in managed spend.
          </p>
        </div>

        <div>
          <div class="label">By the numbers</div>
          <div class="roster roster--tight">
            <div class="row"><span class="nm">Career</span><span class="ds">Paid acquisition, in-house and consulting</span><span class="yr">15 yrs</span></div>
            <div class="row"><span class="nm">Most recent</span><span class="ds">Growth, Somewhere.com</span><span class="yr">1 yr</span></div>
            <div class="row"><span class="nm">Managed spend</span><span class="ds">Paid search, social, programmatic</span><span class="yr">$100M+</span></div>
            <div class="row"><span class="nm">Continents</span><span class="ds">USA, Africa, Europe, Asia</span><span class="yr">4</span></div>
            <div class="row"><span class="nm">Sectors</span><span class="ds">Consumer, B2B, DTC, recruiting, media</span><span class="yr">5+</span></div>
          </div>
          <p class="body body-small body-loose">
            Independent. Cape Town based. Available to a small number of operators per quarter.
          </p>
        </div>
      </div>
    </section>

    <section id="why-sa" class="section-flush">
      <div class="geo">
        <div class="inner">
          <div>
            <div class="sec-head sec-head--dark">
              <div class="label"><b>04</b> · The deal</div>
              <div>
                <h2 class="section-title">Senior judgment. Different cost structure. <span class="em">No agency markup.</span></h2>
                <p class="lede lede-offset">
                  I work from Cape Town by design. The advantage is not "cheap." It is structural: direct access to the operator doing the work, senior growth judgment on the system, and AI-assisted execution underneath without paying for a US agency org chart.
                </p>
              </div>
            </div>
          </div>
          <div class="compare">
            <div class="row head"><span class="lab">Senior growth support</span><span class="lab">Annualized</span></div>
            <div class="row us"><span class="val">US agency, retainer</span><span class="val">$300–500k</span></div>
            <div class="row us"><span class="val">In-house VP marketing</span><span class="val">$220–280k</span></div>
            <div class="row us"><span class="val">Boutique consultancy</span><span class="val">$180–240k</span></div>
            <div class="row rivett"><span class="lab">Rivett · M03 retainer</span><span class="val">~⅓ of the above</span></div>
          </div>
        </div>
      </div>
    </section>

    <section id="approach">
      <div class="sec-head">
        <div class="label"><b>05</b> · AI in the work</div>
        <div>
          <h2 class="section-title">AI belongs below the judgment layer.</h2>
          <p class="lede lede-offset">The valuable work is deciding what matters. AI belongs underneath that judgment, not in place of it.</p>
        </div>
      </div>

      <div class="ai-grid">
        <div>
          <p class="body">
            Most agencies are now selling the busywork as the product. <strong>I am selling senior judgment, with the busywork automated underneath.</strong> Different deal.
          </p>
        </div>
        <div>
          <div class="twocol">
            <div>
              <div class="mini-head yes">What I automate</div>
              <ul class="automate-list">
                <li><PipelineIcon size={20} class="automate-icon" /><span>Lead enrichment &amp; routing</span></li>
                <li><OutreachIcon size={20} class="automate-icon" /><span>Draft outreach &amp; sequencing</span></li>
                <li><NumbersIcon size={20} class="automate-icon" /><span>Daily / weekly reporting</span></li>
                <li><SignalIcon size={20} class="automate-icon" /><span>Anomaly &amp; spend alerts</span></li>
                <li><MemoIcon size={20} class="automate-icon" /><span>Content briefs at scale</span></li>
              </ul>
            </div>
            <div>
              <div class="mini-head no">What stays human</div>
              <ul>
                <li class="dim">Audience &amp; positioning calls</li>
                <li class="dim">Channel mix &amp; budget</li>
                <li class="dim">Creative &amp; message strategy</li>
                <li class="dim">Pricing &amp; offer design</li>
                <li class="dim">The hard conversation about why it is not working</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="section-borderless">
      <div class="cta-block">
        <div>
          <div class="sec-head cta-head">
            <div class="label"><b>06</b> · Next step</div>
            <div>
              <h2 class="section-title">Start with the <span class="em">MRI.</span></h2>
              <p class="lede lede-offset">Run the free scan first. If it points at a real leak, the diagnostic turns that signal into a written fix list. Two weeks. $3,500, fixed. Credited to the build if you continue.</p>
            </div>
          </div>
        </div>
        <div class="actions">
          <a href="/revenue-leak-mri" class="btn primary">Run the Revenue MRI →</a>
          <a href="/diagnostic" class="btn secondary">Book diagnostic</a>
          <div class="meta">fred@rivett.tech · reply within 24 hours</div>
        </div>
      </div>
    </section>

    <footer class="foot">
      <div>
        <a class="wordmark" href="/" aria-label="Rivett, home">
          <img src="/img/marks/wordmark.svg" alt="" width="96" height="24" decoding="async" />
        </a>
        <div class="legal">A practice · est. 2026<br/>Cape Town · remote-first</div>
      </div>
      <div class="col">
        <div class="foot-label">The work</div>
        <ul>
          <li>
            <a class="work-link" href="#modules">
              <DiagnosticIcon size={16} class="foot-icon" />
              <span>M01 · Diagnostic</span>
            </a>
          </li>
          <li>
            <a class="work-link" href="#modules">
              <StackIcon size={16} class="foot-icon" />
              <span>M02 · Build</span>
            </a>
          </li>
          <li>
            <a class="work-link" href="#modules">
              <CadenceIcon size={16} class="foot-icon" />
              <span>M03 · Run</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="col">
        <div class="foot-label">About</div>
        <ul>
          <li><a href="#about">Track record</a></li>
          <li><a href="#approach">AI in the work</a></li>
          <li><a href="/blog">Field Notes</a></li>
        </ul>
      </div>
      <div class="col">
        <div class="foot-label">Contact</div>
        <ul>
          <li><a href="/revenue-leak-mri">Run MRI →</a></li>
          <li><a href="/diagnostic">Book diagnostic</a></li>
          <li><a href="mailto:fred@rivett.tech">fred@rivett.tech</a></li>
          <li><a href="https://www.linkedin.com/in/fredstyle/">LinkedIn</a></li>
        </ul>
      </div>
    </footer>
  </div>
</Base>
