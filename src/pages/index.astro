  /* -------- scroll-driven motion (smart, sparing) -------- */

  /* Thin scroll-progress line, fixed top edge. Accent green fill grows
     left-to-right as the reader moves through the page. */
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: transparent;
    z-index: 99;
    pointer-events: none;
  }
  .scroll-progress-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(
      90deg,
      rgba(143, 191, 63, 0.5) 0%,
      var(--accent, #8FBF3F) 60%,
