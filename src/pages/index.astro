---
// Homepage — 2026 Rivett rebrand.
//
// Ported verbatim from the "Rivett Homepage" handoff bundle. The handoff
// ships as a React/DC component; everything here is the same markup with the
// runtime bindings resolved: sc-if -> hidden panels driven by the inline
// script, style-hover -> the .rv-* classes in the style block, and the two
// scan forms wired to the live /audit/v3 endpoint.
import HomeBase from '../layouts/HomeBase.astro';

// Logo strip. Three slots, each flipping to the next brand every 6s — slot k
// shows brands[(idx + k*2) % N] with brands[(idx + 1 + k*2) % N] queued below.
const brands = [
  { name: 'Samsung', src: '/img/brands/samsung.svg', h: '19px' },
  { name: 'Visa', src: '/img/brands/visa.svg', h: '22px' },
  { name: 'Unilever', src: '/img/brands/unilever.svg', h: '24px' },
  { name: 'Al Jazeera', src: '/img/brands/aljazeera.svg', h: '36px' },
  { name: 'WPP', src: '/img/brands/wpp.svg', h: '26px' },
  { name: 'Publicis Groupe', src: '/img/brands/publicis.svg', h: '48px' },
  { name: 'Vodafone', src: '/img/brands/vodafone.svg', h: '30px' },
  { name: 'Somewhere', src: '/img/brands/somewhere.svg', h: '22px', w: '65%' },
];
const N = brands.length;
const slots = [0, 1, 2].map((k) => ({
  k,
  cur: brands[(k * 2) % N],
  next: brands[(1 + k * 2) % N],
}));
const logoImgStyle = (b: (typeof brands)[number]) =>
  `height:${b.h};width:${b.w || '100%'};object-fit:contain;filter:grayscale(1) opacity(0.62)`;
---
<HomeBase
  title="Rivett · I run ads that make you money"
  description="And I fix everything between the click and the contract. Fifteen years, $100M+ of ad spend, one person on your account."
>
<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html, body {
    margin: 0;
    padding: 0;
    background: #FFFFFF;
    color: #163300;
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }
  a { color: #163300; text-decoration: none; }
  a:hover { color: #4A6E18; }
  button { font: inherit; color: inherit; cursor: pointer; }
  img, svg { display: block; max-width: 100%; }
  ::selection { background: #A5E85C; color: #163300; }
  :focus { outline: none; }
  :focus-visible { outline: 2px solid #4A6E18; outline-offset: 2px; }
  .riv-rail::-webkit-scrollbar { display: none; }
  @media (max-width: 560px) {
    .riv-logoslot { flex: 0 1 200px !important; }
    .riv-logoslot1, .riv-logoslot2 { display: none !important; }
  }
  @media (max-width: 720px) {
    .riv-navlinks { display: none !important; }
    .riv-tabs button { font-size: 13px !important; padding: 12px 2px !important; white-space: nowrap; }
  }
  /* Hero: the swish under "money". Drawn 3s after arrival — late enough
     that the reader has finished the headline and the movement pulls the
     eye back to the promise, rather than competing with it on load. */
  .rv-swish { position: relative; display: inline-block; white-space: nowrap; }
  .rv-swish-line {
    position: absolute;
    left: -0.01em;
    width: calc(100% + 0.03em);
    bottom: -0.1em;
    height: 0.2em;
    overflow: visible;
    pointer-events: none;
  }
  .rv-swish-line path {
    /* pathLength="1" normalises the path, so this is "one dash the length
       of the whole stroke, then a gap twice that". The oversized gap
       matters: with a repeating pattern the next dash peeks in at the tail
       while the first is still offset out. Offsetting slightly past 1 keeps
       the round line-cap from showing as a dot before the draw starts. */
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1.05;
    animation: rv-swish-draw 620ms cubic-bezier(0.65, 0, 0.35, 1) 3s forwards;
  }
  @keyframes rv-swish-draw { to { stroke-dashoffset: 0; } }

  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
  /* The blanket rule above would strand the swish mid-draw, so show it
     already drawn instead of animating it in. */
  @media (prefers-reduced-motion: reduce) {
    .rv-swish-line path { stroke-dashoffset: 0; }
  }

  /* Hover states — the handoff carries these as style-hover attributes on
     elements whose base colours are inline, so they live here instead. */
  .rv-navlink { color: #FFFFFF; }
  .rv-navlink:hover { color: #A5E85C; }
  .rv-navcta { background: #A5E85C; color: #163300; }
  .rv-navcta:hover { background: #FFFFFF; color: #163300; }
  .rv-submit { background: #163300; color: #FFFFFF; }
  .rv-submit:hover { background: #FFFFFF; color: #163300; }
  .rv-ctadark { background: #163300; color: #FFFFFF; }
  .rv-ctadark:hover { background: #A5E85C; color: #163300; }
  .rv-railbtn { background: #FFFFFF; }
  .rv-railbtn:hover { background: #F2F5EC; }
  .rv-note { background: #F2F5EC; }
  .rv-note:hover { background: #EEF7E0; }
  [hidden] { display: none !important; }
</style>

<div style="background:#163300"><nav style="max-width:1280px;margin:0 auto;padding:22px clamp(20px,4vw,56px);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px 32px">
  <a href="#top" aria-label="Rivett, home" style="display:inline-flex;align-items:center;gap:0.12em;font-family:'Inter Tight',system-ui,sans-serif;font-weight:700;font-size:28px;letter-spacing:-0.05em;line-height:1;color:#A5E85C">rivett<span style="display:inline-block;width:0.32em;height:0.32em;border-radius:999px;background:#FFFFFF;transform:translateY(0.04em)"></span></a>
  <div class="riv-navlinks" style="display:flex;flex-wrap:wrap;align-items:center;gap:12px 30px;font-size:16px;font-weight:500">
    <a class="rv-navlink" href="#work">What I do</a>
    <a class="rv-navlink" href="#cost">What it costs</a>
    <a class="rv-navlink" href="#notes">Notes</a>
    <a class="rv-navlink" href="#about">About me</a>
    <a class="rv-navlink" href="#faq">Questions</a>
  </div>
  <a class="rv-navcta" href="#scan" style="display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:15px;padding:12px 22px;border-radius:999px">Check my site →</a>
</nav>

<header id="top" style="max-width:1180px;margin:0 auto;padding:clamp(48px,7vw,84px) clamp(20px,4vw,56px) clamp(32px,4vw,48px);text-align:center">
  <h1 style="font-family:Archivo,sans-serif;font-weight:900;font-variation-settings:'wdth' 87;text-transform:uppercase;font-size:clamp(44px,7.4vw,104px);line-height:0.86;letter-spacing:-0.035em;margin:0 auto;max-width:14ch;color:#FFFFFF;text-wrap:balance">I run ads that make you <span class="rv-swish">money<svg class="rv-swish-line" viewBox="0 0 200 14" fill="none" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M3 9.5C36 4.5 74 12 112 6.5c27-3.9 54 1.5 85-3" stroke="#A5E85C" stroke-width="3.2" stroke-linecap="round"/></svg></span></h1>
  <p style="font-size:20px;line-height:1.5;color:rgba(255,255,255,0.78);max-width:560px;margin:26px auto 0;text-wrap:pretty">And I fix everything between the click and the contract. Fifteen years, $100M+ of ad spend, one person on your account.</p>
</header>

<section style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px) clamp(56px,7vw,88px)">
  <div style="background:#A5E85C;border-radius:28px;padding:clamp(24px,3vw,36px);max-width:860px;margin:0 auto">
    <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;align-items:center;font-weight:600;font-size:13px;color:#2C4408">
      <span style="display:inline-flex;align-items:center;gap:10px"><span style="width:8px;height:8px;border-radius:999px;background:#163300"></span>Free check · yoursite.com</span>
      <span>Nine things · thirty seconds</span>
    </div>
    <form id="scan" method="POST" action="/audit/v3" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;background:#FFFFFF;border-radius:999px;padding:8px 8px 8px 24px;margin-top:22px">
      <span style="font-size:15px;color:#6F7A64;flex-shrink:0">https://</span>
      <input type="text" name="url" required placeholder="type your website address" aria-label="Your website address" autocomplete="off" spellcheck="false" style="flex:1 1 160px;min-width:0;border:0;background:transparent;font-family:'Instrument Sans',sans-serif;font-size:16px;color:#163300;padding:12px 0;outline:none">
      <input type="hidden" name="source" value="home">
      <button class="rv-submit" type="submit" data-cta="home_audit_form_submit" style="display:inline-flex;align-items:center;gap:10px;font-family:'Instrument Sans',sans-serif;font-weight:600;font-size:16px;padding:15px 26px;border:0;border-radius:999px;cursor:pointer;flex-shrink:0">Check my site →</button>
    </form>
    <div style="display:flex;flex-wrap:wrap;gap:12px 28px;justify-content:center;margin-top:22px;font-weight:600;font-size:14px;color:#1C2B18">
      <span>15 years of ads</span><span>·</span><span>$100M+ of ads run</span><span>·</span><span>No account managers</span>
    </div>
  </div>
</section></div>

<section aria-label="Brands I have run ads for" style="padding:clamp(36px,5vw,56px) 0 8px">
  <div style="text-align:center;font-weight:600;font-size:13.5px;letter-spacing:0.08em;text-transform:uppercase;color:#6F7A64;margin-bottom:26px">Brands I've run ads for</div>
  <div style="display:flex;justify-content:center;align-items:center;gap:clamp(28px,6vw,88px);padding:0 clamp(20px,4vw,56px)">
    {slots.map((s) => (
      <div class={`riv-logoslot riv-logoslot${s.k}`} data-slot={String(s.k)} style="position:relative;overflow:hidden;height:60px;flex:0 1 clamp(120px,20vw,190px)">
        <span data-face="cur" style="position:absolute;inset:0;display:grid;place-items:center;transform:translateY(0);transition:none"><img src={s.cur.src} alt={s.cur.name} style={logoImgStyle(s.cur)} /></span>
        <span data-face="next" aria-hidden="true" style="position:absolute;inset:0;display:grid;place-items:center;transform:translateY(100%);transition:none"><img src={s.next.src} alt="" style={logoImgStyle(s.next)} /></span>
      </div>
    ))}
  </div>
  <div aria-hidden="true" style="position:absolute;width:1px;height:1px;overflow:hidden;opacity:0">
    {brands.map((b) => <img src={b.src} alt="" />)}
  </div>
</section>

<section style="max-width:1280px;margin:0 auto;padding:clamp(36px,5vw,56px) clamp(20px,4vw,56px) 24px">
  <div style="display:flex;flex-wrap:wrap;gap:16px 48px;justify-content:space-between">
    <div style="flex:1 1 260px;display:flex;gap:16px;align-items:flex-start">
      <span style="width:44px;height:44px;border-radius:999px;background:#EEF7E0;display:grid;place-items:center;flex-shrink:0"><svg viewBox="0 0 24 24" style="width:22px;height:22px;fill:none;stroke:#163300;stroke-width:1.6;stroke-linecap:square;stroke-linejoin:miter"><circle cx="11" cy="11" r="6"></circle><path d="M15.5 15.5 L20 20"></path></svg></span>
      <div><div style="font-weight:600;font-size:17px">15 years doing this</div><p style="font-size:15.5px;line-height:1.5;color:#454745;margin:4px 0 0">Samsung, Visa, Unilever, Vodafone, Somewhere.</p></div>
    </div>
    <div style="flex:1 1 260px;display:flex;gap:16px;align-items:flex-start">
      <span style="width:44px;height:44px;border-radius:999px;background:#EEF7E0;display:grid;place-items:center;flex-shrink:0"><svg viewBox="0 0 24 24" style="width:22px;height:22px;fill:none;stroke:#163300;stroke-width:1.6;stroke-linecap:square;stroke-linejoin:miter"><path d="M3 7 L12 3 L21 7 L12 11 Z"></path><path d="M3 12 L12 16 L21 12"></path><path d="M3 17 L12 21 L21 17"></path></svg></span>
      <div><div style="font-weight:600;font-size:17px">$100M+ of ads run</div><p style="font-size:15.5px;line-height:1.5;color:#454745;margin:4px 0 0">Across four continents and five industries.</p></div>
    </div>
    <div style="flex:1 1 260px;display:flex;gap:16px;align-items:flex-start">
      <span style="width:44px;height:44px;border-radius:999px;background:#EEF7E0;display:grid;place-items:center;flex-shrink:0"><svg viewBox="0 0 24 24" style="width:22px;height:22px;fill:none;stroke:#163300;stroke-width:1.6;stroke-linecap:square;stroke-linejoin:miter"><circle cx="12" cy="9" r="4"></circle><path d="M4 21 a8 8 0 0 1 16 0"></path></svg></span>
      <div><div style="font-weight:600;font-size:17px">You get me, not a team</div><p style="font-size:15.5px;line-height:1.5;color:#454745;margin:4px 0 0">A few companies at a time. No account managers.</p></div>
    </div>
  </div>
</section>

<section id="work" style="background:#EEF7E0;padding:clamp(56px,7vw,88px) 0;margin-top:32px">
  <div style="max-width:1280px;margin:0 auto;padding:0 clamp(20px,4vw,56px)">
    <span style="font-family:'DM Mono',monospace;font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:#4A6E18">What I do · 01</span>
    <h2 style="font-family:Archivo,sans-serif;font-weight:900;font-variation-settings:'wdth' 87;text-transform:uppercase;font-size:clamp(34px,4.4vw,60px);line-height:0.92;letter-spacing:-0.03em;margin:16px 0 0;max-width:17ch;text-wrap:balance">Find it. Fix it. Keep it running</h2>
    <p style="font-size:19px;line-height:1.5;color:#454745;margin:20px 0 0;max-width:60ch">First I find what is broken. Then I fix the things that cost you the most. If you want me to stay on, I keep the whole thing running and tell you every week how it is going.</p>

    <div class="riv-tabs" style="position:relative;display:grid;grid-template-columns:repeat(3,1fr);background:#D9E6C3;border-radius:999px;padding:5px;margin:36px 0 20px;max-width:520px">
      <div id="tabPill" style="position:absolute;top:5px;left:5px;width:calc((100% - 10px)/3);height:calc(100% - 10px);background:#FFFFFF;border-radius:999px;transition:transform 200ms cubic-bezier(0.2,0.6,0.2,1);transform:translateX(0%)"></div>
      <button type="button" data-tab="0" style="position:relative;background:transparent;border:0;padding:13px 8px;font-family:'Instrument Sans',sans-serif;font-weight:600;font-size:15px;color:#163300;cursor:pointer;border-radius:999px">Find it</button>
      <button type="button" data-tab="1" style="position:relative;background:transparent;border:0;padding:13px 8px;font-family:'Instrument Sans',sans-serif;font-weight:600;font-size:15px;color:#163300;cursor:pointer;border-radius:999px">Fix it</button>
      <button type="button" data-tab="2" style="position:relative;background:transparent;border:0;padding:13px 8px;font-family:'Instrument Sans',sans-serif;font-weight:600;font-size:15px;color:#163300;cursor:pointer;border-radius:999px">Keep it running</button>
    </div>

    <div data-panel="0" style="display:flex;flex-wrap:wrap;gap:12px;align-items:stretch">
      <div style="flex:1 1 340px;position:relative;overflow:hidden;background:#163300;border-radius:28px;min-height:440px;display:grid;place-items:center;padding:40px 24px">
        <div style="position:absolute;width:240px;height:120px;border-radius:999px;background:rgba(255,255,255,0.08);top:52px;left:40px"></div>
        <div style="position:absolute;width:190px;height:190px;border-radius:999px;border:2px solid rgba(255,255,255,0.22);top:-56px;right:-56px"></div>
        <div style="position:absolute;width:250px;height:320px;border-radius:999px 999px 0 0;background:#A5E85C;bottom:0;left:50%;transform:translateX(-50%)"></div>
        <svg viewBox="0 0 24 24" style="position:absolute;bottom:104px;left:50%;transform:translateX(-50%);width:104px;height:104px;fill:none;stroke:#163300;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round"><circle cx="11" cy="11" r="6"></circle><path d="M15.5 15.5 L20 20"></path></svg>
        <div style="position:absolute;width:14px;height:14px;border-radius:999px;background:#A5E85C;bottom:76px;left:56px"></div>
      </div>
      <div style="flex:1.05 1 400px;background:#FFFFFF;border-radius:28px;padding:clamp(32px,4vw,52px) clamp(28px,4vw,52px) clamp(28px,4vw,44px);display:flex;flex-direction:column">
        <span style="font-family:'DM Mono',monospace;font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:#6F7A64">Step 01 · 2 weeks · fixed price</span>
        <h3 style="font-family:Archivo,sans-serif;font-weight:800;font-size:clamp(27px,3vw,34px);line-height:1.05;letter-spacing:-0.03em;margin:14px 0 0">Two weeks to find what is losing you money.</h3>
        <p style="font-size:17px;line-height:1.55;color:#454745;margin:16px 0 26px;max-width:46ch">I go through your ads, your website, your follow-up and your numbers. You get one short document. No slides.</p>
        <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:30px">
          <div style="display:flex;gap:14px;align-items:flex-start;font-size:16px;line-height:1.45"><span style="width:8px;height:8px;border-radius:999px;background:#A5E85C;margin-top:8px;flex-shrink:0"></span>Where your customers actually come from</div>
          <div style="display:flex;gap:14px;align-items:flex-start;font-size:16px;line-height:1.45"><span style="width:8px;height:8px;border-radius:999px;background:#A5E85C;margin-top:8px;flex-shrink:0"></span>Where people give up before they buy</div>
          <div style="display:flex;gap:14px;align-items:flex-start;font-size:16px;line-height:1.45"><span style="width:8px;height:8px;border-radius:999px;background:#A5E85C;margin-top:8px;flex-shrink:0"></span>Which tools you pay for and do not use</div>
          <div style="display:flex;gap:14px;align-items:flex-start;font-size:16px;line-height:1.45"><span style="width:8px;height:8px;border-radius:999px;background:#A5E85C;margin-top:8px;flex-shrink:0"></span>A list of fixes for the next 3 months, worst first</div>
        </div>
        <div style="margin-top:auto;display:flex;align-items:center;gap:20px;flex-wrap:wrap">
          <a class="rv-ctadark" href="#close" style="display:inline-flex;align-items:center;gap:10px;font-weight:600;font-size:16px;padding:15px 28px;border-radius:999px">Start here →</a>
          <span style="font-family:'DM Mono',monospace;font-size:11.5px;letter-spacing:0.12em;text-transform:uppercase;color:#6F7A64">Pay it once. It comes off step 2</span>
        </div>
      </div>
    </div>

    <div data-panel="1" hidden style="display:flex;flex-wrap:wrap;gap:12px;align-items:stretch">
      <div style="flex:1 1 340px;position:relative;overflow:hidden;background:#163300;border-radius:28px;min-height:440px;display:grid;place-items:center;padding:40px 24px">
        <div style="position:absolute;width:240px;height:120px;border-radius:999px;background:rgba(255,255,255,0.08);top:52px;left:40px"></div>
        <div style="position:absolute;width:190px;height:190px;border-radius:999px;border:2px solid rgba(255,255,255,0.22);top:-56px;right:-56px"></div>
        <div style="position:absolute;width:250px;height:320px;border-radius:999px 999px 0 0;background:#A5E85C;bottom:0;left:50%;transform:translateX(-50%)"></div>
        <svg viewBox="0 0 24 24" style="position:absolute;bottom:104px;left:50%;transform:translateX(-50%);width:104px;height:104px;fill:none;stroke:#163300;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round"><path d="M13 3 L6 13 H11 L9.5 21 L18 10 H12.5 Z"></path></svg>
        <div style="position:absolute;width:14px;height:14px;border-radius:999px;background:#A5E85C;bottom:76px;left:56px"></div>
      </div>
      <div style="flex:1.05 1 400px;background:#FFFFFF;border-radius:28px;padding:clamp(32px,4vw,52px) clamp(28px,4vw,52px) clamp(28px,4vw,44px);display:flex;flex-direction:column">
        <span style="font-family:'DM Mono',monospace;font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:#6F7A64">Step 02 · 4 to 6 weeks · priced after step 1</span>
        <h3 style="font-family:Archivo,sans-serif;font-weight:800;font-size:clamp(27px,3vw,34px);line-height:1.05;letter-spacing:-0.03em;margin:14px 0 0">I fix the big ones myself.</h3>
        <p style="font-size:17px;line-height:1.55;color:#454745;margin:16px 0 26px;max-width:46ch">Not a team of juniors learning on your account. Me, doing the work, on the things costing you the most.</p>
        <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:30px">
          <div style="display:flex;gap:14px;align-items:flex-start;font-size:16px;line-height:1.45"><span style="width:8px;height:8px;border-radius:999px;background:#A5E85C;margin-top:8px;flex-shrink:0"></span>Ads rebuilt around what a customer is worth</div>
          <div style="display:flex;gap:14px;align-items:flex-start;font-size:16px;line-height:1.45"><span style="width:8px;height:8px;border-radius:999px;background:#A5E85C;margin-top:8px;flex-shrink:0"></span>Website pages people and Google can find</div>
          <div style="display:flex;gap:14px;align-items:flex-start;font-size:16px;line-height:1.45"><span style="width:8px;height:8px;border-radius:999px;background:#A5E85C;margin-top:8px;flex-shrink:0"></span>Enquiries answered fast, every time</div>
          <div style="display:flex;gap:14px;align-items:flex-start;font-size:16px;line-height:1.45"><span style="width:8px;height:8px;border-radius:999px;background:#A5E85C;margin-top:8px;flex-shrink:0"></span>Numbers you can trust when you check them</div>
        </div>
        <div style="margin-top:auto;display:flex;align-items:center;gap:20px;flex-wrap:wrap">
          <a class="rv-ctadark" href="#close" style="display:inline-flex;align-items:center;gap:10px;font-weight:600;font-size:16px;padding:15px 28px;border-radius:999px">Talk it through →</a>
          <span style="font-family:'DM Mono',monospace;font-size:11.5px;letter-spacing:0.12em;text-transform:uppercase;color:#6F7A64">Fixed scope. No surprises</span>
        </div>
      </div>
