<script define:vars={{ brands }}>
  (function () {
    // ── Tabs (Find it / Fix it / Keep it running) ──
    var pill = document.getElementById('tabPill');
    var tabBtns = document.querySelectorAll('[data-tab]');
    var panels = document.querySelectorAll('[data-panel]');
    tabBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var i = Number(btn.getAttribute('data-tab'));
        if (pill) pill.style.transform = 'translateX(' + i * 100 + '%)';
        panels.forEach(function (p) {
          p.hidden = Number(p.getAttribute('data-panel')) !== i;
        });
      });
    });

    // ── FAQ accordion. Clicking the open row closes it (state -1). ──
    var open = 0;
    document.querySelectorAll('[data-faq]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var i = Number(btn.getAttribute('data-faq'));
        open = open === i ? -1 : i;
        document.querySelectorAll('[data-faq-panel]').forEach(function (p) {
          p.hidden = Number(p.getAttribute('data-faq-panel')) !== open;
        });
        document.querySelectorAll('[data-faq-mark]').forEach(function (m) {
          m.style.transform =
            Number(m.getAttribute('data-faq-mark')) === open ? 'rotate(45deg)' : 'rotate(0deg)';
        });
        document.querySelectorAll('[data-faq]').forEach(function (b) {
          b.setAttribute('aria-expanded', String(Number(b.getAttribute('data-faq')) === open));
        });
      });
    });

    // ── Notes rail arrows ──
    var rail = document.getElementById('notesRail');
    document.querySelectorAll('[data-rail]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!rail) return;
        var dir = Number(btn.getAttribute('data-rail'));
        rail.scrollBy({ left: dir * Math.min(rail.clientWidth * 0.8, 400), behavior: 'smooth' });
      });
    });

    // ── Brand logo strip. Every 6s all three slots roll to the next brand:
    // the current face slides up and out, the queued face slides into place,
    // then both reset instantly with the indices advanced by one.
    var slots = Array.prototype.slice.call(document.querySelectorAll('.riv-logoslot'));
    if (slots.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var N = brands.length;
      var idx = 0;
      var paint = function (slot, brand, face) {
        var img = slot.querySelector('[data-face="' + face + '"] img');
        if (!img) return;
        img.src = brand.src;
        img.alt = face === 'cur' ? brand.name : '';
        img.style.height = brand.h;
        img.style.width = brand.w || '100%';
      };
      setInterval(function () {
        slots.forEach(function (slot) {
          var cur = slot.querySelector('[data-face="cur"]');
          var next = slot.querySelector('[data-face="next"]');
          cur.style.transition = next.style.transition = 'transform 900ms cubic-bezier(0.55,0,0.1,1)';
          cur.style.transform = 'translateY(-100%)';
          next.style.transform = 'translateY(0)';
        });
        setTimeout(function () {
          idx = idx + 1;
          slots.forEach(function (slot) {
            var k = Number(slot.getAttribute('data-slot'));
            var cur = slot.querySelector('[data-face="cur"]');
            var next = slot.querySelector('[data-face="next"]');
            cur.style.transition = next.style.transition = 'none';
            cur.style.transform = 'translateY(0)';
            next.style.transform = 'translateY(100%)';
            paint(slot, brands[(idx + k * 2) % N], 'cur');
            paint(slot, brands[(idx + 1 + k * 2) % N], 'next');
          });
        }, 1000);
      }, 6000);
    }
  })();
</script>
