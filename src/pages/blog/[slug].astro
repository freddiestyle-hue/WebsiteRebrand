---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SubscribeBox from '../../components/SubscribeBox.astro';
import TitleText from '../../components/TitleText.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { parsePost } from '../../utils/parsePost';
import { buildArticleSchema, buildFaqSchema, safeBuild, countWords } from '../../utils/schema';
import { resolveDates } from '../../utils/postDates';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.data.slug ?? post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const slugFor = (p: { data: { slug?: string }; id: string }) =>
  p.data.slug ?? p.id.replace(/\.md$/, '');
const slug = slugFor(post);

const total = allPosts.length;
const positionFromNewest = allPosts.findIndex(p => slugFor(p) === slug);
const issueNumber = total - positionFromNewest;

const sameTag = allPosts.filter(
  p => p.data.tag === post.data.tag && slugFor(p) !== slugFor(post),
);
const fallback = allPosts.filter(p => slugFor(p) !== slugFor(post));
const related = (sameTag.length >= 3 ? sameTag : fallback).slice(0, 3);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const { tldrHtml, bodyHtml, faq, toc } = parsePost(post.body ?? '');

const { datePublished, dateModified } = resolveDates(post);
const description = post.data.metaDescription ?? post.data.excerpt;
const wordCount = countWords(bodyHtml);

const articleSchema = safeBuild(
  () =>
    buildArticleSchema({
      title: post.data.title,
      description,
      slug,
      datePublished,
      dateModified,
      tag: post.data.tag,
      wordCount,
    }),
  `Article(${slug})`,
);
const faqSchema = safeBuild(() => buildFaqSchema(faq), `FAQ(${slug})`);
const postSchemas = [articleSchema, faqSchema].filter(Boolean) as Array<Record<string, unknown>>;
---
<Base
  title={`${post.data.title} · Rivett Field Notes`}
  description={description}
  fontWeights="Inter+Tight:wght@400;500;600;700;800"
  currentNav="blog"
  ogType="article"
  article={{
    publishedTime: datePublished,
    modifiedTime: dateModified,
    author: 'Fred Style',
    tag: post.data.tag,
  }}
  extraSchema={postSchemas}
>
  <div class="page">
    <div class="crumb">
      <a href="/blog">← Field Notes</a>
      <span class="sep">/</span>
      <span class="tag">{post.data.tag}</span>
      <span class="sep">/</span>
      <span>No. {String(issueNumber).padStart(2, '0')}</span>
    </div>

    <header class="article-head">
      <h1 class="title"><TitleText title={post.data.title} /></h1>
      <p class="dek">{post.data.excerpt}</p>
      <div class="meta-strip">
        <div>By<b>Fred Style</b></div>
        <div>Published<b>{fmtDate(post.data.date)}</b></div>
        <div>Read time<b>{post.data.readTime} minutes</b></div>
        <div>Filed under<b>{post.data.tag}</b></div>
      </div>
    </header>

    <div class="article-body">
      <aside class="rail" aria-label="Note rail">
        <div class="block">
          <span class="label">In this note</span>
          <nav class="toc-list" id="toc-list">
            {toc.map((item, i) => (
              <a href={`#${item.id}`} class={i === 0 ? 'active' : ''}>{item.label}</a>
            ))}
          </nav>
        </div>
        <div class="block">
          <span class="label">Share</span>
          <div class="share">
            <a href="#" data-share="copy" aria-label="Copy link">Copy</a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=https://rivett.tech/blog/${slug}`} target="_blank" rel="noopener" aria-label="Share to LinkedIn">in</a>
            <a href={`https://twitter.com/intent/tweet?url=https://rivett.tech/blog/${slug}&text=${encodeURIComponent(post.data.title)}`} target="_blank" rel="noopener" aria-label="Share to X">x</a>
          </div>
        </div>
        <div class="block">
          <span class="label">Author</span>
          <p class="author-note">Fred Style runs Rivett, a one-operator revenue leak practice. Fifteen years in growth. Ran $100M+ of ad spend across four continents.</p>
        </div>
      </aside>

      <article class="prose">
        {tldrHtml && (
          <div class="tldr" id="tldr">
            <span class="stamp">TL;DR</span>
            <p set:html={tldrHtml} />
          </div>
        )}

        <Fragment set:html={bodyHtml} />
      </article>
    </div>

    {faq.length > 0 && (
      <section class="faq-section" id="faq">
        <div class="head">
          <span class="stamp">Frequently asked</span>
          <h2>The questions <span class="ital">that come up every time.</span></h2>
        </div>
        <div class="faq">
          {faq.map((item, i) => (
            <details open={i === 0}>
              <summary>
                <span set:html={item.q} />
                <span class="marker" aria-hidden="true">+</span>
              </summary>
              <p class="a" set:html={item.a} />
            </details>
          ))}
        </div>
      </section>
    )}

    <section class="note-subscribe" aria-label="Subscribe to Field Notes">
      <SubscribeBox source={`note:${slug}`} />
    </section>
  </div>

  <section class="end-cta on-ink">
    <div class="inner">
      <h3>If this lands, the next move is not a download. <span class="ital">It's a diagnostic.</span></h3>
      <div class="right">
        <span class="stamp">Two weeks · one operator · one memo</span>
        <p>I read your last quarter, sit in your stack, talk to two of your customers, and write you a one-page memo on where revenue is leaking, what to halt, and what to instrument. No deck. No retainer. No payment up front.</p>
        <a class="btn btn--lg btn--inverse" href="/diagnostic">Book diagnostic →</a>
        <a class="btn btn--lg btn--ghost-on-ink" href="/blog">Read more Field Notes</a>
      </div>
    </div>
  </section>

  <div class="page">
    <section class="related">
      <span class="stamp">Related</span>
      <h2>Three more <span class="ital">in the same key.</span></h2>
      <div class="rel-grid">
        {related.map(r => (
          <a class="rel-card" href={`/blog/${slugFor(r)}`}>
            <div class="meta"><span class="stamp stamp--sm">{r.data.tag}</span><span>{r.data.readTime} min</span></div>
            <h3><TitleText title={r.data.title} /></h3>
            <p>{r.data.excerpt}</p>
          </a>
        ))}
      </div>
    </section>

    <footer class="site">
      <div class="row">
        <a class="wordmark" href="/" aria-label="Rivett, home">
          <img src="/img/marks/wordmark-on-dark.svg" alt="" width="64" height="16" decoding="async" />
        </a>
        <span>© 2026 Rivett · Operator's Practice</span>
        <span>Set in Archivo, Instrument Sans &amp; DM Mono</span>
      </div>
    </footer>
  </div>
</Base>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('#toc-list a')];
  const sections = links
    .map(a => document.querySelector(a.getAttribute('href') ?? ''))
    .filter((s): s is HTMLElement => Boolean(s));
  function onScroll() {
    const y = window.scrollY + 120;
    let active = sections[0];
    for (const s of sections) if (s.offsetTop <= y) active = s;
    links.forEach(l => l.classList.toggle('active', l.getAttribute('href') === '#' + (active && active.id)));
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  document.querySelectorAll<HTMLAnchorElement>('[data-share="copy"]').forEach(el => {
    el.addEventListener('click', e => {
      e.preventDefault();
      navigator.clipboard.writeText(window.location.href);
      const original = el.textContent;
      el.textContent = 'Copied';
      setTimeout(() => { el.textContent = original; }, 1500);
    });
  });
</script>
