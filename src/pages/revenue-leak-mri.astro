        <div class="leak">
          <span class="key">Response · decay</span>
          <div class="val" data-out="leakResponse">$0<em>/ mo</em></div>
          <p class="note" data-out="noteResponse">Slow first reply turns paid demand into stale demand.</p>
        </div>
        <div class="leak">
          <span class="key">Conversion · gap</span>
          <div class="val" data-out="leakConversion">$0<em>/ mo</em></div>
          <p class="note" data-out="noteConversion">Close rate sits below the operator benchmark.</p>
        </div>
        <div class="leak">
          <span class="key">Sales · handoff</span>
          <div class="val" data-out="leakHandoff">$0<em>/ mo</em></div>
          <p class="note" data-out="noteHandoff">Leads don't qualify at the rate they should — handoff or scoring is leaking.</p>
        </div>
        <div class="leak">
          <span class="key">Operating · drag</span>
          <div class="val" data-out="leakDrag">$0<em>/ mo</em></div>
          <p class="note">Vendor cost plus internal hours on growth ops — overhead the revenue line never sees.</p>
        </div>
      </div>

      <div class="cta-bar">
        <div class="copy">
          <h3>Turn the leak into a <span class="ital">fix list.</span></h3>
        </div>
        <div class="actions">
          <form class="lead-capture" data-lead-form>
            <div>
              <span class="lead-label">Get the first fix list</span>
              <p>Leave the work email. Fred gets the MRI context, not a blind form fill.</p>
            </div>
            <div class="lead-fields">
              <input name="email" type="email" autocomplete="email" placeholder="Work email" required />
              <input name="company" autocomplete="organization" placeholder="Company (optional)" />
              <input class="lead-hp" name="website" autocomplete="off" tabindex="-1" aria-hidden="true" />
              <button type="submit">Send fix list</button>
            </div>
            <p class="lead-status" data-lead-status aria-live="polite"></p>
          </form>
          <a class="book" href="https://rivett.tech/diagnostic">Book diagnostic →</a>
          <div class="small-actions">
            <button data-action="copy">Copy readout</button>
            <button data-action="restart">Run again</button>
          </div>
        </div>
      </div>
    </div>
  </section>

</div>
    <script is:inline>
(function(){
  const screens = [...document.querySelectorAll('.screen')];
  const total = screens.length;
  const fill = document.getElementById('fill');
  const cur = document.getElementById('cur');
  const tot = document.getElementById('tot');
  const prevBtn = document.getElementById('prev');
  const nextBtn = document.getElementById('next');
  const leadForm = document.querySelector('[data-lead-form]');
  const leadStatus = document.querySelector('[data-lead-status]');

  tot.textContent = String(total).padStart(2, '0');

  // ---------- state ----------
  const STATE_KEY = 'rivett-mri-state';
  const POS_KEY = 'rivett-mri-pos';
  const defaults = { spend: 25000, leads: 412, deal: 6500, vendor: 8000, responseHrs: 8, leadToOpp: 18, oppClose: 24, growthHrs: 35, hourly: 120 };
  let state = { ...defaults };
  try {
    const saved = JSON.parse(localStorage.getItem(STATE_KEY) || 'null');
    if (saved && typeof saved === 'object') state = { ...defaults, ...saved };
  } catch(e){}
  let i = 0;
  try {
    const p = parseInt(localStorage.getItem(POS_KEY) || '0', 10);
    if (!isNaN(p) && p >= 0 && p < total) i = p;
  } catch(e){}

  // hydrate inputs
  document.querySelectorAll('[data-input]').forEach(el => {
    const k = el.dataset.input;
    if (state[k] !== undefined && state[k] !== defaults[k]) el.value = state[k];
  });
  document.querySelectorAll('[data-slider]').forEach(el => {
    const k = el.dataset.slider;
    el.value = state[k];
    const display = document.querySelector(`[data-display="${k}"]`);
    if (display) display.textContent = state[k];
  });

  // ---------- math ----------
  function compute() {
    const s = state;
    const closed = s.leads * (s.leadToOpp/100) * (s.oppClose/100);
    const currentRev = closed * s.deal;

    // response decay: leads beyond 1hr lose conversion. ~3% per hour, capped at 55%.
    const decayPct = Math.min(0.55, Math.max(0, (s.responseHrs - 1) * 0.03));
    const leakResponse = currentRev * decayPct / (1 - decayPct || 1);
    // simpler: estimate the closed deals you'd have at <1hr response, minus what you have
    const idealClosed = s.leads * Math.min(0.6, (s.leadToOpp/100) * (1 + decayPct/(1-decayPct||1))) * (s.oppClose/100);
    const responseLeak = Math.max(0, (idealClosed - closed) * s.deal);

    // conversion gap: assume target oppClose 35%
    const targetClose = 0.35;
    const closeShortfall = Math.max(0, targetClose - s.oppClose/100);
    const conversionLeak = s.leads * (s.leadToOpp/100) * closeShortfall * s.deal;

    // sales handoff: assume target leadToOpp 30%
    const targetLTO = 0.30;
    const ltoShortfall = Math.max(0, targetLTO - s.leadToOpp/100);
    const handoffLeak = s.leads * ltoShortfall * (s.oppClose/100) * s.deal;

    // operating drag
    const opDrag = (s.vendor || 0) + (s.growthHrs * s.hourly);

    const totalLeak = responseLeak + conversionLeak + handoffLeak + opDrag;
    const annualised = totalLeak * 12;

    // score: 100 = no leak. drops with leak ratio vs (rev + leak)
    const ratio = totalLeak / Math.max(1, currentRev + totalLeak);
    const score = Math.max(0, Math.min(100, Math.round(100 - ratio * 100)));

    // funnel
    const fLeads = Math.round(s.leads);
    const fContacted = Math.round(s.leads * Math.max(0.5, 1 - decayPct * 0.4));
    const fOpps = Math.round(s.leads * s.leadToOpp/100);
    const fClosed = Math.round(closed);

    return {
      leakResponse: responseLeak, leakConversion: conversionLeak, leakHandoff: handoffLeak, leakDrag: opDrag,
      total: totalLeak, score, annualised,
      fLeads, fContacted, fOpps, fClosed
    };
  }

  function fmtMoney(n) {
    if (!isFinite(n) || n <= 0) return '$0';
    if (n >= 1000000) return '$' + (n/1000000).toFixed(1).replace(/\.0$/,'') + 'M';
    if (n >= 10000) return '$' + Math.round(n/1000) + 'k';
    if (n >= 1000) return '$' + (n/1000).toFixed(1).replace(/\.0$/,'') + 'k';
    return '$' + Math.round(n).toLocaleString();
  }
  function fmtMoneyFull(n) {
    if (!isFinite(n) || n <= 0) return '$0';
    return '$' + Math.round(n).toLocaleString();
  }
  function fmtNum(n) { return isFinite(n) ? Math.round(n).toLocaleString() : '0'; }

  // count-up animation
  function animateValue(el, from, to, fmt, dur=1200) {
    const start = performance.now();
    function step(t){
      const p = Math.min(1, (t - start) / dur);
      const eased = 1 - Math.pow(1 - p, 3); // easeOutCubic
      const v = from + (to - from) * eased;
      el.textContent = fmt(v);
      if (p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  function renderReveal() {
    const r = compute();
    const out = (k) => document.querySelector(`[data-out="${k}"]`);

    // total
    const totalEl = out('total');
    totalEl.innerHTML = '';
    const totSpan = document.createElement('span');
    totalEl.appendChild(totSpan);
    const unitSpan = document.createElement('span');
    unitSpan.className = 'unit';
    unitSpan.textContent = ' / mo';
    totalEl.appendChild(unitSpan);
    animateValue(totSpan, 0, r.total, fmtMoneyFull, 1400);

    animateValue(out('annual'), 0, r.annualised, fmtMoney, 1400);

    // score
    const scoreEl = out('score');
    scoreEl.innerHTML = '';
    const scoreNum = document.createElement('span');
    scoreEl.appendChild(scoreNum);
    const scoreUnit = document.createElement('em');
    scoreUnit.textContent = ' / 100';
    scoreEl.appendChild(scoreUnit);
    animateValue(scoreNum, 0, r.score, (v) => Math.round(v).toString(), 1400);
    scoreEl.classList.add('flash');
    const scoreBar = out('scoreBar');
    if (scoreBar) setTimeout(() => { scoreBar.style.width = r.score + '%'; }, 200);
    const verdictEl = out('verdict');
    if (verdictEl) {
      if (r.score >= 80) verdictEl.textContent = 'Tight operation. The leak is small relative to revenue.';
      else if (r.score >= 60) verdictEl.textContent = 'Workable, but real money is escaping. Worth a closer look.';
      else if (r.score >= 40) verdictEl.textContent = 'Significant leak. Funding more campaigns will scale the problem, not the revenue.';
      else verdictEl.textContent = 'Severe leak. Stop spending on top-of-funnel until the holes below are plugged.';
    }

    // funnel
    animateValue(out('fLeads'), 0, r.fLeads, fmtNum, 1100);
    animateValue(out('fContacted'), 0, r.fContacted, fmtNum, 1100);
    animateValue(out('fOpps'), 0, r.fOpps, fmtNum, 1100);
    animateValue(out('fClosed'), 0, r.fClosed, fmtNum, 1100);

    // leak categories
    ['leakResponse','leakConversion','leakHandoff','leakDrag'].forEach((k, idx) => {
      const el = out(k);
      const val = r[k];
      el.innerHTML = '';
      const numSpan = document.createElement('span');
      el.appendChild(numSpan);
      const em = document.createElement('em');
      em.textContent = ' / mo';
      el.appendChild(em);
      setTimeout(() => animateValue(numSpan, 0, val, fmtMoneyFull, 1100), 200 + idx * 120);
      el.classList.add('flash');
    });

    // notes — adapt to inputs
    const noteR = out('noteResponse');
    if (state.responseHrs <= 1) noteR.textContent = 'Response time is at or near best-in-class. Hold the line.';
    else if (state.responseHrs >= 24) noteR.textContent = 'A reply at ' + state.responseHrs + 'hr is roughly 9× less effective than at <1hr.';
    else noteR.textContent = 'A first reply at ' + state.responseHrs + 'hr loses meaningful conversion vs <1hr.';

    const noteC = out('noteConversion');
    if (state.oppClose >= 35) noteC.textContent = 'Close rate is above the operator benchmark.';
    else noteC.textContent = 'Close rate sits ' + (35 - state.oppClose) + ' pts below the 35% benchmark — usually a conversation-design issue.';

    const noteH = out('noteHandoff');
    if (state.leadToOpp >= 30) noteH.textContent = 'Lead → opportunity rate is at benchmark.';
    else noteH.textContent = 'Lead → opp at ' + state.leadToOpp + '% leaves ' + (30 - state.leadToOpp) + ' pts on the table — handoff or scoring is leaking.';
  }

  // ---------- nav ----------
  function persist() {
    localStorage.setItem(STATE_KEY, JSON.stringify(state));
    localStorage.setItem(POS_KEY, String(i));
  }

  function commitCurrent() {
    const cur = screens[i];
    if (!cur) return;
    cur.querySelectorAll('[data-input]').forEach(el => {
      const k = el.dataset.input;
      const v = parseFloat(el.value);
      if (!isNaN(v)) state[k] = v;
    });
    cur.querySelectorAll('[data-slider]').forEach(el => {
      const k = el.dataset.slider;
      const v = parseFloat(el.value);
      if (!isNaN(v)) state[k] = v;
    });
  }

  function render() {
    screens.forEach((s, idx) => {
      s.classList.remove('active', 'exit');
      if (idx === i) {
        // replay animations
        s.querySelectorAll('.stamp, .qnum, h1.cover, h2.q, .dek, .helptext, .field, .slider-field, .start, .ok, .leak-hero, .funnel, .leaks-grid, .end-cta').forEach(el => {
          el.style.animation = 'none';
          void el.offsetWidth;
          el.style.animation = '';
        });
        s.classList.add('active');
        // focus first input
        setTimeout(() => {
          const inp = s.querySelector('input');
          if (inp) inp.focus({ preventScroll: true });
        }, 380);
        // if reveal screen, compute
        if (s.dataset.step === 'reveal') renderReveal();
      } else if (idx < i) {
        s.classList.add('exit');
      }
    });
    fill.style.width = ((i) / (total - 1) * 100) + '%';
    cur.textContent = String(i + 1).padStart(2, '0');
    prevBtn.disabled = i === 0;
    nextBtn.disabled = i === total - 1;
    nextBtn.textContent = i === total - 1 ? 'fin' : (i === total - 2 ? 'see readout →' : 'continue ↵');
    persist();
  }

  function go(n) {
    if (n > i) commitCurrent();
    const next = Math.max(0, Math.min(total - 1, n));
    if (next === i) return;
    i = next;
    render();
  }

  // keyboard
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      if (document.activeElement?.closest?.('a[href]')) return;
      if (document.activeElement?.closest?.('[data-lead-form]')) return;
      e.preventDefault();
      go(i + 1);
    } else if (e.key === 'ArrowUp' || (e.key === 'ArrowLeft' && document.activeElement.tagName !== 'INPUT')) {
      e.preventDefault();
      go(i - 1);
    } else if (e.key === 'ArrowDown') {
      // allow if not on a slider
      if (document.activeElement.type !== 'range') {
        e.preventDefault();
        go(i + 1);
      }
    } else if (e.key === 'Escape') {
      if (confirm('Reset MRI and start over?')) {
        state = { ...defaults };
        localStorage.removeItem(STATE_KEY);
        localStorage.removeItem(POS_KEY);
        location.reload();
      }
    }
  });

  prevBtn.addEventListener('click', () => go(i - 1));
  nextBtn.addEventListener('click', () => go(i + 1));

  // sliders live update
  document.querySelectorAll('[data-slider]').forEach(el => {
    const k = el.dataset.slider;
    const display = document.querySelector(`[data-display="${k}"]`);
    el.addEventListener('input', () => {
      const v = parseFloat(el.value);
      state[k] = v;
      if (display) display.textContent = v;
      persist();
    });
  });

  // inputs live update
  document.querySelectorAll('[data-input]').forEach(el => {
    el.addEventListener('input', () => {
      const k = el.dataset.input;
      const v = parseFloat(el.value);
      if (!isNaN(v)) state[k] = v;
      persist();
    });
  });

  // action buttons
  document.querySelectorAll('[data-action="next"]').forEach(b => {
    b.addEventListener('click', (e) => { e.preventDefault(); go(i + 1); });
  });

  leadForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(leadForm);
    const email = String(data.get('email') || '').trim().toLowerCase();
    const company = String(data.get('company') || '').trim();
    const website = String(data.get('website') || '').trim();
    const button = leadForm.querySelector('button[type="submit"]');
    const r = compute();

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      if (leadStatus) leadStatus.textContent = 'Use a valid work email.';
      return;
    }

    if (button) {
      button.disabled = true;
      button.textContent = 'Sending...';
    }
    if (leadStatus) leadStatus.textContent = '';

    try {
      const response = await fetch('/api/mri-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          company,
          website,
          source: 'revenue-leak-mri',
          path: window.location.pathname,
          submitted_at: new Date().toISOString(),
          inputs: { ...state },
          readout: { ...r },
        }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Could not send this yet.');

      window.posthog?.identify?.(email, {
        email,
        company,
        revenue_mri_score: r.score,
        revenue_mri_total_leak: Math.round(r.total),
        revenue_mri_annualised: Math.round(r.annualised),
      });
      window.posthog?.capture?.('revenue_mri_email_captured', {
        company,
        score: r.score,
        total_leak: Math.round(r.total),
        annualised: Math.round(r.annualised),
        biggest_leak: biggestLeak(r),
        source: 'revenue-leak-mri',
      });

      leadForm.dataset.sent = 'true';
      if (leadStatus) leadStatus.textContent = 'Got it. Fred has the MRI context.';
      if (button) button.textContent = 'Sent';
    } catch (error) {
      if (leadStatus) leadStatus.textContent = error instanceof Error ? error.message : 'Could not send this yet.';
      if (button) {
        button.disabled = false;
        button.textContent = 'Send fix list';
      }
    }
  });

  function biggestLeak(r) {
    const ranked = [
      ['response_decay', r.leakResponse],
      ['conversion_gap', r.leakConversion],
      ['sales_handoff', r.leakHandoff],
      ['operating_drag', r.leakDrag],
    ].sort((a, b) => b[1] - a[1]);
    return ranked[0]?.[0] || 'unknown';
  }

  // copy + restart on reveal
  document.addEventListener('click', (e) => {
    const a = e.target.closest('[data-action]');
    if (!a) return;
    if (a.dataset.action === 'copy') {
      const r = compute();
      const txt = [
        'Rivett · Revenue Leak MRI · readout',
        '',
        'Total monthly leak · ' + fmtMoneyFull(r.total),
        'Implied annualised · ' + fmtMoneyFull(r.annualised),
        'Operating score · ' + r.score + ' / 100',
        '',
        'Response decay · ' + fmtMoneyFull(r.leakResponse) + ' / mo',
        'Conversion gap · ' + fmtMoneyFull(r.leakConversion) + ' / mo',
        'Sales handoff · ' + fmtMoneyFull(r.leakHandoff) + ' / mo',
        'Operating drag · ' + fmtMoneyFull(r.leakDrag) + ' / mo',
        '',
        'Inputs · spend ' + fmtMoneyFull(state.spend) + ' / leads ' + state.leads + ' / deal ' + fmtMoneyFull(state.deal) + ' / response ' + state.responseHrs + 'hr / lead→opp ' + state.leadToOpp + '% / close ' + state.oppClose + '%',
      ].join('\n');
      navigator.clipboard.writeText(txt);
      a.textContent = 'Copied ✓';
      setTimeout(() => a.textContent = 'Copy readout', 1800);
    } else if (a.dataset.action === 'restart') {
      state = { ...defaults };
      localStorage.removeItem(STATE_KEY);
      localStorage.removeItem(POS_KEY);
      location.reload();
    }
  });

  render();
})();
    </script>
  </body>
</html>
