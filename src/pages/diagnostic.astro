---
import Base from '../layouts/Base.astro';
import BookingProvider from '../components/diagnostic/BookingProvider.astro';
import DiagnosticHero from '../components/diagnostic/DiagnosticHero.astro';
import DiagnosticSteps from '../components/diagnostic/DiagnosticSteps.astro';
import DiagnosticFAQ from '../components/diagnostic/DiagnosticFAQ.astro';
import DiagnosticEndCTA from '../components/diagnostic/DiagnosticEndCTA.astro';
import '../styles/diagnostic-cro.css';

const description = 'A senior operator reads your last quarter, sits in your stack, and writes the one-page memo on what to halt. Two-week diagnostic, fixed scope.';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Rivett Diagnostic',
  serviceType: 'Revenue leak diagnostic',
  description,
  provider: {
    '@type': 'Organization',
    name: 'Rivett',
    url: 'https://rivett.tech',
    founder: { '@type': 'Person', name: 'Fred Style' },
  },
  areaServed: 'Worldwide',
};
---
<Base
  title="Book the diagnostic · Rivett"
  description={description}
  fontWeights="Inter+Tight:wght@400;500;600;700;800"
>
  <BookingProvider />

  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />

  <div class="diagnostic-page" data-proof="C" data-form="three" data-quote="on" data-logos="on">
    <div class="page">
      <DiagnosticHero />

      <DiagnosticSteps />

      <DiagnosticFAQ />
    </div>

    <div class="page">
      <DiagnosticEndCTA />
    </div>
  </div>
</Base>

<script>
  const w = window as any;
  if (w.posthog) {
    w.posthog.capture('diagnostic_view');
  } else {
    document.addEventListener('DOMContentLoaded', () => {
      if ((window as any).posthog) (window as any).posthog.capture('diagnostic_view');
    });
  }
</script>
