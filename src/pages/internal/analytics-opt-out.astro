---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Analytics opt-out · Rivett"
  description="Private Rivett analytics opt-out."
  noindex
  posthogCapturePageview={false}
  posthogOptOutByDefault
>
  <section class="optout-shell" aria-labelledby="optout-title">
    <div class="optout-panel">
      <p class="eyebrow">Private analytics control</p>
      <h1 id="optout-title">This browser is excluded.</h1>
      <p class="lede">
        PostHog capture has been turned off for this browser. Open this page once on each device you use to check the site.
      </p>
      <div class="status" id="optout-status" role="status">Confirming local opt-out...</div>
      <a href="/" class="home-link">Return to Rivett</a>
    </div>
  </section>
</Base>

<script>
  const updateStatus = (message: string) => {
    const status = document.getElementById('optout-status');
    if (status) status.textContent = message;
  };

  const applyOptOut = () => {
    const ph = (window as any).posthog;

    if (!ph?.opt_out_capturing) {
      updateStatus('PostHog is still loading. Refresh this page if the status does not update.');
      return;
    }

    ph.opt_out_capturing();
    ph.stopSessionRecording?.();

    const isOptedOut = ph.has_opted_out_capturing?.();
    updateStatus(isOptedOut ? 'Confirmed: this browser is opted out.' : 'Opt-out requested. Refresh to confirm.');
  };

  applyOptOut();
  window.setTimeout(applyOptOut, 800);
</script>

<style>
  .optout-shell {
    align-items: center;
    background: var(--paper);
    color: var(--ink);
    display: flex;
    min-height: calc(100vh - 88px);
    padding: clamp(56px, 10vw, 120px) var(--page-pad-x);
  }

  .optout-panel {
    border-top: 1px solid var(--line-strong);
    max-width: 720px;
    padding-top: 28px;
  }

  .eyebrow {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0;
    margin: 0 0 20px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(44px, 8vw, 92px);
    letter-spacing: 0;
    line-height: 0.9;
    margin: 0;
    max-width: 640px;
  }

  .lede {
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: clamp(22px, 3vw, 34px);
    font-style: italic;
    line-height: 1.08;
    margin: 28px 0 0;
    max-width: 640px;
  }

  .status {
    border: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 13px;
    margin-top: 36px;
    max-width: 460px;
    padding: 14px 16px;
  }

  .home-link {
    color: var(--ink);
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 12px;
    margin-top: 24px;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-transform: uppercase;
  }

  @media (max-width: 780px) {
    .optout-shell {
      padding-inline: var(--page-pad-x-sm);
    }
  }
</style>
