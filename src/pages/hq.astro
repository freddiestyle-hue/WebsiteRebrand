---
// /hq — private analytics HQ. Fred's view of who is reading the audit memos.
//
// Auth model: HQ_KEY env var is the shared secret. Visitors can authenticate
// via `?key=<secret>` (sets a cookie) or by carrying the cookie from a prior
// authenticated visit. Wrong key or no key returns 404.
//
// Data: server-rendered. All PostHog queries go through a Redis cache so
// warm-cache renders are sub-second. Daily cron pre-warms the hot ranges.

export const prerender = false;

import {
  getRecentReads,
  getTopProspects,
  getHeadlineMetrics,
  getCtaClicks,
  getTopBlogPosts,
  getVisitorsByCountry,
  getVisitorsByCity,
  getVisitorTech,
  getTrafficSources,
  getActivityTimeline,
  getActiveNow,
  type RecentRead,
  type TopProspect,
  type HeadlineMetrics,
  type CtaClick,
  type TopBlogPost,
  type CountryBreakdown,
  type CityBreakdown,
  type DeviceRow,
  type TrafficSource,
  type ActivityDay,
  type TrafficMode,
  type ActiveNow,
} from '../utils/posthog/query';
import { parseDateRange } from '../utils/posthog/dateRange';
import SectionHeader from '../components/hq/SectionHeader.astro';
import RecentReadsFeed from '../components/hq/RecentReadsFeed.astro';
import TopProspectsTable from '../components/hq/TopProspectsTable.astro';
import CtaClicksFeed from '../components/hq/CtaClicksFeed.astro';
import TopBlogPostsTable from '../components/hq/TopBlogPostsTable.astro';
import CountryTable from '../components/hq/CountryTable.astro';
import CityTable from '../components/hq/CityTable.astro';
import DeviceTable from '../components/hq/DeviceTable.astro';
import ReferrerTable from '../components/hq/ReferrerTable.astro';
import ActivityTimeline from '../components/hq/ActivityTimeline.astro';
import DateRangeNav from '../components/hq/DateRangeNav.astro';
import KpiCard from '../components/hq/KpiCard.astro';
import ActiveNowBadge from '../components/hq/ActiveNow.astro';
import ActionQueue from '../components/hq/ActionQueue.astro';
import { getMessagedSlugs } from '../utils/hq/messaged';

// --- Auth gating ---
const HQ_KEY = (process.env.HQ_KEY || import.meta.env.HQ_KEY || '').trim();

const url = new URL(Astro.request.url);
const providedKey = (url.searchParams.get('key') || '').trim();
const cookieHeader = Astro.request.headers.get('cookie') || '';
const cookieKey = (cookieHeader.match(/(?:^|;\s*)rivett_hq_key=([^;]+)/)?.[1] ?? '').trim();

let authed = false;
let setCookie = false;
if (HQ_KEY && providedKey && providedKey === HQ_KEY) {
  authed = true;
  setCookie = true;
} else if (HQ_KEY && cookieKey && cookieKey === HQ_KEY) {
  authed = true;
}

if (setCookie) {
  Astro.response.headers.set(
    'Set-Cookie',
    `rivett_hq_key=${HQ_KEY}; Path=/; Max-Age=31536000; HttpOnly; SameSite=Lax; Secure`
  );
}

if (!authed) {
  Astro.response.status = 404;
}

// --- Parse date range and traffic mode from URL ---
const range = parseDateRange(url.searchParams);
const trafficParam = url.searchParams.get('traffic');
const trafficMode: TrafficMode = trafficParam === 'all' ? 'all' : 'humans';

// Build href helper that preserves current range when flipping traffic mode
function hrefWithTraffic(mode: TrafficMode): string {
  const sp = new URLSearchParams(url.search);
  if (mode === 'all') sp.set('traffic', 'all');
  else sp.delete('traffic');
  const q = sp.toString();
  return `/hq${q ? '?' + q : ''}`;
}

// --- Data fetch (only when authed) ---
let headline: HeadlineMetrics | null = null;
let recent: RecentRead[] = [];
let top: TopProspect[] = [];
let ctas: CtaClick[] = [];
let blog: TopBlogPost[] = [];
let countries: CountryBreakdown[] = [];
let cities: CityBreakdown[] = [];
let devices: DeviceRow[] = [];
let sources: TrafficSource[] = [];
let activity: ActivityDay[] = [];
let activeNow: ActiveNow | null = null;
let messagedSlugs: Set<string> = new Set();
let fetchError: string | null = null;

if (authed) {
  try {
    const [h, r, t, c, b, co, ci, dv, sr, ac, an, ms] = await Promise.all([
      getHeadlineMetrics(range),
      getRecentReads(range, trafficMode),
      getTopProspects(range, trafficMode),
      getCtaClicks(range, trafficMode),
      getTopBlogPosts(range),
      getVisitorsByCountry(range),
      getVisitorsByCity(range),
      getVisitorTech(range, trafficMode),
      getTrafficSources(range, trafficMode),
      getActivityTimeline(range, trafficMode),
      getActiveNow(),
      getMessagedSlugs(),
    ]);
    headline = h;
    recent = r;
    top = t;
    ctas = c;
    blog = b;
    countries = co;
    cities = ci;
    devices = dv;
    sources = sr;
    activity = ac;
    activeNow = an;
    messagedSlugs = ms;
  } catch (e) {
    fetchError = e instanceof Error ? e.message : String(e);
    console.error('[hq] PostHog fetch failed', e);
  }
}

// --- Action queue: engaged prospects who haven't been marked messaged ---
// "Engaged" = real human signal: dwell >= 15s OR a CTA click. Sort by recency
// so freshest signal floats to the top. Show at most 10 — anything beyond is
// queue overflow that we surface in Top Prospects below.
const actionQueue = top
  .filter((p) => !messagedSlugs.has(p.prospect))
  .filter((p) => p.total_dwell_seconds >= 15 || p.cta_clicks > 0)
  .sort((a, b) => (a.last_view < b.last_view ? 1 : -1))
  .slice(0, 10);

// Top-level (always visible) nav. Deep analytics (geography/devices/sources/
// activity) are collapsed by default and not in the primary nav — they live
// behind a "Deep analytics" disclosure at the bottom of the page.
const sections = [
  { id: 'action',    num: '00', label: 'Action queue' },
  { id: 'recent',    num: '01', label: 'Recent reads' },
  { id: 'prospects', num: '02', label: 'Prospects' },
  { id: 'ctas',      num: '03', label: 'CTA clicks' },
  { id: 'blog',      num: '04', label: 'Blog' },
  { id: 'deep',      num: '05', label: 'Deep analytics' },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>{authed ? 'HQ · Rivett' : 'Not found'}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=DM+Mono:wght@400;500&family=Newsreader:ital,wght@0,400;1,400;1,500&display=swap" rel="stylesheet" />
<style>
  :root {
    --paper: #FFFFFF;
    --paper-2: #F4F2ED;
    --paper-3: #EBE6DC;
    --ink: #0E1A2C;
    --ink-dim: #3A4658;
    --ink-faint: #7A8597;
    --line: rgba(14,26,44,0.14);
    --line-strong: rgba(14,26,44,0.28);
    --accent: #8FBF3F;
    --accent-deep: #4A6E18;
    --accent-bg: #F2F7E5;
    --grotesk: 'Inter Tight', system-ui, sans-serif;
    --serif: 'Newsreader', Georgia, serif;
    --mono: 'DM Mono', ui-monospace, monospace;
    --rail-w: 220px;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--grotesk);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  a { color: inherit; }
  button { font: inherit; cursor: pointer; }

  /* ============ APP SHELL ============ */
  .app {
    display: grid;
    grid-template-columns: var(--rail-w) 1fr;
    min-height: 100vh;
  }
  .rail {
    border-right: 1px solid var(--line);
    background: var(--paper-2);
    padding: 1.25rem 0.85rem;
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    overflow-y: auto;
  }
  .main {
    background: var(--paper);
    padding: 0;
    min-width: 0;
  }

  /* ============ RAIL ============ */
  .rail-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.4rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.05em;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.04em;
    text-decoration: none;
    color: var(--ink);
  }
  .wordmark .dot-mark {
    display: inline-block;
    width: 0.3em;
    height: 0.3em;
    border-radius: 999px;
    background: var(--accent);
  }
  .rail-label {
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 3px;
  }

  .sections-nav {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    flex: 1;
  }
  .sec-link {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.5rem;
    align-items: center;
    padding: 0.4rem 0.5rem;
    text-decoration: none;
    border-radius: 3px;
    color: var(--ink-dim);
    transition: background 80ms, color 80ms;
  }
  .sec-link:hover {
    background: var(--paper-3);
    color: var(--ink);
  }
  .sec-num {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--ink-faint);
    letter-spacing: 0.05em;
  }
  .sec-name {
    font-size: 0.85rem;
    font-weight: 500;
  }

  .rail-foot {
    padding: 0.5rem 0.4rem 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-family: var(--mono);
    font-size: 0.7rem;
  }
  .rail-foot a {
    color: var(--ink-dim);
    text-decoration: none;
    padding: 0.25rem 0.1rem;
  }
  .rail-foot a:hover { color: var(--accent-deep); }

  /* ============ APP BAR (top of main) ============ */
  .appbar {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    padding: 0.85rem 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .appbar-title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .appbar-h1 {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .appbar-sub {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }
  .appbar-range {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Traffic toggle pill */
  .traffic-toggle {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    background: var(--paper-2);
  }
  .tt {
    padding: 0.35rem 0.7rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--ink-dim);
    text-decoration: none;
    transition: background 80ms, color 80ms;
    white-space: nowrap;
  }
  .tt:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .tt--active {
    background: var(--ink);
    color: var(--paper);
    font-weight: 500;
  }
  .tt--active:hover {
    background: var(--ink);
    color: var(--paper);
  }

  /* KPI raw breakdown badge */
  .kpi-raw {
    opacity: 0.7;
  }

  /* Deep analytics disclosure — collapsed by default so daily view is clean */
  .deep {
    border: 1px solid var(--line);
    border-radius: 4px;
    margin-bottom: 3rem;
    scroll-margin-top: 4.5rem;
    background: var(--paper);
  }
  .deep summary {
    list-style: none;
    cursor: pointer;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: space-between;
  }
  .deep summary::-webkit-details-marker { display: none; }
  .deep summary:hover { background: var(--paper-2); }
  .deep[open] summary { border-bottom: 1px solid var(--line); }
  .deep-num {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    margin-bottom: 0.15rem;
  }
  .deep-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .deep-title .ital {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--ink-dim);
  }
  .deep-meta {
    margin-top: 0.25rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--ink-faint);
  }
  .deep-chev {
    font-family: var(--mono);
    color: var(--ink-faint);
    transition: transform 120ms;
    font-size: 1rem;
  }
  .deep[open] .deep-chev { transform: rotate(180deg); }
  .deep-body {
    padding: 1.25rem 1.25rem 0.5rem;
  }

  /* ============ MAIN CONTENT ============ */
  .content {
    max-width: 1100px;
    padding: 1.5rem 2rem 4rem;
  }

  /* KPI strip — denser than 4 cards, more like ticker */
  .kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 2.5rem;
    background: var(--paper);
  }
  .kpis :global(.kpi:last-child) {
    border-right: 0;
  }

  /* Sections */
  section.sec {
    margin-bottom: 3rem;
    scroll-margin-top: 4.5rem;
  }

  /* Error banner */
  .err {
    margin: 1rem 0 2rem;
    padding: 1rem;
    border: 1px solid var(--line-strong);
    background: var(--paper-2);
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--ink-dim);
  }
  .err b { color: var(--ink); }

  /* 404 */
  .nf {
    max-width: 480px;
    margin: 6rem auto;
    padding: 0 1.5rem;
    text-align: center;
  }
  .nf h1 {
    font-size: 5rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.05em;
  }
  .nf p {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* ============ MOBILE (<960px) ============ */
  @media (max-width: 960px) {
    .app {
      grid-template-columns: 1fr;
    }
    .rail {
      position: sticky;
      top: 0;
      z-index: 10;
      height: auto;
      flex-direction: column;
      padding: 0;
      background: var(--paper);
      border-right: 0;
      border-bottom: 1px solid var(--line);
      gap: 0;
    }
    .rail-top {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--line);
    }
    .sections-nav {
      flex-direction: row;
      overflow-x: auto;
      gap: 0.3rem;
      padding: 0.5rem 1rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .sections-nav::-webkit-scrollbar { display: none; }
    .sec-link {
      flex-shrink: 0;
      grid-template-columns: auto auto;
      padding: 0.35rem 0.7rem;
      background: var(--paper-2);
      border-radius: 999px;
    }
    .sec-link:hover { background: var(--paper-3); }
    .sec-num { font-size: 0.65rem; }
    .sec-name { font-size: 0.75rem; }
    .rail-foot { display: none; }

    .appbar {
      padding: 0.65rem 1rem;
      gap: 0.5rem;
    }
    .appbar-range { width: 100%; margin-left: 0; gap: 0.5rem; }
    .traffic-toggle { width: 100%; justify-content: center; }
    .tt { flex: 1; text-align: center; }

    .content {
      padding: 1rem 1rem 3rem;
    }

    .kpis {
      grid-template-columns: 1fr 1fr;
    }
    .kpi { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .kpi:nth-child(2n) { border-right: 0; }
    .kpi:nth-last-child(-n+2) { border-bottom: 0; }
  }
</style>
</head>
<body>
{!authed && (
  <div class="nf">
    <h1>404</h1>
    <p>Nothing here.</p>
  </div>
)}

{authed && (
  <div class="app">
    <aside class="rail" aria-label="HQ sections">
      <div class="rail-top">
        <a class="wordmark" href="/">rivett<span class="dot-mark" aria-hidden="true"></span></a>
        <span class="rail-label">HQ</span>
      </div>
      <nav class="sections-nav" aria-label="Section navigation">
        {sections.map((s) => (
          <a href={`#${s.id}`} class="sec-link">
            <span class="sec-num">{s.num}</span>
            <span class="sec-name">{s.label}</span>
          </a>
        ))}
      </nav>
      <div class="rail-foot">
        <a href="/hq">↻ Refresh</a>
        <a href="https://us.posthog.com/project/373899" target="_blank" rel="noopener">PostHog console ↗</a>
      </div>
    </aside>

    <main class="main">
      <div class="appbar">
        <div class="appbar-title">
          <h1 class="appbar-h1">Audit engagement</h1>
          <span class="appbar-sub">{range.label}</span>
          {activeNow && <ActiveNowBadge data={activeNow} />}
        </div>
        <div class="appbar-range">
          <DateRangeNav range={range} />
          <div class="traffic-toggle" role="group" aria-label="Traffic filter">
            <a
              href={hrefWithTraffic('humans')}
              class={`tt ${trafficMode === 'humans' ? 'tt--active' : ''}`}
              aria-current={trafficMode === 'humans' ? 'true' : 'false'}
            >Humans</a>
            <a
              href={hrefWithTraffic('all')}
              class={`tt ${trafficMode === 'all' ? 'tt--active' : ''}`}
              aria-current={trafficMode === 'all' ? 'true' : 'false'}
            >All traffic</a>
          </div>
        </div>
      </div>

      <div class="content">
        {fetchError && (
          <div class="err">
            <b>Could not load live data.</b> {fetchError}
          </div>
        )}

        {headline && (
          <div class="kpis">
            <KpiCard
              label="Memo views"
              value={headline.memo_views}
              rawValue={headline.memo_views_raw}
              prevValue={headline.memo_views_prev}
              prevLabel={`prev ${range.days}d`}
              sub="humans"
              spark={headline.spark_memo_views}
              sparkColor="var(--ink)"
            />
            <KpiCard
              label="Unique visitors"
              value={headline.unique_visitors}
              rawValue={headline.unique_visitors_raw}
              prevValue={headline.unique_visitors_prev}
              prevLabel={`prev ${range.days}d`}
              sub="humans"
              spark={headline.spark_unique_visitors}
              sparkColor="var(--ink)"
            />
            <KpiCard
              label="Engaged reads"
              value={headline.engaged_reads}
              rawValue={headline.engaged_reads_raw}
              prevValue={headline.engaged_reads_prev}
              prevLabel={`prev ${range.days}d`}
              sub="past 50% scroll"
              hint={headline.engaged_reads === 0 && headline.memo_views > 0 ? 'Memos read but no 50% scrollers. Tighten the hook.' : undefined}
              spark={headline.spark_engaged_reads}
              sparkColor="var(--accent-deep)"
              emphasis="accent"
            />
            <KpiCard
              label="CTA clicks"
              value={headline.cta_clicks}
              rawValue={headline.cta_clicks_raw}
              prevValue={headline.cta_clicks_prev}
              prevLabel={`prev ${range.days}d`}
              sub="Book a call etc."
              spark={headline.spark_cta_clicks}
              sparkColor="var(--accent-deep)"
              emphasis="accent"
            />
          </div>
        )}

        <section class="sec" id="action">
          <SectionHeader
            number="00"
            title="Action queue."
            italicTail="Who needs a follow-up today."
            meta={`${actionQueue.length} prospect${actionQueue.length === 1 ? '' : 's'} · engaged & unmessaged · ${range.label.toLowerCase()}`}
          />
          <ActionQueue prospects={actionQueue} />
        </section>

        <section class="sec" id="recent">
          <SectionHeader
            number="01"
            title="Recent reads."
            italicTail="Who looked at what, when."
            meta={`${recent.length} session${recent.length === 1 ? '' : 's'} · ${range.label.toLowerCase()} · ${trafficMode === 'all' ? 'all traffic' : 'real humans only'}`}
          />
          <RecentReadsFeed reads={recent} />
        </section>

        <section class="sec" id="prospects">
          <SectionHeader
            number="02"
            title="Top prospects."
            italicTail="Ranked by engagement."
            meta={`${top.length} prospect${top.length === 1 ? '' : 's'} · ${range.label.toLowerCase()} · click a row to expand sessions`}
          />
          <TopProspectsTable prospects={top} />
        </section>

        <section class="sec" id="ctas">
          <SectionHeader
            number="03"
            title="CTA clicks."
            italicTail="Book-a-call moments."
            meta={`${ctas.length} click${ctas.length === 1 ? '' : 's'} · ${range.label.toLowerCase()}`}
          />
          <CtaClicksFeed clicks={ctas} />
        </section>

        <section class="sec" id="blog">
          <SectionHeader
            number="04"
            title="Blog content."
            italicTail="What is landing with the audience."
            meta={`${blog.length} post${blog.length === 1 ? '' : 's'} · ${range.label.toLowerCase()} · ${trafficMode === 'all' ? 'all traffic' : 'real humans only'}`}
          />
          <TopBlogPostsTable posts={blog} />
        </section>

        <details class="deep" id="deep">
          <summary>
            <div>
              <div class="deep-num">§ 05</div>
              <div class="deep-title">Deep analytics. <span class="ital">Geography, devices, sources, time.</span></div>
              <div class="deep-meta">countries · cities · device + browser · traffic sources · activity timeline</div>
            </div>
            <span class="deep-chev" aria-hidden="true">↓</span>
          </summary>

          <div class="deep-body">
            <section class="sec" id="countries">
              <SectionHeader
                number="05"
                title="Visitors by country."
                italicTail="Where the traffic lands."
                meta={`${countries.length} countries · ${range.label.toLowerCase()} · all traffic`}
              />
              <CountryTable countries={countries} />
            </section>

            <section class="sec" id="cities">
              <SectionHeader
                number="06"
                title="Cities and regions."
                italicTail="Real humans vs scanners."
                meta={`${cities.length} cities · ${range.label.toLowerCase()} · scanners and self flagged`}
              />
              <CityTable cities={cities} />
            </section>

            <section class="sec" id="devices">
              <SectionHeader
                number="07"
                title="Device and browser."
                italicTail="How they read."
                meta={`${devices.length} combinations · ${range.label.toLowerCase()} · ${trafficMode === 'all' ? 'all traffic' : 'real humans only'}`}
              />
              <DeviceTable rows={devices} />
            </section>

            <section class="sec" id="sources">
              <SectionHeader
                number="08"
                title="Traffic sources."
                italicTail="How they got here."
                meta={`${sources.length} source${sources.length === 1 ? '' : 's'} · ${range.label.toLowerCase()} · ${trafficMode === 'all' ? 'all traffic' : 'real humans only'}`}
              />
              <ReferrerTable sources={sources} />
            </section>

            <section class="sec" id="activity">
              <SectionHeader
                number="09"
                title="Activity over time."
                italicTail="The pulse."
                meta={`${activity.length} days · ${range.label.toLowerCase()} · ${trafficMode === 'all' ? 'all traffic' : 'real humans only'}`}
              />
              <ActivityTimeline days={activity} />
            </section>
          </div>
        </details>
      </div>
    </main>
  </div>
)}
</body>
</html>
