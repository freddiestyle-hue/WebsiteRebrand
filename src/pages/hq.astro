---
// /hq — private analytics HQ. Fred's view of who is reading the audit memos.
//
// Auth model: HQ_KEY env var is the shared secret. Visitors can authenticate
// via `?key=<secret>` (sets a cookie) or by carrying the cookie from a prior
// authenticated visit. Wrong key or no key returns 404.
//
// Data: server-rendered. All PostHog queries go through a Redis cache so
// warm-cache renders are sub-second. Daily cron pre-warms the hot ranges.

export const prerender = false;

import {
  getRecentReads,
  getTopProspects,
  getHeadlineMetrics,
  getCtaClicks,
  getTopBlogPosts,
  getVisitorsByCountry,
  getVisitorsByCity,
  getVisitorTech,
  getTrafficSources,
  getActivityTimeline,
  getActiveNow,
  type RecentRead,
  type TopProspect,
  type HeadlineMetrics,
  type CtaClick,
  type TopBlogPost,
  type CountryBreakdown,
  type CityBreakdown,
  type DeviceRow,
  type TrafficSource,
  type ActivityDay,
  type TrafficMode,
  type ActiveNow,
} from '../utils/posthog/query';
import { parseDateRange } from '../utils/posthog/dateRange';
import SectionHeader from '../components/hq/SectionHeader.astro';
import RecentReadsFeed from '../components/hq/RecentReadsFeed.astro';
import TopProspectsTable from '../components/hq/TopProspectsTable.astro';
import CtaClicksFeed from '../components/hq/CtaClicksFeed.astro';
import TopBlogPostsTable from '../components/hq/TopBlogPostsTable.astro';
import CountryTable from '../components/hq/CountryTable.astro';
import CityTable from '../components/hq/CityTable.astro';
import DeviceTable from '../components/hq/DeviceTable.astro';
import ReferrerTable from '../components/hq/ReferrerTable.astro';
import ActivityTimeline from '../components/hq/ActivityTimeline.astro';
import DateRangeNav from '../components/hq/DateRangeNav.astro';
import KpiCard from '../components/hq/KpiCard.astro';
import ActiveNowBadge from '../components/hq/ActiveNow.astro';
import ActionQueue from '../components/hq/ActionQueue.astro';
import { getProspectsBySlug, getOutreachQueueByWave, type ProspectInfo, type OutreachQueueRow } from '../utils/hq/airtable';
import OutreachQueue from '../components/hq/OutreachQueue.astro';

// --- Auth gating ---
const HQ_KEY = (process.env.HQ_KEY || import.meta.env.HQ_KEY || '').trim();

const url = new URL(Astro.request.url);
const providedKey = (url.searchParams.get('key') || '').trim();
const cookieHeader = Astro.request.headers.get('cookie') || '';
const cookieKey = (cookieHeader.match(/(?:^|;\s*)rivett_hq_key=([^;]+)/)?.[1] ?? '').trim();

let authed = false;
let setCookie = false;
if (HQ_KEY && providedKey && providedKey === HQ_KEY) {
  authed = true;
  setCookie = true;
} else if (HQ_KEY && cookieKey && cookieKey === HQ_KEY) {
  authed = true;
}

if (setCookie) {
  Astro.response.headers.set(
    'Set-Cookie',
    `rivett_hq_key=${HQ_KEY}; Path=/; Max-Age=31536000; HttpOnly; SameSite=Lax; Secure`
  );
}

if (!authed) {
  Astro.response.status = 404;
}

// --- Parse date range and traffic mode from URL ---
const range = parseDateRange(url.searchParams);
const trafficParam = url.searchParams.get('traffic');
const trafficMode: TrafficMode = trafficParam === 'all' ? 'all' : 'humans';

// Build href helper that preserves current range when flipping traffic mode
function hrefWithTraffic(mode: TrafficMode): string {
  const sp = new URLSearchParams(url.search);
  if (mode === 'all') sp.set('traffic', 'all');
  else sp.delete('traffic');
  const q = sp.toString();
  return `/hq${q ? '?' + q : ''}`;
}

// --- Data fetch (only when authed) ---
let headline: HeadlineMetrics | null = null;
let recent: RecentRead[] = [];
let top: TopProspect[] = [];
let ctas: CtaClick[] = [];
let blog: TopBlogPost[] = [];
let countries: CountryBreakdown[] = [];
let cities: CityBreakdown[] = [];
let devices: DeviceRow[] = [];
let sources: TrafficSource[] = [];
let activity: ActivityDay[] = [];
let activeNow: ActiveNow | null = null;
let prospectInfo: Map<string, ProspectInfo> = new Map();
// Outreach queue for the current active wave. The wave string is the literal
// Attack Wave field value in Airtable; change CURRENT_WAVE when you roll to
// the next batch (Wave 3, etc) and the queue tracks it without any code
// changes elsewhere.
const CURRENT_WAVE = 'Wave 2 - This Week';
let outreachQueue: OutreachQueueRow[] = [];
let fetchError: string | null = null;

if (authed) {
  try {
    const [h, r, t, c, b, co, ci, dv, sr, ac, an, pi] = await Promise.all([
      getHeadlineMetrics(range),
      getRecentReads(range, trafficMode),
      getTopProspects(range, trafficMode),
      getCtaClicks(range, trafficMode),
      getTopBlogPosts(range),
      getVisitorsByCountry(range),
      getVisitorsByCity(range),
      getVisitorTech(range, trafficMode),
      getTrafficSources(range, trafficMode),
      getActivityTimeline(range, trafficMode),
      getActiveNow(),
      getProspectsBySlug(),
    ]);
    headline = h;
    recent = r;
    top = t;
    ctas = c;
    blog = b;
    countries = co;
    cities = ci;
    devices = dv;
    sources = sr;
    activity = ac;
    activeNow = an;
    prospectInfo = pi;
  } catch (e) {
    fetchError = e instanceof Error ? e.message : String(e);
    console.error('[hq] PostHog fetch failed', e);
  }

  // Outreach queue reads from the same Airtable cache the rest of HQ uses,
  // so the second call hits the warm Redis entry and adds ~5ms total.
  try {
    outreachQueue = await getOutreachQueueByWave(CURRENT_WAVE);
  } catch (e) {
    console.error('[hq] outreach queue fetch failed', e);
  }
}

// --- Action queue: engaged prospects who need a follow-up ---
// Every audit-URL visit is a person event - the slug IS the identifier and
// joins to a name via Airtable. The queue shows every visit that hasn't
// been worked yet. Anything past "Not Sent" is removed:
//   - Sent: already DM'd / emailed (auto-marked when Fred hits Copy+open
//     in the draft modal, or manually via the Mark sent button).
//   - Replied / Booked / Won / Lost / Disqualified: terminal stages.
// The heat tag communicates quality; Fred decides whether a BROWSED row
// is worth a follow-up. We do NOT pre-filter by engagement signals - those
// gate which tier the heat badge shows, but everyone visible is fair game.
const STAGES_DONE = new Set([
  'Sent', 'Replied', 'Booked', 'Won', 'Lost', 'Disqualified',
]);

const actionQueue = top
  .filter((p) => {
    const info = prospectInfo.get(p.prospect);
    if (info && STAGES_DONE.has(info.outreachStage)) return false;
    return true;
  })
  .sort((a, b) => {
    if (b.heat_score !== a.heat_score) return b.heat_score - a.heat_score;
    return a.last_view < b.last_view ? 1 : -1;
  })
  .slice(0, 10);

// Top-level nav. Each section gets a dynamic count and an icon name that
// resolves to one of the SVG sprite symbols below.
const sections = [
  { id: 'action',    num: '00', label: 'Action queue',  icon: 'pipeline',   count: actionQueue.length },
  { id: 'recent',    num: '01', label: 'Recent reads',  icon: 'memo',       count: recent.length },
  { id: 'prospects', num: '02', label: 'Top prospects', icon: 'cohort',     count: top.length },
  { id: 'ctas',      num: '03', label: 'CTA clicks',    icon: 'flag',       count: ctas.length },
  { id: 'blog',      num: '04', label: 'Blog',          icon: 'field-note', count: blog.length },
  { id: 'deep',      num: '05', label: 'Deep',          icon: 'curve',      count: null as number | null },
];

// Today's date in middle-dot mono format for the topbar.
const today = new Date();
const todayDisplay = `${today.getUTCFullYear()}·${String(today.getUTCMonth()+1).padStart(2,'0')}·${String(today.getUTCDate()).padStart(2,'0')}`;
const weekday = today.toLocaleString('en-US', { weekday: 'short', timeZone: 'UTC' }).toLowerCase();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>{authed ? 'HQ · Rivett' : 'Not found'}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=DM+Mono:wght@400;500&family=Newsreader:ital,wght@0,400;1,400;1,500&display=swap" rel="stylesheet" />
<style>
  :root {
    --paper: #FFFFFF;
    --paper-2: #F4F2ED;
    --paper-3: #EBE6DC;
    --paper-4: #DDD7C9;
    --sage: #E8F0D9;
    --sage-2: #D5E3B7;
    --ink: #0E1A2C;
    --ink-2: #1B2940;
    --ink-dim: #3A4658;
    --ink-faint: #7A8597;
    --ink-soft: #B6BCC6;
    --on-ink: #FFFFFF;
    --on-ink-italic: rgba(255,255,255,0.62);
    --on-ink-faint: rgba(255,255,255,0.55);
    --on-ink-line: rgba(255,255,255,0.18);
    --line: rgba(14,26,44,0.14);
    --line-strong: rgba(14,26,44,0.28);
    --line-soft: rgba(14,26,44,0.06);
    --accent: #8FBF3F;
    --accent-deep: #4A6E18;
    --accent-bg: #F2F7E5;
    --grotesk: 'Inter Tight', system-ui, sans-serif;
    --serif: 'Newsreader', Georgia, serif;
    --mono: 'DM Mono', ui-monospace, monospace;
    --track-mono: 0.18em;
    --rail-w: 220px;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--grotesk);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  a { color: inherit; }
  button { font: inherit; cursor: pointer; }

  /* ============ APP SHELL ============ */
  .app {
    display: grid;
    grid-template-columns: var(--rail-w) 1fr;
    min-height: 100vh;
  }
  .rail {
    border-right: 1px solid var(--line);
    background: var(--paper-2);
    padding: 1.25rem 0.85rem;
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    overflow-y: auto;
  }
  .main {
    background: var(--paper);
    padding: 0;
    min-width: 0;
  }

  /* ============ RAIL (Direction A) ============ */
  .rail { padding: 22px 14px; gap: 14px; }
  .rail-mark {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 8px;
    text-decoration: none;
    color: var(--ink);
  }
  .rail-wordmark {
    font-family: var(--grotesk);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.05em;
    display: inline-flex; align-items: baseline; gap: 0.05em;
  }
  .rail-dot {
    display: inline-block;
    width: 0.3em; height: 0.3em;
    border-radius: 999px;
    background: var(--accent);
  }
  .rail-tag {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    padding: 3px 7px;
  }
  .rail-sec-label {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
    padding: 0 8px;
    margin-top: 6px;
  }

  .sections-nav {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1;
  }
  .sec-link {
    display: grid;
    grid-template-columns: 16px 16px 1fr auto;
    gap: 10px;
    align-items: center;
    padding: 7px 22px 7px 6px;
    text-decoration: none;
    color: var(--ink-dim);
    border-left: 2px solid transparent;
    transition: background 120ms, color 120ms, border-color 120ms;
  }
  .sec-link:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .sec-link.active {
    background: var(--paper);
    color: var(--ink);
    border-left-color: var(--accent);
  }
  .sec-num {
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    text-align: right;
  }
  .sec-ic { color: currentColor; opacity: 0.78; }
  .sec-name {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .sec-count {
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
  }

  .rail-foot {
    margin-top: auto;
    padding: 14px 8px 0;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 9.5px;
    line-height: 1.7;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }
  .rail-foot-links {
    display: flex; gap: 12px;
    margin-top: 10px;
  }
  .rail-foot-links a {
    color: var(--ink-dim);
    text-decoration: none;
  }
  .rail-foot-links a:hover { color: var(--accent-deep); }

  /* ============ TOPBAR (sticky 49px, single line) ============ */
  .topbar {
    position: sticky; top: 0; z-index: 6;
    display: flex; align-items: center; gap: 14px;
    padding: 14px 24px;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    min-height: 49px;
  }
  .topbar-mark {
    font-family: var(--grotesk);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.05em;
    text-decoration: none;
    color: var(--ink);
    display: inline-flex; align-items: baseline; gap: 0.05em;
  }
  .topbar-dot {
    display: inline-block; width: 0.3em; height: 0.3em;
    border-radius: 999px; background: var(--accent);
  }
  .topbar-crumb {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .topbar-fill { flex: 1; }
  .topbar-date {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }
  .topbar-live {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--accent-deep);
    padding: 4px 10px;
    border: 1px solid var(--accent);
    background: var(--accent-bg);
  }
  .live-dot {
    display: inline-block; width: 6px; height: 6px;
    border-radius: 999px; background: var(--accent);
    animation: hq-pulse 2s ease-in-out infinite;
  }
  @keyframes hq-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.7); }
  }

  /* ============ APP BAR (top of main) ============ */
  .appbar {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    padding: 0.85rem 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .appbar-title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .appbar-h1 {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .appbar-sub {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }
  .appbar-range {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Traffic toggle pill */
  .traffic-toggle {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 0;
    overflow: hidden;
    background: var(--paper-2);
  }
  .tt {
    padding: 0.35rem 0.7rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--ink-dim);
    text-decoration: none;
    transition: background 80ms, color 80ms;
    white-space: nowrap;
  }
  .tt:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .tt--active {
    background: var(--ink);
    color: var(--paper);
    font-weight: 500;
  }
  .tt--active:hover {
    background: var(--ink);
    color: var(--paper);
  }

  /* KPI raw breakdown badge */
  .kpi-raw {
    opacity: 0.7;
  }

  /* Deep analytics disclosure — collapsed by default so daily view is clean */
  .deep {
    border: 1px solid var(--line);
    border-radius: 0;
    margin-bottom: 3rem;
    scroll-margin-top: 4.5rem;
    background: var(--paper);
  }
  .deep summary {
    list-style: none;
    cursor: pointer;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: space-between;
  }
  .deep summary::-webkit-details-marker { display: none; }
  .deep summary:hover { background: var(--paper-2); }
  .deep[open] summary { border-bottom: 1px solid var(--line); }
  .deep-num {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    margin-bottom: 0.15rem;
  }
  .deep-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .deep-title .ital {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    color: var(--ink-dim);
  }
  .deep-meta {
    margin-top: 0.25rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--ink-faint);
  }
  .deep-chev {
    font-family: var(--mono);
    color: var(--ink-faint);
    transition: transform 120ms;
    font-size: 1rem;
  }
  .deep[open] .deep-chev { transform: rotate(180deg); }
  .deep-body {
    padding: 1.25rem 1.25rem 0.5rem;
  }

  /* ============ MAIN CONTENT ============ */
  .content {
    max-width: 1100px;
    padding: 1.5rem 2rem 4rem;
  }

  /* KPI strip — denser than 4 cards, more like ticker */
  .kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border: 1px solid var(--line);
    border-radius: 0;
    overflow: hidden;
    margin-bottom: 2.5rem;
    background: var(--paper);
  }
  .kpis :global(.kpi:last-child) {
    border-right: 0;
  }

  /* Sections */
  section.sec {
    margin-bottom: 3rem;
    scroll-margin-top: 4.5rem;
  }

  /* Error banner */
  .err {
    margin: 1rem 0 2rem;
    padding: 1rem;
    border: 1px solid var(--line-strong);
    background: var(--paper-2);
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--ink-dim);
  }
  .err b { color: var(--ink); }

  /* 404 */
  .nf {
    max-width: 480px;
    margin: 6rem auto;
    padding: 0 1.5rem;
    text-align: center;
  }
  .nf h1 {
    font-size: 5rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.05em;
  }
  .nf p {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* ============ MOBILE (<960px) ============ */
  @media (max-width: 960px) {
    .app {
      grid-template-columns: 1fr;
    }
    .rail {
      position: sticky;
      top: 0;
      z-index: 10;
      height: auto;
      flex-direction: column;
      padding: 0;
      background: var(--paper);
      border-right: 0;
      border-bottom: 1px solid var(--line);
      gap: 0;
    }
    .rail-top {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--line);
    }
    .sections-nav {
      flex-direction: row;
      overflow-x: auto;
      gap: 0.3rem;
      padding: 0.5rem 1rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .sections-nav::-webkit-scrollbar { display: none; }
    .sec-link {
      flex-shrink: 0;
      grid-template-columns: auto auto;
      padding: 0.35rem 0.7rem;
      background: var(--paper-2);
      border-radius: 999px;
    }
    .sec-link:hover { background: var(--paper-3); }
    .sec-num { font-size: 0.65rem; }
    .sec-name { font-size: 0.75rem; }
    .rail-foot { display: none; }

    .appbar {
      padding: 0.65rem 1rem;
      gap: 0.5rem;
    }
    .appbar-range { width: 100%; margin-left: 0; gap: 0.5rem; }
    .traffic-toggle { width: 100%; justify-content: center; }
    .tt { flex: 1; text-align: center; }

    .content {
      padding: 1rem 1rem 3rem;
    }

    .kpis {
      grid-template-columns: 1fr 1fr;
    }
    .kpi { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .kpi:nth-child(2n) { border-right: 0; }
    .kpi:nth-last-child(-n+2) { border-bottom: 0; }
  }
</style>
</head>
<body>
{!authed && (
  <div class="nf">
    <h1>404</h1>
    <p>Nothing here.</p>
  </div>
)}

{authed && (
  <>
  <svg aria-hidden="true" focusable="false" style="position:absolute; width:0; height:0; overflow:hidden;" xmlns="http://www.w3.org/2000/svg">
    <symbol id="ic-pipeline" viewBox="0 0 24 24"><path d="M3 7 H17 a3 3 0 0 1 0 6 H7 a3 3 0 0 0 0 6 H21" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/><circle cx="3" cy="7" r="1.6" fill="#8FBF3F"/></symbol>
    <symbol id="ic-memo" viewBox="0 0 24 24"><path d="M5 3 H15 L19 7 V21 H5 Z M8 11 H16 M8 15 H16 M8 19 H13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></symbol>
    <symbol id="ic-cohort" viewBox="0 0 24 24"><path d="M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H20 V20 H14 Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></symbol>
    <symbol id="ic-flag" viewBox="0 0 24 24"><path d="M4 20 L12 4 L20 20 Z M12 11 V15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/><circle cx="12" cy="17.5" r="0.8" fill="currentColor"/></symbol>
    <symbol id="ic-field-note" viewBox="0 0 24 24"><path d="M6 4 H18 L20 6 V20 H4 V6 Z M8 10 H16 M8 14 H16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/><circle cx="6" cy="4" r="1.4" fill="#8FBF3F"/></symbol>
    <symbol id="ic-curve" viewBox="0 0 24 24"><path d="M3 17 Q9 17 12 11 T21 5 M3 21 H21" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/><circle cx="21" cy="5" r="1.6" fill="#8FBF3F"/></symbol>
  </svg>
  <div class="app">
    <aside class="rail" aria-label="HQ sections">
      <a class="rail-mark" href="/">
        <span class="rail-wordmark">rivett<span class="rail-dot" aria-hidden="true"></span></span>
        <span class="rail-tag">HQ</span>
      </a>
      <div class="rail-sec-label">SECTIONS</div>
      <nav class="sections-nav" aria-label="Section navigation">
        {sections.map((s) => (
          <a href={`#${s.id}`} class="sec-link">
            <span class="sec-num">{s.num}</span>
            <svg class="sec-ic" width="16" height="16" aria-hidden="true"><use href={`#ic-${s.icon}`}></use></svg>
            <span class="sec-name">{s.label}</span>
            {s.count !== null && <span class="sec-count">{s.count}</span>}
          </a>
        ))}
      </nav>
      <div class="rail-foot">
        Single-operator scope.<br/>
        Fred · Cape Town<br/>
        v1.0 · {todayDisplay.slice(0, 7)}
        <div class="rail-foot-links">
          <a href="/hq">↻ refresh</a>
          <a href="https://us.posthog.com/project/373899" target="_blank" rel="noopener">PostHog ↗</a>
        </div>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <a class="topbar-mark" href="/">rivett<span class="topbar-dot" aria-hidden="true"></span></a>
        <span class="topbar-crumb">HQ · 00 Action queue</span>
        <span class="topbar-fill"></span>
        <div class="traffic-toggle" role="group" aria-label="Traffic filter">
          <a
            href={hrefWithTraffic('humans')}
            class={`tt ${trafficMode === 'humans' ? 'tt--active' : ''}`}
            aria-current={trafficMode === 'humans' ? 'true' : 'false'}
          >Humans</a>
          <a
            href={hrefWithTraffic('all')}
            class={`tt ${trafficMode === 'all' ? 'tt--active' : ''}`}
            aria-current={trafficMode === 'all' ? 'true' : 'false'}
          >All</a>
        </div>
        <span class="topbar-date">{todayDisplay} · {weekday}</span>
        {activeNow && activeNow.active_sessions > 0 && (
          <span class="topbar-live">
            <span class="live-dot" aria-hidden="true"></span>
            Live · {activeNow.active_sessions} now
          </span>
        )}
      </header>
      <div class="appbar">
        <div class="appbar-title">
          <h1 class="appbar-h1">Audit engagement</h1>
          <span class="appbar-sub">{range.label}</span>
        </div>
        <div class="appbar-range">
          <DateRangeNav range={range} />
        </div>
      </div>

      <div class="content">
        {fetchError && (
          <div class="err">
            <b>Could not load live data.</b> {fetchError}
          </div>
        )}

        {headline && (
          <div class="kpis">
            <KpiCard
              label="Memo views"
              icon="memo"
              value={headline.memo_views}
              rawValue={headline.memo_views_raw}
              prevValue={headline.memo_views_prev}
              prevLabel={`prev ${range.days}d`}
              spark={headline.spark_memo_views}
            />
            <KpiCard
              label="Unique visitors"
              icon="operator"
              value={headline.unique_visitors}
              rawValue={headline.unique_visitors_raw}
              prevValue={headline.unique_visitors_prev}
              prevLabel={`prev ${range.days}d`}
              spark={headline.spark_unique_visitors}
            />
            <KpiCard
              label="Engaged reads"
              icon="vital"
              value={headline.engaged_reads}
              rawValue={headline.engaged_reads_raw}
              prevValue={headline.engaged_reads_prev}
              prevLabel={`prev ${range.days}d`}
              hint={headline.engaged_reads === 0 && headline.memo_views > 0 ? 'Memos read but no 50% scrollers. Tighten the hook.' : undefined}
              spark={headline.spark_engaged_reads}
              emphasis="accent"
            />
            <KpiCard
              label="CTA clicks"
              icon="flag"
              value={headline.cta_clicks}
              rawValue={headline.cta_clicks_raw}
              prevValue={headline.cta_clicks_prev}
              prevLabel={`prev ${range.days}d`}
              spark={headline.spark_cta_clicks}
              emphasis="accent"
            />
          </div>
        )}

        <section class="sec" id="action">
          <ActionQueue prospects={actionQueue} prospectInfo={prospectInfo} />
        </section>

        <section class="sec" id="send-queue">
          <OutreachQueue queue={outreachQueue} wave={CURRENT_WAVE} />
        </section>

        <section class="sec" id="recent">
          <SectionHeader
            number="01"
            title="Recent reads."
            italicTail="Who looked at what, when."
            meta={`${recent.length} session${recent.length === 1 ? '' : 's'} · ${range.label.toLowerCase()} · ${trafficMode === 'all' ? 'all traffic' : 'real humans only'}`}
          />
          <RecentReadsFeed reads={recent} prospectInfo={prospectInfo} />
        </section>

        <section class="sec" id="prospects">
          <SectionHeader
            number="02"
            title="Top prospects."
            italicTail="Ranked by engagement."
            meta={`${top.length} prospect${top.length === 1 ? '' : 's'} · ${range.label.toLowerCase()} · click a row to expand sessions`}
          />
          <TopProspectsTable prospects={top} prospectInfo={prospectInfo} />
        </section>

        <section class="sec" id="ctas">
          <SectionHeader
            number="03"
            title="CTA clicks."
            italicTail="Book-a-call moments."
            meta={`${ctas.length} click${ctas.length === 1 ? '' : 's'} · ${range.label.toLowerCase()}`}
          />
          <CtaClicksFeed clicks={ctas} prospectInfo={prospectInfo} />
        </section>

        <section class="sec" id="blog">
          <SectionHeader
            number="04"
            title="Blog content."
            italicTail="What is landing with the audience."
            meta={`${blog.length} post${blog.length === 1 ? '' : 's'} · ${range.label.toLowerCase()} · ${trafficMode === 'all' ? 'all traffic' : 'real humans only'}`}
          />
          <TopBlogPostsTable posts={blog} />
        </section>

        <details class="deep" id="deep">
          <summary>
            <div>
              <div class="deep-num">§ 05</div>
              <div class="deep-title">Deep analytics. <span class="ital">Geography, devices, sources, time.</span></div>
              <div class="deep-meta">countries · cities · device + browser · traffic sources · activity timeline</div>
            </div>
            <span class="deep-chev" aria-hidden="true">↓</span>
          </summary>

          <div class="deep-body">
            <section class="sec" id="countries">
              <SectionHeader
                number="05"
                title="Visitors by country."
                italicTail="Where the traffic lands."
                meta={`${countries.length} countries · ${range.label.toLowerCase()} · all traffic`}
              />
              <CountryTable countries={countries} />
            </section>

            <section class="sec" id="cities">
              <SectionHeader
                number="06"
                title="Cities and regions."
                italicTail="Real humans vs scanners."
                meta={`${cities.length} cities · ${range.label.toLowerCase()} · scanners and self flagged`}
              />
              <CityTable cities={cities} />
            </section>

            <section class="sec" id="devices">
              <SectionHeader
                number="07"
                title="Device and browser."
                italicTail="How they read."
                meta={`${devices.length} combinations · ${range.label.toLowerCase()} · ${trafficMode === 'all' ? 'all traffic' : 'real humans only'}`}
              />
              <DeviceTable rows={devices} />
            </section>

            <section class="sec" id="sources">
              <SectionHeader
                number="08"
                title="Traffic sources."
                italicTail="How they got here."
                meta={`${sources.length} source${sources.length === 1 ? '' : 's'} · ${range.label.toLowerCase()} · ${trafficMode === 'all' ? 'all traffic' : 'real humans only'}`}
              />
              <ReferrerTable sources={sources} />
            </section>

            <section class="sec" id="activity">
              <SectionHeader
                number="09"
                title="Activity over time."
                italicTail="The pulse."
                meta={`${activity.length} days · ${range.label.toLowerCase()} · ${trafficMode === 'all' ? 'all traffic' : 'real humans only'}`}
              />
              <ActivityTimeline days={activity} />
            </section>
          </div>
        </details>
      </div>
    </main>
  </div>
  </>
)}
</body>
</html>
