---
// /hq — the operator cockpit. Two modes on one page:
//   COCKPIT (default)   — pulse strip + the work queue (Follow up / Send lanes)
//   ANALYTICS (?view=…) — the nine reference sections, real PostHog data
//
// Ground-up redesign per docs/hq-redesign-brief.md. The card DNA, shell, and
// interactions are ported from the approved standalone mockup; data is
// server-rendered from the same queries + Airtable the old dashboard used,
// and the Send / Draft / Mark-messaged actions hit the existing endpoints.
//
// Auth + data fetch are unchanged from the prior dashboard. Lane layout
// defaults to "switch" (the recommended direction); ?org=stack|blend is a
// live escape hatch. There is no dev "Tweaks" panel in production.

export const prerender = false;

import {
  getRecentReads,
  getTopProspects,
  getHeadlineMetrics,
  getCtaClicks,
  getTopBlogPosts,
  getVisitorsByCountry,
  getVisitorsByCity,
  getVisitorTech,
  getTrafficSources,
  getActivityTimeline,
  getActiveNow,
  type RecentRead,
  type TopProspect,
  type HeadlineMetrics,
  type CtaClick,
  type TopBlogPost,
  type CountryBreakdown,
  type CityBreakdown,
  type DeviceRow,
  type TrafficSource,
  type ActivityDay,
  type TrafficMode,
  type ActiveNow,
} from '../utils/posthog/query';
import { parseDateRange } from '../utils/posthog/dateRange';
import {
  getProspectsBySlug,
  getOutreachQueueByWave,
  type ProspectInfo,
  type OutreachQueueRow,
} from '../utils/hq/airtable';
import { findOnLinkedinUrl, slugToDomain } from '../utils/hq/messaged';
import RecentReadsFeed from '../components/hq/RecentReadsFeed.astro';
import TopProspectsTable from '../components/hq/TopProspectsTable.astro';
import CtaClicksFeed from '../components/hq/CtaClicksFeed.astro';
import TopBlogPostsTable from '../components/hq/TopBlogPostsTable.astro';
import CountryTable from '../components/hq/CountryTable.astro';
import CityTable from '../components/hq/CityTable.astro';
import DeviceTable from '../components/hq/DeviceTable.astro';
import ReferrerTable from '../components/hq/ReferrerTable.astro';
import ActivityTimeline from '../components/hq/ActivityTimeline.astro';
import DateRangeNav from '../components/hq/DateRangeNav.astro';
import { classifyProspectSignal, filterActionable } from '../utils/hq/signal-filter';

// --- Auth gating (unchanged) ---
const HQ_KEY = (process.env.HQ_KEY || import.meta.env.HQ_KEY || '').trim();
const url = new URL(Astro.request.url);
const providedKey = (url.searchParams.get('key') || '').trim();
const cookieHeader = Astro.request.headers.get('cookie') || '';
const cookieKey = (cookieHeader.match(/(?:^|;\s*)rivett_hq_key=([^;]+)/)?.[1] ?? '').trim();

let authed = false;
let setCookie = false;
if (HQ_KEY && providedKey && providedKey === HQ_KEY) { authed = true; setCookie = true; }
else if (HQ_KEY && cookieKey && cookieKey === HQ_KEY) { authed = true; }
if (setCookie) {
  Astro.response.headers.set(
    'Set-Cookie',
    `rivett_hq_key=${HQ_KEY}; Path=/; Max-Age=31536000; HttpOnly; SameSite=Lax; Secure`
  );
}
if (!authed) { Astro.response.status = 404; }

// --- View state (server-set so there is no flash) ---
const viewParam = url.searchParams.get('view') === 'analytics' ? 'analytics' : 'cockpit';
const orgRaw = url.searchParams.get('org') || '';
const orgParam = orgRaw === 'stack' || orgRaw === 'blend' ? orgRaw : 'switch';
const laneParam = url.searchParams.get('lane') === 'send' ? 'send' : 'followup';

// --- Range + traffic ---
const range = parseDateRange(url.searchParams);
const trafficParam = url.searchParams.get('traffic');
const trafficMode: TrafficMode = trafficParam === 'all' ? 'all' : 'humans';

// --- Data fetch ---
let headline: HeadlineMetrics | null = null;
let recent: RecentRead[] = [];
let top: TopProspect[] = [];
let ctas: CtaClick[] = [];
let blog: TopBlogPost[] = [];
let countries: CountryBreakdown[] = [];
let cities: CityBreakdown[] = [];
let devices: DeviceRow[] = [];
let sources: TrafficSource[] = [];
let activity: ActivityDay[] = [];
let activeNow: ActiveNow | null = null;
let prospectInfo: Map<string, ProspectInfo> = new Map();
const CURRENT_WAVE = 'Wave 3 - This Week';
let outreachQueue: OutreachQueueRow[] = [];
let fetchError: string | null = null;

if (authed) {
  try {
    const [h, r, t, c, b, co, ci, dv, sr, ac, an, pi] = await Promise.all([
      getHeadlineMetrics(range),
      getRecentReads(range, trafficMode),
      getTopProspects(range, trafficMode),
      getCtaClicks(range, trafficMode),
      getTopBlogPosts(range),
      getVisitorsByCountry(range),
      getVisitorsByCity(range),
      getVisitorTech(range, trafficMode),
      getTrafficSources(range, trafficMode),
      getActivityTimeline(range, trafficMode),
      getActiveNow(),
      getProspectsBySlug(),
    ]);
    headline = h; recent = r; top = t; ctas = c; blog = b; countries = co;
    cities = ci; devices = dv; sources = sr; activity = ac; activeNow = an; prospectInfo = pi;
  } catch (e) {
    fetchError = e instanceof Error ? e.message : String(e);
    console.error('[hq] PostHog fetch failed', e);
  }
  try {
    outreachQueue = await getOutreachQueueByWave(CURRENT_WAVE);
  } catch (e) {
    console.error('[hq] outreach queue fetch failed', e);
  }
}

// --- Action (follow-up) queue: engaged prospects not yet worked ---
const STAGES_DONE = new Set(['Sent', 'Replied', 'Booked', 'Won', 'Lost', 'Disqualified']);
const actionQueue = filterActionable(top)
  .filter((p) => {
    const info = prospectInfo.get(p.prospect);
    if (info && STAGES_DONE.has(info.outreachStage)) return false;
    return true;
  })
  .sort((a, b) => {
    if (b.heat_score !== a.heat_score) return b.heat_score - a.heat_score;
    return a.last_view < b.last_view ? 1 : -1;
  })
  .slice(0, 10);

// ============================================================
// View-model helpers (pure; produce the HTML the cards render)
// ============================================================
const ic = (id: string, cls = '') =>
  `<svg class="ic ${cls}" aria-hidden="true"><use href="#${id}"></use></svg>`;
const esc = (s: unknown = '') =>
  String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const attr = (s: unknown = '') =>
  String(s ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const initialsOf = (name = '') =>
  name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => (w[0] || '').toUpperCase()).join('') || '–';

function spark(arr: number[]): string {
  if (!arr || arr.length < 2) return '';
  const w = 56, h = 22, p = 2;
  const min = Math.min(...arr), max = Math.max(...arr);
  const rng = max - min || 1;
  const pts = arr.map((v, i) => {
    const x = p + (i / (arr.length - 1)) * (w - p * 2);
    const y = h - p - ((v - min) / rng) * (h - p * 2);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(' ');
  return `<svg class="spark" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none"><polyline points="${pts}"/></svg>`;
}

function dwell(seconds: number): string {
  if (!seconds || seconds < 60) return `${Math.max(0, seconds | 0)}s`;
  const m = Math.floor(seconds / 60), s = seconds % 60;
  return `${m}m${s ? ' ' + s + 's' : ''}`;
}
function timeAgo(iso: string): string {
  if (!iso) return '';
  const then = new Date(iso).getTime();
  if (!Number.isFinite(then)) return '';
  const sec = Math.max(0, Math.round((Date.now() - then) / 1000));
  if (sec < 60) return `${sec}s ago`;
  const min = Math.round(sec / 60);
  if (min < 60) return `${min}m ago`;
  const hr = Math.round(min / 60);
  if (hr < 48) return `${hr}h ago`;
  return `${Math.round(hr / 24)}d ago`;
}

type Temp = 'hot' | 'warm' | 'cool' | 'cold';
function heatBadge(p: TopProspect): { label: string; temp: Temp } {
  const c = classifyProspectSignal(p);
  return { label: c.label, temp: c.temp };
}
function warmWhy(p: TopProspect): string {
  return classifyProspectSignal(p).why;
}
function warmProof(p: TopProspect): [string, string][] {
  const out: [string, string][] = [];
  if (p.distinct_visitors >= 2) out.push([String(p.distinct_visitors), 'people']);
  if (p.unique_sessions) out.push([String(p.unique_sessions), p.unique_sessions === 1 ? 'session' : 'sessions']);
  if (p.cta_clicks) out.push([String(p.cta_clicks), p.cta_clicks === 1 ? 'cta' : 'ctas']);
  if (p.scroll_100s) out.push(['100%', 'scroll']);
  if (p.verdict_expansions) out.push([String(p.verdict_expansions), 'verdicts']);
  if (p.expanded_dimensions?.length) out.push([String(p.expanded_dimensions.length), 'cells']);
  if (p.total_dwell_seconds) out.push([dwell(p.total_dwell_seconds), 'dwell']);
  return out.slice(0, 5);
}

// tier parse from Airtable "Priority" (e.g. "A+ #3")
function tierLabel(priority: string): string {
  const m = (priority || '').match(/^(A\+|A|B|C|D)\b/);
  return m ? m[1] : '–';
}
function tierRank(priority: string): string {
  const m = (priority || '').match(/#(\d+)/);
  return m ? `#${m[1]}` : '';
}
function safeUrl(u: string): string {
  if (!u) return '';
  try {
    const x = new URL(u);
    return x.protocol === 'http:' || x.protocol === 'https:' ? x.toString() : '';
  } catch { return ''; }
}
const waveShort = CURRENT_WAVE.replace(/\s*[-–]\s*this week\s*$/i, '').trim() || CURRENT_WAVE;

// ---- view models ----
interface WarmVM {
  slug: string; initials: string; name: string; title: string; company: string;
  signal: string; signalClass: string; temp: Temp; why: string; proof: [string, string][]; time: string;
  memo: string; liUrl: string; firstName: string; signals: string; lane?: boolean;
}
interface ColdVM {
  slug: string; initials: string; name: string; title: string; company: string;
  industry: string; tier: string; rank: string; wave: string; dm: string;
  audit: string; liUrl: string; lane?: boolean;
}

const pulse = headline ? [
  { k: 'Memo views', icon: 'ic-13-memo', v: headline.memo_views, prev: headline.memo_views_prev, s: headline.spark_memo_views || [] },
  { k: 'Unique visitors', icon: 'ic-06-operator', v: headline.unique_visitors, prev: headline.unique_visitors_prev, s: headline.spark_unique_visitors || [] },
  { k: 'Engaged reads', icon: 'ic-21-curve', v: headline.engaged_reads, prev: headline.engaged_reads_prev, s: headline.spark_engaged_reads || [] },
  { k: 'CTA clicks', icon: 'ic-20-share', v: headline.cta_clicks, prev: headline.cta_clicks_prev, s: headline.spark_cta_clicks || [] },
] : [];

const followUps: WarmVM[] = actionQueue.map((p) => {
  const info = prospectInfo.get(p.prospect);
  const name = info?.displayName || info?.firstName || slugToDomain(p.prospect);
  const h = heatBadge(p);
  const classified = classifyProspectSignal(p);
  return {
    slug: p.prospect, initials: initialsOf(name), name,
    title: info?.title || '', company: info?.company || slugToDomain(p.prospect),
    signal: h.label, signalClass: classified.kind, temp: h.temp, why: warmWhy(p), proof: warmProof(p),
    time: timeAgo(p.last_view), memo: p.prospect,
    liUrl: info?.linkedinUrl || findOnLinkedinUrl(p.prospect) || '',
    firstName: info?.firstName || name.split(' ')[0] || '',
    signals: JSON.stringify({
      total_dwell_seconds: p.total_dwell_seconds, unique_sessions: p.unique_sessions,
      total_views: p.total_views, cta_clicks: p.cta_clicks, verdict_expansions: p.verdict_expansions,
      scroll_100s: p.scroll_100s, copies: p.copies, prints: p.prints, related_clicks: p.related_clicks,
      distinct_visitors: p.distinct_visitors, focus_seconds_total: p.focus_seconds_total,
      expanded_dimensions: p.expanded_dimensions,
      return_visitor: p.return_visitor, last_view: p.last_view,
    }),
  };
});

const sends: ColdVM[] = outreachQueue.map((r) => ({
  slug: r.slug, initials: initialsOf(r.displayName || r.firstName || r.slug),
  name: r.displayName || r.firstName || r.slug, title: r.title || '',
  company: r.company || '', industry: r.industry || '',
  tier: tierLabel(r.priority), rank: tierRank(r.priority), wave: waveShort,
  dm: r.linkedinDm || '', audit: safeUrl(r.auditUrl || ''), liUrl: safeUrl(r.linkedinUrl || ''),
}));

// ---- card renderers (mirror the approved mockup) ----
function warmCard(p: WarmVM): string {
  return `<article class="card card--warm" data-slug="${attr(p.slug)}" data-signal-class="${attr(p.signalClass)}" data-signals="${attr(p.signals)}" data-li-url="${attr(p.liUrl)}" data-first-name="${attr(p.firstName)}" data-company="${attr(p.company)}" data-name="${attr(p.name)}">
    <div class="strip">
      <span class="striptag">${p.lane ? '<span class="lane">Follow up</span>' : ''}${ic('ic-03-signal')} ${esc(p.signal)}</span>
      <span class="stamp-time">${esc(p.time)}</span>
    </div>
    <div class="body">
      <div class="qhero">
        <span class="avatar">${esc(p.initials)}</span>
        <div class="who"><h3 class="name">${esc(p.name)}</h3><p class="role">${p.title ? esc(p.title) + ' · ' : ''}<span class="co">${esc(p.company)}</span></p></div>
      </div>
      <p class="why">${esc(p.why)}</p>
      <div class="proof">${p.proof.map(([v, k]) => `<span class="pt"><b>${esc(v)}</b> ${esc(k)}</span>`).join('')}</div>
    </div>
    <div class="actions">
      <button class="msgd" data-action="messaged" data-slug="${attr(p.slug)}"><span class="box">${ic('ic-12-confirm')}</span> Mark messaged</button>
      <div class="rightcluster">
        <a class="lnk" href="https://rivett.tech/audit/v3/${attr(p.memo)}" target="_blank" rel="noopener">Open memo ${ic('ic-10-external')}</a>
        <button class="qbtn" data-action="draft" data-slug="${attr(p.slug)}">Draft DM ${ic('ic-11-arrow')}</button>
      </div>
    </div>
  </article>`;
}
function coldCard(p: ColdVM): string {
  const tier = `${esc(p.tier)} tier${p.rank ? ' · ' + esc(p.rank) : ''} · ${esc(p.wave)}`;
  const dmHtml = esc(p.dm).replace(/(rivett\.tech\/audit\/v3\/[a-z0-9-]+)/gi, '<span class="link">$1</span>');
  return `<article class="card card--cold" data-slug="${attr(p.slug)}" data-linkedin="${attr(p.liUrl)}" data-dm="${attr(p.dm)}">
    <div class="strip">
      <span class="striptag">${p.lane ? '<span class="lane">Send</span>' : ''}${tier}</span>
      <span class="stamp-time"></span>
    </div>
    <div class="body">
      <div class="qhero">
        <span class="avatar">${esc(p.initials)}</span>
        <div class="who"><h3 class="name">${esc(p.name)}</h3><p class="role">${p.title ? esc(p.title) + ' · ' : ''}<span class="co">${esc(p.company)}</span></p></div>
      </div>
      <div class="proof"><span class="pt"><b>${esc(p.tier)}</b> tier</span>${p.industry ? `<span class="pt"><b>${esc(p.industry)}</b></span>` : ''}<span class="pt"><b>${esc(p.wave)}</b></span>${p.audit ? '' : '<span class="pt">no audit minted</span>'}</div>
      <div class="dm">
        <div class="dmhead"><span class="l">Drafted DM</span><span class="chars">${p.dm.length} chars</span></div>
        <div class="dmbody">${dmHtml || '<span style="color:var(--ink-faint)">no draft on file</span>'}</div>
      </div>
    </div>
    <div class="actions">
      ${p.audit
        ? `<a class="msgd" href="${attr(p.audit)}" target="_blank" rel="noopener" style="text-decoration:none">${ic('ic-13-memo')} Open audit ${ic('ic-10-external')}</a>`
        : `<span class="msgd" style="cursor:default">${ic('ic-13-memo')} No audit url</span>`}
      <div class="rightcluster"><button class="qbtn" data-action="send" data-slug="${attr(p.slug)}"${p.liUrl && p.dm ? '' : ' disabled'}>Send ${ic('ic-11-arrow')}</button></div>
    </div>
  </article>`;
}

function laneList(items: (WarmVM | ColdVM)[], render: (x: any) => string, empty: string, cls: string): string {
  return items.length ? `<div class="qlist ${cls}">${items.map(render).join('')}</div>` : `<div class="empty ${cls}"><p>${empty}</p></div>`;
}

function renderQueue(): string {
  const fu = followUps, sd = sends;
  const fuEmpty = 'no warm reads today. send more outreach.';
  const sdEmpty = 'no cold sends queued. the wave is clear.';
  if (orgParam === 'stack') {
    return `<div class="org-stack">
      <p class="directive"><b>${fu.length} to follow up, ${sd.length} to send.</b> Both lanes, one scroll. Warm first.</p>
      <section class="lanesec"><div class="lanesec-head"><div class="t"><span class="num">§ Follow up</span>${ic('ic-03-signal')}<h2>Warm reads <span class="ital">earned it.</span></h2></div><span class="count">${fu.length} waiting</span></div><div style="margin-top:var(--sp-5)">${laneList(fu, warmCard, fuEmpty, 'lane-followup')}</div></section>
      <section class="lanesec"><div class="lanesec-head"><div class="t"><span class="num">§ Send · ${esc(waveShort)}</span>${ic('ic-14-outreach')}<h2>Cold wave <span class="ital">ready to go.</span></h2></div><span class="count">${sd.length} drafted</span></div><div style="margin-top:var(--sp-5)">${laneList(sd, coldCard, sdEmpty, 'lane-send')}</div></section>
    </div>`;
  }
  if (orgParam === 'blend') {
    const blended = [
      ...fu.map((x) => ({ ...x, lane: true, _k: 'w', _u: x.temp === 'hot' ? 0 : 1 })),
      ...sd.map((x) => ({ ...x, lane: true, _k: 'c', _u: x.tier === 'A+' ? 0.5 : x.tier === 'A' ? 1.5 : 2.5 })),
    ].sort((a, b) => a._u - b._u);
    return `<div class="org-blend"><p class="directive"><b>${fu.length + sd.length} waiting.</b> One queue, sorted by urgency. Work top down.</p><div class="qlist" style="margin-top:var(--sp-6)">${blended.map((x: any) => (x._k === 'w' ? warmCard(x) : coldCard(x))).join('')}</div></div>`;
  }
  // switch (default): render both lanes; CSS shows the active one
  return `<div class="org-switch">
    <div class="laneswitch"><div class="seg" role="tablist">
      <button data-action="lane" data-lane="followup" aria-pressed="${laneParam === 'followup'}">${ic('ic-03-signal')} Follow up <span class="n">${fu.length}</span></button>
      <button data-action="lane" data-lane="send" aria-pressed="${laneParam === 'send'}">${ic('ic-14-outreach')} Send <span class="n">${sd.length}</span></button>
    </div></div>
    <p class="directive"><b>${fu.length} to follow up, ${sd.length} to send.</b> Warm reads that earned a next touch, and this week’s cold wave.</p>
    <div style="margin-top:var(--sp-6)">${laneList(fu, warmCard, fuEmpty, 'lane-followup')}${laneList(sd, coldCard, sdEmpty, 'lane-send')}</div>
  </div>`;
}

const pulseHtml = pulse.map((p) => {
  const delta = p.v - p.prev;
  const pct = p.prev ? Math.round((delta / p.prev) * 100) : 0;
  const upd = delta >= 0;
  return `<div class="kpi"><span class="k">${ic(p.icon)} ${esc(p.k)}</span><div class="row"><span class="v">${p.v.toLocaleString()}</span>${spark(p.s)}</div><span class="d ${upd ? 'up' : 'down'}">${upd ? '+' : '−'}${Math.abs(pct)}% · ${upd ? '+' : '−'}${Math.abs(delta)}</span></div>`;
}).join('');
const queueHtml = renderQueue();

// analytics section index (chrome only; the components render the data)
const AN_SECTIONS = [
  { id: 'reads', n: '01', icon: 'ic-13-memo', title: 'Recent reads', tail: 'who opened it.', sub: `${recent.length} sessions` },
  { id: 'prospects', n: '02', icon: 'ic-06-operator', title: 'Top prospects', tail: 'by heat.', sub: `${top.length} ranked` },
  { id: 'cta', n: '03', icon: 'ic-20-share', title: 'CTA clicks', tail: 'who raised a hand.', sub: `${ctas.length} events` },
  { id: 'blog', n: '04', icon: 'ic-15-field-note', title: 'Field notes', tail: 'what resonated.', sub: `${blog.length} posts` },
  { id: 'countries', n: '05', icon: 'ic-24-flag', title: 'Countries', tail: 'where from.', sub: `${countries.length}` },
  { id: 'cities', n: '06', icon: 'ic-22-cohort', title: 'Cities', tail: 'closer in.', sub: `${cities.length}` },
  { id: 'devices', n: '07', icon: 'ic-05-stack', title: 'Device & browser', tail: 'on what.', sub: 'share' },
  { id: 'sources', n: '08', icon: 'ic-02-pipeline', title: 'Traffic sources', tail: 'how they arrived.', sub: `${sources.length}` },
  { id: 'timeline', n: '09', icon: 'ic-04-cadence', title: 'Activity', tail: 'in sequence.', sub: `${activity.length}d` },
];
const anHead = (s: typeof AN_SECTIONS[number]) =>
  `<div class="an-head"><div class="l"><span class="snum">§ ${s.n}</span><span class="an-ic">${ic(s.icon)}</span><h2>${esc(s.title)} <span class="ital">${esc(s.tail)}</span></h2></div><span class="sub">${esc(s.sub)}</span></div>`;

const today = new Date();
const todayDisplay = `${today.getUTCFullYear()}·${String(today.getUTCMonth() + 1).padStart(2, '0')}·${String(today.getUTCDate()).padStart(2, '0')}`;
---
