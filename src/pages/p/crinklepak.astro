---
import Base from '../../layouts/Base.astro';

const title = 'The Crinkler Engine · Rivett';
const description = 'Proposal for Mark Gannon, CrinklePak.';
---
<Base
  title={title}
  description={description}
  fontWeights="Inter+Tight:wght@400;500;600;700;800"
>
<div class="proposal">

  <div class="banner">
    <span><b>Rivett</b> · Proposal</span>
    <span><b>Mark Gannon</b> · CrinklePak</span>
  </div>

  <div class="page">

    <header class="head">
      <a class="wm" href="/"><span>rivett</span><span class="dot"></span></a>
      <span class="meta">v1 · 06.02</span>
    </header>

    <!-- HERO -->
    <section class="hero">
      <h1>The Crinkler <span class="ital">Engine.</span></h1>
      <p class="dek">What we talked about. Priced and shaped.</p>
    </section>

    <!-- THE ENGINE -->
    <section class="block engine">
      <div class="strap">
        <span class="lbl">The offer</span>
        <h2>We find them. We audit them.<br>We send them. You close them.</h2>
      </div>

      <div class="nums">
        <div><span class="k">Setup</span><span class="v">$5,000</span></div>
        <div><span class="k">Monthly</span><span class="v">$6,000</span></div>
        <div><span class="k">Volume</span><span class="v">~50/wk</span></div>
        <div><span class="k">Commit</span><span class="v">Any month</span></div>
      </div>

      <div class="three">
        <div>
          <span class="three-k">Mining</span>
          <p>Every gift basket brand, subscription box, 3PL and packaging buyer in your market. Named. Tagged. Ranked by fit.</p>
        </div>
        <div>
          <span class="three-k">Outreach</span>
          <p>Custom audit per prospect, posted at their own domain. Cold DM that lands because it called out something only you'd notice.</p>
        </div>
        <div>
          <span class="three-k">Pipeline</span>
          <p>Booked meetings drop into your calendar. Live dashboard. Audit your auditor any time.</p>
        </div>
      </div>

      <p class="bottom-line">Year 1: <b>$77,000</b>. Less than one BD hire.</p>
    </section>

    <!-- THE DOORWAY -->
    <section class="block doorway">
      <div class="strap">
        <span class="lbl">First step</span>
        <h2>Before that <span class="ital">— the audit.</span></h2>
      </div>

      <p class="lede">$3,500. Two weeks. Written plan using your data. Includes a sample of 10 wholesale prospects with the audits I'd send them and the DMs I'd open with — so you see the engine in action before you sign for the bigger thing.</p>

      <p class="lede minor">Yours to keep. Run it yourself or fire the engine up. Your call.</p>
    </section>

    <!-- END CTA -->
    <section class="cta">
      <div class="cta-left">
        <h3>Reply <span class="quote">"let's do it"</span>.<br><span class="ital">SOW out today.</span></h3>
      </div>
      <div class="cta-right">
        <ol class="steps">
          <li><span class="n">01</span><span>Reply. SOW + invoice today.</span></li>
          <li><span class="n">02</span><span>Pay 50% to kick off — $1,750.</span></li>
          <li><span class="n">03</span><span>Two weeks. Plan delivered. Engine on standby.</span></li>
        </ol>
      </div>
    </section>

    <div class="sign">
      <p>Everyday I'm Crinkling.</p>
      <span class="name">Fred</span>
    </div>

    <footer class="foot">
      <a class="wm wm--sm" href="/"><span>rivett</span><span class="dot"></span></a>
      <span>fred@rivett.tech</span>
    </footer>

  </div>
</div>

<style>
.proposal {
  background: var(--paper);
  color: var(--ink);
  font-family: var(--grotesk);
  line-height: 1.55;
}

.proposal .page {
  max-width: 980px;
  margin: 0 auto;
  padding: 0 56px;
}
@media (max-width: 780px) {
  .proposal .page { padding: 0 24px; }
}

/* ---------- Banner ---------- */
.proposal .banner {
  background: var(--paper-2);
  padding: var(--sp-3) var(--sp-6);
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sp-4);
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: var(--track-mono);
  text-transform: uppercase;
  color: var(--ink-faint);
  border-bottom: var(--bw-hair) solid var(--line);
}
.proposal .banner b { color: var(--ink); font-weight: 500; }

/* ---------- Head ---------- */
.proposal .head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--sp-7) 0 var(--sp-5);
}
.proposal .wm {
  display: inline-flex;
  align-items: center;
  gap: 0.1em;
  font-family: var(--grotesk);
  font-weight: 700;
  font-size: 24px;
  letter-spacing: -0.05em;
  line-height: 1;
  color: var(--ink);
  text-decoration: none;
}
.proposal .wm .dot {
  display: inline-block;
  width: 0.32em;
  height: 0.32em;
  background: var(--accent);
  border-radius: var(--r-pill);
  transform: translateY(0.04em);
}
.proposal .wm--sm { font-size: 14px; }
.proposal .meta {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: var(--track-mono);
  text-transform: uppercase;
  color: var(--ink-faint);
}

/* ---------- Hero ---------- */
.proposal .hero {
  padding: var(--sp-16) 0 var(--sp-20);
  border-bottom: var(--bw-hair) solid var(--line);
}
.proposal .hero h1 {
  font-family: var(--grotesk);
  font-weight: 800;
  font-size: clamp(64px, 11vw, 144px);
  line-height: 0.9;
  letter-spacing: var(--track-display);
  margin: 0;
  text-wrap: balance;
  max-width: 880px;
}
.proposal .hero h1 .ital {
  font-family: var(--serif);
  font-style: italic;
  font-weight: 400;
  color: var(--ink-dim);
  letter-spacing: -0.02em;
}
.proposal .hero .dek {
  font-family: var(--serif);
  font-style: italic;
  font-size: clamp(22px, 2.2vw, 28px);
  line-height: 1.4;
  color: var(--ink-dim);
  margin: var(--sp-7) 0 0;
  max-width: 600px;
}

/* ---------- Block ---------- */
.proposal .block {
  padding: var(--sp-16) 0 var(--sp-14);
  border-bottom: var(--bw-hair) solid var(--line);
}
.proposal .strap {
  margin-bottom: var(--sp-10);
  max-width: 880px;
}
.proposal .lbl {
  display: inline-block;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: var(--track-mono);
  text-transform: uppercase;
  color: var(--accent-deep);
  margin-bottom: var(--sp-4);
}
.proposal .lbl::before {
  content: '';
  display: inline-block;
  width: 7px;
  height: 7px;
  background: var(--accent);
  border-radius: var(--r-pill);
  margin-right: 10px;
  vertical-align: middle;
}
.proposal h2 {
  font-family: var(--grotesk);
  font-weight: 700;
  font-size: clamp(36px, 5vw, 56px);
  line-height: 1.02;
  letter-spacing: var(--track-h);
  margin: 0;
  text-wrap: balance;
  color: var(--ink);
}
.proposal h2 .ital {
  font-family: var(--serif);
  font-style: italic;
  font-weight: 400;
  color: var(--ink-dim);
  letter-spacing: -0.02em;
}

/* ---------- Nums ---------- */
.proposal .nums {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--sp-5);
  padding: var(--sp-7) 0;
  border-top: var(--bw-rule) solid var(--ink);
  border-bottom: var(--bw-rule) solid var(--ink);
  margin: var(--sp-7) 0 var(--sp-10);
}
@media (max-width: 780px) {
  .proposal .nums { grid-template-columns: repeat(2, 1fr); }
}
.proposal .nums .k {
  display: block;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: var(--track-mono);
  text-transform: uppercase;
  color: var(--ink-faint);
  margin-bottom: var(--sp-2);
}
.proposal .nums .v {
  font-family: var(--grotesk);
  font-weight: 700;
  font-size: clamp(28px, 3.4vw, 40px);
  line-height: 1;
  letter-spacing: var(--track-tighter);
  color: var(--ink);
}

/* ---------- Three columns ---------- */
.proposal .three {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--sp-10);
  margin: var(--sp-7) 0;
}
@media (max-width: 780px) {
  .proposal .three { grid-template-columns: 1fr; gap: var(--sp-7); }
}
.proposal .three-k {
  display: block;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: var(--track-mono);
  text-transform: uppercase;
  color: var(--accent-deep);
  margin-bottom: var(--sp-3);
  padding-bottom: var(--sp-3);
  border-bottom: var(--bw-hair) solid var(--ink);
}
.proposal .three p {
  font-size: 16px;
  line-height: 1.55;
  color: var(--ink);
  margin: 0;
}

.proposal .bottom-line {
  font-family: var(--serif);
  font-style: italic;
  font-size: 22px;
  color: var(--ink-dim);
  margin: var(--sp-10) 0 0;
}
.proposal .bottom-line b {
  font-family: var(--grotesk);
  font-style: normal;
  font-weight: 700;
  color: var(--ink);
}

/* ---------- Doorway ---------- */
.proposal .doorway .lede {
  font-family: var(--grotesk);
  font-size: clamp(19px, 1.9vw, 22px);
  line-height: 1.55;
  color: var(--ink);
  margin: 0 0 var(--sp-6);
  max-width: 760px;
}
.proposal .doorway .lede.minor {
  font-family: var(--serif);
  font-style: italic;
  font-size: 19px;
  color: var(--ink-dim);
  margin-top: var(--sp-4);
}

/* ---------- CTA ---------- */
.proposal .cta {
  background: var(--ink);
  color: var(--on-ink);
  margin: var(--sp-16) calc(var(--sp-12) * -1) 0;
  padding: var(--sp-16) var(--sp-12);
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: var(--sp-12);
  align-items: center;
}
@media (max-width: 880px) {
  .proposal .cta {
    grid-template-columns: 1fr;
    margin: var(--sp-12) calc(var(--sp-6) * -1) 0;
    padding: var(--sp-10) var(--sp-7);
    gap: var(--sp-7);
  }
}
.proposal .cta h3 {
  font-family: var(--grotesk);
  font-weight: 700;
  font-size: clamp(36px, 4.4vw, 56px);
  line-height: 1.04;
  letter-spacing: var(--track-h);
  margin: 0;
  color: var(--on-ink);
  text-wrap: balance;
}
.proposal .cta h3 .ital {
  font-family: var(--serif);
  font-style: italic;
  font-weight: 400;
  color: var(--on-ink-italic);
  letter-spacing: -0.02em;
}
.proposal .cta .quote {
  color: var(--accent);
}
.proposal .steps {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--sp-5);
}
.proposal .steps li {
  display: grid;
  grid-template-columns: 38px 1fr;
  gap: var(--sp-3);
  align-items: baseline;
  padding-bottom: var(--sp-5);
  border-bottom: var(--bw-hair) solid var(--on-ink-line);
}
.proposal .steps li:last-child { border-bottom: 0; padding-bottom: 0; }
.proposal .steps .n {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: var(--track-mono);
  color: var(--accent);
  font-weight: 500;
}
.proposal .steps li span:last-child {
  font-size: 16px;
  line-height: 1.5;
  color: var(--on-ink-dim);
}

/* ---------- Sign ---------- */
.proposal .sign {
  padding: var(--sp-16) 0 var(--sp-8);
}
.proposal .sign p {
  font-family: var(--serif);
  font-style: italic;
  font-size: clamp(24px, 2.6vw, 32px);
  line-height: 1.2;
  color: var(--ink-dim);
  margin: 0;
  text-wrap: balance;
  max-width: 600px;
}
.proposal .sign .name {
  display: block;
  margin-top: var(--sp-3);
  font-family: var(--grotesk);
  font-weight: 600;
  font-size: 18px;
  color: var(--ink);
}

/* ---------- Foot ---------- */
.proposal .foot {
  padding: var(--sp-5) 0 var(--sp-10);
  border-top: var(--bw-hair) solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: var(--track-mono);
  text-transform: uppercase;
  color: var(--ink-faint);
}
</style>
</Base>
