<div class="kit-gate" data-kit-gate hidden>
  <div class="kit-gate__panel" role="dialog" aria-modal="true" aria-labelledby="kit-gate-title">
    <button class="kit-gate__close" type="button" aria-label="Close download form" data-kit-gate-close>×</button>
    <span class="kit-gate__label">Field Kit Access</span>
    <h2 id="kit-gate-title">Get the field kit.</h2>
    <p data-kit-gate-copy>Drop your details and the PDF opens immediately.</p>

    <form class="kit-gate__form" data-kit-gate-form>
      <input type="hidden" name="kit" data-kit-gate-kit />
      <label>
        <span>Name</span>
        <input name="name" autocomplete="name" required />
      </label>
      <label>
        <span>Work email</span>
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label>
        <span>Company</span>
        <input name="company" autocomplete="organization" />
      </label>
      <label>
        <span>What are you trying to fix?</span>
        <textarea name="use_case" rows="3"></textarea>
      </label>
      <button class="kit-gate__submit" type="submit">Download PDF →</button>
      <p class="kit-gate__note">No newsletter trap. This just tells me who the kit is helping.</p>
    </form>
  </div>
</div>

<script>
  type PostHogWindow = Window & {
    posthog?: {
      identify?: (id: string, properties?: Record<string, unknown>) => void;
      capture?: (event: string, properties?: Record<string, unknown>) => void;
    };
  };

  const gate = document.querySelector<HTMLElement>('[data-kit-gate]');
  const panel = gate?.querySelector<HTMLElement>('.kit-gate__panel');
  const form = gate?.querySelector<HTMLFormElement>('[data-kit-gate-form]');
  const close = gate?.querySelector<HTMLButtonElement>('[data-kit-gate-close]');
  const title = gate?.querySelector<HTMLElement>('#kit-gate-title');
  const copy = gate?.querySelector<HTMLElement>('[data-kit-gate-copy]');
  const kitField = gate?.querySelector<HTMLInputElement>('[data-kit-gate-kit]');
  let activeButton: HTMLButtonElement | null = null;

  function storageKey(slug: string) {
    return `rivett_field_kit_${slug}`;
  }

  function downloadPdf(pdf: string) {
    const anchor = document.createElement('a');
    anchor.href = pdf;
    anchor.download = '';
    document.body.append(anchor);
    anchor.click();
    anchor.remove();
  }

  function openGate(button: HTMLButtonElement) {
    const slug = button.dataset.kitSlug;
    const pdf = button.dataset.kitPdf;
    if (!slug || !pdf || !gate) return;

    if (window.localStorage.getItem(storageKey(slug))) {
      downloadPdf(pdf);
      return;
    }

    activeButton = button;
    if (title) title.textContent = `Get ${button.dataset.kitTitle ?? 'the field kit'}.`;
    if (copy) copy.textContent = button.dataset.kitCopy ?? 'Drop your details and the PDF opens immediately.';
    if (kitField) kitField.value = slug;
    gate.hidden = false;
    document.body.style.overflow = 'hidden';
    form?.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
  }

  function closeGate() {
    if (!gate) return;
    gate.hidden = true;
    document.body.style.overflow = '';
    activeButton?.focus();
    activeButton = null;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-kit-download]').forEach((button) => {
    button.addEventListener('click', () => openGate(button));
  });

  close?.addEventListener('click', closeGate);
  gate?.addEventListener('click', (event) => {
    if (event.target === gate) closeGate();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && gate && !gate.hidden) closeGate();
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!activeButton) return;

    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim().toLowerCase();
    const company = String(data.get('company') ?? '').trim();
    const useCase = String(data.get('use_case') ?? '').trim();
    const slug = activeButton.dataset.kitSlug ?? '';
    const title = activeButton.dataset.kitTitle ?? '';
    const pdf = activeButton.dataset.kitPdf ?? '';

    const w = window as PostHogWindow;
    w.posthog?.identify?.(email, {
      email,
      name,
      company,
      field_kit: slug,
      use_case: useCase,
    });
    w.posthog?.capture?.('field_kit_download', {
      kit_slug: slug,
      kit_title: title,
      company,
      use_case: useCase,
    });

    window.localStorage.setItem(storageKey(slug), 'true');
    closeGate();
    downloadPdf(pdf);
  });
</script>

<style is:global>
  .kit-gate[hidden]{display:none}
  .kit-gate{position:fixed;inset:0;z-index:500;background:rgba(14,26,44,0.58);display:grid;place-items:center;padding:24px}
  .kit-gate__panel{position:relative;width:min(100%,560px);background:var(--paper);border:1px solid var(--ink);padding:36px 34px 34px;box-shadow:0 28px 80px rgba(14,26,44,0.22)}
  .kit-gate__close{position:absolute;top:14px;right:16px;border:0;background:transparent;color:var(--ink);font-family:var(--grotesk);font-size:34px;line-height:1;cursor:pointer;padding:4px 10px}
  .kit-gate__label{display:inline-flex;align-items:center;font-family:var(--mono);font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:var(--accent-deep)}
  .kit-gate__label::before{content:'';width:8px;height:8px;background:var(--accent);border-radius:50%;margin-right:12px}
  .kit-gate h2{font-size:44px;line-height:1;letter-spacing:-0.045em;margin:22px 0 0;color:var(--ink)}
  .kit-gate p{font-size:17px;line-height:1.55;color:var(--ink-dim);margin:18px 0 0}
  .kit-gate__form{display:grid;gap:16px;margin-top:28px}
  .kit-gate__form label{display:grid;gap:8px}
  .kit-gate__form label span{font-family:var(--mono);font-size:10.5px;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink-faint)}
  .kit-gate__form input,.kit-gate__form textarea{width:100%;border:1px solid var(--line-strong);background:var(--paper-2);color:var(--ink);font:inherit;font-size:16px;padding:13px 14px;border-radius:0}
  .kit-gate__form input:focus,.kit-gate__form textarea:focus{outline:2px solid var(--accent);outline-offset:2px}
  .kit-gate__submit{border:1px solid var(--ink);background:var(--ink);color:var(--paper);min-height:48px;padding:14px 18px;font-family:var(--mono);font-size:11px;letter-spacing:0.18em;text-transform:uppercase;cursor:pointer}
  .kit-gate__note{font-family:var(--serif);font-style:italic;font-size:15px !important;margin-top:0 !important}
  button[data-kit-download]{cursor:pointer}
</style>
