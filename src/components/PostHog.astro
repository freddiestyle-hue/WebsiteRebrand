// Full-stack PostHog instrumentation.
//
// Loaded on every page (via Base.astro) AND on bespoke audit pages (/audit/v3,
// /audit/p/[slug]) that bypass Base.astro. Callers that need to attribute the
// session to a specific prospect (memo pages) pass `identifyAs` + props.
//
// Events fired automatically once this loads:
//   $pageview, $pageleave, $autocapture, $web_vitals (perf), $heatmap data,
//   $session_recording, scroll_depth (25/50/75/100), cta_clicked
//
// Helper exposed: window.rivett.track(eventName, properties)
const POSTHOG_KEY = 'phc_vqst8XDELjjTmFYwJiqzD7PzazzyQ9J69WJmcfJoxt27';
// Events route through our own domain (e.rivett.tech -> PostHog US ingest) so
// ad blockers can't silently drop 10-25% of them. ui_host stays the real
// PostHog app so the toolbar and "view in PostHog" / replay links still work.
const POSTHOG_HOST = 'https://e.rivett.tech';
const POSTHOG_UI_HOST = 'https://us.posthog.com';

interface Props {
  capturePageview?: boolean;
  optOutByDefault?: boolean;
  identifyAs?: string;
  personProperties?: Record<string, unknown>;
  groupKey?: string;
  groupType?: string;
}

const {
  capturePageview = true,
  optOutByDefault = false,
  identifyAs,
  personProperties,
  groupKey,
  groupType = 'company',
} = Astro.props;

const identifyPayload = identifyAs
  ? {
      id: identifyAs,
      props: personProperties ?? {},
      groupKey: groupKey ?? null,
      groupType,
    }
  : null;
---
<script is:inline define:vars={{ POSTHOG_KEY, POSTHOG_HOST, POSTHOG_UI_HOST, capturePageview, optOutByDefault, identifyPayload }}>
  !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init me ws ys ps bs capture je Di ks register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSurveysLoaded onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey canRenderSurveyAsync identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty Es $s createPersonProfile Is opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing Ss debug xs getPageViewId captureTraceFeedback captureTraceMetric".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);

  posthog.init(POSTHOG_KEY, {
    api_host: POSTHOG_HOST,
    ui_host: POSTHOG_UI_HOST,
    person_profiles: 'identified_only',
    capture_pageview: capturePageview,
    capture_pageleave: capturePageview,
    opt_out_capturing_by_default: optOutByDefault,
    autocapture: true,
    capture_heatmaps: true,
    capture_performance: { web_vitals: true, network_timing: true },
    session_recording: {
      maskAllInputs: true,
      maskTextSelector: '[data-private]',
      recordCrossOriginIframes: false,
    },
    enable_recording_console_log: false,
    respect_dnt: true,
    loaded: function (ph) {
      // UTM + referrer capture as super properties — attached to every event.
      try {
        var p = new URLSearchParams(window.location.search);
        var supers = {};
        ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','utm_recipient','prospect','r','rl','via'].forEach(function (k) {
          var v = p.get(k);
          if (v) supers[k] = v;
        });
        if (Object.keys(supers).length) ph.register(supers);
      } catch (e) {}

      // Identify the visitor if the caller knows who they are (e.g. memo slug).
      // Also persist the slug as a 30-day cookie so subsequent visits to ANY
      // page on rivett.tech (blog, MRI, etc) attribute back to this prospect
      // even after the PostHog session expires. This is the sticky-identity
      // play — a prospect who reads the memo Monday and the AI blog Friday
      // shows up in HQ as one trail, not two anonymous visits.
      var COOKIE_NAME = 'rivett_prospect';
      function readCookie(name) {
        try {
          var m = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]+)'));
          return m ? decodeURIComponent(m[1]) : null;
        } catch (e) { return null; }
      }
      function writeCookie(name, val) {
        try {
          var maxAge = 60 * 60 * 24 * 30; // 30 days
          document.cookie = name + '=' + encodeURIComponent(val) +
            '; Max-Age=' + maxAge + '; Path=/; SameSite=Lax';
        } catch (e) {}
      }

      if (identifyPayload && identifyPayload.id) {
        var props = Object.assign({}, identifyPayload.props || {}, {
          first_seen_path: window.location.pathname,
        });
        ph.identify(identifyPayload.id, props);
        if (identifyPayload.groupKey) {
          ph.group(identifyPayload.groupType, identifyPayload.groupKey);
        }
        // Stamp the slug so future visits to other pages re-identify.
        writeCookie(COOKIE_NAME, identifyPayload.id);
      } else {
        // No explicit identify on this page. Check the cookie — if a prior
        // memo visit stamped one, re-identify so this page's events
        // attribute to the prospect.
        var stickySlug = readCookie(COOKIE_NAME);
        if (stickySlug) {
          ph.identify(stickySlug, { sticky_identity_path: window.location.pathname });
        }
      }

      // Force session recording on (init flag alone gates by sample rate).
      if (typeof ph.startSessionRecording === 'function') {
        ph.startSessionRecording();
      }
    },
  });

  // Public helper for components to fire custom events without re-importing PH.
  window.rivett = window.rivett || {};
  window.rivett.track = function (event, properties) {
    if (window.posthog && window.posthog.capture) {
      window.posthog.capture(event, properties || {});
    }
  };

  // Scroll-depth tracking: fire once per threshold per page load.
  (function () {
    var thresholds = [25, 50, 75, 100];
    var fired = {};
    function pct() {
      var h = document.documentElement;
      var b = document.body;
      var scrollTop = h.scrollTop || b.scrollTop;
      var scrollHeight = (h.scrollHeight || b.scrollHeight) - h.clientHeight;
      if (scrollHeight <= 0) return 100;
      return Math.min(100, Math.round((scrollTop / scrollHeight) * 100));
    }
    function onScroll() {
      var p = pct();
      thresholds.forEach(function (t) {
        if (!fired[t] && p >= t) {
          fired[t] = true;
          window.rivett.track('scroll_depth', { depth: t, path: window.location.pathname });
        }
      });
    }
    var ticking = false;
    window.addEventListener('scroll', function () {
      if (!ticking) {
        requestAnimationFrame(function () { onScroll(); ticking = false; });
        ticking = true;
      }
    }, { passive: true });
    // Run once on load in case the page is short enough to already be 100%.
    document.addEventListener('DOMContentLoaded', onScroll);
  })();

  // Click tracking for [data-cta] elements, routed by behaviour so one event
  // name never mixes curiosity with intent:
  //   cell_expand_*   -> finding_expanded  (curiosity: opened a finding cell)
  //   *book_call*     -> book_call_clicked (intent: wants a call)
  //   everything else -> cta_clicked
  // send_instantly + sendBeacon transport so the event survives cross-origin
  // navigation to cal.com / mailto: links. The previous plain capture() was
  // being cancelled on page unload, leaving cta_clicked permanently at zero.
  document.addEventListener('click', function (e) {
    var el = e.target.closest('[data-cta]');
    if (!el) return;
    if (!window.posthog || !window.posthog.capture) return;
    var name = el.getAttribute('data-cta') || '';
    var props = {
      cta: name,
      location: el.getAttribute('data-cta-location') || null,
      href: el.getAttribute('href') || null,
      text: (el.innerText || '').trim().slice(0, 80),
      path: window.location.pathname,
    };
    var eventName = 'cta_clicked';
    if (name.indexOf('cell_expand_') === 0) {
      eventName = 'finding_expanded';
      props.finding = name.slice('cell_expand_'.length);
    } else if (name.indexOf('book_call') !== -1) {
      eventName = 'book_call_clicked';
    }
    window.posthog.capture(eventName, props, { send_instantly: true, transport: 'sendBeacon' });
  }, true);

  // Copy event — someone selected and copied memo text. Strong sharing signal.
  // Ignore tiny copies (UI button labels, accidental selects).
  document.addEventListener('copy', function () {
    var len = 0;
    try {
      var sel = window.getSelection && window.getSelection();
      len = (sel && sel.toString && sel.toString().length) || 0;
    } catch (e) {}
    if (len < 20) return;
    window.rivett.track('content_copied', {
      path: window.location.pathname,
      selection_length: len,
    });
  });

  // Print event — they're saving the memo. Among the hottest signals.
  window.addEventListener('beforeprint', function () {
    if (!window.posthog || !window.posthog.capture) return;
    window.posthog.capture('content_printed', {
      path: window.location.pathname,
    }, { send_instantly: true, transport: 'sendBeacon' });
  });

  // Tab focus time — separates "actually reading" from "open in background tab".
  // Accumulates focused milliseconds and flushes on pagehide via sendBeacon.
  (function () {
    var totalFocusMs = 0;
    var lastFocusStart = !document.hidden ? Date.now() : null;
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) {
        if (lastFocusStart) {
          totalFocusMs += Date.now() - lastFocusStart;
          lastFocusStart = null;
        }
      } else if (!lastFocusStart) {
        lastFocusStart = Date.now();
      }
    });
    function flush() {
      if (lastFocusStart) {
        totalFocusMs += Date.now() - lastFocusStart;
        lastFocusStart = null;
      }
      if (totalFocusMs < 1000) return;
      if (!window.posthog || !window.posthog.capture) return;
      window.posthog.capture('tab_focus_time', {
        focus_seconds: Math.round(totalFocusMs / 1000),
        path: window.location.pathname,
      }, { send_instantly: true, transport: 'sendBeacon' });
      totalFocusMs = 0;
    }
    window.addEventListener('pagehide', flush);
    // Fallback for browsers that don't fire pagehide reliably.
    window.addEventListener('beforeunload', flush);
  })();

  // Verified human open. Fires at most ONCE per page load, and only after the
  // visitor does something a headless preview/scanner never does: move a
  // pointer, scroll, press a key, or touch — while the tab is actually visible.
  // LinkedIn's Azure link-preview renderer, Outlook SafeLinks, Mimecast et al.
  // fetch the page (firing $pageview) but never move a mouse, so they never
  // trip this. HQ treats `human_engaged` as the real "a person opened it"
  // signal; $pageview alone is the bot-inclusive one. One-screen proposals
  // can't lean on scroll_depth, so pointer movement is what makes them
  // countable without letting scanners through.
  (function () {
    var fired = false;
    var evs = ['pointermove', 'scroll', 'keydown', 'touchstart'];
    function cleanup() {
      evs.forEach(function (t) { window.removeEventListener(t, onInteract, true); });
    }
    function onInteract(e) {
      if (fired) return;
      // Automation flags itself — Playwright/Puppeteer/headless CDP set this.
      if (navigator.webdriver === true) return;
      if (document.visibilityState !== 'visible') return;
      fired = true;
      cleanup();
      if (!window.posthog || !window.posthog.capture) return;
      window.posthog.capture('human_engaged', {
        path: window.location.pathname,
        trigger: e && e.type,
      }, { send_instantly: true, transport: 'sendBeacon' });
    }
    evs.forEach(function (t) {
      window.addEventListener(t, onInteract, { capture: true, passive: true });
    });
  })();
</script>
