---
interface Props {
  size?: 16 | 20 | 24 | 44 | number;
  class?: string;
}

const { size = 16, class: cls = '' } = Astro.props;
---
<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={cls}
  aria-hidden="true"
  focusable="false"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="square"
  stroke-linejoin="miter"
  fill="none"
>
  <rect x="3" y="6" width="18" height="13"/><path d="M3 6 L12 14 L21 6"/>
</svg>
