---
interface Props {
  size?: 16 | 20 | 24 | 44 | number;
  class?: string;
}

const { size = 16, class: cls = '' } = Astro.props;
---
<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={cls}
  aria-hidden="true"
  focusable="false"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="square"
  stroke-linejoin="miter"
  fill="none"
>
  <path d="M3 7 H17 a3 3 0 0 1 0 6 H7 a3 3 0 0 0 0 6 H21"/><circle class="dot" cx="3" cy="7" r="1.6" fill="var(--accent)" stroke="none" />
</svg>
