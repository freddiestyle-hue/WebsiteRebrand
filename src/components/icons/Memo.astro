---
interface Props {
  size?: 16 | 20 | 24 | 44 | number;
  class?: string;
}

const { size = 16, class: cls = '' } = Astro.props;
---
<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={cls}
  aria-hidden="true"
  focusable="false"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="square"
  stroke-linejoin="miter"
  fill="none"
>
  <path d="M5 3 H15 L19 7 V21 H5 Z"/><path d="M8 11 H16 M8 15 H16 M8 19 H13"/>
</svg>
