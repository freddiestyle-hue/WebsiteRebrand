---
// Direction A § 03 CTA clicks feed.
// Grid columns: [1.5fr name+title] [1.2fr company italic] [1fr CTA hot chip] [110px time] [80px Open button]
//
// Person info comes from the Airtable Prospects table via the slug join.

import type { CtaClick } from '../../utils/posthog/query';
import type { ProspectInfo } from '../../utils/hq/airtable';
import { slugToDomain, findOnLinkedinUrl } from '../../utils/hq/messaged';

interface Props {
  clicks: CtaClick[];
  prospectInfo?: Map<string, ProspectInfo>;
}

const { clicks, prospectInfo } = Astro.props;

function timeAgo(iso: string): string {
  const sec = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 1000));
  if (sec < 60) return `${sec}s ago`;
  const min = Math.round(sec / 60);
  if (min < 60) return `${min}m ago`;
  const hr = Math.round(min / 60);
  if (hr < 48) return `${hr}h ago`;
  return `${Math.round(hr / 24)}d ago`;
}
---
{clicks.length === 0 ? (
  <p class="empty">No CTA clicks yet. Every Book-a-call click will land here when it happens.</p>
) : (
  <div class="feed">
    {clicks.map((c) => {
      const info = c.prospect ? prospectInfo?.get(c.prospect) : undefined;
      const displayName = info?.firstName || c.prospect || '(no slug)';
      const displayCo = info?.company || (c.prospect ? slugToDomain(c.prospect) : '');
      const geo = [c.city, c.country].filter(Boolean).join(', ');
      const liHref = info?.linkedinUrl || (c.prospect ? findOnLinkedinUrl(c.prospect) : '');
      return (
      <div class="feed-row">
        <div class="cell name">
          {liHref ? (
            <a href={liHref} target="_blank" rel="noopener" class="name-link" title={info?.linkedinUrl ? "Open LinkedIn profile" : "Google site:linkedin.com search"}>
              <strong>{displayName}</strong><span class="li-arrow" aria-hidden="true"> ↗</span>
            </a>
          ) : (
            <strong>{displayName}</strong>
          )}
          {info?.title && <span class="title-ital">, {info.title}</span>}
        </div>
        <div class="cell co">
          {displayCo}
          {geo && <span class="geo"> · {geo}</span>}
        </div>
        <div class="cell"><span class="mark mark--hot">{(c.cta || 'CTA').toUpperCase()}</span></div>
        <div class="cell mono">{timeAgo(c.when)}</div>
        <div class="cell">
          {c.href ? (
            <a class="hq-btn-ghost" href={c.href} target="_blank" rel="noopener">Open ↗</a>
          ) : (
            <span class="dim">—</span>
          )}
        </div>
      </div>
      );
    })}
  </div>
)}

<style>
  .empty {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    color: var(--ink-faint, #7A8597);
    padding: 18px 0;
    margin: 0;
  }
  .feed {
    border: 1px solid var(--ink, #0E1A2C);
    background: var(--paper, #FFFFFF);
  }
  .feed-row {
    display: grid;
    grid-template-columns: 1.5fr 1.2fr 1fr 110px 80px;
    gap: 16px;
    padding: 12px 18px;
    align-items: center;
    border-bottom: 1px solid var(--line, rgba(14,26,44,0.14));
    transition: background 120ms;
  }
  .feed-row:last-child { border-bottom: 0; }
  .feed-row:hover { background: var(--paper-2, #F4F2ED); }
  .cell { min-width: 0; }
  .name { display: flex; align-items: baseline; gap: 4px; min-width: 0; }
  .name strong { font-weight: 600; color: var(--ink, #0E1A2C); flex-shrink: 0; }
  .name-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted var(--line-strong, rgba(14,26,44,0.28));
    padding-bottom: 1px;
    transition: color 120ms, border-color 120ms;
  }
  .name-link:hover { color: var(--accent-deep, #4A6E18); border-bottom-color: var(--accent-deep, #4A6E18); border-bottom-style: solid; }
  .name-link:hover strong { color: var(--accent-deep, #4A6E18); }
  .li-arrow {
    font-size: 0.75em;
    color: var(--ink-faint, #7A8597);
    margin-left: 2px;
    font-weight: 400;
  }
  .name-link:hover .li-arrow { color: var(--accent-deep, #4A6E18); }
  .title-ital {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    font-size: 13px;
    color: var(--ink-dim, #3A4658);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .co {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    font-size: 13.5px;
    color: var(--ink-dim, #3A4658);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .co .geo {
    font-family: var(--mono, 'DM Mono', monospace);
    font-style: normal;
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--ink-faint, #7A8597);
  }
  .mono {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 11px;
    color: var(--ink-dim, #3A4658);
    letter-spacing: 0.06em;
  }
  .dim { color: var(--ink-faint, #7A8597); font-family: var(--mono); font-size: 11px; }
  .mark {
    display: inline-block;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 3px 7px; border: 1px solid var(--accent, #8FBF3F);
    background: var(--accent, #8FBF3F); color: var(--ink, #0E1A2C);
    font-weight: 600;
  }
  .hq-btn-ghost {
    display: inline-block;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 10px; letter-spacing: 0.06em;
    padding: 5px 10px;
    border: 1px solid var(--line-strong, rgba(14,26,44,0.28));
    background: var(--paper, #FFFFFF); color: var(--ink, #0E1A2C);
    text-decoration: none;
  }
  .hq-btn-ghost:hover { background: var(--ink, #0E1A2C); color: var(--paper, #FFFFFF); border-color: var(--ink, #0E1A2C); }

  @media (max-width: 780px) {
    .feed-row {
      grid-template-columns: 1fr auto;
      gap: 4px 12px;
    }
    .feed-row .co, .feed-row .mono { grid-column: 1; }
  }
</style>
