---
interface Props {
  label: string;
  value: string | number;
  sub?: string;
  hint?: string;
}

const { label, value, sub, hint } = Astro.props;
---
<div class="card">
  <div class="lab">{label}</div>
  <div class="val">{value}</div>
  {sub && <div class="sub">{sub}</div>}
  {hint && <div class="hint">{hint}</div>}
</div>

<style>
  .card {
    padding: 1.25rem 1.25rem 1rem;
    background: var(--paper-2, #F2F5EC);
    border: 1px solid var(--line, rgba(22,51,0,0.14));
    border-radius: 0;
  }
  .lab {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-faint, #6F7A64);
    margin-bottom: 0.5rem;
  }
  .val {
    font-family: var(--grotesk, 'Inter Tight', system-ui);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1;
    color: var(--ink, #163300);
    letter-spacing: -0.03em;
  }
  .sub {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--ink-dim, #454745);
  }
  .hint {
    margin-top: 0.4rem;
    font-family: var(--serif, Archivo, 'Inter Tight', system-ui, sans-serif);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--ink-faint, #6F7A64);
  }
</style>
