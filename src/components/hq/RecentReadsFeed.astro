---
// Direction A § 01 Recent Reads feed.
// Grid columns: [1.5fr name+title] [1.2fr company italic] [90px time] [110px depth bar] [90px dwell] [80px event chip]
//
// Person info comes from the Airtable Prospects table via the slug join.
// Falls back to slug/geo when there's no matching record.

import type { RecentRead } from '../../utils/posthog/query';
import { sessionReplayUrl } from '../../utils/posthog/query';
import type { ProspectInfo } from '../../utils/hq/airtable';
import { slugToDomain } from '../../utils/hq/messaged';

interface Props {
  reads: RecentRead[];
  prospectInfo?: Map<string, ProspectInfo>;
}

const { reads, prospectInfo } = Astro.props;

function timeAgo(iso: string): string {
  const then = new Date(iso).getTime();
  const sec = Math.max(0, Math.round((Date.now() - then) / 1000));
  if (sec < 60) return `${sec}s ago`;
  const min = Math.round(sec / 60);
  if (min < 60) return `${min}m ago`;
  const hr = Math.round(min / 60);
  if (hr < 48) return `${hr}h ago`;
  return `${Math.round(hr / 24)}d ago`;
}
function dwell(seconds: number): string {
  if (seconds < 60) return `${seconds}s`;
  const m = Math.floor(seconds / 60);
  const s = seconds % 60;
  return `${m}m ${s}s`;
}
// Estimate depth from cta/dwell heuristic if no scroll signal in this row
function depthPct(r: RecentRead): number {
  if (r.cta_clicks > 0) return 100;
  if (r.dwell_seconds >= 60) return 75;
  if (r.dwell_seconds >= 30) return 50;
  if (r.dwell_seconds >= 10) return 25;
  return 5;
}
function mark(r: RecentRead): { label: string; cls: string } {
  if (r.cta_clicks > 0) return { label: 'CTA', cls: 'mark--hot' };
  if (r.dwell_seconds >= 60) return { label: 'DEEP', cls: 'mark--warm' };
  return { label: '–', cls: 'mark--cold' };
}
function fullUrl(path: string, surface: 'audit' | 'intake-review' | undefined): string {
  if (surface === 'intake-review') return `https://intake-reviews.vercel.app${path}`;
  return path;
}
---
{reads.length === 0 ? (
  <p class="empty">No engaged reads yet. Send the next batch and watch this populate.</p>
) : (
  <div class="feed">
    {reads.map((r) => {
      const d = depthPct(r);
      const m = mark(r);
      const replay = sessionReplayUrl(r.session_id);
      const info = r.prospect ? prospectInfo?.get(r.prospect) : undefined;
      const displayName = info?.firstName || r.prospect || '(unknown)';
      const displayCo = info?.company || (r.prospect ? slugToDomain(r.prospect) : '');
      const geo = [r.city, r.country].filter(Boolean).join(', ');
      return (
        <div class="feed-row">
          <div class="cell name">
            <a href={fullUrl(r.path, r.surface)} target="_blank" rel="noopener">{displayName}</a>
            {info?.title && <span class="title-ital">, {info.title}</span>}
          </div>
          <div class="cell co">
            {displayCo}
            {geo && <span class="geo"> · {geo}</span>}
          </div>
          <div class="cell mono">{timeAgo(r.last_event)}</div>
          <div class="cell depth">
            <span class="depth-num">{d}%</span>
            <span class="depth-bar"><i style={`width:${d}%`}></i></span>
          </div>
          <div class="cell mono">{dwell(r.dwell_seconds)}</div>
          <div class="cell">
            {replay ? (
              <a class={`mark ${m.cls}`} href={replay} target="_blank" rel="noopener">{m.label}</a>
            ) : (
              <span class={`mark ${m.cls}`}>{m.label}</span>
            )}
          </div>
        </div>
      );
    })}
  </div>
)}

<style>
  .empty {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    color: var(--ink-faint, #7A8597);
    padding: 18px 0;
    margin: 0;
  }
  .feed {
    border: 1px solid var(--ink, #0E1A2C);
    background: var(--paper, #FFFFFF);
  }
  .feed-row {
    display: grid;
    grid-template-columns: 1.5fr 1.2fr 90px 110px 90px 80px;
    gap: 16px;
    padding: 12px 18px;
    align-items: center;
    border-bottom: 1px solid var(--line, rgba(14,26,44,0.14));
    transition: background 120ms;
  }
  .feed-row:last-child { border-bottom: 0; }
  .feed-row:hover { background: var(--paper-2, #F4F2ED); }
  .cell { min-width: 0; }
  .name {
    display: flex; align-items: baseline; gap: 4px; min-width: 0;
  }
  .name a {
    font-weight: 600;
    color: var(--ink, #0E1A2C);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong, rgba(14,26,44,0.28));
    flex-shrink: 0;
  }
  .name a:hover { color: var(--accent-deep, #4A6E18); border-bottom-color: var(--accent-deep, #4A6E18); }
  .title-ital {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    font-size: 13px;
    color: var(--ink-dim, #3A4658);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .co {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    font-size: 13.5px;
    color: var(--ink-dim, #3A4658);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .co .geo {
    font-family: var(--mono, 'DM Mono', monospace);
    font-style: normal;
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--ink-faint, #7A8597);
  }
  .mono {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-dim, #3A4658);
  }
  .depth { display: flex; align-items: center; gap: 8px; font-family: var(--mono, 'DM Mono', monospace); font-size: 11px; }
  .depth-num { min-width: 30px; color: var(--ink-dim, #3A4658); }
  .depth-bar {
    flex: 1;
    height: 4px;
    background: var(--paper-3, #EBE6DC);
    overflow: hidden;
  }
  .depth-bar i {
    display: block; height: 100%;
    background: var(--ink, #0E1A2C);
  }
  .mark {
    display: inline-block;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 3px 7px;
    border: 1px solid var(--line, rgba(14,26,44,0.14));
    text-decoration: none;
  }
  .mark--hot { background: var(--accent, #8FBF3F); color: var(--ink, #0E1A2C); border-color: var(--accent, #8FBF3F); font-weight: 600; }
  .mark--warm { background: var(--sage, #E8F0D9); color: var(--accent-deep, #4A6E18); border-color: var(--accent-deep, #4A6E18); }
  .mark--cool { color: var(--ink-dim, #3A4658); border-color: var(--line-strong, rgba(14,26,44,0.28)); }
  .mark--cold { color: var(--ink-faint, #7A8597); border-color: var(--line, rgba(14,26,44,0.14)); }

  @media (max-width: 780px) {
    .feed-row {
      grid-template-columns: 1fr auto;
      gap: 6px 12px;
    }
    .feed-row .co, .feed-row .depth, .feed-row .mono:nth-of-type(2) { display: none; }
  }
</style>
