    color: var(--accent-deep, #4A6E18);
    border-bottom-color: var(--accent-deep, #4A6E18);
  }
  .aq-dot { color: var(--ink-faint, #7A8597); }
  .aq-stage {
    color: var(--ink-faint, #7A8597);
    font-style: italic;
  }
  .aq-signal {
    margin-top: 0.25rem;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.75rem;
    color: var(--ink-dim, #3A4658);
  }
  .aq-signal b { color: var(--ink, #0E1A2C); font-weight: 600; }
  .aq-cta { color: var(--accent-deep, #4A6E18); font-weight: 500; }
  .aq-memo {
    color: var(--ink-dim, #3A4658);
    text-decoration: none;
    border-bottom: 1px dotted var(--line, rgba(14,26,44,0.14));
  }
  .aq-memo:hover {
    color: var(--accent-deep, #4A6E18);
    border-bottom-color: var(--accent-deep, #4A6E18);
  }

  .aq-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .aq-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.7rem;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.72rem;
    color: var(--ink-dim, #3A4658);
    text-decoration: none;
    border: 1px solid var(--line-strong, rgba(14,26,44,0.28));
    background: var(--paper, #FFFFFF);
    border-radius: 3px;
    cursor: pointer;
    transition: background 80ms, color 80ms, border-color 80ms;
    white-space: nowrap;
  }
  .aq-btn:hover {
    border-color: var(--ink, #0E1A2C);
    color: var(--ink, #0E1A2C);
  }
  .aq-btn--primary {
    background: var(--ink, #0E1A2C);
    color: var(--paper, #FFFFFF);
    border-color: var(--ink, #0E1A2C);
    font-weight: 500;
  }
  .aq-btn--primary:hover {
    background: var(--accent-deep, #4A6E18);
    border-color: var(--accent-deep, #4A6E18);
    color: var(--paper, #FFFFFF);
  }
