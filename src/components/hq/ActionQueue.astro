---
// Direction A — Action Queue.
// Hero row for the top prospect (4px heat rail + body + 340px draft preview).
// Compact rows for everyone else. Slug→Airtable join surfaces names. Heat
// tag communicates quality; the queue surfaces every visit so Fred sees
// the full picture and decides.

import type { TopProspect } from '../../utils/posthog/query';
import { sessionReplayUrl } from '../../utils/posthog/query';
import type { ProspectInfo } from '../../utils/hq/airtable';
import {
  findOnLinkedinUrl,
  prospectWebsiteUrl,
  slugToDomain,
} from '../../utils/hq/messaged';

interface Props {
  prospects: TopProspect[];
  prospectInfo?: Map<string, ProspectInfo>;
}

const { prospects, prospectInfo } = Astro.props;

function dwell(seconds: number): string {
  if (seconds < 60) return `${seconds}s`;
  const m = Math.floor(seconds / 60);
  const s = seconds % 60;
  return `${m}m ${s}s`;
}

function timeAgo(iso: string): string {
  const then = new Date(iso).getTime();
  const now = Date.now();
  const sec = Math.max(0, Math.round((now - then) / 1000));
  if (sec < 60) return `${sec}s ago`;
  const min = Math.round(sec / 60);
  if (min < 60) return `${min}m ago`;
  const hr = Math.round(min / 60);
  if (hr < 48) return `${hr}h ago`;
  return `${Math.round(hr / 24)}d ago`;
}

type Temp = 'hot' | 'warm' | 'cool' | 'cold';
function heatBadge(p: TopProspect): { label: string; temp: Temp } {
  if (p.cta_clicks > 0) return { label: 'CTA CLICK', temp: 'hot' };
  if (p.prints > 0) return { label: 'PRINTED', temp: 'hot' };
  if (p.copies > 0) return { label: 'COPIED', temp: 'hot' };
  const engagedReturn = p.return_visitor && (
    p.scroll_100s > 0 || p.verdict_expansions > 0 ||
    p.total_dwell_seconds >= 30 || p.focus_seconds_total >= 30
  );
  if (engagedReturn) return { label: 'RETURNED', temp: 'warm' };
  if (p.verdict_expansions > 0) return { label: 'VERDICTS', temp: 'warm' };
  if (p.scroll_100s > 0) return { label: 'FULL READ', temp: 'warm' };
  if (p.total_dwell_seconds >= 60 || p.focus_seconds_total >= 60) return { label: 'DEEP READ', temp: 'cool' };
  if (p.total_dwell_seconds >= 30 || p.focus_seconds_total >= 30) return { label: 'ENGAGED', temp: 'cool' };
  return { label: 'BROWSED', temp: 'cold' };
}

const hero = prospects[0];
const rest = prospects.slice(1);
const heroHeat = hero ? heatBadge(hero) : null;
const heroInfo = hero ? prospectInfo?.get(hero.prospect) : undefined;
const heroDomain = hero ? slugToDomain(hero.prospect) : '';
const heroLiHref = heroInfo?.linkedinUrl || (hero ? findOnLinkedinUrl(hero.prospect) : '#');
const heroLatest = hero?.sessions[0] ?? null;
const heroReplay = heroLatest ? sessionReplayUrl(heroLatest.sid) : null;
---
<section class="aqv2" data-action-queue>
  <div class="aqv2-head">
    <div class="aqv2-eyebrow">00 · ACTION QUEUE</div>
    <h2 class="aqv2-title">The queue. <span class="ital">{prospects.length} waiting for a follow-up.</span></h2>
  </div>

  {prospects.length === 0 && (
    <div class="qhero qhero--empty">
      <div class="heat-rail"></div>
      <div class="hero-body">
        <span class="stamp">All caught up</span>
        <h3>Nothing in the queue. <span class="ital">Quiet morning.</span></h3>
        <p class="empty-body">The feed is empty. Either today's distribution didn't land, or everyone's been worked. Send the next batch and watch this populate.</p>
      </div>
    </div>
  )}

  {hero && heroHeat && (
    <article
      class="qhero"
      data-slug={hero.prospect}
      data-signals={JSON.stringify({
        total_dwell_seconds: hero.total_dwell_seconds,
        unique_sessions: hero.unique_sessions,
        total_views: hero.total_views,
        cta_clicks: hero.cta_clicks,
        verdict_expansions: hero.verdict_expansions,
        scroll_100s: hero.scroll_100s,
        copies: hero.copies,
        prints: hero.prints,
        return_visitor: hero.return_visitor,
        last_view: hero.last_view,
      })}
      data-li-url={heroInfo?.linkedinUrl || heroLiHref}
      data-email={heroInfo?.email || ''}
      data-first-name={heroInfo?.firstName || ''}
      data-company={heroInfo?.company || heroDomain}
      data-source={heroInfo?.source || ''}
    >
      <div class={`heat-rail ${heroHeat.temp}`}></div>
      <div class="hero-body">
        <div class="head">
          <span class={`heat ${heroHeat.temp}`}>{heroHeat.label}</span>
          <span class="when">{timeAgo(hero.last_view)}</span>
          {heroInfo?.source && <span class="src-pill">{heroInfo.source}</span>}
          <span class="head-fill"></span>
          <span class="heat-score">heat <b>{hero.heat_score}</b></span>
        </div>
        <h3 class="hero-name">{heroInfo?.firstName || heroDomain}</h3>
        <div class="hero-ti">
          {heroInfo?.title && <>{heroInfo.title}, </>}<b>{heroInfo?.company || heroDomain}</b>
          {heroInfo?.industry && <span class="hero-ind"> {heroInfo.industry}</span>}
        </div>
        {(heroInfo?.email || heroInfo?.linkedinUrl) && (
          <div class="hero-contact">
            {heroInfo.email && <a href={`mailto:${heroInfo.email}`}>{heroInfo.email}</a>}
            {heroInfo.linkedinUrl && <a href={heroInfo.linkedinUrl} target="_blank" rel="noopener">LinkedIn ↗</a>}
            {heroInfo.outreachStage && <span class="hero-stage">{heroInfo.outreachStage.toLowerCase()}</span>}
          </div>
        )}
        <div class="signal-row">
          <span class="m"><b>{dwell(hero.total_dwell_seconds)}</b> dwell</span>
          <span class="m"><b>{hero.unique_sessions}</b> sess</span>
          <span class="m"><b>{hero.total_views}</b> views</span>
          {hero.cta_clicks > 0 && <span class="m accent"><b>{hero.cta_clicks}</b> cta</span>}
          {hero.verdict_expansions > 0 && <span class="m"><b>{hero.verdict_expansions}</b> verdict</span>}
          {hero.scroll_100s > 0 && <span class="m"><b>{hero.scroll_100s}</b> full read</span>}
          {hero.copies > 0 && <span class="m"><b>{hero.copies}</b> copy</span>}
          {hero.prints > 0 && <span class="m"><b>{hero.prints}</b> print</span>}
          <span class="head-fill"></span>
          <a class="memo-link" href={`https://rivett.tech/audit/v3/${hero.prospect}`} target="_blank" rel="noopener">open memo ↗</a>
          {heroReplay && <a class="memo-link" href={heroReplay} target="_blank" rel="noopener">↻ replay</a>}
        </div>
      </div>
      <aside class="hero-side">
        <div class="label">DRAFT · LINKEDIN DM</div>
        <p class="preview">
          {heroInfo?.firstName ? `${heroInfo.firstName}, ` : ''}referenced your engagement on the audit. Press <b>Draft DM</b> to generate a fresh, hyper-personalised follow-up.
        </p>
        <div class="actions">
          <button class="hq-btn pri" type="button" data-draft="linkedin">Draft DM</button>
          {heroInfo?.email && (
            <button class="hq-btn pri" type="button" data-draft="email">Draft email</button>
          )}
          <button class="hq-btn done" type="button" data-mark-messaged>✓ Messaged</button>
        </div>
      </aside>
    </article>
  )}

  {rest.length > 0 && (
    <div class="qrow-list">
      {rest.map((p) => {
        const heat = heatBadge(p);
        const info = prospectInfo?.get(p.prospect);
        const liHref = info?.linkedinUrl || findOnLinkedinUrl(p.prospect);
        const domain = slugToDomain(p.prospect);
        return (
          <article
            class="qrow"
            data-slug={p.prospect}
            data-signals={JSON.stringify({
              total_dwell_seconds: p.total_dwell_seconds,
              unique_sessions: p.unique_sessions,
              total_views: p.total_views,
              cta_clicks: p.cta_clicks,
              verdict_expansions: p.verdict_expansions,
              scroll_100s: p.scroll_100s,
              copies: p.copies,
              prints: p.prints,
              return_visitor: p.return_visitor,
              last_view: p.last_view,
            })}
            data-li-url={info?.linkedinUrl || liHref}
            data-email={info?.email || ''}
            data-first-name={info?.firstName || ''}
            data-company={info?.company || domain}
            data-source={info?.source || ''}
          >
            <div class={`heat-rail ${heat.temp}`}></div>
            <div class="meta-col">
              <span class={`heat ${heat.temp}`}>{heat.label}</span>
              {info?.source && <span class="src-pill">{info.source}</span>}
              <span class="when">{timeAgo(p.last_view)}</span>
            </div>
            <div class="body-col">
              <div class="name">
                {info?.firstName || domain}
                <span class="when">heat {p.heat_score}</span>
              </div>
              <div class="ti">
                {info?.title && <>{info.title}, </>}<b>{info?.company || domain}</b>
              </div>
              <div class="signals">
                <span class="m"><b>{dwell(p.total_dwell_seconds)}</b> dwell</span>
                <span class="m"><b>{p.unique_sessions}</b> sess</span>
                <span class="m"><b>{p.total_views}</b> views</span>
                {p.cta_clicks > 0 && <span class="m accent"><b>{p.cta_clicks}</b> cta</span>}
                {p.verdict_expansions > 0 && <span class="m"><b>{p.verdict_expansions}</b> vrd</span>}
                {p.scroll_100s > 0 && <span class="m"><b>full</b></span>}
                {p.copies > 0 && <span class="m"><b>{p.copies}</b> cp</span>}
                {p.prints > 0 && <span class="m"><b>{p.prints}</b> pr</span>}
              </div>
            </div>
            <div class="act-col">
              <button class="hq-btn pri sm" type="button" data-draft="linkedin">Draft</button>
              {info?.email && (
                <button class="hq-btn sm" type="button" data-draft="email">Email</button>
              )}
              <button class="hq-btn done sm" type="button" data-mark-messaged aria-label="Mark messaged">✓</button>
            </div>
          </article>
        );
      })}
    </div>
  )}
</section>

<!-- Draft preview modal — one instance, populated per click -->
<div class="dm-modal" data-dm-modal hidden>
  <div class="dm-backdrop" data-dm-close></div>
  <div class="dm-card" role="dialog" aria-modal="true" aria-labelledby="dm-title">
    <header class="dm-head">
      <h3 id="dm-title" class="dm-h">Draft message</h3>
      <div class="dm-meta" data-dm-meta></div>
      <button class="dm-x" type="button" data-dm-close aria-label="Close">×</button>
    </header>
    <div class="dm-body">
      <div class="dm-row" data-dm-subject-row hidden>
        <label class="dm-lbl" for="dm-subject">Subject</label>
        <input class="dm-input" id="dm-subject" type="text" data-dm-subject />
      </div>
      <div class="dm-row">
        <label class="dm-lbl" for="dm-text">Message</label>
        <textarea class="dm-text" id="dm-text" data-dm-text rows="10"></textarea>
      </div>
      <div class="dm-status" data-dm-status></div>
    </div>
    <footer class="dm-foot">
      <button class="dm-btn" type="button" data-dm-regenerate>↻ Regenerate</button>
      <div class="dm-spacer"></div>
      <button class="dm-btn" type="button" data-dm-close>Cancel</button>
      <button class="dm-btn dm-btn--primary" type="button" data-dm-go>Copy + open</button>
    </footer>
  </div>
</div>

<script is:inline>
  (function () {
    const modal = document.querySelector('[data-dm-modal]');
    const modalSubjectRow = modal?.querySelector('[data-dm-subject-row]');
    const modalSubject = modal?.querySelector('[data-dm-subject]');
    const modalText = modal?.querySelector('[data-dm-text]');
    const modalStatus = modal?.querySelector('[data-dm-status]');
    const modalMeta = modal?.querySelector('[data-dm-meta]');
    const modalGo = modal?.querySelector('[data-dm-go]');
    const modalRegen = modal?.querySelector('[data-dm-regenerate]');
    const modalCloseEls = modal?.querySelectorAll('[data-dm-close]');
    let ctx = null;

    function openModal() { modal && (modal.hidden = false); }
    function closeModal() { modal && (modal.hidden = true); ctx = null; }
    modalCloseEls?.forEach((el) => el.addEventListener('click', closeModal));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
    });

    async function fetchDraft(slug, channel, signals, force) {
      const res = await fetch('/api/hq/draft-message', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ slug, channel, signals, force: !!force }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.message || data.error || ('http ' + res.status));
      return data;
    }

    async function startDraft(row, channel) {
      const slug = row.getAttribute('data-slug');
      const liUrl = row.getAttribute('data-li-url') || '';
      const email = row.getAttribute('data-email') || '';
      const firstName = row.getAttribute('data-first-name') || '';
      const company = row.getAttribute('data-company') || '';
      const source = row.getAttribute('data-source') || '';
      let signals = {};
      try { signals = JSON.parse(row.getAttribute('data-signals') || '{}'); } catch (e) {}

      ctx = { slug, channel, signals, liUrl, email, firstName, company, source };

      modalSubjectRow.hidden = channel !== 'email';
      modalSubject.value = '';
      modalText.value = '';
      modalStatus.textContent = 'Drafting with Claude...';
      modalStatus.className = 'dm-status dm-status--info';
      modalMeta.textContent = (firstName || slug) + (company ? ' · ' + company : '') + (source ? ' · ' + source : '') + ' · ' + (channel === 'email' ? 'Email' : 'LinkedIn DM');
      modalGo.textContent = channel === 'email' ? 'Open in mail' : 'Copy + open LinkedIn';
      modalGo.disabled = true;
      modalRegen.disabled = true;
      openModal();

      try {
        const data = await fetchDraft(slug, channel, signals, false);
        modalSubject.value = data.subject || '';
        modalText.value = data.body || '';
        const noAt = data.has_airtable_record === false;
        modalStatus.textContent = data.cached
          ? 'Loaded cached draft. ↻ Regenerate for a fresh one.'
          : noAt
            ? 'Drafted from engagement signals only (no Airtable match for ' + slug + ').'
            : 'Drafted. Edit if needed, then copy + open.';
        modalStatus.className = 'dm-status ' + (noAt && !data.cached ? 'dm-status--info' : 'dm-status--ok');
        modalGo.disabled = false;
        modalRegen.disabled = false;
      } catch (e) {
        modalStatus.textContent = 'Could not draft: ' + (e && e.message ? e.message : String(e));
        modalStatus.className = 'dm-status dm-status--err';
        modalRegen.disabled = false;
      }
    }

    async function copyToClipboard(text) {
      try { await navigator.clipboard.writeText(text); return true; }
      catch { return false; }
    }

    modalRegen?.addEventListener('click', async () => {
      if (!ctx) return;
      modalStatus.textContent = 'Regenerating...';
      modalStatus.className = 'dm-status dm-status--info';
      modalGo.disabled = true; modalRegen.disabled = true;
      try {
        const data = await fetchDraft(ctx.slug, ctx.channel, ctx.signals, true);
        modalSubject.value = data.subject || '';
        modalText.value = data.body || '';
        modalStatus.textContent = 'Regenerated.';
        modalStatus.className = 'dm-status dm-status--ok';
      } catch (e) {
        modalStatus.textContent = 'Regenerate failed: ' + (e && e.message ? e.message : String(e));
        modalStatus.className = 'dm-status dm-status--err';
      } finally {
        modalGo.disabled = false;
        modalRegen.disabled = false;
      }
    });

    modalGo?.addEventListener('click', async () => {
      if (!ctx) return;
      const subject = modalSubject.value || '';
      const body = modalText.value || '';
      if (ctx.channel === 'email') {
        const params = new URLSearchParams();
        if (subject) params.set('subject', subject);
        if (body) params.set('body', body);
        await copyToClipboard(body);
        window.location.href = 'mailto:' + encodeURIComponent(ctx.email) + '?' + params.toString();
        modalStatus.textContent = 'Opened mail. Body copied as backup.';
        modalStatus.className = 'dm-status dm-status--ok';
      } else {
        const ok = await copyToClipboard(body);
        if (ctx.liUrl) window.open(ctx.liUrl, '_blank', 'noopener');
        modalStatus.textContent = ok
          ? 'DM copied. LinkedIn opened — paste into Message.'
          : 'Could not copy. Select and copy manually.';
        modalStatus.className = 'dm-status ' + (ok ? 'dm-status--ok' : 'dm-status--err');
      }
    });

    // Wire per-row buttons
    document.querySelectorAll('[data-action-queue]').forEach((queue) => {
      queue.querySelectorAll('[data-draft]').forEach((btn) => {
        btn.addEventListener('click', (ev) => {
          ev.preventDefault();
          const row = btn.closest('[data-slug]');
          if (!row) return;
          const channel = btn.getAttribute('data-draft') === 'email' ? 'email' : 'linkedin';
          startDraft(row, channel);
        });
      });
      queue.querySelectorAll('[data-mark-messaged]').forEach((btn) => {
        btn.addEventListener('click', async (ev) => {
          ev.preventDefault();
          const row = btn.closest('[data-slug]');
          if (!row) return;
          const slug = row.getAttribute('data-slug');
          if (!slug) return;
          btn.disabled = true;
          btn.textContent = '…';
          try {
            const res = await fetch('/api/hq/mark-messaged', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({ slug, action: 'mark' }),
            });
            if (!res.ok) throw new Error('mark failed: ' + res.status);
            row.style.transition = 'opacity 200ms';
            row.style.opacity = '0';
            setTimeout(() => window.location.reload(), 220);
          } catch (e) {
            console.error('[action queue] mark failed', e);
            btn.disabled = false;
            btn.textContent = '✓';
            alert('Could not mark messaged. Try again.');
          }
        });
      });
    });
  })();
</script>

<style>
  /* ===== Direction A — Action Queue ===== */
  .aqv2 { margin-bottom: 2.5rem; }
  .aqv2-head { margin: 0 0 16px; }
  .aqv2-eyebrow {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint, #7A8597);
    margin-bottom: 6px;
  }
  .aqv2-title {
    font-family: var(--grotesk, 'Inter Tight', system-ui, sans-serif);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--ink, #0E1A2C);
    margin: 0;
  }
  .aqv2-title .ital {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    font-weight: 400;
    color: var(--ink-dim, #3A4658);
  }

  /* ===== Heat chip ===== */
  .heat {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 3px 8px; border: 1px solid var(--line, rgba(14,26,44,0.14));
    white-space: nowrap;
  }
  .heat::before {
    content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 999px;
    background: var(--ink-faint, #7A8597);
  }
  .heat.hot { background: #8FBF3F; color: var(--ink, #0E1A2C); border-color: #8FBF3F; font-weight: 600; }
  .heat.hot::before { background: var(--ink, #0E1A2C); }
  .heat.warm { background: #E8F0D9; color: #4A6E18; border-color: #4A6E18; }
  .heat.warm::before { background: #4A6E18; }
  .heat.cool { color: var(--ink-dim, #3A4658); border-color: var(--line-strong, rgba(14,26,44,0.28)); background: var(--paper, #FFFFFF); }
  .heat.cold { color: var(--ink-faint, #7A8597); border-color: var(--line, rgba(14,26,44,0.14)); background: var(--paper, #FFFFFF); }

  /* ===== Heat rail (4px leading edge) ===== */
  .heat-rail { width: 4px; align-self: stretch; flex-shrink: 0; }
  .heat-rail.hot  { background: #8FBF3F; }
  .heat-rail.warm { background: #D5E3B7; }
  .heat-rail.cool { background: var(--line-strong, rgba(14,26,44,0.28)); }
  .heat-rail.cold { background: transparent; }

  /* ===== Source pill ===== */
  .src-pill {
    display: inline-block;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-faint, #7A8597);
    border: 1px solid var(--line, rgba(14,26,44,0.14));
    padding: 2px 6px;
    background: var(--paper-2, #F4F2ED);
  }
  .when {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 10px; letter-spacing: 0.06em;
    color: var(--ink-faint, #7A8597);
  }

  /* ===== Hero row ===== */
  .qhero {
    display: grid;
    grid-template-columns: 4px 1fr 340px;
    border: 1px solid var(--ink, #0E1A2C);
    background: var(--paper, #FFFFFF);
    margin-bottom: 24px;
    align-items: stretch;
  }
  .qhero.qhero--empty {
    grid-template-columns: 4px 1fr;
    min-height: 180px;
  }
  .qhero .hero-body { padding: 22px 28px 22px 22px; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .qhero .head { display: flex; align-items: center; gap: 12px; margin-bottom: 4px; flex-wrap: wrap; }
  .qhero .head .head-fill { flex: 1; }
  .qhero .heat-score {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 11px; letter-spacing: 0.06em;
    color: var(--ink-dim, #3A4658);
  }
  .qhero .heat-score b { color: #4A6E18; font-weight: 600; }
  .qhero .hero-name {
    font-family: var(--grotesk, 'Inter Tight', system-ui, sans-serif);
    font-weight: 700; font-size: 26px; line-height: 1.1;
    letter-spacing: -0.03em; color: var(--ink, #0E1A2C);
    margin: 4px 0 0;
  }
  .qhero .hero-ti {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic; font-size: 16px; line-height: 1.4;
    color: var(--ink-dim, #3A4658);
  }
  .qhero .hero-ti b {
    color: var(--ink, #0E1A2C); font-style: normal;
    font-family: var(--grotesk, 'Inter Tight', system-ui, sans-serif);
    font-weight: 600;
  }
  .qhero .hero-ind {
    color: var(--ink-faint, #7A8597); font-family: var(--mono, 'DM Mono', monospace);
    font-style: normal; font-size: 11px; letter-spacing: 0.06em; margin-left: 6px;
  }
  .qhero .hero-contact {
    display: flex; gap: 14px; flex-wrap: wrap;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 11px; color: var(--ink-dim, #3A4658);
  }
