---
import type { TopProspect } from '../../utils/posthog/query';
import { sessionReplayUrl } from '../../utils/posthog/query';
import type { ProspectInfo } from '../../utils/hq/airtable';
import {
  findOnLinkedinUrl,
  prospectWebsiteUrl,
  slugToDomain,
} from '../../utils/hq/messaged';

interface Props {
  /** Already filtered: engaged AND not yet messaged. Sorted by recency desc. */
  prospects: TopProspect[];
  /** Slug → Airtable record (name, email, LinkedIn). Empty if PAT not configured. */
  prospectInfo?: Map<string, ProspectInfo>;
}

const { prospects, prospectInfo } = Astro.props;

function dwell(seconds: number): string {
  if (seconds < 60) return `${seconds}s`;
  const m = Math.floor(seconds / 60);
  const s = seconds % 60;
  return `${m}m ${s}s`;
}

function timeAgo(iso: string): string {
  const then = new Date(iso).getTime();
  const now = Date.now();
  const sec = Math.max(0, Math.round((now - then) / 1000));
  if (sec < 60) return `${sec}s ago`;
  const min = Math.round(sec / 60);
  if (min < 60) return `${min}m ago`;
  const hr = Math.round(min / 60);
  if (hr < 48) return `${hr}h ago`;
  return `${Math.round(hr / 24)}d ago`;
}

function heatBadge(p: TopProspect): { label: string; cls: string } {
  // Order by strength of buying signal. CTA click / print / copy = top tier.
  // Return visit = strong intent. Verdict expansion + full read = engaged.
  // Dwell-only = browsed.
  if (p.cta_clicks > 0) return { label: 'CTA CLICK', cls: 'heat--hot' };
  if (p.prints > 0) return { label: 'PRINTED', cls: 'heat--hot' };
  if (p.copies > 0) return { label: 'COPIED', cls: 'heat--hot' };
  if (p.return_visitor) return { label: 'RETURNED', cls: 'heat--warm' };
  if (p.verdict_expansions > 0) return { label: 'VERDICTS', cls: 'heat--warm' };
  if (p.scroll_100s > 0) return { label: 'FULL READ', cls: 'heat--warm' };
  if (p.total_dwell_seconds >= 30) return { label: 'DEEP READ', cls: 'heat--cool' };
  if (p.total_dwell_seconds >= 15) return { label: 'ENGAGED', cls: 'heat--cool' };
  return { label: 'BROWSED', cls: 'heat--cold' };
}
---
<div class="aq" data-action-queue>
  <header class="aq-head">
    <div class="aq-title">
      <span class="aq-num">{prospects.length}</span>
      <div>
        <div class="aq-h">Action queue</div>
        <div class="aq-sub">
          {prospects.length === 0
            ? 'all caught up — send your next outreach batch to refill'
            : prospects.length === 1
              ? 'prospect waiting for follow-up'
              : 'prospects waiting for follow-up'}
        </div>
      </div>
    </div>
  </header>

  {prospects.length === 0 ? (
    <div class="aq-empty">
      <p>No follow-ups queued. Either you're caught up, or your outreach hasn't generated engagement signal yet.</p>
    </div>
  ) : (
    <ol class="aq-list">
      {prospects.map((p) => {
        const heat = heatBadge(p);
        const latestSession = p.sessions[0] ?? null;
        const replay = latestSession ? sessionReplayUrl(latestSession.sid) : null;
        const domain = slugToDomain(p.prospect);
        const info = prospectInfo?.get(p.prospect);
        // Prefer the Airtable LinkedIn URL if we have one; fall back to Google search.
        const liHref = info?.linkedinUrl || findOnLinkedinUrl(p.prospect);
        const liIsExact = !!info?.linkedinUrl;
        const siteUrl = prospectWebsiteUrl(p.prospect);
        return (
          <li
            class="aq-row"
            data-slug={p.prospect}
            data-signals={JSON.stringify({
              total_dwell_seconds: p.total_dwell_seconds,
              unique_sessions: p.unique_sessions,
              total_views: p.total_views,
              cta_clicks: p.cta_clicks,
              verdict_expansions: p.verdict_expansions,
              scroll_100s: p.scroll_100s,
              copies: p.copies,
              prints: p.prints,
              return_visitor: p.return_visitor,
              last_view: p.last_view,
            })}
            data-li-url={info?.linkedinUrl || liHref}
            data-email={info?.email || ''}
            data-first-name={info?.firstName || ''}
            data-company={info?.company || domain}
            data-source={info?.source || ''}
          >
            <div class="aq-left">
              <span class={`aq-heat ${heat.cls}`}>{heat.label}</span>
              <span class="aq-when">{timeAgo(p.last_view)}</span>
              {info?.source && <span class="aq-source">{info.source}</span>}
            </div>
            <div class="aq-mid">
              <div class="aq-prospect">
                {info?.firstName ? (
                  <>
                    <span class="aq-person">{info.firstName}</span>
                    {info.title && <span class="aq-title">, {info.title}</span>}
                    <span class="aq-company">· {info.company || domain}</span>
                  </>
                ) : (
                  <a href={`https://rivett.tech/audit/v3/${p.prospect}`} target="_blank" rel="noopener">{domain}</a>
                )}
              </div>
              {info && (info.email || info.linkedinUrl) && (
                <div class="aq-contact">
                  {info.email && (
                    <a class="aq-link" href={`mailto:${info.email}`}>{info.email}</a>
                  )}
                  {info.email && info.linkedinUrl && <span class="aq-dot">·</span>}
                  {info.linkedinUrl && (
                    <a class="aq-link" href={info.linkedinUrl} target="_blank" rel="noopener">LinkedIn ↗</a>
                  )}
                  {info.outreachStage && <span class="aq-stage">· {info.outreachStage}</span>}
                </div>
              )}
              <div class="aq-signal">
                <a class="aq-memo" href={`https://rivett.tech/audit/v3/${p.prospect}`} target="_blank" rel="noopener">memo</a>
                · <b>{dwell(p.total_dwell_seconds)}</b> dwell
                · <b>{p.unique_sessions}</b> sess
                · <b>{p.total_views}</b> view{p.total_views === 1 ? '' : 's'}
                {p.cta_clicks > 0 && <span class="aq-cta">· {p.cta_clicks} CTA</span>}
                {p.verdict_expansions > 0 && <span> · {p.verdict_expansions} verdict{p.verdict_expansions === 1 ? '' : 's'}</span>}
                {p.copies > 0 && <span> · {p.copies} cop{p.copies === 1 ? 'y' : 'ies'}</span>}
                {p.prints > 0 && <span> · {p.prints} print{p.prints === 1 ? '' : 's'}</span>}
              </div>
            </div>
            <div class="aq-actions">
              <button class="aq-btn aq-btn--primary" type="button" data-draft="linkedin" title="LLM-draft a LinkedIn DM referencing what they did on the memo">Draft DM</button>
              {info?.email && (
                <button class="aq-btn aq-btn--primary" type="button" data-draft="email" title="LLM-draft an email referencing what they did on the memo">Draft Email</button>
              )}
              <a class="aq-btn" href={siteUrl} target="_blank" rel="noopener" title="Open the prospect's website">Site</a>
              {replay && (
                <a class="aq-btn" href={replay} target="_blank" rel="noopener">Replay</a>
              )}
              <button class="aq-btn aq-btn--done" type="button" data-mark-messaged>✓ Messaged</button>
            </div>
          </li>
        );
      })}
    </ol>
  )}
</div>

<!-- Draft preview modal — single instance, populated on each draft button click -->
<div class="dm-modal" data-dm-modal hidden>
  <div class="dm-backdrop" data-dm-close></div>
  <div class="dm-card" role="dialog" aria-modal="true" aria-labelledby="dm-title">
    <header class="dm-head">
      <h3 id="dm-title" class="dm-h">Draft message</h3>
      <div class="dm-meta" data-dm-meta></div>
      <button class="dm-x" type="button" data-dm-close aria-label="Close">×</button>
    </header>
    <div class="dm-body">
      <div class="dm-row" data-dm-subject-row hidden>
        <label class="dm-lbl" for="dm-subject">Subject</label>
        <input class="dm-input" id="dm-subject" type="text" data-dm-subject />
      </div>
      <div class="dm-row">
        <label class="dm-lbl" for="dm-text">Message</label>
        <textarea class="dm-text" id="dm-text" data-dm-text rows="10"></textarea>
      </div>
      <div class="dm-status" data-dm-status></div>
    </div>
    <footer class="dm-foot">
      <button class="dm-btn" type="button" data-dm-regenerate title="Throw the draft away and ask the LLM for a fresh one">↻ Regenerate</button>
      <div class="dm-spacer"></div>
      <button class="dm-btn" type="button" data-dm-close>Cancel</button>
      <button class="dm-btn dm-btn--primary" type="button" data-dm-go>Copy + open</button>
    </footer>
  </div>
</div>

<script is:inline>
  (function () {
    const modal = document.querySelector('[data-dm-modal]');
    const modalSubjectRow = modal?.querySelector('[data-dm-subject-row]');
    const modalSubject = modal?.querySelector('[data-dm-subject]');
    const modalText = modal?.querySelector('[data-dm-text]');
    const modalStatus = modal?.querySelector('[data-dm-status]');
    const modalMeta = modal?.querySelector('[data-dm-meta]');
    const modalGo = modal?.querySelector('[data-dm-go]');
    const modalRegen = modal?.querySelector('[data-dm-regenerate]');
    const modalCloseEls = modal?.querySelectorAll('[data-dm-close]');

    // Active context for the open modal.
    let ctx = null;  // { slug, channel, signals, liUrl, email, firstName, company }

    function openModal() { modal && (modal.hidden = false); }
    function closeModal() { modal && (modal.hidden = true); ctx = null; }
    modalCloseEls?.forEach(function (el) { el.addEventListener('click', closeModal); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
    });

    async function fetchDraft(slug, channel, signals, force) {
      const res = await fetch('/api/hq/draft-message', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ slug, channel, signals, force: !!force }),
      });
      const data = await res.json().catch(function () { return {}; });
      if (!res.ok) {
        throw new Error(data.message || data.error || ('http ' + res.status));
      }
      return data;
    }

    async function startDraft(row, channel, opts) {
      const slug = row.getAttribute('data-slug');
      const liUrl = row.getAttribute('data-li-url') || '';
      const email = row.getAttribute('data-email') || '';
      const firstName = row.getAttribute('data-first-name') || '';
      const company = row.getAttribute('data-company') || '';
      const source = row.getAttribute('data-source') || '';
      let signals = {};
      try { signals = JSON.parse(row.getAttribute('data-signals') || '{}'); } catch (e) {}

      ctx = { slug, channel, signals, liUrl, email, firstName, company, source };

      // Set up modal shell
      if (channel === 'email') {
        modalSubjectRow.hidden = false;
      } else {
        modalSubjectRow.hidden = true;
      }
      modalSubject.value = '';
      modalText.value = '';
      modalStatus.textContent = 'Drafting with Claude...';
      modalStatus.className = 'dm-status dm-status--info';
      modalMeta.textContent = (firstName || slug) + (company ? ' · ' + company : '') + (source ? ' · ' + source : '') + ' · ' + (channel === 'email' ? 'Email' : 'LinkedIn DM');
      modalGo.textContent = channel === 'email' ? 'Open in mail' : 'Copy + open LinkedIn';
      modalGo.disabled = true;
      modalRegen.disabled = true;
      openModal();

      try {
        const data = await fetchDraft(slug, channel, signals, opts && opts.force);
        modalSubject.value = data.subject || '';
        modalText.value = data.body || '';
        const noAt = data.has_airtable_record === false;
        if (data.cached) {
          modalStatus.textContent = 'Loaded cached draft. ↻ Regenerate for a fresh one.';
        } else if (noAt) {
          modalStatus.textContent = 'Drafted from engagement signals only (no Airtable match for ' + slug + '). Add an Audit URL to a record so future drafts are richer.';
        } else {
          modalStatus.textContent = 'Drafted. Edit if needed, then copy + open.';
        }
        modalStatus.className = 'dm-status ' + (noAt && !data.cached ? 'dm-status--info' : 'dm-status--ok');
        modalGo.disabled = false;
        modalRegen.disabled = false;
      } catch (e) {
        modalStatus.textContent = 'Could not draft: ' + (e && e.message ? e.message : String(e));
        modalStatus.className = 'dm-status dm-status--err';
        modalGo.disabled = true;
        modalRegen.disabled = false;
      }
    }

    async function copyToClipboard(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch (e) {
        return false;
      }
    }

    modalRegen?.addEventListener('click', async function () {
      if (!ctx) return;
      modalStatus.textContent = 'Regenerating...';
      modalStatus.className = 'dm-status dm-status--info';
      modalGo.disabled = true;
      modalRegen.disabled = true;
      try {
        const data = await fetchDraft(ctx.slug, ctx.channel, ctx.signals, true);
        modalSubject.value = data.subject || '';
        modalText.value = data.body || '';
        modalStatus.textContent = 'Regenerated.';
        modalStatus.className = 'dm-status dm-status--ok';
        modalGo.disabled = false;
        modalRegen.disabled = false;
      } catch (e) {
        modalStatus.textContent = 'Regenerate failed: ' + (e && e.message ? e.message : String(e));
        modalStatus.className = 'dm-status dm-status--err';
        modalRegen.disabled = false;
      }
    });

    modalGo?.addEventListener('click', async function () {
      if (!ctx) return;
      const subject = modalSubject.value || '';
      const body = modalText.value || '';
      if (ctx.channel === 'email') {
        // mailto with subject + body. Cap length so browsers don't truncate.
        const params = new URLSearchParams();
        if (subject) params.set('subject', subject);
        if (body) params.set('body', body);
        const href = 'mailto:' + encodeURIComponent(ctx.email) + '?' + params.toString();
        await copyToClipboard(body);  // safety copy in case mailto fails
        window.location.href = href;
        modalStatus.textContent = 'Opened mail client. Body also copied to clipboard.';
        modalStatus.className = 'dm-status dm-status--ok';
      } else {
        // LinkedIn can't deep-link to compose. Copy body, then open the profile.
        const ok = await copyToClipboard(body);
        if (ctx.liUrl) window.open(ctx.liUrl, '_blank', 'noopener');
        modalStatus.textContent = ok
          ? 'DM copied to clipboard. LinkedIn opened in a new tab — paste into the Message box.'
          : 'Could not copy to clipboard (browser blocked). Select and copy manually.';
        modalStatus.className = ok ? 'dm-status dm-status--ok' : 'dm-status dm-status--err';
      }
    });

    // Wire up the per-row buttons.
    document.querySelectorAll('[data-action-queue]').forEach(function (queue) {
      queue.querySelectorAll('[data-draft]').forEach(function (btn) {
        btn.addEventListener('click', function (ev) {
          ev.preventDefault();
          const row = btn.closest('[data-slug]');
          if (!row) return;
          const channel = btn.getAttribute('data-draft') === 'email' ? 'email' : 'linkedin';
          startDraft(row, channel, {});
        });
      });

      queue.querySelectorAll('[data-mark-messaged]').forEach(function (btn) {
        btn.addEventListener('click', async function (ev) {
          ev.preventDefault();
          const row = btn.closest('[data-slug]');
          if (!row) return;
          const slug = row.getAttribute('data-slug');
          if (!slug) return;
          btn.disabled = true;
          btn.textContent = '…';
          try {
            const res = await fetch('/api/hq/mark-messaged', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({ slug, action: 'mark' }),
            });
            if (!res.ok) throw new Error('mark failed: ' + res.status);
            row.style.transition = 'opacity 200ms';
            row.style.opacity = '0';
            setTimeout(function () {
              window.location.reload();
            }, 220);
          } catch (e) {
            console.error('[action queue] mark failed', e);
            btn.disabled = false;
            btn.textContent = '✓ Messaged';
            alert('Could not mark messaged. Try again.');
          }
        });
      });
    });
  })();
</script>

<style>
  .aq {
    border: 1px solid var(--ink, #0E1A2C);
    border-radius: 6px;
    background: var(--paper, #FFFFFF);
    overflow: hidden;
    margin-bottom: 2.5rem;
  }

  .aq-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    background: var(--ink, #0E1A2C);
    color: var(--paper, #FFFFFF);
  }
  .aq-title {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .aq-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.5rem;
    border-radius: 4px;
    background: var(--accent, #8FBF3F);
    color: var(--ink, #0E1A2C);
    font-family: var(--grotesk, 'Inter Tight', system-ui);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .aq-h {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .aq-sub {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.7rem;
    color: rgba(255,255,255,0.7);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 0.1rem;
  }

  .aq-empty {
    padding: 1.5rem 1rem;
  }
  .aq-empty p {
    margin: 0;
    color: var(--ink-dim, #3A4658);
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
  }

  .aq-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .aq-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.5rem 1rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line, rgba(14,26,44,0.14));
    align-items: center;
  }
  .aq-row:last-child { border-bottom: 0; }
  .aq-row:hover { background: var(--paper-2, #F4F2ED); }

  .aq-left {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    white-space: nowrap;
  }
  .aq-heat {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: center;
  }
  .heat--hot { background: var(--accent-deep, #4A6E18); color: var(--paper, #FFFFFF); }
  .heat--warm { background: var(--accent, #8FBF3F); color: var(--ink, #0E1A2C); }
  .heat--cool { background: var(--paper-3, #EBE6DC); color: var(--ink-dim, #3A4658); }
  .heat--cold { background: var(--paper-2, #F4F2ED); color: var(--ink-faint, #7A8597); }
  .aq-when {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.7rem;
    color: var(--ink-faint, #7A8597);
    text-align: center;
  }

  .aq-mid { min-width: 0; }
  .aq-prospect {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .aq-prospect a {
    font-weight: 600;
    color: var(--ink, #0E1A2C);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong, rgba(14,26,44,0.28));
  }
  .aq-prospect a:hover {
    color: var(--accent-deep, #4A6E18);
    border-bottom-color: var(--accent-deep, #4A6E18);
  }
  .aq-co {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    color: var(--ink-faint, #7A8597);
    font-size: 0.85rem;
  }
  .aq-person {
    font-weight: 600;
    color: var(--ink, #0E1A2C);
    font-size: 0.95rem;
  }
  .aq-title {
    color: var(--ink-dim, #3A4658);
    font-size: 0.85rem;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
  }
  .aq-company {
    color: var(--ink-dim, #3A4658);
    font-size: 0.85rem;
  }
  .aq-contact {
    margin-top: 0.2rem;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.75rem;
    color: var(--ink-dim, #3A4658);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .aq-link {
    color: var(--ink-dim, #3A4658);
    text-decoration: none;
    border-bottom: 1px dotted var(--line, rgba(14,26,44,0.14));
  }
