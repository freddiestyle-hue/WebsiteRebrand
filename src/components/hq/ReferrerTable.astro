---
import type { TrafficSource } from '../../utils/posthog/query';

interface Props {
  sources: TrafficSource[];
}

const { sources } = Astro.props;
const total = sources.reduce((s, x) => s + x.visitors, 0) || 1;

function prettySource(src: string): string {
  const [base, ...detail] = src.split(' / ');
  const prettyBase = (() => {
    if (base === '$direct') return 'Direct / no referrer';
    if (base === 'linkedin_dm') return 'LinkedIn DM';
    if (base === 'linkedin_comment') return 'LinkedIn comment';
    if (base === 'linkedin_post' || base === 'linkedin') return 'LinkedIn';
    if (base === 'cold_email') return 'Cold email';
    if (base === 'email_signature') return 'Email signature';
    if (base === 'shortlink') return 'Shortlink';
    if (base === 'linkedin.com' || base === 'www.linkedin.com') return 'LinkedIn';
    if (base.endsWith('google.com') || base === 'google.com') return 'Google';
    if (base === 'twitter.com' || base === 't.co' || base === 'x.com') return 'Twitter / X';
    return base;
  })();
  return detail.length ? `${prettyBase} / ${detail.join(' / ')}` : prettyBase;
}
---
{sources.length === 0 ? (
  <p class="empty">No referrer data yet.</p>
) : (
  <table class="tbl">
    <thead>
      <tr>
        <th class="th-rank">#</th>
        <th>Source</th>
        <th class="th-num">Visitors</th>
        <th class="th-num">% share</th>
        <th class="th-num">Views</th>
      </tr>
    </thead>
    <tbody>
      {sources.map((s, i) => {
        const pct = (s.visitors / total) * 100;
        const isDirect = s.source === '$direct';
        return (
          <tr>
            <td class="td-rank">{String(i + 1).padStart(2, '0')}</td>
            <td class="td-src">
              <span class={isDirect ? 'src-direct' : 'src-domain'}>{prettySource(s.source)}</span>
            </td>
            <td class="td-num"><b>{s.visitors}</b></td>
            <td class="td-num td-pct">
              <span class="pct-bar"><span class="pct-fill" style={`width:${pct.toFixed(1)}%`}></span></span>
              <span class="pct-val">{pct.toFixed(0)}%</span>
            </td>
            <td class="td-num">{s.pageviews}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
)}

<style>
  .empty {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    color: var(--ink-faint, #7A8597);
    padding: 1.5rem 0;
  }
  .tbl { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .tbl th, .tbl td {
    text-align: left; padding: 0.6rem 0.5rem;
    border-bottom: 1px solid var(--line, rgba(14,26,44,0.14));
  }
  .tbl thead th {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em;
    font-weight: 500; color: var(--ink-faint, #7A8597);
    border-bottom-color: var(--line-strong, rgba(14,26,44,0.28));
  }
  .th-rank, .td-rank {
    font-family: var(--mono, 'DM Mono', monospace);
    color: var(--ink-faint, #7A8597); width: 3rem;
  }
  .th-num, .td-num {
    text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .td-src { font-weight: 500; }
  .src-direct { color: var(--ink-faint, #7A8597); font-style: italic; font-weight: 400; }
  .src-domain { color: var(--ink, #0E1A2C); }
  .td-pct { width: 140px; }
  .pct-bar {
    display: inline-block; width: 70px; height: 6px;
    background: var(--paper-3, #EBE6DC); border-radius: 999px;
    overflow: hidden; vertical-align: middle; margin-right: 0.5rem;
  }
  .pct-fill { display: block; height: 100%; background: var(--accent, #8FBF3F); }
  .pct-val {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.75rem;
    color: var(--ink-dim, #3A4658);
  }
</style>
