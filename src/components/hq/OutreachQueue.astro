---
// HQ Send Queue — Direction A.
// One row per unsent Wave prospect. Click "Send" to:
//   1. Copy the LinkedIn DM to clipboard
//   2. Open the prospect's LinkedIn profile in a new tab
//   3. PATCH Outreach Stage to "Connection Sent" so the row drops out
// This is the operator's "send next" view, distinct from the Action Queue
// which is the engagement / replied view.

import type { OutreachQueueRow } from '../../utils/hq/airtable';

interface Props {
  queue: OutreachQueueRow[];
  wave: string;
}

const { queue, wave } = Astro.props;

type Tier = 'aplus' | 'a' | 'b' | 'c' | 'd' | 'none';
function tierOf(priority: string): Tier {
  const m = priority.match(/^(A\+|A|B|C|D)\b/);
  if (!m) return 'none';
  return { 'A+': 'aplus', A: 'a', B: 'b', C: 'c', D: 'd' }[m[1] as 'A+' | 'A' | 'B' | 'C' | 'D'];
}
function tierLabel(priority: string): string {
  const m = priority.match(/^(A\+|A|B|C|D)\b/);
  return m ? m[1] : '–';
}
function tierRank(priority: string): string {
  const m = priority.match(/#(\d+)/);
  return m ? `#${m[1]}` : '';
}

// Linkedin URL safety. Drop scheme-less or non-http inputs so window.open
// can't be tricked into javascript: hrefs by a bad Airtable cell value.
function safeUrl(u: string): string {
  if (!u) return '';
  try {
    const url = new URL(u);
    if (url.protocol !== 'http:' && url.protocol !== 'https:') return '';
    return url.toString();
  } catch {
    return '';
  }
}
---
<section class="sq" data-outreach-queue data-wave={wave}>
  <div class="sq-head">
    <div class="sq-head-left">
      <div class="sq-eyebrow">SEND QUEUE · {wave.toUpperCase()}</div>
      <h2 class="sq-title">The next batch. <span class="ital">{queue.length} ready to send.</span></h2>
    </div>
    <div class="sq-instr">Click <b>Send</b> to copy the DM and open LinkedIn.</div>
  </div>

  {queue.length === 0 ? (
    <div class="sq-empty">
      <p>No prospects ready to send for this wave.</p>
      <p class="dim">Once an audit is generated and a DM is written, it appears here. Anything marked beyond <code>Not Sent</code> drops out automatically.</p>
    </div>
  ) : (
    <ol class="sq-list">
      {queue.map((row) => {
        const liHref = safeUrl(row.linkedinUrl);
        const tier = tierOf(row.priority);
        return (
          <li
            class={`sq-row tier-${tier}`}
            data-record-id={row.recordId}
            data-slug={row.slug}
            data-linkedin={liHref}
            data-dm={row.linkedinDm}
          >
            <div class="sq-rail" aria-hidden="true"></div>
            <div class="sq-meta">
              <span class="sq-tier">{tierLabel(row.priority)}<span class="rk">{tierRank(row.priority)}</span></span>
            </div>
            <div class="sq-who">
              <div class="sq-line1">
                <b class="sq-name">{row.firstName || row.displayName}</b>
                {row.title && <span class="sq-title-it">, <em>{row.title}</em></span>}
              </div>
              <div class="sq-line2">
                <span class="sq-co">{row.company}</span>
                {row.industry && <span class="sq-dot">·</span>}
                {row.industry && <span class="sq-ind">{row.industry}</span>}
              </div>
              <div class="sq-dm" title={row.linkedinDm}>{row.linkedinDm}</div>
            </div>
            <div class="sq-actions">
              <button class="sq-send" type="button" data-action="send">
                <span class="sq-send-label">Send</span>
                <span class="sq-send-icon" aria-hidden="true">→</span>
              </button>
              {row.auditUrl && (
                <a class="sq-aux" href={row.auditUrl} target="_blank" rel="noopener noreferrer" title="Open the audit memo">Audit ↗</a>
              )}
            </div>
            <div class="sq-status" aria-live="polite" hidden></div>
          </li>
        );
      })}
    </ol>
  )}
</section>

<style>
  .sq { margin: var(--sp-8) 0; }
  .sq-head {
    display: flex; justify-content: space-between; align-items: flex-end;
    border-bottom: 1px solid var(--ink); padding-bottom: var(--sp-3);
    margin-bottom: var(--sp-5); gap: var(--sp-6);
  }
  .sq-eyebrow {
    font: 600 10px/1 var(--mono); letter-spacing: var(--track-mono);
    text-transform: uppercase; color: var(--ink-faint); margin-bottom: var(--sp-2);
  }
  .sq-title { font: 600 22px/1.15 var(--grotesk); margin: 0; }
  .sq-title .ital { font: italic 18px/1.2 var(--serif); color: var(--ink-dim); margin-left: var(--sp-2); }
  .sq-instr {
    font: 12px/1.4 var(--mono); color: var(--ink-faint); max-width: 280px; text-align: right;
  }
  .sq-instr b { color: var(--ink); }

  .sq-empty {
    border: 1px solid var(--ink); padding: var(--sp-5);
    background: var(--paper-2); color: var(--ink-dim); font: 14px/1.5 var(--serif);
  }
  .sq-empty p { margin: 0 0 var(--sp-2); }
  .sq-empty .dim { color: var(--ink-faint); font-size: 13px; }
  .sq-empty code { font: 11px/1 var(--mono); background: var(--paper); padding: 2px 4px; }

  .sq-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--ink); }
  .sq-row {
    display: grid; grid-template-columns: 4px 56px 1fr auto; align-items: stretch;
    border-bottom: 1px solid var(--line-soft); padding: 0;
    transition: background 100ms;
  }
  .sq-row:last-child { border-bottom: 0; }
  .sq-row:hover { background: var(--paper-2); }
  .sq-row.sent {
    background: var(--paper-3); opacity: 0.55;
  }
  .sq-row.sent .sq-send { background: var(--paper-3); color: var(--ink-faint); pointer-events: none; }

  .sq-rail { background: var(--ink-faint); }
  .sq-row.tier-aplus .sq-rail { background: var(--accent); }
  .sq-row.tier-a .sq-rail { background: var(--accent-deep); }
  .sq-row.tier-b .sq-rail { background: var(--sage); }
  .sq-row.tier-c .sq-rail { background: var(--ink-soft); }
  .sq-row.tier-d .sq-rail { background: var(--ink-faint); }

  .sq-meta {
    display: flex; align-items: center; justify-content: center;
    padding: var(--sp-3) var(--sp-2);
  }
  .sq-tier {
    font: 600 11px/1 var(--mono); letter-spacing: var(--track-mono);
    color: var(--ink); white-space: nowrap;
  }
  .sq-tier .rk { color: var(--ink-faint); margin-left: 4px; font-weight: 400; }

  .sq-who { padding: var(--sp-3) var(--sp-4); min-width: 0; }
  .sq-line1 { font-size: 14px; line-height: 1.3; margin-bottom: 2px; }
  .sq-line1 .sq-name { font-weight: 700; font-family: var(--grotesk); }
  .sq-title-it { color: var(--ink-dim); font-family: var(--serif); }
  .sq-line2 {
    font: italic 13px/1.3 var(--serif); color: var(--ink-dim); margin-bottom: var(--sp-2);
  }
  .sq-line2 .sq-co { font-style: normal; font-weight: 600; color: var(--ink); }
  .sq-line2 .sq-dot { margin: 0 var(--sp-2); color: var(--ink-faint); }
  .sq-line2 .sq-ind { font: 11px/1.3 var(--mono); color: var(--ink-faint); text-transform: uppercase; }
  .sq-dm {
    font: 12px/1.5 var(--mono); color: var(--ink-soft);
    background: var(--paper-2); padding: var(--sp-2) var(--sp-3);
    border-left: 2px solid var(--line-soft);
    max-height: 4.5em; overflow: hidden; text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sq-row:hover .sq-dm { white-space: normal; max-height: 12em; }

  .sq-actions {
    display: flex; flex-direction: column; gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4); align-items: stretch; justify-content: center;
  }
  .sq-send {
    display: inline-flex; align-items: center; justify-content: space-between;
    gap: var(--sp-2);
    background: var(--ink); color: var(--paper);
    border: 0; padding: var(--sp-2) var(--sp-4);
    font: 600 12px/1 var(--mono); letter-spacing: var(--track-mono);
    text-transform: uppercase; cursor: pointer;
    min-width: 110px;
  }
  .sq-send:hover { background: var(--accent); color: var(--ink); }
  .sq-send-icon { font-size: 16px; }
  .sq-aux {
    text-align: center; font: 11px/1 var(--mono); color: var(--ink-faint);
    text-decoration: none; padding: var(--sp-2);
    border: 1px solid var(--line-soft);
  }
  .sq-aux:hover { color: var(--ink); border-color: var(--ink); }

  .sq-status {
    grid-column: 2 / -1;
    font: 11px/1.4 var(--mono); color: var(--ink-faint);
    padding: 0 var(--sp-4) var(--sp-3);
  }
  .sq-status[data-ok="1"] { color: var(--accent-deep); }
  .sq-status[data-err="1"] { color: #b00020; }

  @media (max-width: 720px) {
    .sq-head { flex-direction: column; align-items: flex-start; gap: var(--sp-2); }
    .sq-instr { text-align: left; max-width: none; }
    .sq-row { grid-template-columns: 4px 1fr; }
    .sq-meta { padding: var(--sp-3) var(--sp-3) 0; justify-content: flex-start; }
    .sq-who { padding: var(--sp-2) var(--sp-3); }
    .sq-actions { padding: 0 var(--sp-3) var(--sp-3); flex-direction: row; }
    .sq-send { flex: 1; }
    .sq-aux { flex: 0 0 auto; }
  }
</style>

<script>
  // Send-queue interactivity. One handler per row's Send button:
  //   1. Copy DM to clipboard (modern API with fallback)
  //   2. Open LinkedIn URL in a new tab
  //   3. POST mark-messaged so the prospect drops out on next render
  // All in that order so the click consumes the user-gesture for both
  // clipboard.writeText AND window.open. If clipboard fails (older browser /
  // permissions), we surface the DM in the status row so the operator can
  // still copy manually.

  function copyToClipboard(text: string): Promise<boolean> {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text).then(() => true).catch(() => false);
    }
    // Fallback for browsers that block clipboard in non-secure contexts.
    return new Promise((resolve) => {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        resolve(ok);
      } catch {
        resolve(false);
      }
    });
  }

  async function markSent(slug: string): Promise<{ ok: boolean; stage?: string; error?: string }> {
    try {
      const res = await fetch('/api/hq/mark-messaged', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug, action: 'mark', stage: 'Connection Sent' }),
        credentials: 'include',
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) return { ok: false, error: data?.message || data?.error || `HTTP ${res.status}` };
      return { ok: true, stage: data?.stage };
    } catch (e) {
      return { ok: false, error: e instanceof Error ? e.message : String(e) };
    }
  }

  function setStatus(row: HTMLElement, text: string, kind?: 'ok' | 'err') {
    const status = row.querySelector<HTMLElement>('.sq-status');
    if (!status) return;
    status.textContent = text;
    status.hidden = false;
    if (kind === 'ok') status.setAttribute('data-ok', '1');
    else status.removeAttribute('data-ok');
    if (kind === 'err') status.setAttribute('data-err', '1');
    else status.removeAttribute('data-err');
  }

  // Upgrade 13 - auto-shorten rivett.tech audit URLs in the DM body before
  // copy. Each Send click mints a fresh shortlink scoped to this recipient
  // and the current outreach wave, so per-recipient attribution works end
  // to end (shortlink click → audit pageview → /hq Action Queue).
  //
  // Detected URL shapes:
  //   - https://rivett.tech/audit/v3/{slug}
  //   - http://rivett.tech/audit/v3/{slug}
  //
  // Failure mode: if minting fails (KV down, network), the long URL stays
  // in the DM unmodified - send still works, just loses the per-recipient
  // shortlink signal for this one row.
  const AUDIT_URL_RE = /https?:\/\/rivett\.tech\/audit\/v3\/[a-zA-Z0-9-]+\.?/g;
  async function mintShortlink(targetUrl: string, recipient: string): Promise<string | null> {
    try {
      const res = await fetch('/api/r/create', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({
          target_url: targetUrl.replace(/[.,;:!?)]+$/, ''),
          campaign: 'wave1',
          recipient,
          channel: 'linkedin_dm',
          created_by: 'hq_outreach_queue',
        }),
      });
      if (!res.ok) return null;
      const data = (await res.json()) as { short_url?: string };
      return data.short_url ?? null;
    } catch {
      return null;
    }
  }

  async function shortenAuditUrlsIn(dm: string, recipient: string): Promise<string> {
    const matches = Array.from(dm.matchAll(AUDIT_URL_RE));
    if (matches.length === 0) return dm;
    let out = dm;
    for (const m of matches) {
      const long = m[0];
      const cleanLong = long.replace(/[.,;:!?)]+$/, '');
      const trailingPunct = long.slice(cleanLong.length);
      const short = await mintShortlink(cleanLong, recipient);
      if (short) {
        out = out.replace(long, short + trailingPunct);
      }
    }
    return out;
  }

  document.querySelectorAll<HTMLElement>('[data-outreach-queue] .sq-row').forEach((row) => {
    const btn = row.querySelector<HTMLButtonElement>('.sq-send[data-action="send"]');
    if (!btn) return;
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const slug = row.dataset.slug || '';
      const dm = row.dataset.dm || '';
      const linkedin = row.dataset.linkedin || '';

      if (!slug || !dm || !linkedin) {
        setStatus(row, 'Missing slug, DM, or LinkedIn URL on this row.', 'err');
        return;
      }

      // Upgrade 13 - shorten audit URLs in the DM body first. Synchronous
      // enough to keep the user gesture alive for the clipboard + window.open
      // calls below (the mint is a single fetch that resolves in <300ms on
      // warm KV; user gesture timing is forgiving in modern Chrome/Safari).
      const dmToCopy = await shortenAuditUrlsIn(dm, slug);

      // Order matters: clipboard + window.open must run while we still have
      // the user gesture. Both are synchronous-ish (clipboard returns a
      // Promise but the call itself happens inside the gesture).
      const copyPromise = copyToClipboard(dmToCopy);
      const opened = window.open(linkedin, '_blank', 'noopener,noreferrer');
      const copied = await copyPromise;

      if (!opened) {
        setStatus(row, 'Popup blocked. Allow popups for this site, then click Send again.', 'err');
        return;
      }

      // Mark as sent in Airtable. Don't block the UI on this - the DM is
      // already copied and LinkedIn is open. If the mark fails the operator
      // can hit it again or fix manually.
      const mark = await markSent(slug);
      if (mark.ok) {
        row.classList.add('sent');
        const msg = copied
          ? `Copied DM. Opened LinkedIn. Marked ${mark.stage || 'sent'}.`
          : `Couldn't auto-copy DM (browser blocked clipboard). Opened LinkedIn. Marked ${mark.stage || 'sent'}.`;
        setStatus(row, msg, 'ok');
      } else {
        const msg = copied
          ? `Copied DM and opened LinkedIn. Airtable update failed: ${mark.error}`
          : `Opened LinkedIn but neither copy nor Airtable worked. Manual copy needed. ${mark.error}`;
        setStatus(row, msg, 'err');
      }
    });
  });
</script>
