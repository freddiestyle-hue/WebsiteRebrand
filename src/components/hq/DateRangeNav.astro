---
import { PRESETS, type DateRange } from '../../utils/posthog/dateRange';

interface Props {
  range: DateRange;
}

const { range } = Astro.props;

const todayIso = new Date().toISOString().slice(0, 10);
const fromIso = range.fromIso.slice(0, 10);
const toIso = range.toIso.slice(0, 10);
---
<div class="rangebar" role="region" aria-label="Date range">
  <div class="row row--presets">
    <div class="lab">Range</div>
    <div class="opts" role="group" aria-label="Date presets">
      {PRESETS.map((p) => (
        <a
          href={`?range=${p.value}`}
          class={`opt ${range.preset === p.value ? 'opt--active' : ''}`}
          aria-current={range.preset === p.value ? 'true' : 'false'}
        >{p.label}</a>
      ))}
    </div>
  </div>

  <details class="row row--custom" open={range.isCustom}>
    <summary>
      <span class="lab">Custom</span>
      <span class={`opt opt--summary ${range.isCustom ? 'opt--active' : ''}`}>
        {range.isCustom ? `${fromIso} → ${toIso}` : 'pick dates'}
        <span class="chev" aria-hidden="true">↓</span>
      </span>
    </summary>
    <form class="form" method="get" action="/hq">
      <input type="date" name="from" value={fromIso} max={todayIso} aria-label="From" />
      <span class="arrow">→</span>
      <input type="date" name="to" value={toIso} max={todayIso} aria-label="To" />
      <button type="submit" class="opt opt--apply">Apply</button>
    </form>
  </details>
</div>

<style>
  .rangebar {
    border: 1px solid var(--line, rgba(14,26,44,0.14));
    border-radius: 4px;
    background: var(--paper, #FFFFFF);
    margin-bottom: 2rem;
    overflow: hidden;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem 0.85rem;
  }
  .row--presets {
    border-bottom: 1px solid var(--line, rgba(14,26,44,0.14));
  }

  .lab {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-faint, #7A8597);
    flex-shrink: 0;
    width: 4.5rem;
  }

  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem;
  }
  .opt {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.65rem;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.75rem;
    color: var(--ink-dim, #3A4658);
    text-decoration: none;
    border-radius: 3px;
    transition: color 100ms, background 100ms;
    cursor: pointer;
    border: 0;
    background: transparent;
  }
  .opt:hover {
    color: var(--ink, #0E1A2C);
    background: var(--paper-2, #F4F2ED);
  }
  .opt--active {
    color: var(--ink, #0E1A2C);
    background: var(--accent-bg, #F2F7E5);
    font-weight: 500;
    box-shadow: inset 0 -1px 0 var(--accent-deep, #4A6E18);
  }
  .opt--active:hover {
    background: var(--accent-bg, #F2F7E5);
  }

  /* Custom range disclosure */
  details summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
  }
  details summary::-webkit-details-marker { display: none; }
  .opt--summary {
    color: var(--ink-faint, #7A8597);
  }
  .opt--summary .chev {
    margin-left: 0.4rem;
    transition: transform 120ms;
  }
  details[open] .opt--summary .chev { transform: rotate(180deg); }

  .form {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    padding: 0 0.85rem 0.65rem calc(4.5rem + 0.85rem + 1rem);
    border-top: 1px dashed var(--line, rgba(14,26,44,0.14));
    margin-top: 0.4rem;
    padding-top: 0.65rem;
  }
  .form input[type="date"] {
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--line-strong, rgba(14,26,44,0.28));
    border-radius: 3px;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.75rem;
    color: var(--ink, #0E1A2C);
    background: var(--paper, #FFFFFF);
  }
  .form input[type="date"]:focus {
    outline: 2px solid var(--accent-deep, #4A6E18);
    outline-offset: 1px;
  }
  .arrow {
    font-family: var(--mono, 'DM Mono', monospace);
    color: var(--ink-faint, #7A8597);
    font-size: 0.85rem;
  }
  .opt--apply {
    color: var(--ink, #0E1A2C);
    background: var(--accent-bg, #F2F7E5);
    box-shadow: inset 0 -1px 0 var(--accent-deep, #4A6E18);
    font-weight: 500;
  }
  .opt--apply:hover {
    background: var(--accent, #8FBF3F);
  }

  @media (max-width: 720px) {
    .lab { width: auto; }
    .row { flex-wrap: wrap; }
    .form { padding-left: 0.85rem; }
  }
</style>
