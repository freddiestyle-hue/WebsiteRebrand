---
import { PRESETS, type DateRange } from '../../utils/posthog/dateRange';

interface Props {
  range: DateRange;
}

const { range } = Astro.props;

const todayIso = new Date().toISOString().slice(0, 10);
const fromIso = range.fromIso.slice(0, 10);
const toIso = range.toIso.slice(0, 10);
---
<div class="rangebar" role="region" aria-label="Date range">
  <div class="opts" role="group" aria-label="Date presets">
    {PRESETS.map((p) => (
      <a
        href={`?range=${p.value}`}
        class={`opt ${range.preset === p.value ? 'opt--active' : ''}`}
        aria-current={range.preset === p.value ? 'true' : 'false'}
      >{p.label}</a>
    ))}
  </div>

  <details class="custom" open={range.isCustom}>
    <summary class={`opt ${range.isCustom ? 'opt--active' : ''}`}>
      {range.isCustom ? `${fromIso} → ${toIso}` : 'Custom'}
      <span class="chev" aria-hidden="true">↓</span>
    </summary>
    <form class="form" method="get" action="/hq">
      <input type="date" name="from" value={fromIso} max={todayIso} aria-label="From" />
      <span class="arrow">→</span>
      <input type="date" name="to" value={toIso} max={todayIso} aria-label="To" />
      <button type="submit" class="opt opt--apply">Apply</button>
    </form>
  </details>
</div>

<style>
  .rangebar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .opts {
    display: flex;
    gap: 0.1rem;
    padding: 0.15rem;
    background: var(--paper-2, #F4F2ED);
    border: 1px solid var(--line, rgba(14,26,44,0.14));
    border-radius: 0;
  }
  .opt {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.6rem;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.72rem;
    color: var(--ink-dim, #3A4658);
    text-decoration: none;
    border-radius: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: background 80ms, color 80ms;
  }
  .opt:hover {
    color: var(--ink, #0E1A2C);
    background: var(--paper, #FFFFFF);
  }
  .opt--active {
    background: var(--ink, #0E1A2C);
    color: var(--paper, #FFFFFF);
    font-weight: 500;
  }
  .opt--active:hover {
    background: var(--ink, #0E1A2C);
    color: var(--paper, #FFFFFF);
  }

  /* Custom range — disclosure */
  .custom {
    display: inline-block;
  }
  details summary {
    display: inline-flex;
    align-items: center;
    list-style: none;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--line, rgba(14,26,44,0.14));
    border-radius: 0;
    background: var(--paper-2, #F4F2ED);
  }
  details summary::-webkit-details-marker { display: none; }
  details summary:hover { background: var(--paper, #FFFFFF); color: var(--ink, #0E1A2C); }
  details summary .chev {
    margin-left: 0.4rem;
    transition: transform 120ms;
    font-size: 0.7rem;
    opacity: 0.6;
  }
  details[open] summary .chev { transform: rotate(180deg); }

  .form {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: 0.5rem;
  }
  .form input[type="date"] {
    padding: 0.25rem 0.4rem;
    border: 1px solid var(--line-strong, rgba(14,26,44,0.28));
    border-radius: 0;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.72rem;
    color: var(--ink, #0E1A2C);
    background: var(--paper, #FFFFFF);
  }
  .form input[type="date"]:focus {
    outline: 2px solid var(--accent-deep, #4A6E18);
    outline-offset: 1px;
  }
  .arrow {
    font-family: var(--mono, 'DM Mono', monospace);
    color: var(--ink-faint, #7A8597);
    font-size: 0.8rem;
  }
  .opt--apply {
    background: var(--accent, #8FBF3F);
    color: var(--ink, #0E1A2C);
    font-weight: 500;
    padding: 0.3rem 0.7rem;
  }
  .opt--apply:hover {
    background: var(--accent-deep, #4A6E18);
    color: var(--paper, #FFFFFF);
  }

  @media (max-width: 640px) {
    .rangebar {
      width: 100%;
    }
    .opts {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .opts::-webkit-scrollbar { display: none; }
    .form { flex-wrap: wrap; margin-left: 0; }
  }
</style>
