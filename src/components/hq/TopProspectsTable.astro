---
// Direction A § 02 Top Prospects table.
// Same .feed / .feed-row visual as the other section feeds, but each row
// expands to show session history with replay links.

import type { TopProspect } from '../../utils/posthog/query';
import { sessionReplayUrl } from '../../utils/posthog/query';
import type { ProspectInfo } from '../../utils/hq/airtable';
import { slugToDomain, findOnLinkedinUrl } from '../../utils/hq/messaged';

interface Props {
  prospects: TopProspect[];
  prospectInfo?: Map<string, ProspectInfo>;
}

const { prospects, prospectInfo } = Astro.props;

function dwell(seconds: number): string {
  if (seconds < 60) return `${seconds}s`;
  const m = Math.floor(seconds / 60);
  const s = seconds % 60;
  return `${m}m ${s}s`;
}
function timeAgo(iso: string): string {
  const sec = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 1000));
  if (sec < 60) return `${sec}s ago`;
  const min = Math.round(sec / 60);
  if (min < 60) return `${min}m ago`;
  const hr = Math.round(min / 60);
  if (hr < 48) return `${hr}h ago`;
  return `${Math.round(hr / 24)}d ago`;
}
function prospectUrl(slug: string, surface: 'audit' | 'intake-review' | undefined): string {
  if (surface === 'intake-review') return `https://intake-reviews.vercel.app/intake-review/${slug}`;
  return `https://rivett.tech/audit/v3/${slug}`;
}
function heatClass(h: number): string {
  if (h >= 50) return 'heat-hot';
  if (h >= 25) return 'heat-warm';
  if (h >= 10) return 'heat-cool';
  return 'heat-cold';
}

// Map dimension icon keys (as emitted by /audit/v3/[slug].astro's cell_expand_*
// data-cta) to short human labels. Mirrors src/utils/audit/locked-observation
// shortLabel without taking a runtime dep on it (this is UI concern, not
// audit-engine concern).
const DIM_LABEL: Record<string, string> = {
  search:    'Search visibility',
  spark:     'AI citation',
  bolt:      'Page speed',
  target:    'Measurement',
  megaphone: 'Ads in flight',
  eye:       'Conversion path',
  phone:     'Mobile',
  mail:      'Email reputation',
  flag:      'Stack',
  bar:       'Ranking',
  clock:     'Cadence',
};
function dimLabel(key: string): string {
  return DIM_LABEL[key] ?? key;
}
---
{prospects.length === 0 ? (
  <p class="empty">No prospect engagement yet.</p>
) : (
  <div class="feed">
    {prospects.map((p, i) => {
      const info = prospectInfo?.get(p.prospect);
      const displayName = info?.firstName || p.prospect;
      const displayCo = info?.company || slugToDomain(p.prospect);
      const noContact = !info?.firstName;
      const liHref = info?.linkedinUrl || findOnLinkedinUrl(p.prospect);
      return (
        <details class="row">
          <summary>
            <span class="rank">{String(i + 1).padStart(2, '0')}</span>
            <div class="who">
              <div class="line-1">
                <a class="name" href={liHref} target="_blank" rel="noopener" title={info?.linkedinUrl ? "Open LinkedIn profile" : "Google site:linkedin.com search"}>{displayName}<span class="name-arrow" aria-hidden="true"> ↗</span></a>
                {info?.title && <span class="title">, {info.title}</span>}
                <a class="memo-side-link" href={prospectUrl(p.prospect, p.surface)} target="_blank" rel="noopener" title="Open the memo">memo ↗</a>
              </div>
              <div class="line-2">
                <span class="co">{displayCo}</span>
                {info?.source && <span class="src">· {info.source}</span>}
                {noContact && <span class="src">· no Airtable record</span>}
              </div>
            </div>
            <span class="m"><b>{p.total_views}</b> views</span>
            <span class="m"><b>{p.unique_sessions}</b> sess</span>
            <span class="m" title={p.distinct_visitors >= 2 ? 'Multi-viewer: forwarded internally or returned from another device' : 'Single viewer'}><b class={p.distinct_visitors >= 2 ? 'accent' : 'dim'}>{p.distinct_visitors}</b> ppl</span>
            <span class="m"><b>{dwell(p.total_dwell_seconds)}</b> dwell</span>
            <span class="m"><b class={p.cta_clicks > 0 ? 'accent' : 'dim'}>{p.cta_clicks > 0 ? p.cta_clicks : '—'}</b> cta</span>
            <span class={`heat-pill ${heatClass(p.heat_score)}`}><b>{p.heat_score}</b> heat</span>
            <span class="chev" aria-hidden="true">↓</span>
          </summary>
          <div class="sessions">
            {p.expanded_dimensions && p.expanded_dimensions.length > 0 && (
              <div class="dim-row">
                <span class="dim-label">Drilled into</span>
                <ul class="dim-chips">
                  {p.expanded_dimensions.map((d) => (
                    <li class="dim-chip" title={`cell_expand_${d}`}>{dimLabel(d)}</li>
                  ))}
                </ul>
              </div>
            )}
            {p.sessions.length === 0 ? (
              <p class="empty">No session data.</p>
            ) : (
              <ol class="sess-list">
                {p.sessions.map((s) => {
                  const url = sessionReplayUrl(s.sid);
                  return (
                    <li>
                      <span class="s-when">{timeAgo(s.last_event)}</span>
                      <span class="s-mono">{dwell(s.dwell_seconds)} dwell</span>
                      <span class="s-mono">{s.views} event{s.views === 1 ? '' : 's'}</span>
                      {s.clicks > 0 && <span class="s-cta">{s.clicks} CTA click{s.clicks === 1 ? '' : 's'}</span>}
                      <span class="s-fill"></span>
                      {url ? (
                        <a class="s-replay" href={url} target="_blank" rel="noopener">↻ replay</a>
                      ) : (
                        <span class="s-replay s-replay--miss">no replay</span>
                      )}
                    </li>
                  );
                })}
              </ol>
            )}
          </div>
        </details>
      );
    })}
  </div>
)}

<style>
  .empty {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    color: var(--ink-faint, #7A8597);
    padding: 18px 0;
    margin: 0;
  }
  .feed {
    border: 1px solid var(--ink, #0E1A2C);
    background: var(--paper, #FFFFFF);
  }
  .row {
    border-bottom: 1px solid var(--line, rgba(14,26,44,0.14));
  }
  .row:last-child { border-bottom: 0; }
  .row[open] { background: var(--paper-2, #F4F2ED); }

  summary {
    list-style: none;
    display: grid;
    grid-template-columns: 28px 1fr 70px 60px 80px 50px 90px 18px;
    align-items: center;
    gap: 16px;
    padding: 12px 18px;
    cursor: pointer;
    transition: background 120ms;
  }
  summary::-webkit-details-marker { display: none; }
  summary::marker { display: none; }
  summary:hover { background: var(--paper-2, #F4F2ED); }
  .row[open] summary { background: var(--paper-3, #EBE6DC); }

  .rank {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--ink-faint, #7A8597);
    text-align: right;
  }

  .who { min-width: 0; }
  .line-1 {
    display: flex; align-items: baseline; gap: 4px; min-width: 0;
  }
  .name {
    font-weight: 600;
    color: var(--ink, #0E1A2C);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong, rgba(14,26,44,0.28));
    flex-shrink: 0;
  }
  .name:hover { color: var(--accent-deep, #4A6E18); border-bottom-color: var(--accent-deep, #4A6E18); }
  .name-arrow {
    font-size: 0.75em;
    color: var(--ink-faint, #7A8597);
    margin-left: 2px;
    font-weight: 400;
  }
  .name:hover .name-arrow { color: var(--accent-deep, #4A6E18); }
  .memo-side-link {
    margin-left: 10px;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--ink-faint, #7A8597);
    text-decoration: none;
    border-bottom: 1px dotted var(--line, rgba(14,26,44,0.14));
    padding-bottom: 1px;
  }
  .memo-side-link:hover { color: var(--accent-deep, #4A6E18); border-bottom-color: var(--accent-deep, #4A6E18); }
  .title {
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    font-size: 13px;
    color: var(--ink-dim, #3A4658);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .line-2 {
    margin-top: 2px;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    font-size: 13px;
    color: var(--ink-dim, #3A4658);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .co { color: var(--ink-dim, #3A4658); }
  .src {
    margin-left: 6px;
    font-family: var(--mono, 'DM Mono', monospace);
    font-style: normal;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--ink-faint, #7A8597);
  }

  .m {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 11px;
    color: var(--ink-faint, #7A8597);
    letter-spacing: 0.04em;
    text-align: right;
    white-space: nowrap;
  }
  .m b {
    color: var(--ink, #0E1A2C);
    font-weight: 600;
    margin-right: 4px;
  }
  .m .accent { color: var(--accent-deep, #4A6E18); }
  .m .dim { color: var(--ink-faint, #7A8597); font-weight: 400; }

  .heat-pill {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    padding: 3px 8px;
    border: 1px solid var(--line, rgba(14,26,44,0.14));
    text-align: center;
    white-space: nowrap;
  }
  .heat-pill b { font-weight: 600; margin-right: 4px; }
  .heat-pill.heat-hot { background: var(--accent-bg, #F2F7E5); color: var(--accent-deep, #4A6E18); border-color: var(--accent, #8FBF3F); }
  .heat-pill.heat-hot b { color: var(--accent-deep, #4A6E18); }
  .heat-pill.heat-warm { background: var(--sage, #E8F0D9); color: var(--accent-deep, #4A6E18); border-color: var(--accent-deep, #4A6E18); }
  .heat-pill.heat-warm b { color: var(--accent-deep, #4A6E18); }
  .heat-pill.heat-cool { color: var(--ink-dim, #3A4658); border-color: var(--line-strong, rgba(14,26,44,0.28)); }
  .heat-pill.heat-cool b { color: var(--ink, #0E1A2C); }
  .heat-pill.heat-cold { color: var(--ink-faint, #7A8597); }
  .heat-pill.heat-cold b { color: var(--ink-dim, #3A4658); }

  .chev {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 12px;
    color: var(--ink-faint, #7A8597);
    transition: transform 120ms;
    text-align: center;
  }
  .row[open] .chev { transform: rotate(180deg); }

  /* Sessions detail */
  .sessions {
    padding: 12px 18px 16px 50px;
    border-top: 1px solid var(--line, rgba(14,26,44,0.14));
  }

  /* Drilled-into dimensions chip row (v3.5 per-cell expand signal) */
  .dim-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px dotted var(--line, rgba(14,26,44,0.14));
  }
  .dim-label {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint, #7A8597);
    flex-shrink: 0;
    margin-top: 3px;
  }
  .dim-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .dim-chip {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    background: var(--sage, #E8F0D9);
    color: var(--accent-deep, #4A6E18);
    border: 1px solid var(--accent-deep, #4A6E18);
    white-space: nowrap;
  }

  .sess-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .sess-list li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 6px 0;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 11px;
    color: var(--ink-dim, #3A4658);
    border-bottom: 1px dotted var(--line, rgba(14,26,44,0.14));
  }
  .sess-list li:last-child { border-bottom: 0; }
  .s-when { color: var(--ink, #0E1A2C); min-width: 70px; }
  .s-mono { color: var(--ink-dim, #3A4658); }
  .s-cta { color: var(--accent-deep, #4A6E18); font-weight: 600; }
  .s-fill { flex: 1; }
  .s-replay {
    color: var(--accent-deep, #4A6E18);
    text-decoration: none;
    border-bottom: 1px dotted var(--accent-deep, #4A6E18);
  }
  .s-replay:hover { color: var(--ink, #0E1A2C); border-bottom-color: var(--ink, #0E1A2C); }
  .s-replay--miss { color: var(--ink-faint, #7A8597); border-bottom: 0; font-style: italic; }

  @media (max-width: 780px) {
    summary {
      grid-template-columns: 28px 1fr 60px 90px 18px;
      gap: 8px;
    }
    summary .m:nth-of-type(2), summary .m:nth-of-type(3) { display: none; }
    .sessions { padding: 10px 14px 14px 14px; }
  }
</style>
