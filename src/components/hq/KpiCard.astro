---
import Sparkline from './Sparkline.astro';

interface Props {
  label: string;
  value: number;
  rawValue?: number;
  prevValue?: number;
  prevLabel?: string;
  sub?: string;
  hint?: string;
  spark?: number[];
  sparkColor?: string;
  /** When true, render this card as a higher-affinity "money" metric (CTA / engaged). */
  emphasis?: 'standard' | 'accent';
}

const {
  label,
  value,
  rawValue,
  prevValue,
  prevLabel = 'prev period',
  sub,
  hint,
  spark,
  sparkColor = 'var(--ink)',
  emphasis = 'standard',
} = Astro.props;

// Calculate % change vs previous period
let deltaPct: number | null = null;
let deltaSign: 'up' | 'down' | 'flat' = 'flat';
if (typeof prevValue === 'number') {
  if (prevValue === 0 && value === 0) {
    deltaSign = 'flat';
    deltaPct = 0;
  } else if (prevValue === 0) {
    deltaSign = 'up';
    deltaPct = null; // ∞ — show as new
  } else {
    const pct = ((value - prevValue) / prevValue) * 100;
    deltaPct = Math.abs(pct);
    if (pct > 0.5) deltaSign = 'up';
    else if (pct < -0.5) deltaSign = 'down';
    else deltaSign = 'flat';
  }
}

function fmtPct(n: number): string {
  if (n >= 100) return `${Math.round(n)}%`;
  if (n >= 10) return `${n.toFixed(0)}%`;
  return `${n.toFixed(1)}%`;
}
---
<div class={`kpi ${emphasis === 'accent' ? 'kpi--accent' : ''}`}>
  <div class="lab">{label}</div>
  <div class="row">
    <div class="val">{value.toLocaleString()}</div>
    {typeof prevValue === 'number' && (
      <div class={`delta delta--${deltaSign}`} title={`Previous ${prevLabel}: ${prevValue.toLocaleString()}`}>
        {deltaSign === 'up' && <span class="arrow">↑</span>}
        {deltaSign === 'down' && <span class="arrow">↓</span>}
        {deltaSign === 'flat' && <span class="arrow">·</span>}
        <span class="delta-pct">{deltaPct === null ? 'new' : fmtPct(deltaPct)}</span>
      </div>
    )}
  </div>
  {spark && spark.length > 0 && (
    <div class="spark-wrap">
      <Sparkline data={spark} color={sparkColor} ariaLabel={`${label} trend`} />
    </div>
  )}
  {(sub || typeof rawValue === 'number') && (
    <div class="sub">
      {sub}
      {typeof rawValue === 'number' && (
        <span class="raw"> · {rawValue.toLocaleString()} total</span>
      )}
    </div>
  )}
  {hint && <div class="hint">{hint}</div>}
</div>

<style>
  .kpi {
    padding: 1rem 1.25rem;
    border-right: 1px solid var(--line, rgba(14,26,44,0.14));
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 130px;
  }
  .lab {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-faint, #7A8597);
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .val {
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink, #0E1A2C);
    font-variant-numeric: tabular-nums;
  }
  .delta {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.15rem 0.4rem;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.7rem;
    font-weight: 500;
    border-radius: 3px;
    font-variant-numeric: tabular-nums;
  }
  .delta--up {
    color: var(--accent-deep, #4A6E18);
    background: var(--accent-bg, #F2F7E5);
  }
  .delta--down {
    color: #9b2c2c;
    background: #fbeaea;
  }
  .delta--flat {
    color: var(--ink-faint, #7A8597);
    background: var(--paper-2, #F4F2ED);
  }
  .arrow {
    font-size: 0.8rem;
    line-height: 1;
  }

  .spark-wrap {
    color: var(--ink, #0E1A2C);
    margin: -0.1rem -0.25rem 0;
    height: 32px;
  }

  .sub {
    margin-top: auto;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 0.7rem;
    color: var(--ink-faint, #7A8597);
  }
  .raw {
    opacity: 0.85;
  }
  .hint {
    margin-top: 0.25rem;
    font-family: var(--serif, 'Newsreader', Georgia, serif);
    font-style: italic;
    font-size: 0.78rem;
    color: var(--ink-faint, #7A8597);
    line-height: 1.3;
  }

  .kpi--accent .val { color: var(--accent-deep, #4A6E18); }
  .kpi--accent .spark-wrap { color: var(--accent-deep, #4A6E18); }
</style>
