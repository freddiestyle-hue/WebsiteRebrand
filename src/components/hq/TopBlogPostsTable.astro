---
// Direction A § 04 Blog feed.
// Grid columns: [2fr title + slug] [1fr views mono] [1fr uniques mono] [90px Site button]

import type { TopBlogPost } from '../../utils/posthog/query';

interface Props {
  posts: TopBlogPost[];
}

const { posts } = Astro.props;

function isFresh(post: TopBlogPost): boolean {
  const ageMs = Date.now() - new Date(post.last_view).getTime();
  return ageMs < 48 * 60 * 60 * 1000 && post.views_raw <= 10;
}
---
{posts.length === 0 ? (
  <p class="empty">No blog activity yet in this range.</p>
) : (
  <div class="feed">
    {posts.map((p) => (
      <div class="feed-row">
        <div class="cell title">
          <strong>{p.slug.replace(/-/g, ' ')}</strong>
          <span class="slug">/notes/{p.slug}</span>
          {isFresh(p) && <span class="tag-new">NEW</span>}
        </div>
        <div class="cell mono"><b>{p.views_humans}</b> views <span class="raw">/ {p.views_raw}</span></div>
        <div class="cell mono"><b>{p.visitors_humans}</b> uniques <span class="raw">/ {p.visitors_raw}</span></div>
        <div class="cell">
          <a class="hq-btn-ghost" href={p.path} target="_blank" rel="noopener">Site ↗</a>
        </div>
      </div>
    ))}
  </div>
)}

<style>
  .empty {
    font-family: var(--serif, Archivo, 'Inter Tight', system-ui, sans-serif);
    font-style: italic;
    color: var(--ink-faint, #6F7A64);
    padding: 18px 0;
    margin: 0;
  }
  .feed {
    border: 1px solid var(--ink, #163300);
    background: var(--paper, #FFFFFF);
  }
  .feed-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 90px;
    gap: 16px;
    padding: 14px 18px;
    align-items: center;
    border-bottom: 1px solid var(--line, rgba(22,51,0,0.14));
    transition: background 120ms;
  }
  .feed-row:last-child { border-bottom: 0; }
  .feed-row:hover { background: var(--paper-2, #F2F5EC); }
  .cell { min-width: 0; }
  .title {
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
  }
  .title strong {
    font-weight: 600; color: var(--ink, #163300);
    text-transform: capitalize;
  }
  .slug {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 10px; letter-spacing: 0.06em;
    color: var(--ink-faint, #6F7A64);
  }
  .mono {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-dim, #454745);
  }
  .mono b { color: var(--ink, #163300); font-weight: 600; }
  .raw { color: var(--ink-faint, #6F7A64); }
  .tag-new {
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 9px; letter-spacing: 0.18em;
    padding: 2px 6px;
    background: var(--accent, #A5E85C); color: var(--ink, #163300);
    font-weight: 600;
  }
  .hq-btn-ghost {
    display: inline-block;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 10px; letter-spacing: 0.06em;
    padding: 5px 10px;
    border: 1px solid var(--line-strong, rgba(22,51,0,0.28));
    background: var(--paper, #FFFFFF); color: var(--ink, #163300);
    text-decoration: none;
  }
  .hq-btn-ghost:hover { background: var(--ink, #163300); color: var(--paper, #FFFFFF); border-color: var(--ink, #163300); }

  @media (max-width: 780px) {
    .feed-row {
      grid-template-columns: 1fr auto;
      gap: 6px 12px;
    }
    .feed-row .mono { grid-column: 1; }
  }
</style>
