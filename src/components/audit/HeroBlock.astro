---
import Block from './Block.astro';

interface Props {
  kicker?: string;
  headline: string;
  italicTail?: string;
  dek?: string;
  primaryCtaLabel?: string;
  primaryCtaHref?: string;
  primaryCtaName?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  secondaryCtaName?: string;
}

const {
  kicker,
  headline,
  italicTail,
  dek,
  primaryCtaLabel,
  primaryCtaHref,
  primaryCtaName = 'hq_hero_primary',
  secondaryCtaLabel,
  secondaryCtaHref,
  secondaryCtaName = 'hq_hero_secondary',
} = Astro.props;
---
<Block id="hero" label="Hero">
  {kicker && <div class="kicker">{kicker}</div>}
  <h1>
    {headline}
    {italicTail && <> <span class="ital">{italicTail}</span></>}
  </h1>
  {dek && <p class="dek">{dek}</p>}
  {(primaryCtaLabel || secondaryCtaLabel) && (
    <div class="actions">
      {primaryCtaLabel && primaryCtaHref && (
        <a class="btn btn--primary" data-cta={primaryCtaName} href={primaryCtaHref}>{primaryCtaLabel}</a>
      )}
      {secondaryCtaLabel && secondaryCtaHref && (
        <a class="btn" data-cta={secondaryCtaName} href={secondaryCtaHref}>{secondaryCtaLabel}</a>
      )}
    </div>
  )}
</Block>

<style>
  .kicker { font-family: var(--mono, 'DM Mono', monospace); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; opacity: 0.7; margin-bottom: 1rem; }
  h1 { font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.05; font-weight: 700; margin: 0 0 1rem; }
  .ital { font-family: var(--serif, Archivo, 'Inter Tight', system-ui, sans-serif); font-style: italic; font-weight: 400; }
  .dek { font-size: 1.15rem; line-height: 1.4; opacity: 0.85; max-width: 60ch; margin: 0 0 1.5rem; }
  .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 0.75rem 1.25rem; border-radius: 4px; border: 1px solid currentColor; text-decoration: none; font-weight: 500; }
  .btn--primary { background: var(--accent, #A5E85C); color: var(--accent-ink, #163300); border-color: var(--accent, #A5E85C); }
</style>
