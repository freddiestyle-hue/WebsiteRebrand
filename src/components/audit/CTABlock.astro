---
import Block from './Block.astro';

interface Props {
  sectionNumber?: string;
  headline: string;
  italicTail?: string;
  body?: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  primaryCtaName?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  secondaryCtaName?: string;
  signature?: string;
}

const {
  sectionNumber = '04',
  headline,
  italicTail,
  body,
  primaryCtaLabel,
  primaryCtaHref,
  primaryCtaName = 'hq_cta_primary',
  secondaryCtaLabel,
  secondaryCtaHref,
  secondaryCtaName = 'hq_cta_secondary',
  signature,
} = Astro.props;
---
<Block id="cta" label="CTA">
  <div class="head">
    <div class="num">§ {sectionNumber}</div>
    <h2>
      {headline}
      {italicTail && <> <span class="ital">{italicTail}</span></>}
    </h2>
  </div>
  {body && <p class="body">{body}</p>}
  <div class="actions">
    <a class="btn btn--primary" data-cta={primaryCtaName} href={primaryCtaHref}>{primaryCtaLabel}</a>
    {secondaryCtaLabel && secondaryCtaHref && (
      <a class="btn" data-cta={secondaryCtaName} href={secondaryCtaHref}>{secondaryCtaLabel}</a>
    )}
  </div>
  {signature && <div class="sig">{signature}</div>}
</Block>

<style>
  .head { margin-bottom: 1rem; }
  .num { font-family: var(--mono, 'DM Mono', monospace); font-size: 0.75rem; opacity: 0.6; margin-bottom: 0.5rem; }
  h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.15; font-weight: 600; margin: 0; }
  .ital { font-family: var(--serif, 'Newsreader', Georgia, serif); font-style: italic; font-weight: 400; }
  .body { font-size: 1.05rem; line-height: 1.5; opacity: 0.85; max-width: 60ch; margin: 0 0 1.5rem; }
  .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .btn { display: inline-block; padding: 0.75rem 1.25rem; border-radius: 4px; border: 1px solid currentColor; text-decoration: none; font-weight: 500; }
  .btn--primary { background: var(--accent, #6FB582); color: white; border-color: var(--accent, #6FB582); }
  .sig { font-family: var(--mono, 'DM Mono', monospace); font-size: 0.85rem; opacity: 0.7; }
</style>
