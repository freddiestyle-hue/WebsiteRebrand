---
// /diagnostic CRO hero — approved 2026-06-02.
// stamp · h1 · dek · trust · quote · proof (Variant C: hybrid band)
// The book card aside is rendered next to this by diagnostic.astro.
import DiagnosticBookCard from './DiagnosticBookCard.astro';

const logos = [
  { id: 'somewhere', name: 'Somewhere', wordmark: true },
  { id: 'visa', name: 'VISA', src: '/img/proof/visa.svg' },
  { id: 'samsung', name: 'Samsung', src: '/img/proof/samsung.svg' },
  { id: 'unilever', name: 'Unilever', src: '/img/proof/unilever.svg' },
  { id: 'vodafone', name: 'Vodafone', src: '/img/proof/vodafone.svg' },
  { id: 'aljazeera', name: 'Al Jazeera', src: '/img/proof/aljazeera.svg' },
];
---
<header class="cro-hero">
  <div class="cro-copy">
    <span class="stamp">Two-week diagnostic · one senior operator</span>
    <h1>Find where the revenue leaks. <span class="ital">In a fortnight.</span></h1>
    <p class="cro-dek">A senior operator reads your last quarter, sits in your stack, and writes the one-page memo on what to halt.</p>

    <div class="cro-trust">
      <span>30 min call</span><span class="tdot"></span>
      <span>No payment up front</span><span class="tdot"></span>
      <span>Reply in 24 hrs</span>
    </div>

    <div class="cro-quote">
      <blockquote>&ldquo;The memo found the leak in week one. We halted <b>$40k</b> of spend that fortnight.&rdquo;</blockquote>
      <cite>VP Growth · Series B fintech · 2025 · name withheld · NDA</cite>
    </div>

    <div class="cro-proof">
      <div class="proof-C">
        <div class="band-lbl">Past portfolio work</div>
        <div class="logos logo-row">
          {logos.map((logo) => (
            <span class="logo-cell">
              {logo.wordmark ? (
                <span class="logo-wordmark">{logo.name}</span>
              ) : (
                <img src={logo.src} alt={logo.name} class="logo-img" loading="lazy" />
              )}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <DiagnosticBookCard />
</header>

<style>
  /* Local overrides for the Variant C logo presentation (image-based instead of design-bundle wordmark slots) */
  .logo-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-6) var(--sp-7); }
  .logo-cell { display: inline-flex; align-items: center; height: 28px; opacity: 0.78; }
  .logo-img { height: 22px; width: auto; display: block; filter: grayscale(1); }
  .logo-cell .logo-wordmark { font-family: var(--grotesk); font-weight: 700; font-size: 16px; letter-spacing: -0.02em; color: var(--ink); line-height: 1; }
  @media (max-width: 640px) {
    .logo-row { gap: var(--sp-4) var(--sp-5); }
    .logo-cell { height: 22px; }
    .logo-img { height: 16px; }
    .logo-cell .logo-wordmark { font-size: 13px; }
  }
</style>
