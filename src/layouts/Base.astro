---
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/global.css';
import PostHog from '../components/PostHog.astro';
import GoogleTags from '../components/GoogleTags.astro';
import GtmNoscript from '../components/GtmNoscript.astro';
import Nav from '../components/Nav.astro';
import BookingProvider from '../components/diagnostic/BookingProvider.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { organizationSchema, websiteSchema, safeBuild } from '../utils/schema';
import { buildCanonicalUrl } from '../utils/canonicalUrl';

interface ArticleMeta {
  publishedTime: string;
  modifiedTime: string;
  author?: string;
  tag?: string;
}

interface Props {
  title: string;
  description?: string;
  fontWeights?: string;
  currentNav?: 'home' | 'blog' | 'mri';
  noindex?: boolean;
  posthogCapturePageview?: boolean;
  posthogOptOutByDefault?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  article?: ArticleMeta;
  extraSchema?: Array<Record<string, unknown>>;
}

const {
  title,
  description = 'Find and fix revenue leaks for profitable operator-led companies. Senior judgment across acquisition, lifecycle, CRM, reporting, and AI-assisted workflows.',
  fontWeights = 'Inter+Tight:wght@400;500;600;700;800',
  currentNav,
  noindex = false,
  posthogCapturePageview = true,
  posthogOptOutByDefault = false,
  ogType = 'website',
  ogImage,
  article,
  extraSchema = [],
} = Astro.props;

const fontHref = `https://fonts.googleapis.com/css2?family=${fontWeights}&family=DM+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap`;
const canonical = buildCanonicalUrl(Astro.url.pathname);
const ogImageUrl = ogImage ?? new URL('/og-default.png', Astro.site).toString();
const authorName = article?.author ?? 'Fred Style';

const sitewideSchema = [
  safeBuild(() => organizationSchema, 'Organization'),
  safeBuild(() => websiteSchema, 'WebSite'),
  ...extraSchema,
].filter(Boolean) as Array<Record<string, unknown>>;

// Floating "Book a call" pill is site-wide but suppressed on pages that
// already carry an inline booking CTA, or on internal HQ surfaces.
const _path = Astro.url.pathname;
const showFloatingCta = !(
  _path === '/diagnostic' ||
  _path.startsWith('/diagnostic/') ||
  _path.startsWith('/audit/v3') ||
  _path.startsWith('/audit/p/') ||
  _path.startsWith('/hq') ||
  _path.startsWith('/brite/hq') ||
  _path.startsWith('/action-center') ||
  _path.startsWith('/internal/') ||
  _path.startsWith('/p/') ||
  _path.startsWith('/r/') ||
  _path.startsWith('/q/')
);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <GoogleTags />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <link rel="canonical" href={canonical} />
  <meta name="author" content={authorName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Rivett" />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  {article && (
    <>
      <meta property="article:published_time" content={article.publishedTime} />
      <meta property="article:modified_time" content={article.modifiedTime} />
      <meta property="article:author" content={article.author ?? authorName} />
      {article.tag && <meta property="article:section" content={article.tag} />}
    </>
  )}
  <link rel="alternate" type="application/rss+xml" title="Rivett Field Notes" href="/rss.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#8FBF3F" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={fontHref} rel="stylesheet" />
  {sitewideSchema.map((s) => <JsonLd schema={s} />)}
  <PostHog capturePageview={posthogCapturePageview} optOutByDefault={posthogOptOutByDefault} />
</head>
<body>
  {showFloatingCta && (
    <>
      <BookingProvider />
      <a
        class="floating-cta"
        href="https://cal.com/fred-style/discovery?overlayCalendar=true"
        target="_blank"
        rel="noopener noreferrer"
        data-cta="floating_book_call"
        data-cal-link="fred-style/discovery"
        aria-label="Book a call with Fred"
      >
        <span class="floating-cta-dot" aria-hidden="true"></span>
        <span class="floating-cta-label">Book a call</span>
        <svg class="floating-cta-arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <script is:inline>
        // Wire the floating CTA to open the Cal modal in-place. The anchor
        // keeps a working https://cal.com/... href so the click still works
        // if JS is off or Cal hasn't loaded yet. When Cal is ready, intercept
        // and open the modal instead.
        (function () {
          var a = document.querySelector('a.floating-cta[data-cal-link]');
          if (!a) return;
          var link = a.getAttribute('data-cal-link');
          a.addEventListener('click', function (e) {
            var w = window;
            var ns = w.__rivettCalNamespace;
            if (w.Cal && ns && w.Cal.ns && w.Cal.ns[ns]) {
              e.preventDefault();
              if (w.posthog && w.posthog.capture) {
                w.posthog.capture('floating_cta_modal_opened', {
                  path: window.location.pathname,
                }, { send_instantly: true, transport: 'sendBeacon' });
              }
              w.Cal.ns[ns]('modal', { calLink: link });
            }
            // else: fall through to the href (opens cal.com in a new tab)
          });
        })();
      </script>
    </>
  )}
  <GtmNoscript />
  <Nav current={currentNav} />
  <main id="main">
    <slot />
  </main>
</body>
</html>

<style is:global>
  .floating-cta {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px 12px 16px;
    background: var(--ink, #0E1A2C);
    color: var(--on-ink, #ffffff);
    border-radius: 999px;
    font-family: var(--mono, 'DM Mono', monospace);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow:
      0 8px 28px rgba(143, 191, 63, 0.22),
      0 2px 6px rgba(0, 0, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 220ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  .floating-cta:hover,
  .floating-cta:focus-visible {
    transform: translateY(-1px) scale(1.03);
    box-shadow:
      0 12px 36px rgba(143, 191, 63, 0.32),
      0 3px 8px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    outline: none;
  }
  .floating-cta-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent, #8FBF3F);
    box-shadow: 0 0 8px rgba(143, 191, 63, 0.6);
    animation: floating-cta-pulse 2.4s ease-in-out infinite;
  }
  .floating-cta-arrow {
    opacity: 0.7;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .floating-cta:hover .floating-cta-arrow {
    transform: translateX(2px);
    opacity: 1;
  }
  @keyframes floating-cta-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.35); opacity: 0.7; }
  }
  @media (max-width: 640px) {
    .floating-cta {
      bottom: 16px;
      right: 16px;
      padding: 10px 14px 10px 12px;
      font-size: 11px;
      gap: 8px;
    }
    .floating-cta-arrow { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-cta-dot { animation: none; }
    .floating-cta { transition: none; }
    .floating-cta:hover { transform: none; }
  }
</style>
