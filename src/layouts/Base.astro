---
import '../styles/tokens.css';
import '../styles/global.css';
import PostHog from '../components/PostHog.astro';
import GoogleTags from '../components/GoogleTags.astro';
import GtmNoscript from '../components/GtmNoscript.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
  fontWeights?: string;
  currentNav?: 'home' | 'blog' | 'tools';
}

const {
  title,
  description = 'Growth infrastructure for operator-led companies. Senior judgment across acquisition, lifecycle, CRM, reporting, and AI-assisted workflows.',
  fontWeights = 'Inter+Tight:wght@400;500;600;700;800',
  currentNav,
} = Astro.props;

const fontHref = `https://fonts.googleapis.com/css2?family=${fontWeights}&family=DM+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Rivett" />
  <meta property="og:image" content={new URL('/og-default.png', Astro.site).toString()} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={new URL('/og-default.png', Astro.site).toString()} />
  <link rel="alternate" type="application/rss+xml" title="Rivett Field Notes" href="/rss.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={fontHref} rel="stylesheet" />
  <PostHog />
  <GoogleTags />
</head>
<body>
  <GtmNoscript />
  <Nav current={currentNav} />
  <slot />
</body>
</html>
