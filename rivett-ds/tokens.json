{
  "$schema": "https://rivett.tech/schema/tokens-v1.json",
  "meta": {
    "name": "Rivett",
    "version": "1.0.0",
    "issued": "2026-05",
    "canonical": true,
    "source": "tokens.css"
  },
  "color": {
    "surface": {
      "paper":   { "value": "#FFFFFF", "use": "default page background" },
      "paper-2": { "value": "#F4F2ED", "use": "demo wells, raised cards, TLDR" },
      "paper-3": { "value": "#EBE6DC", "use": "code chips, table heads" },
      "paper-4": { "value": "#DDD7C9", "use": "deepest paper, code blocks" },
      "sage":    { "value": "#E8F0D9", "use": "tinted accent surface, numbox" },
      "sage-2":  { "value": "#D5E3B7", "use": "sage hover/active" }
    },
    "ink": {
      "ink":       { "value": "#0E1A2C", "use": "primary type, dark surface bg" },
      "ink-2":     { "value": "#1B2940", "use": "dark surface raised" },
      "ink-dim":   { "value": "#3A4658", "use": "secondary type, italic serif on light" },
      "ink-faint": { "value": "#7A8597", "use": "meta strip, captions" },
      "ink-soft":  { "value": "#B6BCC6", "use": "disabled, dividers on dark" }
    },
    "on-ink": {
      "on-ink":        { "value": "#FFFFFF",                "use": "primary on dark" },
      "on-ink-dim":    { "value": "rgba(255,255,255,0.78)", "use": "body on dark" },
      "on-ink-italic": { "value": "rgba(255,255,255,0.62)", "use": "italic clause on dark" },
      "on-ink-faint":  { "value": "rgba(255,255,255,0.55)", "use": "meta on dark" },
      "on-ink-line":   { "value": "rgba(255,255,255,0.18)", "use": "hairline on dark" },
      "on-ink-line-2": { "value": "rgba(255,255,255,0.32)", "use": "stronger hairline on dark" }
    },
    "line": {
      "line":         { "value": "rgba(14,26,44,0.14)", "use": "default border" },
      "line-strong":  { "value": "rgba(14,26,44,0.28)", "use": "section dividers" },
      "line-soft":    { "value": "rgba(14,26,44,0.06)", "use": "faint rule" }
    },
    "accent": {
      "accent":      { "value": "#8FBF3F", "use": "the dot, hover fills, focus ring on dark" },
      "accent-deep": { "value": "#4A6E18", "use": "AA on paper, small text, focus ring on light", "wcag-aa-on-paper": true },
      "accent-bg":   { "value": "#F2F7E5", "use": "callout tint" }
    },
    "signal": {
      "signal-warn": { "value": "#B8651F", "use": "MRI amber bars only" },
      "signal-halt": { "value": "#9A2B2B", "use": "halt, decline, destructive only" }
    }
  },
  "type": {
    "family": {
      "grotesk": { "value": "'Inter Tight', system-ui, -apple-system, sans-serif", "use": "body, headlines, UI" },
      "serif":   { "value": "'Newsreader', Georgia, 'Times New Roman', serif",      "use": "italic clause only" },
      "mono":    { "value": "'DM Mono', ui-monospace, 'SF Mono', Menlo, monospace",  "use": "stamps, labels, code" }
    },
    "weight": {
      "grotesk": [400, 500, 600, 700, 800],
      "serif":   [400, 500],
      "mono":    [300, 400, 500]
    },
    "scale": {
      "display":    { "value": "clamp(56px, 8vw, 124px)",  "use": "hero only" },
      "h-xxl":      { "value": "clamp(48px, 6vw, 72px)",   "use": "section opener" },
      "h-xl":       { "value": "clamp(36px, 4.4vw, 48px)", "use": "section h2" },
      "h-lg":       { "value": "30px", "use": "h2 small, numbox v" },
      "h-md":       { "value": "22px", "use": "h3" },
      "h-sm":       { "value": "17px", "use": "h4, UI heads" },
      "body-xl":    { "value": "19px", "use": "feature body, pull-out" },
      "body":       { "value": "16px", "use": "default body" },
      "body-md":    { "value": "15px", "use": "card lede, supporting" },
      "body-sm":    { "value": "13.5px", "use": "tables, dense lists" },
      "meta":       { "value": "11px",   "use": "mono labels, stamps" },
      "caption":    { "value": "10.5px", "use": "demo captions, footer" }
    },
    "tracking": {
      "mono":       "0.22em",
      "mono-tight": "0.16em",
      "tighter":    "-0.03em",
      "display":    "-0.055em",
      "h":          "-0.04em",
      "h-md":       "-0.03em",
      "h-sm":       "-0.02em"
    },
    "line-height": {
      "display":  0.92,
      "h":        1.05,
      "h-prose":  1.18,
      "body":     1.55,
      "prose":    1.65,
      "tight":    1.25
    }
  },
  "spacing": {
    "base": 4,
    "scale": {
      "sp-1":  4, "sp-2":  8, "sp-3":  12, "sp-4":  16, "sp-5":  20,
      "sp-6":  24, "sp-7":  28, "sp-8":  32, "sp-10": 40, "sp-12": 48,
      "sp-14": 56, "sp-16": 64, "sp-20": 80, "sp-24": 96, "sp-32": 128, "sp-40": 160
    }
  },
  "radius": {
    "r-0":    0,
    "r-sm":   2,
    "r-pill": 999,
    "rule": "Default is 0. Rivett is square. The only allowed radii are r-sm (2px, tiny chrome only) and r-pill (the dot, pills). Never 4/6/8."
  },
  "border-width": {
    "hair":  1,
    "rule":  2,
    "thick": 3
  },
  "motion": {
    "ease":  "cubic-bezier(0.2, 0.6, 0.2, 1)",
    "ease-in":  "cubic-bezier(0.4, 0, 1, 1)",
    "ease-out": "cubic-bezier(0, 0, 0.2, 1)",
    "dur-1": 120,
    "dur-2": 200,
    "dur-3": 320,
    "dur-4": 500
  },
  "elevation": {
    "shadow-0": "none",
    "shadow-1": "0 1px 0 rgba(14,26,44,0.04)",
    "shadow-2": "0 8px 24px -10px rgba(14,26,44,0.18)",
    "rule": "Shadow is almost off. Default is none. shadow-2 is only allowed on the modal."
  },
  "layout": {
    "page-max":       1240,
    "page-max-prose": 720,
    "page-pad":       56,
    "page-pad-sm":    24,
    "col-gap":        24,
    "cols":           12
  },
  "z": {
    "base":    1,
    "sticky":  10,
    "overlay": 100,
    "modal":   200,
    "toast":   300
  }
}
